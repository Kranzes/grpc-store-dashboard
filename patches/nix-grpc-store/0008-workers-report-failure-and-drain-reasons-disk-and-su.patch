+
+// A long version is cut at a character and cleaned, so the WorkerState
+// every watcher decodes stays a valid proto3 string.
+void testVersionCut()
+{
+    Metrics metrics("");
+    Dispatcher disp({.defaultSystem = std::string(x86), .lookupThreads = 0}, metrics);
+    Session wkr;
+    auto hello = helloMsg("w1", 2);
+    hello.mutable_hello()->set_version("2.36" + std::string(rlo) + std::string(56, 'v') + "é-and-more");
+    sendOne(disp, wkr.worker, hello);
+    auto const snap = snapshot(disp);
+    const auto & state = snap.workers.at("w1");
+    assert(state.version() == "2.36" + std::string(56, 'v'));
+    std::string wire;
+    rpc::WorkerState back;
+    assert(state.SerializeToString(&wire) && back.ParseFromString(wire) && back.version() == state.version());
+}
+
+auto reportMsg(std::initializer_list<std::pair<std::string, uint64_t>> narBytes, std::optional<uint64_t> diskFree = {})
+    -> rpc::WorkerMsg
+{
+    rpc::WorkerMsg msg;
+    auto * rep = msg.mutable_report();
+    for (const auto & [url, bytes] : narBytes) {
+        auto * sub = rep->add_substituters();
+        sub->set_url(url);
+        sub->set_nar_bytes(bytes);
+        sub->set_paths(1);
+    }
+    if (diskFree) {
+        rep->set_disk_free_bytes(*diskFree);
+        rep->set_disk_total_bytes(1000);
+    }
+    return msg;
+}
+
+auto bytesOf(const google::protobuf::RepeatedPtrField<rpc::SubstituterTraffic> & list, std::string_view url) -> uint64_t
+{
+    auto const found = std::ranges::find(list, url, &rpc::SubstituterTraffic::url);
+    return found == list.end() ? 0 : found->nar_bytes();
+}
+
+// Reports go into the counters at once and out as WorkerStates with the
+// next stats pass, at most one per worker and pass.
+void testReports()
+{
+    Metrics metrics("");
+    Dispatcher disp(
+        {.defaultSystem = std::string(x86),
+         .lookupThreads = 0,
+         .cacheSubstituterUrl = "https://farm.example",
+         .sampleEveryMs = 100},
+        metrics);
+    constexpr std::string_view nixos = "https://cache.nixos.org";
+    Session one;
+    sendOne(disp, one.worker, helloMsg("w1", 2, {"https://cache.nixos.org/", "https://farm.example"}));
+    assert(one.wanted() == 1);
+
+    // While nobody watches, the history still gets the counts.
+    sendOne(disp, one.worker, reportMsg({{"https://User:pw@Cache.NixOS.org/?x=1", 100}}, 500));
+    std::this_thread::sleep_for(std::chrono::milliseconds(1500));
+    Sink sink;
+    auto watcher = disp.watch(sink.send(), sink.end());
+    assert(watcher);
+    Model model;
+    for (const auto & event : sink.take()) {
+        apply(model, event);
+        if (event.has_reset()) {
+            assert(event.reset().cache_substituter_url() == "https://farm.example");
+            assert(std::ranges::any_of(event.reset().history(), [&](const rpc::CounterSample & sample) -> bool {
+                return sample.time_ms() + 100 < event.time_ms() && bytesOf(sample.counters().substituters(), nixos) == 100;
+            }));
+        }
+    }
+    const auto & w1 = model.workers.at("w1");
+    assert(w1.version() == "test" && w1.disk_free_bytes() == 500 && w1.disk_total_bytes() == 1000);
+    assert(w1.substituters_size() == 2 && w1.substituters(0).url() == nixos && w1.substituters(0).nar_bytes() == 100);
+    assert(w1.substituters(1).url() == "https://farm.example" && w1.substituters(1).nar_bytes() == 0);
+
+    // Cumulative, and only with the stats pass.
+    sendOne(disp, one.worker, reportMsg({{std::string(nixos), 50}}));
+    std::optional<rpc::WorkerState> later;
+    bool const reported = waitFor([&] -> bool {
+        for (const auto & event : sink.take()) {
+            apply(model, event);
+            later = event.has_worker() ? std::optional(event.worker()) : later;
+        }
+        return later.has_value();
+    });
+    assert(reported);
+    assert(later->substituters(0).nar_bytes() == 150 && later->disk_free_bytes() == 500);
+
+    // A batch of reports runs no dispatch pass.
+    auto const passes = disp.dispatchPasses();
+    rpc::WorkerMsgs batch;
+    for (int idx = 0; idx < 3; idx++) {
+        *batch.add_msgs() = reportMsg({{std::string(nixos), 1}});
+    }
+    disp.workerMsgs(one.worker, batch);
+    assert(disp.dispatchPasses() == passes);
+
+    // However fast reports come, a worker's report-driven WorkerStates have
+    // a Stats between them.
+    auto const until = std::chrono::steady_clock::now() + std::chrono::milliseconds(3200);
+    std::vector<rpc::WatchEvent> seenEvents;
+    while (std::chrono::steady_clock::now() < until) {
+        sendOne(disp, one.worker, reportMsg({{std::string(nixos), 1}}));
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        for (auto & event : sink.take()) {
+            apply(model, event);
+            seenEvents.push_back(std::move(event));
+        }
+    }
+    size_t states = 0;
+    bool statsSince = true;
+    for (const auto & event : seenEvents) {
+        if (event.has_stats()) {
+            statsSince = true;
+        } else if (event.has_worker()) {
+            assert(statsSince);
+            statsSince = false;
+            states++;
+        }
+    }
+    assert(states >= 2);
+
+    // A snapshot right after a report agrees with what the watcher has once
+    // it took in what the snapshot flushed.
+    sendOne(disp, one.worker, reportMsg({{"https://lab.example", 7}}, 400));
+    auto const fresh = snapshot(disp);
+    for (const auto & event : sink.take()) {
+        apply(model, event);
+    }
+    assertSame(model, fresh);
+    assert(model.workers.at("w1").substituters(2).url() == "https://lab.example");
+
+    // A worker's 33rd URL and the farm's 65th add up under "other".
+    auto const many = [&](Dispatcher::Worker & session, std::string_view prefix, int count) -> void {
+        rpc::WorkerMsgs reports;
+        for (int idx = 0; idx < count; idx += 20) {
+            auto * rep = reports.add_msgs()->mutable_report();
+            for (int url = idx; url < std::min(idx + 20, count); url++) {
+                auto * sub = rep->add_substituters();
+                sub->set_url(std::format("https://{}{:02}.example", prefix, url));
+                sub->set_nar_bytes(1);
+            }
+        }
+        disp.workerMsgs(session, reports);
+    };
+    many(one.worker, "u", 40); // with cache.nixos.org and lab.example: 32 named at 30
+    Session two;
+    sendOne(disp, two.worker, helloMsg("w2", 2));
+    many(two.worker, "v", 40);
+    Session three;
+    sendOne(disp, three.worker, helloMsg("w3", 2));
+    sendOne(disp, three.worker, reportMsg({{"https://z.example", 5}}));
+    auto const after = snapshot(disp);
+    for (const auto & addr : {"w1", "w2"}) {
+        const auto & list = after.workers.at(addr).substituters();
+        auto const named = std::ranges::count_if(list, [](const rpc::SubstituterTraffic & sub) -> bool {
+            return sub.url() != "other" && sub.nar_bytes() > 0;
+        });
+        assert(std::cmp_equal(named, Dispatcher::maxWorkerUrls) && bytesOf(list, "other") > 0);
+    }
+    std::optional<rpc::Counters> totals;
+    auto const statsFrom = [&](Sink & from) -> bool {
+        return waitFor([&] -> bool {
+            for (const auto & event : from.take()) {
+                totals = event.has_stats() ? std::optional(event.stats().totals()) : totals;
+            }
+            return totals.has_value();
+        });
+    };
+    bool const counted = statsFrom(sink);
+    assert(counted);
+    const auto & farm = totals->substituters();
+    assert(farm.size() == static_cast<int>(Dispatcher::maxFarmUrls) + 1 && bytesOf(farm, "other") > 0);
+    assert(bytesOf(farm, "https://z.example") == 0 && std::ranges::is_sorted(farm, {}, &rpc::SubstituterTraffic::url));
+
+    // A new term as leader starts every count over. Disk stays.
+    disp.unwatch(*watcher);
+    disp.restarting();
+    disp.serving();
+    auto const term = snapshot(disp);
+    for (const auto & sub : term.workers.at("w1").substituters()) {
+        assert(sub.nar_bytes() == 0 && sub.paths() == 0);
+    }
+    assert(term.workers.at("w1").substituters_size() == 2 && term.workers.at("w1").disk_free_bytes() == 400);
+    Sink next;
+    watcher = disp.watch(next.send(), next.end());
+    assert(watcher);
+    totals.reset();
+    bool const restarted = statsFrom(next);
+    assert(restarted);
+    assert(totals->substituters().empty());
+    disp.unwatch(*watcher);
+}
