+// Failure text is for anyone who can watch: a watch-role caller and a
+// read-only one get the same text.
+void testErrorForEveryWatcher()
+{
+    Farm farm;
+    std::optional<oidc::Verifier> verifier;
+    Tls const viewer("dash-viewer");
+    Tls const reader("ro-reader");
+    Auth auth{.oidc = &verifier};
+    auth.acl.addRule(viewer.name + "=watch");
+    auth.acl.addRule(reader.name + "=read-only");
+    IdleTracker idle;
+    EventsService forViewer(farm.disp, auth, idle);
+    EventsService forReader(farm.disp, auth, idle);
+    Server one(forViewer, viewer);
+    Server two(forReader, reader);
+    auto const synced = [](const rpc::WatchEvent & event) -> bool { return event.has_snapshot_done(); };
+    auto const failed = [](const rpc::WatchEvent & event) -> bool { return event.has_drv_gone(); };
+    Stream watching(*one.certStub);
+    Stream reading(*two.certStub);
+    assert(watching.readUntil(synced) && reading.readUntil(synced));
+    Failing failing(farm, 1, "every");
+    failing.fail(farm, "Cannot build 'x'.\n> GITHUB_TOKEN=abc123 make\n> Error 2");
+    assert(watching.readUntil(failed) && reading.readUntil(failed));
+    const auto & mine = watching.events.back().drv_gone();
+    const auto & theirs = reading.events.back().drv_gone();
+    assert(mine.error() == "Cannot build 'x'.\n> GITHUB_TOKEN=*** make\n> Error 2" && theirs.error() == mine.error());
+    assert(mine.status() == rpc::DrvGone::STATUS_PERMANENT_FAILURE);
+    for (auto * stream : {&watching, &reading}) {
+        stream->ctx.TryCancel();
+        assert(!stream->reader->Finish().ok());
+    }
+    one.server->Shutdown(std::chrono::system_clock::now() + std::chrono::seconds(1));
+    two.server->Shutdown(std::chrono::system_clock::now() + std::chrono::seconds(1));
+}
