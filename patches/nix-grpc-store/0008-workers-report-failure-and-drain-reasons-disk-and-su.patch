+// With a callback, activity frames reach it in order. Log lines and phases
+// still go to the log sink only.
+void activitiesReachTheCallback()
+{
+    nix::StringSink sink;
+    sink << STDERR_START_ACTIVITY << uint64_t{7} << uint64_t{0} << uint64_t{nix::actSubstitute} << "substituting"
+         << uint64_t{2} << uint64_t{1} << "/nix/store/x" << uint64_t{1} << "https://cache.nixos.org" << uint64_t{3};
+    sink << STDERR_RESULT << uint64_t{8} << uint64_t{nix::resBuildLogLine} << uint64_t{1} << uint64_t{1} << "a line";
+    sink << STDERR_RESULT << uint64_t{8} << uint64_t{nix::resProgress} << uint64_t{2} << uint64_t{0} << uint64_t{5}
+         << uint64_t{0} << uint64_t{9};
+    sink << STDERR_STOP_ACTIVITY << uint64_t{7};
+    sink << STDERR_LAST;
+
+    std::vector<std::string> lines;
+    std::vector<nixgrpc::ActivityEvent> events;
+    auto const relay = [&](const nixgrpc::ActivitySink & activity) -> void {
+        nix::StringSource source(sink.s);
+        nixgrpc::relayBuildLog(
+            source, [&](nixgrpc::BuildEvent event) -> void { lines.push_back(std::move(event.text)); }, activity);
+    };
+    relay([&](const nixgrpc::ActivityEvent & event) -> void { events.push_back(event); });
+    using Kind = nixgrpc::ActivityEvent::Kind;
+    assert(events.size() == 3);
+    assert(events.at(0).kind == Kind::start && events.at(0).id == 7 && events.at(0).type == nix::actSubstitute);
+    assert(events.at(0).parent == 3 && events.at(0).fields.at(1).str == "https://cache.nixos.org");
+    assert(events.at(1).kind == Kind::result && events.at(1).type == nix::resProgress);
+    assert(events.at(1).fields.at(0).num == 5 && events.at(1).fields.at(1).num == 9);
+    assert(events.at(2).kind == Kind::stop && events.at(2).id == 7);
+    assert((lines == std::vector<std::string>{"a line"}));
+    // Without one, the same stream gives the same lines.
+    lines.clear();
+    events.clear();
+    relay({});
+    assert(events.empty() && (lines == std::vector<std::string>{"a line"}));
+}
+
 } // namespace
