+#pragma once
+// Bytes a builder downloads from each substituter, from the activities its
+// nix-daemon reports. The nix-daemon forwards every activity whatever the
+// verbosity, and the pooled RemoteStore hands them to nix::logger in this
+// process, so a logger that wraps the real one sees them all. The build
+// connection parses its own stream and passes them through activitySink().
+//
+// A substitution is an actSubstitute with fields [storePath, subURI]. Its
+// child actCopyPath reports NAR bytes done and expected, and the
+// actFileTransfer under that the bytes received for http(s) caches. No
+// activity says whether a substitution succeeded: a copy that reached its
+// expected size counts as a path, anything else as a failure, so a NAR
+// whose hash check fails after the last byte counts as a path.
+//
+// Daemon code: it uses the Logger API of the one Nix the daemon builds
+// against.
+
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <iterator>
+#include <mutex>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <utility>
+#include <variant>
+#include <vector>
+
+#include <nix/util/error.hh>
+#include <nix/util/logging.hh>
+
+#include "build-log.hh"
+#include "nix-compat.hh"
+#include "substituter-url.hh"
+
+namespace nixgrpc {
+
+// Nix 2.36 passes an activity's fields as a span of variants. Older
+// releases pass a vector of fields tagged with their type.
+#if NIX_COMPAT_AT_LEAST(2, 36)
+using LoggerFields = std::span<const nix::Logger::Field>;
+#else
+using LoggerFields = const nix::Logger::Fields &;
+#endif
+
+// A field's string, or null when it holds a number.
+inline auto fieldString(const nix::Logger::Field & field) -> const std::string *
+{
+#if NIX_COMPAT_AT_LEAST(2, 36)
+    return std::get_if<std::string>(&field);
+#else
+    return field.type == nix::Logger::Field::tString ? &field.s : nullptr;
+#endif
+}
+
+// A field's number, or null when it holds a string.
+inline auto fieldNumber(const nix::Logger::Field & field) -> const uint64_t *
+{
+#if NIX_COMPAT_AT_LEAST(2, 36)
+    return std::get_if<uint64_t>(&field);
+#else
+    return field.type == nix::Logger::Field::tInt ? &field.i : nullptr;
+#endif
+}
+
+struct SubstituterCounts
+{
+    uint64_t narBytes = 0;
+    uint64_t downloadBytes = 0;
+    uint64_t paths = 0;
+    uint64_t failures = 0;
+
+    auto operator==(const SubstituterCounts &) const -> bool = default;
+};
+
+// Per reduced URL, in the tally's order.
+using SubstituterTotals = std::vector<std::pair<std::string, SubstituterCounts>>;
+
+class SubstituterTally final : public nix::Logger
+{
+public:
+    using Clock = std::chrono::steady_clock;
+    // Substituters seen that the settings do not list. Past these, "other".
+    static constexpr size_t maxOthers = 32;
+    // A dead connection can lose a stop: entries idle this long go, and the
+    // map holds at most this many.
+    static constexpr std::chrono::minutes idleLimit{10};
+    static constexpr size_t maxActivities = 4096;
+
+    // `next` gets every call. `configured`: the builder's substituters.
+    SubstituterTally(nix::Logger * next, const std::vector<std::string> & configured)
+        : next(next)
+        , entries(reduceAll(configured))
+        , configuredCount(entries.size())
+    {
+    }
+
+    // Reduced and deduplicated, in the settings' order.
+    [[nodiscard]] auto configured() const -> std::vector<std::string>
+    {
+        const std::scoped_lock lock(mutex);
+        std::vector<std::string> out;
+        out.reserve(configuredCount);
+        for (size_t idx = 0; idx < configuredCount; idx++) {
+            out.push_back(entries.at(idx).first);
+        }
+        return out;
+    }
+
+    // Cumulative since the tally started: configured URLs first, then the
+    // others in the order seen, then "other" once anything went there.
+    [[nodiscard]] auto totals() const -> SubstituterTotals
+    {
+        const std::scoped_lock lock(mutex);
+        return entries;
+    }
+
+    // For frames that never reach nix::logger, such as the build connection's.
+    [[nodiscard]] auto activitySink() -> ActivitySink
+    {
+        return [this](const ActivityEvent & event) -> void {
+            switch (event.kind) {
+            case ActivityEvent::Kind::start:
+                started(event.id, event.type, event.parent, fieldText(event.fields, 1));
+                break;
+            case ActivityEvent::Kind::stop:
+                stopped(event.id);
+                break;
+            case ActivityEvent::Kind::result:
+                if (event.type == nix::resProgress && event.fields.size() >= 2) {
+                    progressed(event.id, event.fields.at(0).num, event.fields.at(1).num);
+                }
+                break;
+            }
+        };
+    }
+
+    // The tally's own entry points, which the Logger calls take.
+    // NOLINTNEXTLINE(bugprone-easily-swappable-parameters): the activity, then its parent, as Nix has them.
+    void started(nix::ActivityId act, uint64_t type, nix::ActivityId parent, std::string_view subUri, Clock::time_point now = Clock::now()) noexcept
+    {
+        try {
+            const std::scoped_lock lock(mutex);
+            if (acts.size() >= maxActivities) {
+                pruneLocked(now);
+                if (acts.size() >= maxActivities) {
+                    return;
+                }
+            }
+            if (type == nix::actSubstitute) {
+                uses[act] = Use{.url = urlIndexLocked(reduceSubstituterUrl(subUri))};
+                acts[act] = Act{.use = act, .type = type, .seen = now};
+            } else if (auto const found = acts.find(parent); found != acts.end()) {
+                auto const use = found->second.use;
+                acts[act] = Act{.use = use, .type = type, .seen = now};
+            }
+        } catch (...) { // NOLINT(bugprone-empty-catch): a logger must not throw, a lost count is fine
+        }
+    }
+
+    // NOLINTNEXTLINE(bugprone-easily-swappable-parameters): done, then expected, as in resProgress.
+    void progressed(nix::ActivityId act, uint64_t done, uint64_t expected, Clock::time_point now = Clock::now()) noexcept
+    {
+        const std::scoped_lock lock(mutex);
+        auto const found = acts.find(act);
+        if (found == acts.end()) {
+            return;
+        }
+        auto & ent = found->second;
+        auto const use = uses.find(ent.use);
+        if (use == uses.end()) {
+            return;
+        }
+        uint64_t const delta = done >= ent.done ? done - ent.done : 0;
+        ent.done = std::max(ent.done, done);
+        ent.seen = now;
+        if (auto const parent = acts.find(ent.use); parent != acts.end()) {
+            parent->second.seen = now;
+        }
+        auto & sum = entries.at(use->second.url).second;
+        if (ent.type == nix::actCopyPath) {
+            sum.narBytes += delta;
+            use->second.done = ent.done;
+            use->second.expected = std::max(use->second.expected, expected);
+        } else if (ent.type == nix::actFileTransfer) {
+            sum.downloadBytes += delta;
+        }
+    }
+
+    void stopped(nix::ActivityId act) noexcept
+    {
+        const std::scoped_lock lock(mutex);
+        acts.erase(act);
+        auto const use = uses.find(act);
+        if (use == uses.end()) {
+            return;
+        }
+        auto & sum = entries.at(use->second.url).second;
+        if (use->second.expected > 0 && use->second.done >= use->second.expected) {
+            sum.paths++;
+        } else {
+            sum.failures++;
+        }
+        uses.erase(use);
+    }
+
+    // Drops activities idle for idleLimit. Their substitutions count neither
+    // as a path nor as a failure.
+    void prune(Clock::time_point now = Clock::now())
+    {
+        const std::scoped_lock lock(mutex);
+        pruneLocked(now);
+    }
+
+    [[nodiscard]] auto tracked() const -> size_t
+    {
+        const std::scoped_lock lock(mutex);
+        return acts.size();
+    }
+
+    // ------------------------------------------------------- nix::Logger
+
+    void stop() override
+    {
+        next->stop();
+    }
+
+    void pause() override
+    {
+        next->pause();
+    }
+
+    void resume() override
+    {
+        next->resume();
+    }
+
+    auto isVerbose() -> bool override
+    {
+        return next->isVerbose();
+    }
+
+    void log(nix::Verbosity lvl, std::string_view msg) noexcept override
+    {
+        next->log(lvl, msg);
+    }
+
+    void logEI(const nix::ErrorInfo & info) noexcept override
+    {
+        next->logEI(info);
+    }
+
+    void warn(const std::string & msg) noexcept override
+    {
+        next->warn(msg);
+    }
+
+    void startActivity(
+        nix::ActivityId act,
+        nix::Verbosity lvl,
+        nix::ActivityType type,
+        const std::string & text,
+        LoggerFields fields,
+        nix::ActivityId parent) noexcept override
+    {
+        std::string_view subUri;
+        if (fields.size() >= 2) {
+            if (const auto * str = fieldString(*std::next(fields.begin()))) {
+                subUri = *str;
+            }
+        }
+        started(act, type, parent, subUri);
+        next->startActivity(act, lvl, type, text, fields, parent);
+    }
+
+    void stopActivity(nix::ActivityId act) noexcept override
+    {
+        stopped(act);
+        next->stopActivity(act);
+    }
+
+    void result(nix::ActivityId act, nix::ResultType type, LoggerFields fields) noexcept override
+    {
+        if (type == nix::resProgress && fields.size() >= 2) {
+            const auto * done = fieldNumber(fields.front());
+            const auto * expected = fieldNumber(*std::next(fields.begin()));
+            if (done != nullptr && expected != nullptr) {
+                progressed(act, *done, *expected);
+            }
+        }
+        next->result(act, type, fields);
+    }
+
+#if NIX_COMPAT_AT_LEAST(2, 36)
+    // Nix 2.36 added results that carry JSON.
+    void result(nix::ActivityId act, nix::ResultType type, const nlohmann::json & json) noexcept override
+    {
+        next->result(act, type, json);
+    }
+#endif
+
+    void writeToStdout(std::string_view text) override
+    {
+        next->writeToStdout(text);
+    }
+
+    auto ask(std::string_view msg) -> std::optional<char> override
+    {
+        return next->ask(msg);
+    }
+
+    void setPrintBuildLogs(bool printBuildLogs) override
+    {
+        next->setPrintBuildLogs(printBuildLogs);
+    }
+
+private:
+    struct Act
+    {
+        nix::ActivityId use = 0; // the actSubstitute it belongs to
+        uint64_t type = 0;
+        uint64_t done = 0; // the last progress it reported
+        Clock::time_point seen;
+    };
+
+    struct Use
+    {
+        size_t url = 0;
+        uint64_t expected = 0;
+        uint64_t done = 0;
+    };
+
+    nix::Logger * next;
+    mutable std::mutex mutex;
+    std::unordered_map<nix::ActivityId, Act> acts;
+    std::unordered_map<nix::ActivityId, Use> uses;
+    SubstituterTotals entries;
+    size_t configuredCount = 0;
+    std::optional<size_t> otherIdx;
+
+    static auto reduceAll(const std::vector<std::string> & configured) -> SubstituterTotals
+    {
+        SubstituterTotals out;
+        for (const auto & url : configured) {
+            auto reduced = reduceSubstituterUrl(url);
+            if (std::ranges::find(out, reduced, &SubstituterTotals::value_type::first) == out.end()) {
+                out.emplace_back(std::move(reduced), SubstituterCounts{});
+            }
+        }
+        return out;
+    }
+
+    static auto fieldText(const std::vector<ActivityField> & fields, size_t idx) -> std::string_view
+    {
+        return idx < fields.size() ? std::string_view(fields.at(idx).str) : std::string_view{};
+    }
+
+    auto urlIndexLocked(std::string url) -> size_t
+    {
+        if (auto const found = std::ranges::find(entries, url, &SubstituterTotals::value_type::first);
+            found != entries.end()) {
+            return static_cast<size_t>(found - entries.begin());
+        }
+        if (entries.size() - configuredCount - (otherIdx ? 1 : 0) >= maxOthers) {
+            if (!otherIdx) {
+                otherIdx = entries.size();
+                entries.emplace_back(otherSubstituterUrl, SubstituterCounts{});
+            }
+            return *otherIdx;
+        }
+        entries.emplace_back(std::move(url), SubstituterCounts{});
+        return entries.size() - 1;
+    }
+
+    void pruneLocked(Clock::time_point now)
+    {
+        std::erase_if(acts, [&](const auto & ent) -> bool { return now - ent.second.seen >= idleLimit; });
+        std::erase_if(uses, [&](const auto & ent) -> bool { return !acts.contains(ent.first); });
+    }
+};
+
+} // namespace nixgrpc
