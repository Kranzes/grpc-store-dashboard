--- /dev/null
+++ b/src/daemon/substituter-url.hh
@@ -0,0 +1,50 @@
+#pragma once
+// A substituter URL as it may leave a builder: in Hello, in reports and in
+// metric labels. The scheduler reduces what it gets again, and the farm
+// cache's URL the same way, so the two compare equal.
+
+#include <cstddef>
+#include <string>
+#include <string_view>
+
+#include "build-report.hh"
+
+namespace nixgrpc {
+
+constexpr size_t maxSubstituterUrlLen = 256;
+// Hello and each report name at most this many substituters, and the
+// scheduler reads no more. A report adds up the traffic of any past them
+// under otherSubstituterUrl, the name the tally also gives the unlisted
+// ones it no longer tells apart.
+constexpr size_t maxSubstituters = 32;
+constexpr std::string_view otherSubstituterUrl = "other";
+
+// scheme://authority/path?query#fragment becomes scheme://host[:port]/path:
+// user and password go (everything up to the last @ of the authority), and
+// so do query and fragment, which can hold S3 profiles and ssh keys. Scheme
+// and host are lower-cased and trailing slashes go. A store reference
+// without "://" (daemon, local, auto) keeps its text up to the first '?'.
+// At most 256 bytes, cut on a UTF-8 boundary.
+inline auto reduceSubstituterUrl(std::string_view url) -> std::string
+{
+    std::string out;
+    if (auto const sep = url.find("://"); sep == std::string_view::npos) {
+        out = url.substr(0, url.find('?'));
+    } else {
+        auto rest = url.substr(sep + 3);
+        rest = rest.substr(0, rest.find_first_of("?#"));
+        auto const slash = rest.find('/');
+        auto authority = rest.substr(0, slash);
+        auto const path = slash == std::string_view::npos ? std::string_view{} : rest.substr(slash);
+        if (auto const userinfo = authority.rfind('@'); userinfo != std::string_view::npos) {
+            authority.remove_prefix(userinfo + 1);
+        }
+        out = detail::lower(url.substr(0, sep)) + "://" + detail::lower(authority) + std::string(path);
+        while (out.ends_with('/') && out.size() > sep + 3) {
+            out.pop_back();
+        }
+    }
+    return cutAtChar(out, maxSubstituterUrlLen);
+}
+
+} // namespace nixgrpc
