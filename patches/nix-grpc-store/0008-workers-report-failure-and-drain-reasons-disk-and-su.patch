+#pragma once
+// What a builder says about a finished build: Nix's status, and the end of
+// its error message with ANSI escapes removed, common secret shapes masked
+// and the middle cut out. Free of Nix store headers, so the scheduler can
+// use the same functions on what it receives.
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cstddef>
+#include <initializer_list>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include <nix/util/terminal.hh>
+
+#include "nix_remote.pb.h"
+
+namespace nixgrpc {
+
+struct StatusName
+{
+    nix::remote::Done::Status status;
+    std::string_view name;
+};
+
+// Nix's BuildResult status names, as nixcompat::statusName() gives them.
+inline constexpr std::array<StatusName, 16> nixStatusNames{{
+    {.status = nix::remote::Done::STATUS_BUILT, .name = "Built"},
+    {.status = nix::remote::Done::STATUS_SUBSTITUTED, .name = "Substituted"},
+    {.status = nix::remote::Done::STATUS_ALREADY_VALID, .name = "AlreadyValid"},
+    {.status = nix::remote::Done::STATUS_ALREADY_VALID, .name = "ResolvesToAlreadyValid"},
+    {.status = nix::remote::Done::STATUS_PERMANENT_FAILURE, .name = "PermanentFailure"},
+    {.status = nix::remote::Done::STATUS_INPUT_REJECTED, .name = "InputRejected"},
+    {.status = nix::remote::Done::STATUS_OUTPUT_REJECTED, .name = "OutputRejected"},
+    {.status = nix::remote::Done::STATUS_OUTPUT_REJECTED, .name = "HashMismatch"},
+    {.status = nix::remote::Done::STATUS_TRANSIENT_FAILURE, .name = "TransientFailure"},
+    {.status = nix::remote::Done::STATUS_CACHED_FAILURE, .name = "CachedFailure"},
+    {.status = nix::remote::Done::STATUS_TIMED_OUT, .name = "TimedOut"},
+    {.status = nix::remote::Done::STATUS_MISC_FAILURE, .name = "MiscFailure"},
+    {.status = nix::remote::Done::STATUS_DEPENDENCY_FAILED, .name = "DependencyFailed"},
+    {.status = nix::remote::Done::STATUS_LOG_LIMIT_EXCEEDED, .name = "LogLimitExceeded"},
+    {.status = nix::remote::Done::STATUS_NOT_DETERMINISTIC, .name = "NotDeterministic"},
+    {.status = nix::remote::Done::STATUS_NO_SUBSTITUTERS, .name = "NoSubstituters"},
+}};
+
+// From Nix's status name. A name the table does not know, from a newer Nix,
+// is MISC_FAILURE for a failure and BUILT for a success.
+inline auto doneStatus(std::string_view nixName, bool succeeded) -> nix::remote::Done::Status
+{
+    const auto * const found =
+        std::ranges::find_if(nixStatusNames, [&](const StatusName & known) -> bool { return known.name == nixName; });
+    if (found != nixStatusNames.end()) {
+        return found->status;
+    }
+    return succeeded ? nix::remote::Done::STATUS_BUILT : nix::remote::Done::STATUS_MISC_FAILURE;
+}
+
+// For logs and metric labels: Nix's name, "WorkerError" for a failure
+// without a BuildResult, or "unreported" from builders that send none.
+inline auto statusLabel(nix::remote::Done::Status status) -> std::string_view
+{
+    if (status == nix::remote::Done::STATUS_WORKER_ERROR) {
+        return "WorkerError";
+    }
+    const auto * const found =
+        std::ranges::find_if(nixStatusNames, [&](const StatusName & known) -> bool { return known.status == status; });
+    return found != nixStatusNames.end() ? found->name : "unreported";
+}
+
+namespace detail {
+
+
+constexpr std::string_view mask = "***";
+
+inline auto lower(std::string_view text) -> std::string
+{
+    std::string out(text);
+    std::ranges::transform(out, out.begin(), [](unsigned char chr) -> char { return static_cast<char>(std::tolower(chr)); });
+    return out;
+}
+
+// The character at `pos`, or NUL past the end.
+inline auto charAt(std::string_view text, size_t pos) -> char
+{
+    return pos < text.size() ? text.at(pos) : '\0';
+}
+
+template<typename Pred>
+inline auto skipWhile(std::string_view text, size_t pos, Pred pred) -> size_t
+{
+    while (pos < text.size() && pred(text.at(pos))) {
+        pos++;
+    }
+    return pos;
+}
+
+inline auto isBlank(char chr) -> bool
+{
+    return chr == ' ' || chr == '\t';
+}
+
+inline auto isSpace(char chr) -> bool
+{
+    return isBlank(chr) || chr == '\n' || chr == '\r';
+}
+
+inline auto isQuote(char chr) -> bool
+{
+    return chr == '"' || chr == '\'';
+}
+
+inline auto isIdent(char chr) -> bool
+{
+    return std::isalnum(static_cast<unsigned char>(chr)) != 0 || chr == '_';
+}
+
+// A token, up to the next blank or quote.
+inline auto isWordChar(char chr) -> bool
+{
+    return !isSpace(chr) && !isQuote(chr);
+}
+
+inline auto lineEnd(std::string_view text, size_t pos) -> size_t
+{
+    auto const end = text.find('\n', pos);
+    return end == std::string_view::npos ? text.size() : end;
+}
+
+inline auto containsAny(std::string_view name, std::initializer_list<std::string_view> words) -> bool
+{
+    auto const low = lower(name);
+    return std::ranges::any_of(words, [&](std::string_view word) -> bool { return low.contains(word); });
+}
+
+// The text of a line without Nix's "> " log prefix and surrounding blanks.
+inline auto lineBody(std::string_view line) -> std::string_view
+{
+    if (line.starts_with("> ")) {
+        line.remove_prefix(2);
+    }
+    while (!line.empty() && isSpace(line.front())) {
+        line.remove_prefix(1);
+    }
+    while (!line.empty() && isSpace(line.back())) {
+        line.remove_suffix(1);
+    }
+    return line;
+}
+
+inline auto isBase64Line(std::string_view line) -> bool
+{
+    auto const body = lineBody(line);
+    return !body.empty() && std::ranges::all_of(body, [](char chr) -> bool {
+        return std::isalnum(static_cast<unsigned char>(chr)) != 0 || chr == '+' || chr == '/' || chr == '=';
+    });
+}
+
+inline auto splitLines(std::string_view text) -> std::vector<std::string_view>
+{
+    std::vector<std::string_view> lines;
+    for (size_t pos = 0;;) {
+        auto const end = lineEnd(text, pos);
+        lines.push_back(text.substr(pos, end - pos));
+        if (end == text.size()) {
+            return lines;
+        }
+        pos = end + 1;
+    }
+}
+
+// Private key bodies, between their BEGIN and END lines. Nix keeps only the
+// last lines of a log, so an END line can come without its BEGIN: then the
+// base64 lines right above it go.
+inline auto maskPem(std::string_view text) -> std::string
+{
+    auto const isBegin = [](std::string_view line) -> bool {
+        return line.contains("-----BEGIN ") && line.contains("PRIVATE KEY-----");
+    };
+    auto const isEnd = [](std::string_view line) -> bool {
+        return line.contains("-----END ") && line.contains("PRIVATE KEY-----");
+    };
+    auto const lines = splitLines(text);
+    std::vector<bool> hide(lines.size());
+    for (size_t idx = 0; idx < lines.size(); idx++) {
+        if (isBegin(lines.at(idx))) {
+            while (idx + 1 < lines.size() && !isEnd(lines.at(idx + 1))) {
+                hide.at(++idx) = true;
+            }
+        } else if (isEnd(lines.at(idx))) {
+            for (size_t above = idx; above > 0 && !hide.at(above - 1) && isBase64Line(lines.at(above - 1)); above--) {
+                hide.at(above - 1) = true;
+            }
+        }
+    }
+    std::string out;
+    out.reserve(text.size());
+    for (size_t idx = 0; idx < lines.size(); idx++) {
+        if (hide.at(idx) && idx > 0 && hide.at(idx - 1)) {
+            continue;
+        }
+        if (idx > 0) {
+            out += '\n';
+        }
+        out.append(hide.at(idx) ? mask : lines.at(idx));
+    }
+    return out;
+}
+
+// "Authorization:" and "Proxy-Authorization:" headers, as curl -v prints
+// them: the rest of the line.
+inline auto maskHeaders(std::string_view text) -> std::string
+{
+    constexpr std::string_view header = "authorization:";
+    auto const low = lower(text);
+    std::string out;
+    size_t pos = 0;
+    for (auto found = low.find(header); found != std::string::npos; found = low.find(header, pos)) {
+        auto const value = found + header.size();
+        auto const end = lineEnd(text, value);
+        out.append(text.substr(pos, value - pos));
+        if (end > value) {
+            out += ' ';
+            out += mask;
+        }
+        pos = end;
+    }
+    out.append(text.substr(pos));
+    return out;
+}
+
+// "Bearer <token>" anywhere.
+inline auto maskBearer(std::string_view text) -> std::string
+{
+    constexpr std::string_view word = "bearer";
+    auto const low = lower(text);
+    std::string out;
+    size_t pos = 0;
+    for (auto found = low.find(word); found != std::string::npos; found = low.find(word, found + 1)) {
+        if (found < pos || (found > 0 && isIdent(text.at(found - 1)))) {
+            continue;
+        }
+        auto const from = skipWhile(text, found + word.size(), isBlank);
+        auto const until = skipWhile(text, from, isWordChar);
+        if (from == found + word.size() || until == from) {
+            continue;
+        }
+        out.append(text.substr(pos, from - pos));
+        out += mask;
+        pos = until;
+    }
+    out.append(text.substr(pos));
+    return out;
+}
+
+// URL userinfo: scheme://user:password@host becomes scheme://***@host.
+inline auto maskUserinfo(std::string_view text) -> std::string
+{
+    auto const isAuthority = [](char chr) -> bool {
+        return isWordChar(chr) && chr != '/' && chr != '?' && chr != '#' && chr != '<' && chr != '>';
+    };
+    std::string out;
+    size_t pos = 0;
+    for (auto found = text.find("://"); found != std::string_view::npos; found = text.find("://", found + 3)) {
+        auto const start = found + 3;
+        auto const authority = text.substr(start, skipWhile(text, start, isAuthority) - start);
+        auto const userinfo = authority.rfind('@');
+        if (userinfo == std::string_view::npos || start < pos) {
+            continue;
+        }
+        out.append(text.substr(pos, start - pos));
+        out += mask;
+        pos = start + userinfo;
+    }
+    out.append(text.substr(pos));
+    return out;
+}
+
+// Query values whose name says they are secret: ?X-Amz-Signature=***&x=1.
+inline auto maskQuery(std::string_view text) -> std::string
+{
+    auto const isParam = [](char chr) -> bool { return isIdent(chr) || chr == '-' || chr == '.'; };
+    auto const isValue = [](char chr) -> bool { return isWordChar(chr) && chr != '&' && chr != '#'; };
+    std::string out;
+    size_t pos = 0;
+    size_t idx = 0;
+    while (idx < text.size()) {
+        if (text.at(idx) != '?' && text.at(idx) != '&') {
+            idx++;
+            continue;
+        }
+        auto const nameEnd = skipWhile(text, idx + 1, isParam);
+        auto const name = text.substr(idx + 1, nameEnd - idx - 1);
+        auto const until = skipWhile(text, nameEnd + 1, isValue);
+        idx = nameEnd;
+        if (name.empty() || charAt(text, nameEnd) != '=' || until <= nameEnd + 1
+            || !containsAny(name, {"token", "sig", "key", "secret", "password", "credential"})) {
+            continue;
+        }
+        out.append(text.substr(pos, nameEnd + 1 - pos));
+        out += mask;
+        pos = idx = until;
+    }
+    out.append(text.substr(pos));
+    return out;
+}
+
+// A quoted key at `pos`, as JSON, YAML and TOML write one: "X-Auth-Token",
+// 'client.secret', or \"password\" in JSON inside a JSON string. Its
+// quote, with the backslash if any, its name and where it ends, past the
+// closing quote. An empty name if there is none at `pos`.
+struct QuotedKey
+{
+    std::string_view quote;
+    std::string_view name;
+    size_t end = 0;
+};
+
+inline auto quotedKey(std::string_view text, size_t pos) -> QuotedKey
+{
+    auto const isKeyChar = [](char chr) -> bool { return isIdent(chr) || chr == '-' || chr == '.'; };
+    size_t const quoteLen = charAt(text, pos) == '\\' ? 2 : 1;
+    if (!isQuote(charAt(text, pos + quoteLen - 1))) {
+        return {};
+    }
+    auto const quote = text.substr(pos, quoteLen);
+    auto const from = pos + quoteLen;
+    auto const nameEnd = skipWhile(text, from, isKeyChar);
+    if (nameEnd == from || text.substr(nameEnd, quoteLen) != quote) {
+        return {};
+    }
+    return {.quote = quote, .name = text.substr(from, nameEnd - from), .end = nameEnd + quoteLen};
+}
+
+// Where the value starts after a name that ends at `nameEnd`, npos if no
+// =, => or : follows. Blanks may stand around = (TOKEN = abc, as Nix and
+// TOML write it) and, after a quoted key, before :. NAME= cmd runs cmd with
+// an empty NAME, and == compares, so neither has a value.
+inline auto valueStart(std::string_view text, size_t nameEnd, bool quoted) -> size_t
+{
+    auto const opAt = skipWhile(text, nameEnd, isBlank);
+    bool const spaced = opAt > nameEnd;
+    switch (charAt(text, opAt)) {
+    case '=': {
+        auto const next = charAt(text, opAt + 1);
+        if (next == '=') {
+            return std::string_view::npos;
+        }
+        auto const after = next == '>' ? opAt + 2 : opAt + 1;
+        return spaced || quoted ? skipWhile(text, after, isBlank) : after;
+    }
+    case ':':
+        return spaced && !quoted ? std::string_view::npos : skipWhile(text, opAt + 1, isBlank);
+    default:
+        return std::string_view::npos;
+    }
+}
+
+// A value from `start`: inside its quotes, escaped ones as in \"abc\"
+// too, else up to a blank or a quote.
+inline auto valueSpan(std::string_view text, size_t start) -> std::pair<size_t, size_t>
+{
+    bool const escaped = charAt(text, start) == '\\' && isQuote(charAt(text, start + 1));
+    if (escaped || isQuote(charAt(text, start))) {
+        auto const quote = text.substr(start, escaped ? 2 : 1);
+        auto const from = start + quote.size();
+        auto const close = text.find(quote, from);
+        return {from, close == std::string_view::npos ? lineEnd(text, from) : close};
+    }
+    return {start, skipWhile(text, start, isWordChar)};
+}
+
+// NAME=value, NAME = value and NAME: value for secret-looking names, such
+// as GITHUB_TOKEN=abc or export AWS_SECRET_ACCESS_KEY="abc def", and quoted
+// keys as JSON, YAML and Ruby write them: "token": "abc", 'password':'x',
+// "X-Auth-Token"=>"abc" or {\"secret\":\"x\"} inside a JSON string.
+inline auto maskAssignments(std::string_view text) -> std::string
+{
+    auto const secret = [](std::string_view name) -> bool {
+        return containsAny(name, {"token", "secret", "password", "passwd", "key", "credential"});
+    };
+    std::string out;
+    size_t pos = 0;
+    size_t idx = 0;
+    while (idx < text.size()) {
+        size_t nameEnd = 0;
+        size_t start = std::string_view::npos;
+        if (auto const key = quotedKey(text, idx); !key.name.empty()) {
+            nameEnd = key.end;
+            if (secret(key.name)) {
+                start = valueStart(text, nameEnd, true);
+            }
+        } else if (isIdent(text.at(idx))) {
+            nameEnd = skipWhile(text, idx, isIdent);
+            // Query parameters have their own rule and end.
+            bool const query = idx > 0 && (text.at(idx - 1) == '?' || text.at(idx - 1) == '&');
+            if (!query && secret(text.substr(idx, nameEnd - idx))) {
+                start = valueStart(text, nameEnd, false);
+            }
+        } else {
+            idx++;
+            continue;
+        }
+        idx = nameEnd;
+        if (start == std::string_view::npos) {
+            continue;
+        }
+        auto const [from, until] = valueSpan(text, start);
+        // Empty, or masked already by the query or header rule.
+        if (from == until || text.substr(from).starts_with(mask)) {
+            continue;
+        }
+        out.append(text.substr(pos, from - pos));
+        out += mask;
+        pos = idx = until;
+    }
+    out.append(text.substr(pos));
+    return out;
+}
+
+inline auto isContinuation(char chr) -> bool
+{
+    constexpr unsigned topBits = 0xC0U;
+    constexpr unsigned continuation = 0x80U;
+    return (static_cast<unsigned char>(chr) & topBits) == continuation;
+}
+
+// The start of the UTF-8 sequence that holds byte `pos`.
+inline auto backToChar(std::string_view text, size_t pos) -> size_t
+{
+    while (pos > 0 && isContinuation(charAt(text, pos))) {
+        pos--;
+    }
+    return pos;
+}
+
+} // namespace detail
+
+// Done.error and DrvGone.error stop here.
+inline constexpr size_t errorCap = 4096;
+
+// Masks the shapes secrets usually take in build output: URL userinfo,
+// secret query values, Authorization headers, Bearer tokens, secret-named
+// variables and private key blocks. It cannot catch everything a build
+// prints.
+inline auto redactSecrets(std::string text) -> std::string
+{
+    text = detail::maskPem(text);
+    text = detail::maskHeaders(text);
+    text = detail::maskBearer(text);
+    text = detail::maskUserinfo(text);
+    text = detail::maskQuery(text);
+    return detail::maskAssignments(text);
+}
+
+// At most `cap` bytes from the start of `text`. Never splits a UTF-8 sequence.
+inline auto cutAtChar(std::string_view text, size_t cap) -> std::string
+{
+    return std::string(text.substr(0, text.size() <= cap ? text.size() : detail::backToChar(text, cap)));
+}
+
+// `text` when it fits `cap`. Else its first two lines (at most 512 bytes),
+// "\n[...]\n", and as much of its end as fits, starting at a line start
+// when one is near. Never splits a UTF-8 sequence.
+inline auto cutMiddle(std::string_view text, size_t cap) -> std::string
+{
+    constexpr size_t headMax = 512;
+    constexpr size_t lineSlack = 200;
+    constexpr std::string_view marker = "\n[...]\n";
+    if (text.size() <= cap) {
+        return std::string(text);
+    }
+    if (cap <= headMax + marker.size()) {
+        return cutAtChar(text, cap);
+    }
+    auto const first = text.find('\n');
+    auto const second = first == std::string_view::npos ? first : text.find('\n', first + 1);
+    auto const head = detail::backToChar(text, std::min({second, text.size(), headMax}));
+    auto start = text.size() - (cap - head - marker.size());
+    if (auto const line = text.find('\n', start - 1); line != std::string_view::npos && line + 1 < start + lineSlack) {
+        start = line + 1;
+    }
+    start = detail::skipWhile(text, start, detail::isContinuation);
+    std::string out(text.substr(0, head));
+    out += marker;
+    out.append(text.substr(start));
+    return out;
+}
+
+namespace detail {
+
+// What cleanUtf8 drops: C0 controls other than \n and \t, DEL, C1 controls
+// and Unicode's Bidi_Control characters.
+constexpr auto hiddenControl(char32_t code) -> bool
+{
+    constexpr char32_t space = 0x20;
+    constexpr char32_t del = 0x7F;
+    constexpr char32_t c1End = 0x9F;
+    constexpr char32_t arabicLetterMark = 0x061C;
+    constexpr char32_t bidiMarkFirst = 0x200E;
+    constexpr char32_t bidiMarkLast = 0x200F;
+    constexpr char32_t bidiEmbedFirst = 0x202A;
+    constexpr char32_t bidiEmbedLast = 0x202E;
+    constexpr char32_t bidiIsolateFirst = 0x2066;
+    constexpr char32_t bidiIsolateLast = 0x2069;
+    return (code < space && code != '\n' && code != '\t') || (code >= del && code <= c1End)
+           || code == arabicLetterMark || (code >= bidiMarkFirst && code <= bidiMarkLast)
+           || (code >= bidiEmbedFirst && code <= bidiEmbedLast) || (code >= bidiIsolateFirst && code <= bidiIsolateLast);
+}
+
+} // namespace detail
+
+// Valid UTF-8 for a proto3 string, safe to show as plain text: invalid
+// sequences become U+FFFD; C0 controls other than \n and \t, DEL, C1
+// controls and Unicode's bidi controls (U+061C, U+200E, U+200F, U+202A to
+// U+202E and U+2066 to U+2069) go, so a log block cannot be spoofed
+// visually.
+inline auto cleanUtf8(std::string_view text) -> std::string
+{
+    constexpr std::string_view replacement = "\xEF\xBF\xBD";
+    auto const byteAt = [&](size_t pos) -> unsigned {
+        return static_cast<unsigned char>(detail::charAt(text, pos));
+    };
+    // Length of the valid sequence at `pos` and its code point, or 0.
+    auto const decode = [&](size_t pos, char32_t & code) -> size_t {
+        constexpr unsigned ascii = 0x80U;
+        constexpr unsigned payload = 0x3FU;
+        auto const lead = byteAt(pos);
+        if (lead < ascii) {
+            code = lead;
+            return 1;
+        }
+        struct Form
+        {
+            unsigned leadMin, leadMax, len, mask, secondMin, secondMax;
+        };
+        // RFC 3629: no overlong forms, no surrogates, nothing past U+10FFFF.
+        static constexpr std::array<Form, 7> forms{{
+            {.leadMin = 0xC2, .leadMax = 0xDF, .len = 2, .mask = 0x1F, .secondMin = 0x80, .secondMax = 0xBF},
+            {.leadMin = 0xE0, .leadMax = 0xE0, .len = 3, .mask = 0x0F, .secondMin = 0xA0, .secondMax = 0xBF},
+            {.leadMin = 0xE1, .leadMax = 0xEC, .len = 3, .mask = 0x0F, .secondMin = 0x80, .secondMax = 0xBF},
+            {.leadMin = 0xED, .leadMax = 0xED, .len = 3, .mask = 0x0F, .secondMin = 0x80, .secondMax = 0x9F},
+            {.leadMin = 0xEE, .leadMax = 0xEF, .len = 3, .mask = 0x0F, .secondMin = 0x80, .secondMax = 0xBF},
+            {.leadMin = 0xF0, .leadMax = 0xF0, .len = 4, .mask = 0x07, .secondMin = 0x90, .secondMax = 0xBF},
+            {.leadMin = 0xF1, .leadMax = 0xF4, .len = 4, .mask = 0x07, .secondMin = 0x80, .secondMax = 0xBF},
+        }};
+        const auto * const form = std::ranges::find_if(
+            forms, [&](const Form & candidate) -> bool { return lead >= candidate.leadMin && lead <= candidate.leadMax; });
+        if (form == forms.end()) {
+            return 0;
+        }
+        constexpr unsigned lastLead = 0xF4;
+        constexpr unsigned lastSecond = 0x8F;
+        auto const second = byteAt(pos + 1);
+        if (second < form->secondMin || second > (lead == lastLead ? lastSecond : form->secondMax)) {
+            return 0;
+        }
+        constexpr unsigned bits = 6;
+        char32_t value = lead & form->mask;
+        for (size_t idx = 1; idx < form->len; idx++) {
+            auto const next = byteAt(pos + idx);
+            if (!detail::isContinuation(static_cast<char>(next))) {
+                return 0;
+            }
+            value = (value << bits) | (next & payload);
+        }
+        code = value;
+        return form->len;
+    };
+    std::string out;
+    out.reserve(text.size());
+    size_t pos = 0;
+    while (pos < text.size()) {
+        char32_t code = 0;
+        auto const len = decode(pos, code);
+        if (len == 0) {
+            out += replacement;
+            pos++;
+            continue;
+        }
+        if (!detail::hiddenControl(code)) {
+            out.append(text.substr(pos, len));
+        }
+        pos += len;
+    }
+    return out;
+}
+
+// For Done.error: ANSI escapes removed, secrets masked, then cut to `cap`.
+// Masking comes before the cut, so a cut cannot leave half a secret.
+inline auto capError(std::string_view msg, size_t cap = errorCap) -> std::string
+{
+    // Log lines have no length limit. Only the start and the end survive
+    // the cut, so drop all but a wide margin of both before any other work.
+    constexpr size_t keepHead = size_t{64} << 10U;
+    constexpr size_t keepTail = size_t{128} << 10U;
+    // Each part loses its escapes on its own, so none spans the join.
+    std::string text = msg.size() > keepHead + keepTail
+                           ? nix::filterANSIEscapes(msg.substr(0, keepHead), true) + "\n"
+                                 + nix::filterANSIEscapes(msg.substr(msg.size() - keepTail), true)
+                           : nix::filterANSIEscapes(msg, true);
+    return cutMiddle(redactSecrets(std::move(text)), cap);
+}
