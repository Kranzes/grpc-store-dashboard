+// A worker that keeps the drvs it was sent.
+struct FakeWorker
+{
+    std::mutex mutex;
+    std::vector<rpc::Expect> expected;
+    Dispatcher::Worker worker{.send = [this](const rpc::SchedCmd & cmd) -> bool {
+        if (cmd.has_expect()) {
+            const std::scoped_lock lock(mutex);
+            expected.push_back(cmd.expect());
+        }
+        return true;
+    }};
+};
+
+// `count` builds on workers of 50 slots each. fail() reports them all
+// FAILED with `error`, one batch per worker.
+struct Failing
+{
+    static constexpr uint32_t slots = 50;
+    std::vector<std::unique_ptr<FakeWorker>> workers;
+    Dispatcher::ClientPtr client;
+
+    Failing(Farm & farm, size_t count, std::string_view tag)
+    {
+        for (size_t idx = 0; idx * slots < count; idx++) {
+            auto & wkr = *workers.emplace_back(std::make_unique<FakeWorker>());
+            rpc::WorkerMsgs hello;
+            auto * hel = hello.add_msgs()->mutable_hello();
+            hel->set_addr(std::format("{}-{}:50051", tag, idx));
+            hel->add_systems("x86_64-linux");
+            hel->set_max_jobs(slots);
+            farm.disp.workerMsgs(wkr.worker, hello);
+        }
+        client = farm.client("ci-failing");
+        rpc::ClientMsgs wants;
+        for (size_t idx = 0; idx < count; idx++) {
+            wants.add_msgs()->mutable_want()->set_drv_path(std::format("{:032}-{}{}.drv", idx, tag, idx));
+        }
+        farm.disp.clientMsgs(client, wants);
+    }
+
+    void fail(Farm & farm, const std::string & error)
+    {
+        for (auto & wkr : workers) {
+            rpc::WorkerMsgs dones;
+            const std::scoped_lock lock(wkr->mutex);
+            for (const auto & exp : wkr->expected) {
+                auto * done = dones.add_msgs()->mutable_done();
+                done->set_drv_path(exp.drv_path());
+                done->set_assign_id(exp.assign_id());
+                done->set_outcome(rpc::Done::FAILED);
+                done->set_status(rpc::Done::STATUS_PERMANENT_FAILURE);
+                done->set_error(error);
+            }
+            farm.disp.workerMsgs(wkr->worker, dones);
+        }
+    }
+};
