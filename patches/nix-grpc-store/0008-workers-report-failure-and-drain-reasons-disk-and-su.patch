+auto Dispatcher::farmTrafficLocked(const std::string & url) -> SubstituterTraffic &
+{
+    auto & list = *counters.mutable_substituters();
+    auto const find = [&](std::string_view name) -> SubstituterTraffic * {
+        auto const found = std::ranges::find_if(list, [&](const SubstituterTraffic & ent) -> bool { return ent.url() == name; });
+        return found == list.end() ? nullptr : &*found;
+    };
+    if (auto * found = find(url)) {
+        return *found;
+    }
+    bool const haveOther = find(otherSubstituterUrl) != nullptr;
+    auto const named = static_cast<size_t>(list.size()) - (haveOther ? 1 : 0);
+    std::string const name = named >= maxFarmUrls ? std::string(otherSubstituterUrl) : url;
+    if (auto * found = find(name)) {
+        return *found;
+    }
+    list.Add()->set_url(name);
+    for (int idx = list.size() - 1; idx > 0 && list.Get(idx - 1).url() > list.Get(idx).url(); idx--) {
+        list.SwapElements(idx - 1, idx);
+    }
+    return *find(name);
+}
