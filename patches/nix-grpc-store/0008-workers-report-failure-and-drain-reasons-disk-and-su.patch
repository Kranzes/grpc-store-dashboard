 }
 
+// Nix's name of the result's status, success or failure. The flat enum
+// before 2.32 holds both kinds; failureStatusName() covers its failures.
+template <typename R = nix::BuildResult>
+inline auto statusName(R &res) -> std::string_view {
+  if constexpr (requires { res.tryGetSuccess(); }) {
+    if (const auto *success = res.tryGetSuccess()) {
+      switch (success->status) {
+      case R::Success::Built:
+        return "Built";
+      case R::Success::Substituted:
+        return "Substituted";
+      case R::Success::AlreadyValid:
+        return "AlreadyValid";
+      case R::Success::ResolvesToAlreadyValid:
+        return "ResolvesToAlreadyValid";
+      default:
+        return "Unknown";
+      }
+    }
+    return failureStatusName(res.tryGetFailure()->status);
+  } else {
+    switch (res.status) {
+    case R::Built:
+      return "Built";
+    case R::Substituted:
+      return "Substituted";
+    case R::AlreadyValid:
+      return "AlreadyValid";
+    case R::ResolvesToAlreadyValid:
+      return "ResolvesToAlreadyValid";
+    default:
+      return failureStatusName(res.status);
+    }
+  }
+}
