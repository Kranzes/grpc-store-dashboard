diff --git a/src/daemon/scheduler-link.hh b/src/daemon/scheduler-link.hh
new file mode 100644
index 0000000..c15a5c6
--- /dev/null
+++ b/src/daemon/scheduler-link.hh
@@ -0,0 +1,191 @@
+#pragma once
+// A builder's line to its scheduler: the send function of the current
+// session, and the WorkerReports that go out on it once the scheduler asked
+// for them with ReportsWanted.
+//
+// Reports carry deltas against what the last successful send carried, on
+// this session or an earlier one, so a scheduler that restarts never counts
+// a builder's history twice and a failed send loses nothing. An older
+// scheduler never asks, so it gets no reports.
+
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include <nix/util/sync.hh>
+
+#include "nix_remote.pb.h"
+#include "substituter-tally.hh"
+
+namespace nixgrpc {
+
+class SchedulerLink
+{
+public:
+    // Delivers a message to the scheduler. False if no session is up.
+    using SendFn = std::function<bool(const nix::remote::WorkerMsg &)>;
+    using Clock = std::chrono::steady_clock;
+
+    static constexpr std::chrono::seconds minInterval{2};
+    static constexpr uint64_t minDiskStep = uint64_t{256} << 20U;
+    static constexpr uint64_t diskStepPercent = 5;
+
+    // `tally` may be null: then reports carry disk only.
+    SchedulerLink(const SubstituterTally * tally, uint64_t minFree)
+        : tally(tally)
+        , minFree(minFree)
+    {
+    }
+
+    // A new session, or none. Reports wait for its ReportsWanted.
+    void setSend(SendFn send)
+    {
+        auto lck = session.lock();
+        lck->send = std::move(send);
+        lck->wanted = false;
+        lck->reported = false;
+        lck->generation++;
+    }
+
+    auto send(const nix::remote::WorkerMsg & msg) const -> bool
+    {
+        const SendFn cur = session.lock()->send; // copy: do not hold the lock across stream I/O
+        return cur && cur(msg);
+    }
+
+    // SchedCmd.reports_wanted. Sends nothing: the in-process scheduler calls
+    // this under its own mutex.
+    void reportsWanted()
+    {
+        session.lock()->wanted = true;
+    }
+
+    // Free and total bytes of the store's file system, once a second.
+    void setDisk(uint64_t free, uint64_t total)
+    {
+        const std::scoped_lock lock(reportMutex);
+        disk = Disk{.free = free, .total = total};
+    }
+
+    // From the serve loop: sends a report when one is due. The first goes
+    // out on the first tick after ReportsWanted, then one at most every
+    // minInterval when traffic grew or free disk moved by a step.
+    void tick(Clock::time_point now = Clock::now())
+    {
+        const std::scoped_lock lock(reportMutex);
+        SendFn sendFn;
+        bool first = false;
+        uint64_t generation = 0;
+        {
+            auto lck = session.lock();
+            if (!lck->wanted || !lck->send) {
+                return;
+            }
+            sendFn = lck->send;
+            first = !lck->reported;
+            generation = lck->generation;
+        }
+        if (!first && now - lastReport < minInterval) {
+            return;
+        }
+        auto totals = tally != nullptr ? tally->totals() : SubstituterTotals{};
+        nix::remote::WorkerMsg msg;
+        auto & report = *msg.mutable_report();
+        bool const traffic = addDeltas(report, totals);
+        bool const step = disk && (!diskSent || diskStep(*diskSent, disk->free));
+        if (!first && !traffic && !step) {
+            return;
+        }
+        bool const withDisk = disk && (first || step);
+        if (withDisk) {
+            report.set_disk_free_bytes(disk->free);
+            report.set_disk_total_bytes(disk->total);
+        }
+        if (!sendFn(msg)) {
+            return; // the counts go into the next report
+        }
+        sent = std::move(totals);
+        if (withDisk) {
+            diskSent = disk->free;
+        }
+        lastReport = now;
+        if (auto lck = session.lock(); lck->generation == generation) {
+            lck->reported = true;
+        }
+    }
+
+private:
+    struct Session
+    {
+        SendFn send;
+        bool wanted = false;   // the scheduler sent ReportsWanted on this session
+        bool reported = false; // the first report of this session went out
+        uint64_t generation = 0;
+    };
+
+    struct Disk
+    {
+        uint64_t free = 0;
+        uint64_t total = 0;
+    };
+
+    const SubstituterTally * tally;
+    const uint64_t minFree;
+    mutable nix::Sync<Session> session;
+    // One tick at a time. Guards what follows.
+    std::mutex reportMutex;
+    SubstituterTotals sent; // what the last successful report covered
+    std::optional<Disk> disk;
+    std::optional<uint64_t> diskSent;
+    Clock::time_point lastReport;
+
+    [[nodiscard]] auto diskStep(uint64_t last, uint64_t now) const -> bool
+    {
+        auto const moved = last > now ? last - now : now - last;
+        constexpr uint64_t percent = 100;
+        if (moved >= std::max(minDiskStep, last / percent * diskStepPercent)) {
+            return true;
+        }
+        return minFree > 0 && (last < minFree) != (now < minFree);
+    }
+
+    // What `totals` adds to `sent`, only substituters with traffic, folding
+    // any past maxSubstituters into otherSubstituterUrl. The tally only appends, so an index
+    // names the same URL in both.
+    auto addDeltas(nix::remote::WorkerReport & report, const SubstituterTotals & totals) const -> bool
+    {
+        nix::remote::WorkerReport::Substituter * other = nullptr;
+        for (size_t idx = 0; idx < totals.size(); idx++) {
+            const auto & [url, now] = totals.at(idx);
+            auto const was = idx < sent.size() ? sent.at(idx).second : SubstituterCounts{};
+            if (now == was) {
+                continue;
+            }
+            nix::remote::WorkerReport::Substituter * out = nullptr;
+            // One place stays free for "other".
+            if (url != otherSubstituterUrl && report.substituters_size() + 1 < static_cast<int>(maxSubstituters)) {
+                out = report.add_substituters();
+                out->set_url(url);
+            } else {
+                if (other == nullptr) {
+                    other = report.add_substituters();
+                    other->set_url(std::string(otherSubstituterUrl));
+                }
+                out = other;
+            }
+            out->set_nar_bytes(out->nar_bytes() + now.narBytes - was.narBytes);
+            out->set_download_bytes(out->download_bytes() + now.downloadBytes - was.downloadBytes);
+            out->set_paths(out->paths() + now.paths - was.paths);
+            out->set_failures(out->failures() + now.failures - was.failures);
+        }
+        return report.substituters_size() > 0;
+    }
+};
+
+} // namespace nixgrpc
