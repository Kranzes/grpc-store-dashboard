+struct ActivityEvent
+{
+    enum class Kind : std::uint8_t { start, stop, result } kind = Kind::start;
+    uint64_t id = 0;
+    uint64_t type = 0; // the activity type for start, the result type for result
+    uint64_t parent = 0;
+    std::vector<ActivityField> fields;
+};
+
+using ActivitySink = std::function<void(const ActivityEvent &)>;
+
+namespace detail {
+
+inline auto readLogFields(nix::Source & source) -> std::vector<ActivityField>
+{
+    std::vector<ActivityField> fields;
