+// What a watcher learns about how drvs ended, by path.
+auto gone(Sink & sink) -> std::map<std::string, rpc::DrvGone>
+{
+    std::map<std::string, rpc::DrvGone> out;
+    for (const auto & event : sink.take()) {
+        if (event.has_drv_gone()) {
+            out[event.drv_gone().drv_path()] = event.drv_gone();
+        }
+    }
+    return out;
+}
