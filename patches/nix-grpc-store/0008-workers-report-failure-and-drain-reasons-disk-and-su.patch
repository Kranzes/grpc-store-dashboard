+// Reports go into the counters at once, so every history sample and every
+// Stats carries them, watched or not. The WorkerState waits for the next
+// stats pass: at most one per worker a second, whatever the reports' pace.
+void Dispatcher::onReport(sched::WorkerId wid, const nix::remote::WorkerReport & report)
+{
+    // Taken for gone after a failed send: nothing counts until its next Hello.
+    if (!core.worker(wid).up) {
+        return;
+    }
+    auto & info = infoLocked(wid);
+    int const taken = std::min(report.substituters_size(), static_cast<int>(maxSubstituters));
+    for (int idx = 0; idx < taken; idx++) {
+        const auto & delta = report.substituters(idx);
+        auto url = reduceSubstituterUrl(delta.url());
+        auto const named = info.totals.size() - (info.totals.contains(std::string(otherSubstituterUrl)) ? 1 : 0);
+        if (!info.totals.contains(url) && named >= maxWorkerUrls) {
+            url = otherSubstituterUrl;
+        }
+        auto & mine = info.totals[url];
+        mine.set_url(url);
+        addTraffic(mine, delta);
+        addTraffic(farmTrafficLocked(url), delta);
+    }
+    if (report.has_disk_free_bytes()) {
+        info.diskFree = report.disk_free_bytes();
+    }
+    if (report.has_disk_total_bytes()) {
+        info.diskTotal = report.disk_total_bytes();
+    }
+    if (!std::exchange(info.dirty, true)) {
+        dirtyWorkers.push_back(wid);
+    }
+}
