+
+// A worker session that keeps what the scheduler sends it.
+struct Session
+{
+    std::mutex mutex;
+    std::vector<rpc::SchedCmd> cmds;
+    Dispatcher::Worker worker{.send = [this](const rpc::SchedCmd & cmd) -> bool {
+        const std::scoped_lock lock(mutex);
+        cmds.push_back(cmd);
+        return true;
+    }};
+
+    auto wanted() -> size_t
+    {
+        const std::scoped_lock lock(mutex);
+        return static_cast<size_t>(std::ranges::count_if(cmds, &rpc::SchedCmd::has_reports_wanted));
+    }
+
+    // The latest assignment of `path` to this worker, 0 for none.
+    auto assignId(const std::string & path) -> uint64_t
+    {
+        const std::scoped_lock lock(mutex);
+        for (const auto & cmd : std::views::reverse(cmds)) {
+            if (cmd.has_expect() && cmd.expect().drv_path() == path) {
+                return cmd.expect().assign_id();
+            }
+        }
+        return 0;
+    }
+};
+
+void sendOne(Dispatcher & disp, Dispatcher::Worker & session, rpc::WorkerMsg msg)
+{
+    rpc::WorkerMsgs msgs;
+    *msgs.add_msgs() = std::move(msg);
+    disp.workerMsgs(session, msgs);
+}
+
+auto helloMsg(const std::string & addr, uint32_t maxJobs, std::vector<std::string> substituters = {}) -> rpc::WorkerMsg
+{
+    rpc::WorkerMsg msg;
+    auto * hel = msg.mutable_hello();
+    hel->set_addr(addr);
+    hel->add_systems(std::string(x86));
+    hel->set_max_jobs(maxJobs);
+    hel->set_version("test");
+    for (auto & url : substituters) {
+        hel->add_substituters(std::move(url));
+    }
+    return msg;
+}
+
+auto doneMsg(
+    const std::string & path, uint64_t assignId, rpc::Done::Outcome outcome, rpc::Done::Status status, std::string error = {})
+    -> rpc::WorkerMsg
+{
+    rpc::WorkerMsg msg;
+    auto * done = msg.mutable_done();
+    done->set_drv_path(path);
+    done->set_assign_id(assignId);
+    done->set_outcome(outcome);
+    done->set_status(status);
+    done->set_error(std::move(error));
+    return msg;
+}
