diff --git a/tests/build-report-test.cc b/tests/build-report-test.cc
new file mode 100644
index 0000000..88fc602
--- /dev/null
+++ b/tests/build-report-test.cc
@@ -0,0 +1,214 @@
+// What a builder reports about a finished build: the status mapping, the
+// secret masks and the start-and-end cut of the error text, and how the
+// scheduler cleans the text for watchers.
+
+#include <array>
+#include <cassert>
+#include <cstddef>
+#include <exception>
+#include <iostream>
+#include <string>
+#include <string_view>
+
+#include <nix/store/build-result.hh>
+
+#include "build-report.hh"
+#include "nix-compat.hh"
+#include "nix_remote.pb.h"
+#include "valid-utf8.hh"
+
+using nix::remote::Done;
+using nixgrpc::capError;
+using nixgrpc::cleanUtf8;
+using nixgrpc::cutMiddle;
+using nixgrpc::doneStatus;
+using nixgrpc::redactSecrets;
+
+// NOLINTBEGIN(*-magic-numbers, misc-use-internal-linkage): test vectors.
+namespace {
+
+auto success(nix::BuildResult::Success::Status status) -> nix::BuildResult
+{
+    nix::BuildResult res;
+    res.inner = nix::BuildResult::Success{.status = status};
+    return res;
+}
+
+void testStatus()
+{
+    using Fail = nixcompat::FailureStatus;
+    auto const statusOf = [](nix::BuildResult res) -> Done::Status {
+        return doneStatus(nixcompat::statusName(res), nixcompat::succeeded(res));
+    };
+    assert(statusOf(success(nix::BuildResult::Success::Built)) == Done::STATUS_BUILT);
+    assert(statusOf(success(nix::BuildResult::Success::Substituted)) == Done::STATUS_SUBSTITUTED);
+    assert(statusOf(success(nix::BuildResult::Success::AlreadyValid)) == Done::STATUS_ALREADY_VALID);
+    assert(statusOf(success(nix::BuildResult::Success::ResolvesToAlreadyValid)) == Done::STATUS_ALREADY_VALID);
+    struct Case
+    {
+        Fail fail;
+        Done::Status status;
+    };
+    for (auto const [fail, status] :
+         {Case{.fail = Fail::PermanentFailure, .status = Done::STATUS_PERMANENT_FAILURE},
+          Case{.fail = Fail::InputRejected, .status = Done::STATUS_INPUT_REJECTED},
+          Case{.fail = Fail::OutputRejected, .status = Done::STATUS_OUTPUT_REJECTED},
+          Case{.fail = Fail::HashMismatch, .status = Done::STATUS_OUTPUT_REJECTED},
+          Case{.fail = Fail::TransientFailure, .status = Done::STATUS_TRANSIENT_FAILURE},
+          Case{.fail = Fail::CachedFailure, .status = Done::STATUS_CACHED_FAILURE},
+          Case{.fail = Fail::TimedOut, .status = Done::STATUS_TIMED_OUT},
+          Case{.fail = Fail::MiscFailure, .status = Done::STATUS_MISC_FAILURE},
+          Case{.fail = Fail::DependencyFailed, .status = Done::STATUS_DEPENDENCY_FAILED},
+          Case{.fail = Fail::LogLimitExceeded, .status = Done::STATUS_LOG_LIMIT_EXCEEDED},
+          Case{.fail = Fail::NotDeterministic, .status = Done::STATUS_NOT_DETERMINISTIC},
+          Case{.fail = Fail::NoSubstituters, .status = Done::STATUS_NO_SUBSTITUTERS}}) {
+        assert(statusOf(nixcompat::failed(fail, "boom")) == status);
+    }
+    // A name from a newer Nix.
+    assert(doneStatus("Exploded", false) == Done::STATUS_MISC_FAILURE);
+    assert(doneStatus("Teleported", true) == Done::STATUS_BUILT);
+    assert(nixgrpc::statusLabel(Done::STATUS_TIMED_OUT) == "TimedOut");
+    assert(nixgrpc::statusLabel(Done::STATUS_WORKER_ERROR) == "WorkerError");
+    assert(nixgrpc::statusLabel(Done::STATUS_UNSPECIFIED) == "unreported");
+}
+
+void testRedact()
+{
+    assert(redactSecrets("fetching https://oauth2:abc@github.com/x") == "fetching https://***@github.com/x");
+    assert(
+        redactSecrets("GET https://b.s3.amazonaws.com/k?X-Amz-Signature=abc&x=1 200")
+        == "GET https://b.s3.amazonaws.com/k?X-Amz-Signature=***&x=1 200");
+    assert(redactSecrets("u?X-Amz-Credential=AKIA%2Fx&X-Amz-Security-Token=t1#f") == "u?X-Amz-Credential=***&X-Amz-Security-Token=***#f");
+    assert(redactSecrets("> Authorization: Bearer abc\n> Accept: */*") == "> Authorization: ***\n> Accept: */*");
+    assert(redactSecrets("> Proxy-Authorization: Basic abc") == "> Proxy-Authorization: ***");
+    assert(redactSecrets("curl -H 'X: Bearer abc' x") == "curl -H 'X: Bearer ***' x");
+    assert(redactSecrets("GITHUB_TOKEN=abc make") == "GITHUB_TOKEN=*** make");
+    assert(redactSecrets(R"(export AWS_SECRET_ACCESS_KEY="abc def")") == R"(export AWS_SECRET_ACCESS_KEY="***")");
+    assert(redactSecrets("password: abc") == "password: ***");
+    assert(redactSecrets("db_passwd=hunter2;") == "db_passwd=***");
+    // Quoted keys, as JSON and YAML write them.
+    assert(redactSecrets(R"({"token": "abc", "name": "x"})") == R"({"token": "***", "name": "x"})");
+    assert(redactSecrets(R"({"password":"x"})") == R"({"password":"***"})");
+    assert(redactSecrets(R"({'api_key' : 'abc def'})") == R"({'api_key' : '***'})");
+    assert(redactSecrets(R"("secret": 42,)") == R"("secret": ***)");
+    assert(redactSecrets(R"(the "token" expired; 'key': ok")") == R"(the "token" expired; 'key': ***")");
+    // Keys with - or ., and JSON inside a JSON string.
+    assert(redactSecrets(R"({"X-Auth-Token": "abc"})") == R"({"X-Auth-Token": "***"})");
+    assert(
+        redactSecrets(R"({"access-token": "abc", "client.secret": "def"})")
+        == R"({"access-token": "***", "client.secret": "***"})");
+    assert(redactSecrets(R"(body: "{\"password\":\"hunter2\"}")") == R"(body: "{\"password\":\"***\"}")");
+    // Blanks around =, as Nix and TOML write it, and Ruby's =>.
+    assert(redactSecrets(R"("token" = "abc")") == R"("token" = "***")");
+    assert(redactSecrets(R"(password = "x y";)") == R"(password = "***";)");
+    assert(redactSecrets("TOKEN = abc") == "TOKEN = ***");
+    assert(redactSecrets(R"({"api_key"=>"abc"})") == R"({"api_key"=>"***"})");
+    // A quote that does not close the key, no = or : after it, a command
+    // run with an empty variable, a comparison, or a blank before the :
+    // of a bare name.
+    for (std::string_view const text :
+         {R"(the "token" expired)", R"("token': abc)", R"(set "password" in the form)", R"({"tokens_used" , 3})",
+          "GIT_TOKEN= make", "if token == null then", "password : see the manual", R"("X-Auth-Token" is set)"}) {
+        assert(redactSecrets(std::string(text)) == text);
+    }
+    std::string const pem = "> -----BEGIN OPENSSH PRIVATE KEY-----\n> b3BlbnNzaC1rZXktdjEAAAAA\n> QyNTUxOQAAACD\n"
+                            "> -----END OPENSSH PRIVATE KEY-----\nafter";
+    assert(
+        redactSecrets(pem)
+        == "> -----BEGIN OPENSSH PRIVATE KEY-----\n***\n> -----END OPENSSH PRIVATE KEY-----\nafter");
+    // Nix keeps only the last lines, which can start inside the key.
+    assert(
+        redactSecrets("Last 3 log lines:\n> MIIEvQIBADANBgkqhkiG9w0BAQEFAASC\n> AoGBAMo=\n> -----END PRIVATE KEY-----")
+        == "Last 3 log lines:\n***\n> -----END PRIVATE KEY-----");
+    std::string const plain = "Cannot build '/nix/store/abc-hello-2.12.1.drv'.\nReason: builder failed with exit code 2.\n"
+                              "> make: *** [Makefile:12: all] Error 2\nsee https://example.org/a?b=c&d=e";
+    assert(redactSecrets(plain) == plain);
+}
+
+void testCut()
+{
+    assert(cutMiddle("short", 4096) == "short");
+    assert(capError("short\nmessage") == "short\nmessage");
+    std::string text = "Cannot build '/nix/store/abc-x.drv'.\nReason: builder failed with exit code 2.\nLast lines:\n";
+    for (int line = 0; line < 400; line++) {
+        text += "> line " + std::to_string(line) + " ünïcödé ✓ output\n";
+    }
+    text += "> make: *** [Makefile:12: all] Error 2";
+    auto const cut = capError(text);
+    assert(cut.size() <= 4096 && validUtf8(cut));
+    assert(cut.starts_with("Cannot build '/nix/store/abc-x.drv'.\nReason: builder failed with exit code 2.\n[...]\n> line "));
+    assert(cut.ends_with("Error 2"));
+    // Wherever the cut lands, no UTF-8 sequence is split.
+    std::string wide;
+    for (int idx = 0; idx < 3000; idx++) {
+        wide += "€😀";
+    }
+    for (size_t cap = 600; cap < 700; cap++) {
+        auto const out = cutMiddle(wide, cap);
+        assert(out.size() <= cap && validUtf8(out) && out.contains("[...]"));
+    }
+    // A cut that leaves no room for "[...]" still ends at a character.
+    assert(cutMiddle(std::string(63, 'v') + "é", 64) == std::string(63, 'v'));
+    // ANSI escapes go.
+    assert(capError("\x1b[31;1merror:\x1b[0m boom") == "error: boom");
+    // Also in a message much longer than what survives the cut.
+    std::string huge = "\x1b[1mfirst\x1b[0m line\n";
+    for (int idx = 0; idx < 100'000; idx++) {
+        huge += "\x1b[32mok\x1b[0m\n";
+    }
+    huge += "\x1b[31mfailed\x1b[0m";
+    auto const hugeCut = capError(huge);
+    assert(hugeCut.size() <= 4096 && hugeCut.starts_with("first line\n") && hugeCut.ends_with("ok\nfailed"));
+    assert(!hugeCut.contains('\x1b'));
+    // A token where a cut of the raw text would start is masked first.
+    std::string const straddle = "head\nsecond\n" + std::string(3000, 'x') + "\nGITHUB_TOKEN=" + std::string(2000, 'S')
+                                 + "\n" + std::string(3000, 'y');
+    assert(cutMiddle(straddle, 4096).contains("SS"));
+    auto const masked = capError(straddle);
+    assert(masked.size() <= 4096 && !masked.contains("SS") && masked.ends_with("yyy"));
+}
+
+// UTF-8 of a code point from U+0080 to U+FFFF, so that no literal in this
+// file holds a bidi control.
+auto utf8(char32_t code) -> std::string
+{
+    if (code < 0x800U) {
+        return {static_cast<char>(0xC0U | (code >> 6U)), static_cast<char>(0x80U | (code & 0x3FU))};
+    }
+    return {
+        static_cast<char>(0xE0U | (code >> 12U)),
+        static_cast<char>(0x80U | ((code >> 6U) & 0x3FU)),
+        static_cast<char>(0x80U | (code & 0x3FU))};
+}
+
+// Controls go, and so do Unicode's Bidi_Control characters, all twelve.
+// Other format characters stay.
+void testClean()
+{
+    assert(cleanUtf8("plain\ttext\n\u05E9\u05DC\u05D5\u05DD \u2713") == "plain\ttext\n\u05E9\u05DC\u05D5\u05DD \u2713");
+    assert(cleanUtf8("a\x07" "b\x7f\xc2\x85" "c\xff") == "abc\xEF\xBF\xBD");
+    constexpr std::array<char32_t, 12> bidi{
+        0x061C, 0x200E, 0x200F, 0x202A, 0x202B, 0x202C, 0x202D, 0x202E, 0x2066, 0x2067, 0x2068, 0x2069};
+    for (auto const code : bidi) {
+        assert(cleanUtf8("exit " + utf8(code) + "2") == "exit 2");
+    }
+    // ZERO WIDTH JOINER, which emoji sequences need.
+    assert(cleanUtf8(utf8(0x200D)) == utf8(0x200D));
+}
+
+} // namespace
+// NOLINTEND(*-magic-numbers, misc-use-internal-linkage)
+
+auto main() -> int
+{
+    try {
+        testStatus();
+        testRedact();
+        testCut();
+        testClean();
+    } catch (std::exception & err) {
+        std::cerr << "error: " << err.what() << "\n";
+        return 1;
+    }
+    return 0;
+}
