diff --git a/proto/events.proto b/proto/events.proto
index c9bd595..33ec6c1 100644
--- a/proto/events.proto
+++ b/proto/events.proto
@@ -27,6 +27,12 @@ package nix.remote;
 // in flight is cancelled here too. Streams of certificate callers do not
 // end this way.
 //
+// A failed build's DrvGone carries the end of its error text, up to 4 KiB,
+// which can hold whatever the build printed. A stream with more than 4 MiB
+// of it queued is cancelled like one that falls behind, and a WatchEvents
+// message stops after 1 MiB of it, so messages stay under gRPC's default
+// 4 MiB receive limit.
+//
 // Callers need the `watch` role or higher. For a bearer token that is an
 // --oidc-config rule with scopes ["watch"], not an OAuth scope. Anonymous
 // callers are refused even where the anonymous role would allow it, because
@@ -82,13 +88,18 @@ message Reset {
   // for "last N minutes" totals right after connecting. The current
   // values arrive with the next Stats.
   repeated CounterSample history = 6;
+  // The farm cache as builders list it among their substituters
+  // (--niks3-cache-url, reduced like WorkerState.substituters). Empty when
+  // the scheduler does not know it.
+  string cache_substituter_url = 7;
 }
 
 message SnapshotDone {}
 
 // A builder's session. Upsert keyed by addr, sent in the snapshot (connected
-// workers only) and on Hello, Load and disconnect. A worker that went away
-// stays known with up = false until it says Hello again.
+// workers only), on Hello, Load and disconnect, and at most once a second
+// after a WorkerReport changed it. A worker that went away stays known with
+// up = false until it says Hello again.
 message WorkerState {
   // The address the balancer reaches it at (its --advertise).
   string addr = 1;
@@ -97,8 +108,45 @@ message WorkerState {
   repeated string features = 3;
   uint32 max_jobs = 4;
   bool up = 5;
-  // Stopping, or low on disk. The scheduler cannot tell which.
+  // Stopping, low on disk or without its local nix-daemon. drain_reason
+  // says which when the builder reports it.
   bool draining = 6;
+  enum DrainReason {
+    DRAIN_REASON_UNSPECIFIED = 0;
+    DRAIN_REASON_STOPPING = 1;
+    DRAIN_REASON_LOW_DISK = 2;
+    DRAIN_REASON_LOCAL_DAEMON = 3;
+  }
+  // While draining. UNSPECIFIED: the builder does not say.
+  DrainReason drain_reason = 7;
+  // nix-grpc-store version of the builder. Empty: the builder is older and
+  // reports no drain reason, disk, substituters or build status.
+  string version = 8;
+  // As the builder last reported them. Unset: never reported.
+  optional uint64 disk_free_bytes = 9;
+  optional uint64 disk_total_bytes = 10;
+  // --min-free, 0 = none.
+  uint64 min_free_bytes = 11;
+  // The builder's substituters in its order, then any others it reported
+  // traffic for, sorted by URL. Each URL is reduced to
+  // scheme://host[:port]/path, without user, password, query or fragment.
+  // Counts are cumulative since Reset.serving_since_ms: a client takes rates
+  // from the change between two events. Kept while the builder is down and
+  // across its reconnects.
+  repeated SubstituterTraffic substituters = 12;
+}
+
+message SubstituterTraffic {
+  string url = 1;
+  // NAR bytes copied from it.
+  uint64 nar_bytes = 2;
+  // Bytes received on the wire, http and https substituters only.
+  uint64 download_bytes = 3;
+  // NARs that arrived in full. One whose hash check failed after the last
+  // byte counts too: nothing the builder sees tells the two apart.
+  uint64 paths = 4;
+  // Substitutions that stopped before the whole NAR arrived.
+  uint64 failures = 5;
 }
 
 // One Schedule stream: a build client. Hook-mode builds open one per
@@ -208,6 +256,36 @@ message DrvGone {
   string worker_addr = 3;
   // BUILT only. These have been published to the cache.
   repeated Output outputs = 4;
+  // Same values as nix.remote.Done.Status, repeated to keep this file
+  // self-contained.
+  enum Status {
+    STATUS_UNSPECIFIED = 0;
+    STATUS_BUILT = 1;
+    STATUS_SUBSTITUTED = 2;
+    STATUS_ALREADY_VALID = 3;
+    STATUS_PERMANENT_FAILURE = 4;
+    STATUS_INPUT_REJECTED = 5;
+    STATUS_OUTPUT_REJECTED = 6;
+    STATUS_TRANSIENT_FAILURE = 7;
+    STATUS_CACHED_FAILURE = 8;
+    STATUS_TIMED_OUT = 9;
+    STATUS_MISC_FAILURE = 10;
+    STATUS_DEPENDENCY_FAILED = 11;
+    STATUS_LOG_LIMIT_EXCEEDED = 12;
+    STATUS_NOT_DETERMINISTIC = 13;
+    STATUS_NO_SUBSTITUTERS = 14;
+    // The builder or its nix-daemon failed before or while building, so
+    // Nix reported no result.
+    STATUS_WORKER_ERROR = 15;
+  }
+  // Nix's status: BUILT and FAILED, from builders that report it.
+  Status status = 5;
+  // FAILED only: the builder's error text, valid UTF-8 without control or
+  // bidi control characters, at most 4096 bytes: its first two lines,
+  // "[...]" and its end. Every watcher gets it. Empty when the builder sent
+  // none. It can hold whatever the build printed; common secret shapes are
+  // masked.
+  string error = 6;
 }
 
 message Output {
@@ -254,6 +332,10 @@ message Counters {
   // a bound either way: it leaves out inputs nobody here built, and counts an
   // input again for every build that needs it, even once the worker has it.
   uint64 fetched_bytes_estimate = 11;
+  // What builders reported downloading, summed over builders per
+  // substituter URL, sorted by URL. At most 64 URLs; the rest add up under
+  // "other".
+  repeated SubstituterTraffic substituters = 12;
 }
 
 message CounterSample {
diff --git a/proto/nix_remote.proto b/proto/nix_remote.proto
index 6cad119..fe16149 100644
--- a/proto/nix_remote.proto
+++ b/proto/nix_remote.proto
@@ -244,6 +244,15 @@ message Hello {
   // Builds a client came for, so a restarted scheduler neither double-assigns
   // them nor counts their slots as free.
   repeated RunningBuild running = 5;
+  // The builder's substituters, in its Nix settings' order, each reduced to
+  // scheme://host[:port]/path: no user, password, query or fragment, scheme
+  // and host in lower case, no trailing slash, at most 256 bytes. At most 32.
+  repeated string substituters = 6;
+  // nix-grpc-store version of the builder. Empty from builders older than
+  // this field, which send no build status, drain reason, disk or traffic.
+  string version = 7;
+  // --min-free in bytes. 0 = no threshold.
+  uint64 min_free_bytes = 8;
 }
 
 message Done {
@@ -265,15 +274,75 @@ message Done {
     UNREACHABLE = 4; // no client came for it
     TRANSIENT_FAILURE = 5; // e.g. ENOSPC
   }
+  // Nix's BuildResult status. Set with BUILT and FAILED by builders that
+  // report it. Values carry a prefix because they share the scope of
+  // Outcome and Reason.
+  enum Status {
+    STATUS_UNSPECIFIED = 0;
+    STATUS_BUILT = 1;
+    STATUS_SUBSTITUTED = 2;
+    STATUS_ALREADY_VALID = 3; // also ResolvesToAlreadyValid
+    STATUS_PERMANENT_FAILURE = 4;
+    STATUS_INPUT_REJECTED = 5;
+    STATUS_OUTPUT_REJECTED = 6; // also HashMismatch
+    STATUS_TRANSIENT_FAILURE = 7;
+    STATUS_CACHED_FAILURE = 8;
+    STATUS_TIMED_OUT = 9;
+    STATUS_MISC_FAILURE = 10;
+    STATUS_DEPENDENCY_FAILED = 11;
+    STATUS_LOG_LIMIT_EXCEEDED = 12;
+    STATUS_NOT_DETERMINISTIC = 13;
+    STATUS_NO_SUBSTITUTERS = 14;
+    // FAILED without a BuildResult: the builder or its nix-daemon failed
+    // before or while building. `error` says how.
+    STATUS_WORKER_ERROR = 15;
+  }
   string drv_path = 1;
   uint64 assign_id = 2;
   Outcome outcome = 3;
   repeated PathSize outputs = 4;
   Reason reason = 5; // with GIVEN_BACK
+  Status status = 6;
+  // FAILED only: Nix's message, or the worker's error, with ANSI escapes
+  // removed and common secret shapes masked. At most 4096 bytes: the first
+  // two lines, then "[...]", then as much of the end as fits. Bytes, because
+  // build output need not be UTF-8.
+  bytes error = 7;
 }
 
 message Load {
   bool draining = 1;
+  // When several hold, the first listed wins.
+  enum DrainReason {
+    DRAIN_REASON_UNSPECIFIED = 0;
+    DRAIN_REASON_STOPPING = 1;     // a stop signal
+    DRAIN_REASON_LOW_DISK = 2;     // free space below --min-free
+    DRAIN_REASON_LOCAL_DAEMON = 3; // the local nix-daemon does not answer
+  }
+  // While draining. A builder sends Load again when the reason changes.
+  DrainReason drain_reason = 2;
+}
+
+// Measurements a connected builder sends once the scheduler asked for them
+// with ReportsWanted on this session: the first on the builder's next tick,
+// then at most every 2 s, and only when something changed.
+message WorkerReport {
+  message Substituter {
+    string url = 1;            // reduced as in Hello.substituters
+    uint64 nar_bytes = 2;      // NAR bytes copied from it
+    uint64 download_bytes = 3; // bytes received, http and https only
+    uint64 paths = 4;          // NARs that arrived in full
+    uint64 failures = 5;       // substitutions that stopped before that
+  }
+  // Free (f_bavail) and total (f_blocks) bytes of the store's file system.
+  // Set in the first report of a session, and when free moved by at least
+  // max(256 MiB, 5% of the last value sent) or crossed min_free_bytes.
+  optional uint64 disk_free_bytes = 1;
+  optional uint64 disk_total_bytes = 2;
+  // Traffic since the last report this builder sent without a send error,
+  // on this session or an earlier one, per substituter, only those with
+  // traffic. At most 32.
+  repeated Substituter substituters = 3;
 }
 
 message WorkerMsg {
@@ -281,6 +350,7 @@ message WorkerMsg {
     Hello hello = 1;
     Done done = 2;
     Load load = 3;
+    WorkerReport report = 4;
   }
 }
 
@@ -293,11 +363,17 @@ message Revoke {
   string drv_path = 1;
 }
 
+// The scheduler takes WorkerReports on this session. Sent once, after it
+// handled Hello. Older schedulers never send it, so builders send them no
+// reports.
+message ReportsWanted {}
+
 message SchedCmd {
   oneof cmd {
     Expect expect = 1;
     Revoke revoke = 2;
     Restarting restarting = 3;
+    ReportsWanted reports_wanted = 4;
   }
 }
 
