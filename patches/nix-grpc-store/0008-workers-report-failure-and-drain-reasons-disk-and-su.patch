+// What a builder counts per substituter, and the WorkerReports that carry it:
+// URL reduction, the activity tally, and when reports go out.
+
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <exception>
+#include <format>
+#include <iostream>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <vector>
+
+#include <nix/util/error.hh>
+#include <nix/util/logging.hh>
+
+#include "metrics.hh"
+#include "nix_remote.pb.h"
+#include "scheduler-link.hh"
+#include "substituter-tally.hh"
+#include "substituter-url.hh"
+
+using nix::remote::WorkerMsg;
+using nixgrpc::LoggerFields;
+using nixgrpc::reduceSubstituterUrl;
+using nixgrpc::SchedulerLink;
+using nixgrpc::SubstituterCounts;
+using nixgrpc::SubstituterTally;
+
+// NOLINTBEGIN(*-magic-numbers, misc-use-internal-linkage, readability-identifier-length): test vectors.
+namespace {
+
+constexpr std::string_view nixos = "https://cache.nixos.org";
+
+// The logger the tally wraps.
+class NullLogger final : public nix::Logger
+{
+public:
+    size_t starts = 0;
+
+    void log(nix::Verbosity /*lvl*/, std::string_view /*msg*/) noexcept override {}
+    void logEI(const nix::ErrorInfo & /*info*/) noexcept override {}
+    void startActivity(
+        nix::ActivityId /*act*/,
+        nix::Verbosity /*lvl*/,
+        nix::ActivityType /*type*/,
+        const std::string & /*text*/,
+        LoggerFields /*fields*/,
+        nix::ActivityId /*parent*/) noexcept override
+    {
+        starts++;
+    }
+};
+
+auto countsOf(const SubstituterTally & tally, std::string_view url) -> SubstituterCounts
+{
+    for (const auto & [name, counts] : tally.totals()) {
+        if (name == url) {
+            return counts;
+        }
+    }
+    return {};
+}
+
+void testReduce()
+{
+    assert(reduceSubstituterUrl("https://user:pw@Cache.NixOS.org/?priority=40#x") == nixos);
+    assert(reduceSubstituterUrl("https://cache.nixos.org/") == nixos);
+    assert(reduceSubstituterUrl("HTTPS://Example.COM:8443/Some/Path//") == "https://example.com:8443/Some/Path");
+    assert(reduceSubstituterUrl("s3://bucket?region=eu-west-1&profile=x") == "s3://bucket");
+    assert(reduceSubstituterUrl("ssh-ng://builder@host?ssh-key=/k") == "ssh-ng://host");
+    assert(reduceSubstituterUrl("daemon") == "daemon");
+    assert(reduceSubstituterUrl("local?root=/x") == "local");
+    // Cut on a UTF-8 boundary: "é" is two bytes and would straddle 256.
+    std::string longUrl = "https://h/" + std::string(245, 'a');
+    while (longUrl.size() < 300) {
+        longUrl += "é";
+    }
+    auto const cut = reduceSubstituterUrl(longUrl);
+    assert(cut.size() <= nixgrpc::maxSubstituterUrlLen && cut.size() >= 255);
+    assert((static_cast<unsigned char>(cut.back()) & 0xC0U) != 0xC0U);
+}
+
+// One substitution: the copy under it and the transfer under that.
+void substitute(
+    SubstituterTally & tally, nix::ActivityId base, std::string_view url, uint64_t done, uint64_t expected)
+{
+    tally.started(base, nix::actSubstitute, 0, url);
+    tally.started(base + 1, nix::actCopyPath, base, "");
+    tally.started(base + 2, nix::actFileTransfer, base + 1, "");
+    tally.progressed(base + 1, done / 2, expected);
+    tally.progressed(base + 2, done / 4, 0);
+    tally.progressed(base + 1, done, expected);
+    tally.progressed(base + 2, done / 3, 0);
+    tally.stopped(base + 2);
+    tally.stopped(base + 1);
+    tally.stopped(base);
+}
+
+void testActivities()
+{
+    NullLogger next;
+    SubstituterTally tally(&next, {"https://cache.nixos.org/", "https://Cache.nixos.org", "https://farm.example"});
+    assert((tally.configured() == std::vector<std::string>{std::string(nixos), "https://farm.example"}));
+    // Complete: a path, and NAR bytes equal to the expected size.
+    substitute(tally, 10, "https://cache.nixos.org", 1000, 1000);
+    assert((countsOf(tally, nixos) == SubstituterCounts{.narBytes = 1000, .downloadBytes = 333, .paths = 1}));
+    // Stopped short: a failure, and its bytes still count.
+    substitute(tally, 20, "https://cache.nixos.org", 400, 1000);
+    assert((countsOf(tally, nixos) == SubstituterCounts{.narBytes = 1400, .downloadBytes = 466, .paths = 1, .failures = 1}));
+    // Under a parent the tally does not know: nothing.
+    tally.started(30, nix::actCopyPath, 99, "");
+    tally.progressed(30, 500, 500);
+    tally.stopped(30);
+    assert(countsOf(tally, nixos).narBytes == 1400 && tally.tracked() == 0);
+    // Through the Logger interface, as RemoteStore calls it.
+    nix::Logger & logger = tally;
+    std::vector<nix::Logger::Field> const fields{nix::Logger::Field("/nix/store/x"), nix::Logger::Field("https://farm.example/")};
+    logger.startActivity(40, nix::lvlError, nix::actSubstitute, "", fields, 0);
+    logger.startActivity(41, nix::lvlError, nix::actCopyPath, "", {}, 40);
+    std::vector<nix::Logger::Field> const progress{
+        nix::Logger::Field(uint64_t{64}), nix::Logger::Field(uint64_t{64}), nix::Logger::Field(uint64_t{1}),
+        nix::Logger::Field(uint64_t{0})};
+    logger.result(41, nix::resProgress, progress);
+    logger.stopActivity(41);
+    logger.stopActivity(40);
+    assert(next.starts == 2);
+    assert((countsOf(tally, "https://farm.example") == SubstituterCounts{.narBytes = 64, .paths = 1}));
+
+    // Two substitutions on two threads count apart.
+    std::thread first([&] -> void {
+        for (nix::ActivityId idx = 0; idx < 200; idx++) {
+            substitute(tally, 1000 + (idx * 3), "https://a.example", 10, 10);
+        }
+    });
+    std::thread second([&] -> void {
+        for (nix::ActivityId idx = 0; idx < 200; idx++) {
+            substitute(tally, 5000 + (idx * 3), "https://b.example", 20, 20);
+        }
+    });
+    first.join();
+    second.join();
+    assert((countsOf(tally, "https://a.example") == SubstituterCounts{.narBytes = 2000, .downloadBytes = 600, .paths = 200}));
+    assert((countsOf(tally, "https://b.example") == SubstituterCounts{.narBytes = 4000, .downloadBytes = 1200, .paths = 200}));
+}
+
+void testLimits()
+{
+    NullLogger next;
+    SubstituterTally tally(&next, {std::string(nixos)});
+    auto const t0 = SubstituterTally::Clock::now();
+    for (nix::ActivityId idx = 1; idx <= SubstituterTally::maxActivities; idx++) {
+        tally.started(idx, nix::actSubstitute, 0, nixos, t0);
+    }
+    assert(tally.tracked() == SubstituterTally::maxActivities);
+    tally.started(100'000, nix::actSubstitute, 0, nixos, t0);
+    assert(tally.tracked() == SubstituterTally::maxActivities);
+    // Idle ones go, without counting as a path or a failure.
+    tally.started(100'001, nix::actSubstitute, 0, nixos, t0 + SubstituterTally::idleLimit);
+    assert(tally.tracked() == 1);
+    tally.prune(t0 + (2 * SubstituterTally::idleLimit));
+    assert(tally.tracked() == 0 && countsOf(tally, nixos) == SubstituterCounts{});
+
+    // An unconfigured URL is added. Past 32 of them, "other".
+    for (nix::ActivityId idx = 0; idx < SubstituterTally::maxOthers + 2; idx++) {
+        substitute(tally, 200'000 + (idx * 3), std::format("https://c{}.example", idx), 5, 5);
+    }
+    auto const totals = tally.totals();
+    assert(totals.size() == 1 + SubstituterTally::maxOthers + 1);
+    assert(totals.at(1).first == "https://c0.example" && totals.back().first == "other");
+    assert(totals.back().second.paths == 2);
+}
+
+// The messages a session got.
+struct Recorder
+{
+    std::vector<WorkerMsg> msgs;
+    bool fail = false;
+
+    auto send() -> SchedulerLink::SendFn
+    {
+        return [this](const WorkerMsg & msg) -> bool {
+            if (fail) {
+                return false;
+            }
+            msgs.push_back(msg);
+            return true;
+        };
+    }
+};
+
+void testReports()
+{
+    using std::chrono::seconds;
+    NullLogger next;
+    SubstituterTally tally(&next, {std::string(nixos)});
+    constexpr uint64_t gib = uint64_t{1} << 30U;
+    SchedulerLink link(&tally, 10 * gib);
+    auto now = SchedulerLink::Clock::now();
+    Recorder one;
+    link.setSend(one.send());
+    link.setDisk(50 * gib, 200 * gib);
+    substitute(tally, 1, nixos, 100, 100);
+    // Nothing before ReportsWanted.
+    link.tick(now);
+    assert(one.msgs.empty());
+    link.reportsWanted();
+    link.tick(now += seconds(1));
+    assert(one.msgs.size() == 1 && one.msgs.at(0).has_report());
+    const auto & first = one.msgs.at(0).report();
+    assert(first.has_disk_free_bytes() && first.disk_free_bytes() == 50 * gib && first.disk_total_bytes() == 200 * gib);
+    assert(first.substituters_size() == 1 && first.substituters(0).url() == nixos && first.substituters(0).nar_bytes() == 100);
+    // Traffic within 2 s of the last report waits.
+    substitute(tally, 10, nixos, 50, 100);
+    link.setDisk((50 * gib) - (1U << 20U), 200 * gib); // a small move is no step
+    link.tick(now += seconds(1));
+    assert(one.msgs.size() == 1);
+    link.tick(now += seconds(1));
+    assert(one.msgs.size() == 2);
+    const auto & second = one.msgs.at(1).report();
+    assert(!second.has_disk_free_bytes() && second.substituters_size() == 1);
+    assert(second.substituters(0).nar_bytes() == 50 && second.substituters(0).failures() == 1);
+    // Nothing changed: nothing goes out.
+    link.tick(now += seconds(3));
+    assert(one.msgs.size() == 2);
+    // Crossing --min-free is a step.
+    link.setDisk(9 * gib, 200 * gib);
+    link.tick(now += seconds(1));
+    assert(one.msgs.size() == 3 && one.msgs.at(2).report().disk_free_bytes() == 9 * gib);
+    assert(one.msgs.at(2).report().substituters_size() == 0);
+
+    // A failed send keeps its counts for the next report, also on the next
+    // session, which sends nothing until it is asked.
+    one.fail = true;
+    substitute(tally, 20, nixos, 30, 30);
+    link.tick(now += seconds(3));
+    Recorder two;
+    link.setSend(two.send());
+    substitute(tally, 30, nixos, 40, 40);
+    link.tick(now += seconds(3));
+    assert(two.msgs.empty());
+    link.reportsWanted();
+    link.tick(now += seconds(1));
+    assert(two.msgs.size() == 1);
+    const auto & carried = two.msgs.at(0).report();
+    assert(carried.disk_free_bytes() == 9 * gib);
+    assert(carried.substituters_size() == 1 && carried.substituters(0).nar_bytes() == 70 && carried.substituters(0).paths() == 2);
+    // Without a session nothing goes out, and nothing is lost.
+    substitute(tally, 40, nixos, 25, 25);
+    link.setSend(nullptr);
+    link.tick(now += seconds(3));
+    assert(two.msgs.size() == 1);
+    Recorder three;
+    link.setSend(three.send());
+    link.reportsWanted();
+    link.tick(now += seconds(1));
+    assert(three.msgs.size() == 1);
+    const auto & kept = three.msgs.at(0).report();
+    assert(kept.substituters_size() == 1 && kept.substituters(0).nar_bytes() == 25 && kept.substituters(0).paths() == 1);
+}
+
+// Until a builder sets them, the disk gauges have no sample: a node without
+// the builder role would otherwise show a full disk.
+void testDiskGauges()
+{
+    nixgrpc::Metrics metrics("");
+    auto const samples = [&](std::string_view name) -> size_t {
+        for (const auto & family : metrics.collect()) {
+            if (family.name == name) {
+                return family.metric.size();
+            }
+        }
+        return 0;
+    };
+    constexpr std::array<std::string_view, 3> names{
+        "nix_grpc_store_free_bytes", "nix_grpc_store_size_bytes", "nix_grpc_min_free_bytes"};
+    assert(std::ranges::all_of(names, [&](std::string_view name) -> bool { return samples(name) == 0; }));
+    metrics.storeDisk(1, 2);
+    metrics.minFree(0);
+    assert(std::ranges::all_of(names, [&](std::string_view name) -> bool { return samples(name) == 1; }));
+}
+
+} // namespace
+// NOLINTEND(*-magic-numbers, misc-use-internal-linkage, readability-identifier-length)
+
+auto main() -> int
+{
+    try {
+        testReduce();
+        testActivities();
+        testLimits();
+        testReports();
+        testDiskGauges();
+    } catch (std::exception & err) {
+        std::cerr << "error: " << err.what() << "\n";
+        return 1;
+    }
+    return 0;
+}
