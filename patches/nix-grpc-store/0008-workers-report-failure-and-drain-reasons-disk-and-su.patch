+#pragma once
+// For tests: whether `text` is well-formed UTF-8 in its lead and
+// continuation bytes, as a proto3 string must be.
+
+#include <cstddef>
+#include <string_view>
+
+// NOLINTBEGIN(*-magic-numbers): the bit patterns of UTF-8 lead bytes.
+inline auto validUtf8(std::string_view text) -> bool
+{
+    size_t idx = 0;
+    while (idx < text.size()) {
+        auto const lead = static_cast<unsigned char>(text.at(idx));
+        size_t len = 0;
+        if (lead < 0x80) {
+            len = 1;
+        } else if (lead >> 5U == 6) {
+            len = 2;
+        } else if (lead >> 4U == 14) {
+            len = 3;
+        } else if (lead >> 3U == 30) {
+            len = 4;
+        }
+        if (len == 0 || idx + len > text.size()) {
+            return false;
+        }
+        for (size_t more = 1; more < len; more++) {
+            if ((static_cast<unsigned char>(text.at(idx + more)) & 0xC0U) != 0x80U) {
+                return false;
+            }
+        }
+        idx += len;
+    }
+    return true;
+}
+// NOLINTEND(*-magic-numbers)
