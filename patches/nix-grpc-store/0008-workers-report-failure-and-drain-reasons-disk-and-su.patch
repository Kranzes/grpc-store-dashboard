+// Each Load names the reason the worker takes no builds. Stopping wins,
+// then low disk, then the local nix-daemon, and a Load goes out again only
+// when the reason changes.
+auto loadsCarryTheReason() -> bool
+{
+    nixgrpc::Metrics metrics{""};
+    Builder builder({.advertise = "w:0", .systems = {"x86_64-linux"}, .features = {}, .maxJobs = 1}, metrics);
+    std::vector<int> reasons; // -1: a Load that ends the drain
+    builder.setSend([&](const nix::remote::WorkerMsg & msg) -> bool {
+        if (msg.has_load()) {
+            reasons.push_back(msg.load().draining() ? msg.load().drain_reason() : -1);
+        }
+        return true;
+    });
+    builder.greet();
+    builder.setUnavailable(Builder::Unavailable::localDaemonDown, true);
+    builder.setUnavailable(Builder::Unavailable::lowDisk, true);
+    builder.setUnavailable(Builder::Unavailable::localDaemonDown, false);
+    builder.setUnavailable(Builder::Unavailable::lowDisk, false);
+    using Load = nix::remote::Load;
+    return reasons == std::vector<int>{Load::DRAIN_REASON_LOCAL_DAEMON, Load::DRAIN_REASON_LOW_DISK, -1};
+}
