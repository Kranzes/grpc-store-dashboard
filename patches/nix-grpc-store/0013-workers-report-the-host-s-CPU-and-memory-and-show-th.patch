+    // The load, when a report should carry it: in a session's first, then
+    // when it moved by a step or went out loadEvery ago.
+    [[nodiscard]] auto loadToSend(bool first, Clock::time_point now) const -> std::optional<HostLoad>
+    {
+        if (!load) {
+            return std::nullopt;
+        }
+        if (first || !loadSent || now - loadSentAt >= loadEvery || loadStep(*loadSent, *load)) {
+            return load;
+        }
+        return std::nullopt;
+    }
+
+    [[nodiscard]] static auto loadStep(const HostLoad & last, const HostLoad & now) -> bool
+    {
+        constexpr uint64_t percent = 100;
+        constexpr uint64_t milli = 1000;
+        auto const moved = [](uint64_t before, uint64_t after) -> uint64_t {
+            return before > after ? before - after : after - before;
+        };
+        auto const cpuStep = std::max<uint64_t>(1, uint64_t{now.cpuCores} * milli * loadStepPercent / percent);
+        auto const memStep = std::max<uint64_t>(1, now.memTotalBytes / percent * loadStepPercent);
+        return last.cpuCores != now.cpuCores || last.memTotalBytes != now.memTotalBytes
+            || moved(last.cpuBusyMillicores, now.cpuBusyMillicores) >= cpuStep
+            || moved(last.memUsedBytes, now.memUsedBytes) >= memStep;
+    }
+
     // What `totals` adds to `sent`, only substituters with traffic, folding
     // any past maxSubstituters into otherSubstituterUrl. The tally only appends, so an index
     // names the same URL in both.
