+  optional uint64 cpu_busy_millicores = 5;
+  optional uint32 cpu_cores = 6;
+  optional uint64 mem_used_bytes = 7;
+  optional uint64 mem_total_bytes = 8;
+  optional uint64 cpu_iowait_millicores = 9;
