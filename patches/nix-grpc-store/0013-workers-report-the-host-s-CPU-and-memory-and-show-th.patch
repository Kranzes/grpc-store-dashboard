+// The load goes out in a session's first report, then when busy CPUs moved
+// by 5% of the cores, memory in use by 5% of the total, or after 30 s.
+void testLoadReports()
+{
+    using std::chrono::seconds;
+    constexpr uint64_t gib = uint64_t{1} << 30U;
+    SchedulerLink link(nullptr, 0);
+    auto now = SchedulerLink::Clock::now();
+    Recorder one;
+    link.setSend(one.send());
+    HostLoad load{
+        .cpuBusyMillicores = 4000,
+        .cpuIowaitMillicores = 500,
+        .cpuCores = 16,
+        .memUsedBytes = 10 * gib,
+        .memTotalBytes = 64 * gib};
+    link.setLoad(load);
+    link.tick(now);
+    assert(one.msgs.empty()); // only to a scheduler that asks
+    link.reportsWanted();
+    link.tick(now += seconds(1));
+    assert(one.msgs.size() == 1);
+    const auto & first = one.msgs.at(0).report();
+    assert(first.cpu_busy_millicores() == 4000 && first.cpu_iowait_millicores() == 500 && first.cpu_cores() == 16);
+    assert(first.mem_used_bytes() == 10 * gib && first.mem_total_bytes() == 64 * gib);
+    // Moves under 800 millicores, 5% of 16 CPUs, and under 3.2 GiB send no report.
+    load.cpuBusyMillicores = 4790;
+    load.memUsedBytes = 13 * gib;
+    link.setLoad(load);
+    link.tick(now += seconds(3));
+    assert(one.msgs.size() == 1);
+    load.cpuBusyMillicores = 3200;
+    link.setLoad(load);
+    link.tick(now += seconds(3));
+    assert(one.msgs.size() == 2 && one.msgs.at(1).report().cpu_busy_millicores() == 3200);
+    assert(one.msgs.at(1).report().mem_used_bytes() == 13 * gib && !one.msgs.at(1).report().has_disk_free_bytes());
+    load.memUsedBytes = 17 * gib;
+    link.setLoad(load);
+    link.tick(now += seconds(3));
+    assert(one.msgs.size() == 3 && one.msgs.at(2).report().mem_used_bytes() == 17 * gib);
+    // Unchanged, it goes out again after 30 s.
+    link.tick(now += seconds(20));
+    assert(one.msgs.size() == 3);
+    link.tick(now += seconds(10));
+    assert(one.msgs.size() == 4 && one.msgs.at(3).report().cpu_cores() == 16);
+    // A new session's first report carries it.
+    Recorder two;
+    link.setSend(two.send());
+    link.reportsWanted();
+    link.tick(now += seconds(1));
+    assert(two.msgs.size() == 1 && two.msgs.at(0).report().has_cpu_busy_millicores());
+    // A builder that has no load to report sends none.
+    SchedulerLink bare(nullptr, 0);
+    Recorder three;
+    bare.setSend(three.send());
+    bare.reportsWanted();
+    bare.tick(now);
+    assert(three.msgs.size() == 1 && !three.msgs.at(0).report().has_cpu_cores());
+    bare.tick(now += seconds(31));
+    assert(three.msgs.size() == 1);
+    // A host that does not measure iowait sends none.
+    SchedulerLink mac(nullptr, 0);
+    Recorder four;
+    mac.setSend(four.send());
+    mac.setLoad({.cpuBusyMillicores = 1000, .cpuCores = 8, .memUsedBytes = gib, .memTotalBytes = 16 * gib});
+    mac.reportsWanted();
+    mac.tick(now);
+    assert(four.msgs.size() == 1 && four.msgs.at(0).report().has_cpu_busy_millicores());
+    assert(!four.msgs.at(0).report().has_cpu_iowait_millicores());
+}
