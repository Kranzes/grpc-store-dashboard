+// A builder's CPU and memory go to watchers with the next stats pass, busy
+// within its cores and in use within the total. A new session has none
+// until it reports, since it may come from a builder that sends none.
+void testLoad()
+{
+    Metrics metrics("");
+    Dispatcher disp({.defaultSystem = std::string(x86), .lookupThreads = 0}, metrics);
+    Session one;
+    sendOne(disp, one.worker, helloMsg("w1", 2));
+    auto const loadMsg = [](uint64_t busy, uint64_t used) -> rpc::WorkerMsg {
+        rpc::WorkerMsg msg;
+        auto * rep = msg.mutable_report();
+        rep->set_cpu_busy_millicores(busy);
+        rep->set_cpu_cores(4);
+        rep->set_mem_used_bytes(used);
+        rep->set_mem_total_bytes(2000);
+        return msg;
+    };
+    assert(!snapshot(disp).workers.at("w1").has_cpu_cores());
+    sendOne(disp, one.worker, loadMsg(9000, 3000));
+    auto const snap = snapshot(disp);
+    const auto & w1 = snap.workers.at("w1");
+    assert(w1.cpu_busy_millicores() == 4000 && w1.cpu_cores() == 4);
+    assert(w1.mem_used_bytes() == 2000 && w1.mem_total_bytes() == 2000);
+
+    Sink sink;
+    auto watcher = disp.watch(sink.send(), sink.end());
+    assert(watcher);
+    sendOne(disp, one.worker, loadMsg(1500, 500));
+    std::optional<rpc::WorkerState> later;
+    bool const heard = waitFor([&] -> bool {
+        for (const auto & event : sink.take()) {
+            later = event.has_worker() ? std::optional(event.worker()) : later;
+        }
+        return later && later->cpu_busy_millicores() == 1500; // after the snapshot's
+    });
+    assert(heard && later->mem_used_bytes() == 500);
+    disp.unwatch(*watcher);
+
+    // The builder reconnects: no load until its first report.
+    Session two;
+    sendOne(disp, two.worker, helloMsg("w1", 2));
+    auto const again = snapshot(disp);
+    const auto & back = again.workers.at("w1");
+    assert(back.up() && !back.has_cpu_busy_millicores() && !back.has_mem_total_bytes());
+}
