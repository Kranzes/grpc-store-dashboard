diff --git a/src/daemon/host-load.hh b/src/daemon/host-load.hh
new file mode 100644
index 0000000..f206304
--- /dev/null
+++ b/src/daemon/host-load.hh
@@ -0,0 +1,166 @@
+#pragma once
+// The host's CPU and memory as a builder reports them, read from /proc/stat
+// and /proc/meminfo. The figures are host-wide: every process on the host
+// counts, the builder's builds and anything else that runs there. A host
+// without those files, such as macOS, reports none.
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include <nix/util/error.hh>
+#include <nix/util/file-system.hh>
+
+namespace nixgrpc {
+
+// What a WorkerReport carries about the host.
+struct HostLoad
+{
+    uint64_t cpuBusyMillicores = 0; // CPUs busy since the last sample, in thousandths
+    uint32_t cpuCores = 0;          // online CPUs
+    uint64_t memUsedBytes = 0;      // MemTotal minus MemAvailable
+    uint64_t memTotalBytes = 0;
+};
+
+// Jiffies of all online CPUs together, from /proc/stat.
+struct CpuTimes
+{
+    uint64_t total = 0;
+    uint64_t idle = 0;  // idle and iowait
+    uint32_t cores = 0; // its cpuN lines: the online CPUs
+};
+
+// The "cpu" line adds up every online CPU: user nice system idle iowait irq
+// softirq steal, then guest and guest_nice, which user and nice already
+// include. nullopt when the line is missing or short.
+[[nodiscard]] inline auto parseProcStat(std::string_view text) -> std::optional<CpuTimes>
+{
+    constexpr int fields = 8;
+    constexpr int idleField = 3;
+    constexpr int iowaitField = 4;
+    std::optional<CpuTimes> out;
+    uint32_t cores = 0;
+    std::istringstream lines{std::string(text)};
+    for (std::string line; std::getline(lines, line);) {
+        if (!line.starts_with("cpu")) {
+            continue;
+        }
+        if (line.size() > 3 && std::isdigit(static_cast<unsigned char>(line.at(3))) != 0) {
+            cores++;
+            continue;
+        }
+        std::istringstream words(line.substr(3));
+        CpuTimes times;
+        int read = 0;
+        for (uint64_t val = 0; read < fields && words >> val; read++) {
+            times.total += val;
+            if (read == idleField || read == iowaitField) {
+                times.idle += val;
+            }
+        }
+        if (read == fields) {
+            out = times;
+        }
+    }
+    if (out) {
+        out->cores = cores;
+    }
+    return out;
+}
+
+// MemTotal and MemAvailable in bytes. nullopt without both.
+[[nodiscard]] inline auto parseMeminfo(std::string_view text) -> std::optional<std::pair<uint64_t, uint64_t>>
+{
+    constexpr uint64_t kib = 1024;
+    std::optional<uint64_t> total;
+    std::optional<uint64_t> available;
+    std::istringstream lines{std::string(text)};
+    for (std::string line; std::getline(lines, line);) {
+        std::istringstream words(line);
+        std::string key;
+        uint64_t val = 0;
+        if (!(words >> key >> val)) {
+            continue;
+        }
+        if (key == "MemTotal:") {
+            total = val * kib;
+        } else if (key == "MemAvailable:") {
+            available = val * kib;
+        }
+    }
+    if (!total || !available) {
+        return std::nullopt;
+    }
+    return std::pair{*total, std::min(*available, *total)};
+}
+
+// CPUs busy between two samples, in thousandths: the share of jiffies
+// neither idle nor iowait, times the online CPUs. nullopt when no time
+// passed or the counters went back.
+[[nodiscard]] inline auto busyMillicores(const CpuTimes & before, const CpuTimes & now) -> std::optional<uint64_t>
+{
+    if (now.total <= before.total) {
+        return std::nullopt;
+    }
+    auto const total = static_cast<double>(now.total - before.total);
+    // iowait can go back a little, so busy is clamped to the time that passed.
+    auto const busyBefore = static_cast<double>(before.total - std::min(before.idle, before.total));
+    auto const busyNow = static_cast<double>(now.total - std::min(now.idle, now.total));
+    auto const share = std::clamp((busyNow - busyBefore) / total, 0.0, 1.0);
+    constexpr double milli = 1000;
+    return static_cast<uint64_t>(std::llround(share * now.cores * milli));
+}
+
+// Samples the host once per call, from the serve loop.
+class HostLoadSampler
+{
+public:
+    explicit HostLoadSampler(std::string procDir = "/proc")
+        : procDir(std::move(procDir))
+    {
+    }
+
+    // The load since the last call. nullopt on the first call, and while a
+    // file cannot be read or parsed.
+    auto sample() -> std::optional<HostLoad>
+    {
+        auto const cpu = parseProcStat(read("stat"));
+        auto const mem = parseMeminfo(read("meminfo"));
+        auto const before = std::exchange(last, cpu);
+        if (!cpu || !mem || !before) {
+            return std::nullopt;
+        }
+        auto const busy = busyMillicores(*before, *cpu);
+        if (!busy) {
+            return std::nullopt;
+        }
+        return HostLoad{
+            .cpuBusyMillicores = *busy,
+            .cpuCores = cpu->cores,
+            .memUsedBytes = mem->first - mem->second,
+            .memTotalBytes = mem->first,
+        };
+    }
+
+private:
+    std::string procDir;
+    std::optional<CpuTimes> last;
+
+    // Empty where it cannot be read, which no parse accepts.
+    [[nodiscard]] auto read(std::string_view name) const -> std::string
+    {
+        try {
+            return nix::readFile(procDir + "/" + std::string(name));
+        } catch (nix::Error &) {
+            return {};
+        }
+    }
+};
+
+} // namespace nixgrpc
