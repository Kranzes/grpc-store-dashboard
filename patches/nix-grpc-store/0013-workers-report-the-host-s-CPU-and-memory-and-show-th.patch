diff --git a/src/daemon/host-load.hh b/src/daemon/host-load.hh
new file mode 100644
index 0000000..4842e99
--- /dev/null
+++ b/src/daemon/host-load.hh
@@ -0,0 +1,317 @@
+#pragma once
+// The host's CPU and memory as a builder reports them: from /proc/stat and
+// /proc/meminfo on Linux, from the Mach host statistics on macOS. The figures
+// are host-wide: every process on the host counts, the builder's builds and
+// anything else that runs there. Other hosts report none.
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include <nix/util/error.hh>
+#include <nix/util/file-system.hh>
+
+#ifdef __APPLE__
+#    include <mach/mach.h>
+#    include <mach/mach_host.h>
+#    include <mach/vm_page_size.h>
+#    include <sys/sysctl.h>
+#    include <sys/types.h>
+#endif
+
+namespace nixgrpc {
+
+// What a WorkerReport carries about the host. The CPU figures are averages
+// over the sampler's window, about the last minute; memory is as of now.
+struct HostLoad
+{
+    uint64_t cpuBusyMillicores = 0; // CPUs busy, in thousandths
+    // CPUs idle with I/O of theirs outstanding. nullopt where the host does
+    // not measure it, as on macOS.
+    std::optional<uint64_t> cpuIowaitMillicores;
+    uint32_t cpuCores = 0; // online CPUs
+    uint64_t memUsedBytes = 0;
+    uint64_t memTotalBytes = 0;
+};
+
+// CPU time of all online CPUs together, in the host's ticks.
+struct CpuTimes
+{
+    uint64_t total = 0;  // every state below, idle and steal included
+    uint64_t busy = 0;   // user, nice, system, irq and softirq
+    uint64_t iowait = 0; // idle with I/O outstanding
+    uint32_t cores = 0;  // the online CPUs
+};
+
+struct Memory
+{
+    uint64_t used = 0;
+    uint64_t total = 0;
+};
+
+// One read of the host. A part it cannot give is nullopt.
+struct HostReading
+{
+    std::optional<CpuTimes> cpu;
+    // The host measures iowait. False on macOS, which has none.
+    bool iowait = true;
+    std::optional<Memory> mem;
+};
+
+// The "cpu" line adds up every online CPU: user nice system idle iowait irq
+// softirq steal, then guest and guest_nice, which user and nice already
+// include. Steal, the time a hypervisor took, counts in the total only. Its
+// cpuN lines count the online CPUs. nullopt when the line is missing or
+// short.
+[[nodiscard]] inline auto parseProcStat(std::string_view text) -> std::optional<CpuTimes>
+{
+    constexpr int fields = 8;
+    constexpr int idleField = 3;
+    constexpr int iowaitField = 4;
+    constexpr int stealField = 7;
+    std::optional<CpuTimes> out;
+    uint32_t cores = 0;
+    std::istringstream lines{std::string(text)};
+    for (std::string line; std::getline(lines, line);) {
+        if (!line.starts_with("cpu")) {
+            continue;
+        }
+        if (line.size() > 3 && std::isdigit(static_cast<unsigned char>(line.at(3))) != 0) {
+            cores++;
+            continue;
+        }
+        std::istringstream words(line.substr(3));
+        CpuTimes times;
+        int read = 0;
+        for (uint64_t val = 0; read < fields && words >> val; read++) {
+            times.total += val;
+            if (read == iowaitField) {
+                times.iowait += val;
+            } else if (read != idleField && read != stealField) {
+                times.busy += val;
+            }
+        }
+        if (read == fields) {
+            out = times;
+        }
+    }
+    if (out) {
+        out->cores = cores;
+    }
+    return out;
+}
+
+// MemTotal and MemAvailable in bytes. nullopt without both.
+[[nodiscard]] inline auto parseMeminfo(std::string_view text) -> std::optional<std::pair<uint64_t, uint64_t>>
+{
+    constexpr uint64_t kib = 1024;
+    std::optional<uint64_t> total;
+    std::optional<uint64_t> available;
+    std::istringstream lines{std::string(text)};
+    for (std::string line; std::getline(lines, line);) {
+        std::istringstream words(line);
+        std::string key;
+        uint64_t val = 0;
+        if (!(words >> key >> val)) {
+            continue;
+        }
+        if (key == "MemTotal:") {
+            total = val * kib;
+        } else if (key == "MemAvailable:") {
+            available = val * kib;
+        }
+    }
+    if (!total || !available) {
+        return std::nullopt;
+    }
+    return std::pair{*total, std::min(*available, *total)};
+}
+
+// macOS's CPU ticks of all CPUs, as HOST_CPU_LOAD_INFO gives them.
+struct MachCpuTicks
+{
+    uint64_t user = 0;
+    uint64_t system = 0;
+    uint64_t idle = 0;
+    uint64_t nice = 0;
+};
+
+// macOS has no iowait: its idle time is all idle.
+[[nodiscard]] inline auto cpuTimesFromMach(const MachCpuTicks & ticks, uint32_t cores) -> CpuTimes
+{
+    auto const busy = ticks.user + ticks.system + ticks.nice;
+    return CpuTimes{.total = busy + ticks.idle, .busy = busy, .iowait = 0, .cores = cores};
+}
+
+// macOS's pages, as HOST_VM_INFO64 gives them, and their size.
+struct MachVmPages
+{
+    uint64_t active = 0;
+    uint64_t wired = 0;
+    uint64_t compressed = 0; // pages the compressor holds
+    uint64_t pageSize = 0;   // vm_kernel_page_size
+};
+
+// Memory in use as active, wired and compressed pages, which approximates
+// "Memory Used" in Activity Monitor; `total` is hw.memsize.
+[[nodiscard]] inline auto memoryFromMach(const MachVmPages & pages, uint64_t total) -> Memory
+{
+    auto const used = (pages.active + pages.wired + pages.compressed) * pages.pageSize;
+    return Memory{.used = std::min(used, total), .total = total};
+}
+
+using HostReader = std::function<HostReading()>;
+
+// Linux: /proc/stat and /proc/meminfo under procDir.
+[[nodiscard]] inline auto procReader(std::string procDir = "/proc") -> HostReader
+{
+    return [procDir = std::move(procDir)] -> HostReading {
+        // Empty where it cannot be read, which no parse accepts. The files
+        // report size 0, and readFile reads to the end.
+        auto const read = [&](std::string_view name) -> std::string {
+            try {
+                return nix::readFile(procDir + "/" + std::string(name));
+            } catch (nix::Error &) {
+                return {};
+            }
+        };
+        HostReading out{.cpu = parseProcStat(read("stat"))};
+        if (auto const mem = parseMeminfo(read("meminfo"))) {
+            out.mem = Memory{.used = mem->first - mem->second, .total = mem->first};
+        }
+        return out;
+    };
+}
+
+#ifdef __APPLE__
+// macOS: the Mach host statistics and sysctl.
+[[nodiscard]] inline auto machReader() -> HostReader
+{
+    return [] -> HostReading {
+        static const mach_port_t host = mach_host_self();
+        HostReading out{.iowait = false};
+        host_cpu_load_info_data_t load{};
+        mach_msg_type_number_t loadCount = HOST_CPU_LOAD_INFO_COUNT;
+        int cores = 0;
+        size_t coresLen = sizeof(cores);
+        if (host_statistics64(host, HOST_CPU_LOAD_INFO, reinterpret_cast<host_info64_t>(&load), &loadCount) == KERN_SUCCESS
+            && sysctlbyname("hw.logicalcpu", &cores, &coresLen, nullptr, 0) == 0 && cores > 0) {
+            out.cpu = cpuTimesFromMach(
+                {.user = load.cpu_ticks[CPU_STATE_USER],
+                 .system = load.cpu_ticks[CPU_STATE_SYSTEM],
+                 .idle = load.cpu_ticks[CPU_STATE_IDLE],
+                 .nice = load.cpu_ticks[CPU_STATE_NICE]},
+                static_cast<uint32_t>(cores));
+        }
+        vm_statistics64_data_t vm{};
+        mach_msg_type_number_t vmCount = HOST_VM_INFO64_COUNT;
+        uint64_t memsize = 0;
+        size_t memsizeLen = sizeof(memsize);
+        if (host_statistics64(host, HOST_VM_INFO64, reinterpret_cast<host_info64_t>(&vm), &vmCount) == KERN_SUCCESS
+            && sysctlbyname("hw.memsize", &memsize, &memsizeLen, nullptr, 0) == 0) {
+            out.mem = memoryFromMach(
+                {.active = vm.active_count,
+                 .wired = vm.wire_count,
+                 .compressed = vm.compressor_page_count,
+                 .pageSize = vm_kernel_page_size},
+                memsize);
+        }
+        return out;
+    };
+}
+#endif
+
+// The reader for the platform this runs on.
+[[nodiscard]] inline auto hostReader() -> HostReader
+{
+#ifdef __APPLE__
+    return machReader();
+#else
+    return procReader();
+#endif
+}
+
+// Shares of the CPU time between two samples.
+struct CpuShares
+{
+    double busy = 0;
+    double iowait = 0;
+};
+
+// nullopt when no time passed or the counters went back, as after a reboot
+// or when macOS's 32-bit tick counters wrap. iowait can go back a little; it
+// counts as none then.
+[[nodiscard]] inline auto cpuShares(const CpuTimes & before, const CpuTimes & now) -> std::optional<CpuShares>
+{
+    if (now.total <= before.total || now.busy < before.busy) {
+        return std::nullopt;
+    }
+    auto const total = static_cast<double>(now.total - before.total);
+    auto const iowait = now.iowait > before.iowait ? static_cast<double>(now.iowait - before.iowait) : 0.0;
+    return CpuShares{
+        .busy = std::clamp(static_cast<double>(now.busy - before.busy) / total, 0.0, 1.0),
+        .iowait = std::clamp(iowait / total, 0.0, 1.0),
+    };
+}
+
+// Samples the host once per call, from the serve loop, about once a second.
+class HostLoadSampler
+{
+public:
+    // The CPU figures average over this many calls: about a minute.
+    static constexpr size_t window = 60;
+
+    explicit HostLoadSampler(HostReader reader = hostReader())
+        : reader(std::move(reader))
+    {
+    }
+
+    // The load over the window, or over the calls so far while it fills.
+    // nullopt on the first call, and while the host cannot be read.
+    auto sample() -> std::optional<HostLoad>
+    {
+        auto const now = reader();
+        auto const & cpu = now.cpu;
+        if (!cpu || (!kept.empty() && cpu->total < kept.back().total)) {
+            kept.clear(); // unreadable, or the counters started over
+        }
+        if (!cpu) {
+            return std::nullopt;
+        }
+        kept.push_back(*cpu);
+        if (kept.size() > window + 1) {
+            kept.pop_front();
+        }
+        auto const shares = kept.size() > 1 ? cpuShares(kept.front(), kept.back()) : std::nullopt;
+        if (!shares || !now.mem) {
+            return std::nullopt;
+        }
+        constexpr double milli = 1000;
+        auto const millicores = [&](double share) -> uint64_t {
+            return static_cast<uint64_t>(std::llround(share * cpu->cores * milli));
+        };
+        return HostLoad{
+            .cpuBusyMillicores = millicores(shares->busy),
+            .cpuIowaitMillicores = now.iowait ? std::optional(millicores(shares->iowait)) : std::nullopt,
+            .cpuCores = cpu->cores,
+            .memUsedBytes = now.mem->used,
+            .memTotalBytes = now.mem->total,
+        };
+    }
+
+private:
+    HostReader reader;
+    // The last window + 1 samples, oldest first.
+    std::deque<CpuTimes> kept;
+};
+
