+#pragma once
+// A graph's counts on a Schedule stream of their own, for a build with
+// nothing left to schedule. See nix.remote.Graph.
+
+#include <chrono>
+#include <memory>
+
+#include <grpcpp/client_context.h>
+#include <grpcpp/support/status.h>
+#include <grpcpp/support/sync_stream.h>
+
+#include "nix_remote.grpc.pb.h"
+#include "nix_remote.pb.h"
+
+namespace nixgrpc {
+
+// Sends `graph` and half-closes; a scheduler that took it ends the stream.
+// Gives up once `deadline` passed: then the status is not OK and the counts
+// are lost, not retried. Blocks for `deadline` at most and never throws, so
+// the caller's build is not held up or failed by it.
+inline auto reportGraph(nix::remote::Scheduler::Stub & sched, grpc::ClientContext & ctx,
+                        const nix::remote::Graph & graph, std::chrono::milliseconds deadline) -> grpc::Status
+{
+    ctx.set_deadline(std::chrono::system_clock::now() + deadline);
+    std::unique_ptr<grpc::ClientReaderWriter<nix::remote::ClientMsgs, nix::remote::SchedMsgs>> stream =
+        sched.Schedule(&ctx);
+    nix::remote::ClientMsgs batch;
+    *batch.add_msgs()->mutable_graph() = graph;
+    if (stream->Write(batch)) {
+        stream->WritesDone();
+    }
+    // Finish wants what the scheduler sent read first, as a Restarting.
+    for (nix::remote::SchedMsgs ignored; stream->Read(&ignored);) {
+    }
+    return stream->Finish();
+}
+
+} // namespace nixgrpc
