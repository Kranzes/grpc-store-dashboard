diff --git a/tests/graph-report-test.cc b/tests/graph-report-test.cc
new file mode 100644
index 0000000..395305a
--- /dev/null
+++ b/tests/graph-report-test.cc
@@ -0,0 +1,157 @@
+// nixgrpc::reportGraph against an in-process scheduler. A fully cached build
+// sends its graph's counts this way before it returns, so a scheduler that
+// never answers must cost it GrpcStore::graphReportDeadline at most.
+
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <thread>
+#include <utility>
+
+#include <grpcpp/client_context.h>
+#include <grpcpp/create_channel.h>
+#include <grpcpp/security/credentials.h>
+#include <grpcpp/security/server_credentials.h>
+#include <grpcpp/server.h>
+#include <grpcpp/server_builder.h>
+#include <grpcpp/server_context.h>
+#include <grpcpp/support/status.h>
+#include <grpcpp/support/sync_stream.h>
+
+#include "graph-report.hh"
+#include "nix_remote.grpc.pb.h"
+#include "nix_remote.pb.h"
+#include "store.hh"
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+using std::chrono::milliseconds;
+using std::chrono::seconds;
+
+// Takes the counts. One that answers ends the stream once the client
+// half-closed, as the scheduler does; a hung one never ends it.
+class Scheduler final : public nix::remote::Scheduler::Service
+{
+public:
+    explicit Scheduler(bool answers)
+        : answers(answers)
+    {
+    }
+
+    [[nodiscard]] auto graphCount() const -> int { return graphs; }
+
+    auto Schedule(grpc::ServerContext * ctx,
+                  grpc::ServerReaderWriter<nix::remote::SchedMsgs, nix::remote::ClientMsgs> * stream)
+        -> grpc::Status override
+    {
+        for (nix::remote::ClientMsgs msgs; stream->Read(&msgs);) {
+            for (const auto & msg : msgs.msgs()) {
+                graphs += msg.has_graph() ? 1 : 0;
+            }
+        }
+        constexpr milliseconds poll{10};
+        while (!answers && !ctx->IsCancelled()) {
+            std::this_thread::sleep_for(poll);
+        }
+        return grpc::Status::OK;
+    }
+
+private:
+    bool answers;
+    std::atomic<int> graphs = 0;
+};
+
+struct Fixture
+{
+    Scheduler service;
+    std::unique_ptr<grpc::Server> server;
+    std::unique_ptr<nix::remote::Scheduler::Stub> stub;
+
+    explicit Fixture(bool answers)
+        : service(answers)
+    {
+        grpc::ServerBuilder builder;
+        int port = 0;
+        builder.AddListeningPort("127.0.0.1:0", grpc::InsecureServerCredentials(), &port);
+        builder.RegisterService(&service);
+        server = builder.BuildAndStart();
+        assert(server);
+        stub = nix::remote::Scheduler::NewStub(
+            grpc::CreateChannel("127.0.0.1:" + std::to_string(port), grpc::InsecureChannelCredentials()));
+    }
+
+    ~Fixture() { server->Shutdown(std::chrono::system_clock::now() + seconds{1}); }
+
+    Fixture(const Fixture &) = delete;
+    Fixture(Fixture &&) = delete;
+    auto operator=(const Fixture &) -> Fixture & = delete;
+    auto operator=(Fixture &&) -> Fixture & = delete;
+};
+
+struct Sent
+{
+    grpc::Status status;
+    Clock::duration took;
+};
+
+auto send(nix::remote::Scheduler::Stub & stub) -> Sent
+{
+    constexpr uint64_t drvs = 120;
+    constexpr uint64_t pruned = 100;
+    nix::remote::Graph graph;
+    graph.set_drvs(drvs);
+    graph.set_pruned_drvs(pruned);
+    grpc::ClientContext ctx;
+    auto const start = Clock::now();
+    auto status = nixgrpc::reportGraph(stub, ctx, graph, nix::GrpcStore::graphReportDeadline);
+    return {.status = std::move(status), .took = Clock::now() - start};
+}
+
+// Room for scheduling on a loaded test machine, well under another deadline.
+constexpr seconds margin{1};
+// Within a tick of the deadline.
+constexpr milliseconds early{100};
+
+void aHungSchedulerCostsTheDeadlineAtMost()
+{
+    Fixture fix(false);
+    auto const sent = send(*fix.stub);
+    assert(sent.status.error_code() == grpc::StatusCode::DEADLINE_EXCEEDED);
+    assert(sent.took >= nix::GrpcStore::graphReportDeadline - early);
+    assert(sent.took < nix::GrpcStore::graphReportDeadline + margin);
+    // The counts arrived; only the end of the stream never did.
+    assert(fix.service.graphCount() == 1);
+}
+
+void aSchedulerThatAnswersEndsTheReportAtOnce()
+{
+    Fixture fix(true);
+    auto const sent = send(*fix.stub);
+    assert(sent.status.ok());
+    assert(sent.took < margin);
+    assert(fix.service.graphCount() == 1);
+}
+
+void aSchedulerThatIsDownFailsTheReportAtOnce()
+{
+    // Nothing listens on port 1 of the loopback.
+    auto stub = nix::remote::Scheduler::NewStub(
+        grpc::CreateChannel("127.0.0.1:1", grpc::InsecureChannelCredentials()));
+    auto const sent = send(*stub);
+    assert(!sent.status.ok());
+    assert(sent.took < margin);
+}
+
+} // namespace
+
+auto main() -> int
+{
+    aHungSchedulerCostsTheDeadlineAtMost();
+    aSchedulerThatAnswersEndsTheReportAtOnce();
+    aSchedulerThatIsDownFailsTheReportAtOnce();
+    return 0;
+}
