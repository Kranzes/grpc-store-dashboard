+// The counts a client reports for its graph: the nodes it needed keys of, and
+// of those the held ones. Nothing below a held node is needed, so a cached
+// subtree counts once, as its top.
+void aCachedSubtreeCountsAsItsTop()
+{
+    // x builds on a's out and b's out, b on c's out, c on d's out.
+    Uses const uses{
+        {"x", {{"a", {"a-out"}}, {"b", {"b-out"}}}}, {"b", {{"c", {"c-out"}}}}, {"c", {{"d", {"d-out"}}}}, {"a", {}}, {"d", {}}};
+    auto const cached = runBuild(uses, {{"x", {"x-out"}}}, {"b-out", "c-out", "d-out"}, false);
+    assert((cached.missing == Names{"a", "x"}));
+    assert(cached.counts.considered == 3 && cached.counts.held == 1);
+    // All of it held: the root alone.
+    auto const warm = runBuild(uses, {{"x", {"x-out"}}}, {"x-out"}, false);
+    assert(warm.missing.empty() && warm.counts.considered == 1 && warm.counts.held == 1);
+    // None of it: every node, none held.
+    auto const cold = runBuild(uses, {{"x", {"x-out"}}}, {}, false);
+    assert(cold.counts.considered == 5 && cold.counts.held == 0);
+}
