+// Graph counts from every client add up in the counters, each capped and
+// with no more pruned than considered.
+void testGraphCounts()
+{
+    double now = 0;
+    Metrics metrics("");
+    Dispatcher disp(
+        {.defaultSystem = std::string(x86), .lookupThreads = 0, .nowMs = [&] -> double { return now; }}, metrics);
+    auto const graphMsg = [](uint64_t drvs, uint64_t pruned) -> rpc::ClientMsgs {
+        rpc::ClientMsgs msgs;
+        auto * graph = msgs.add_msgs()->mutable_graph();
+        graph->set_drvs(drvs);
+        graph->set_pruned_drvs(pruned);
+        return msgs;
+    };
+    auto const send = [](const rpc::SchedMsg &) -> bool { return true; };
+    auto const one = disp.connectClient(send, [] -> void {}, "ci");
+    auto const two = disp.connectClient(send, [] -> void {}, "alice");
+    disp.clientMsgs(one, graphMsg(100, 90));
+    disp.clientMsgs(two, graphMsg(40, 10));
+    // More pruned than considered: no more than considered.
+    disp.clientMsgs(two, graphMsg(5, 9));
+    Sink sink;
+    auto const watcher = disp.watch(sink.send(), sink.end());
+    assert(watcher);
+    now += 1000;
+    disp.tick();
+    std::optional<rpc::Counters> totals;
+    for (const auto & event : sink.take()) {
+        totals = event.has_stats() ? std::optional(event.stats().totals()) : totals;
+    }
+    disp.unwatch(*watcher);
+    assert(totals && totals->graph_drvs() == 145 && totals->graph_pruned_drvs() == 105);
+    // They carry no Wants: nothing is queued and nothing is looked up.
+    assert(totals->wanted() == 0 && totals->cache_hits() == 0 && totals->cache_misses() == 0);
+}
