+namespace {
+// What a client's walk counted, as the scheduler takes it. nullopt for a
+// walk that considered nothing, as for a single derivation without one.
+auto graphMsg(const nixgrpc::WalkCounts & graph) -> std::optional<remote::Graph> {
+  if (graph.considered == 0) {
+    return std::nullopt;
+  }
+  remote::Graph msg;
+  msg.set_drvs(graph.considered);
+  msg.set_pruned_drvs(graph.held);
+  return msg;
+}
+} // namespace
+
+void GrpcStore::reportGraph(const nixgrpc::WalkCounts & graph, const std::vector<DerivedPath> & reqs,
+                            Store & evalStore) {
+  auto const msg = graphMsg(graph);
+  if (!msg) {
+    return;
+  }
+  // Routed like the stream it would have had: by the first requested derivation.
+  auto const first = std::ranges::find_if(
+      reqs, [](const DerivedPath & req) -> bool { return std::holds_alternative<DerivedPath::Built>(req.raw()); });
+  if (first == reqs.end()) {
+    return;
+  }
+  const auto & built = std::get<DerivedPath::Built>(first->raw());
+  // Best effort: on any failure the counts are dropped and the build's own
+  // result stands.
+  std::string why;
+  try {
+    nixgrpc::Call call;
+    auto const drvPath = built.drvPath->getBaseStorePath();
+    addHeaders(call.ctx(), routingFor(basicForFarm(evalStore, drvPath, evalStore.readDerivation(drvPath))));
+    auto const status = nixgrpc::reportGraph(*sched, call.ctx(), *msg, graphReportDeadline);
+    if (status.ok()) {
+      return;
+    }
+    why = status.error_message();
+  } catch (Error & err) {
+    why = err.what();
+  }
+  debug("grpc: dropped the graph's counts (%d so far): %s", ++graphReportsDropped, why);
+}
+
+void GrpcStore::buildGraph(const std::vector<DerivedPath> & reqs, BuildMode buildMode, Store & evalStore,
+                           std::map<StorePath, Job> & jobs) {
+  nixgrpc::WalkCounts graph;
