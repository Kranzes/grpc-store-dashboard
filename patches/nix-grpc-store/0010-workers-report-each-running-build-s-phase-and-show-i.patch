+    // A stale assignment and a drv the worker does not run change nothing.
+    sendOne(disp, wkr.worker, progressMsg("p.drv", assignId + 7, "installPhase", 1000, 4000));
+    sendOne(disp, wkr.worker, progressMsg("q.drv", assignId, "installPhase", 1000, 4000));
+    std::this_thread::sleep_for(std::chrono::milliseconds(1200));
