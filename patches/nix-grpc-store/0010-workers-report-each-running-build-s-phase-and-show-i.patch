+// NOLINTNEXTLINE(bugprone-easily-swappable-parameters): as BuildProgress orders them.
+auto progressMsg(const std::string & path, uint64_t assignId, const std::string & phase, uint64_t started, uint64_t phaseStarted)
+    -> rpc::WorkerMsg
+{
+    rpc::WorkerMsg msg;
+    auto * run = msg.mutable_report()->add_builds();
+    run->set_drv_path(path);
+    run->set_assign_id(assignId);
+    run->set_phase(phase);
+    run->set_started_ms(started);
+    run->set_phase_started_ms(phaseStarted);
+    return msg;
+}
+
+// The assignment the worker was told to expect for `path`.
+auto expected(Session & session, const std::string & path) -> uint64_t
+{
+    const std::scoped_lock lock(session.mutex);
+    uint64_t assignId = 0;
+    for (const auto & cmd : session.cmds) {
+        if (cmd.has_expect() && cmd.expect().drv_path() == path) {
+            assignId = cmd.expect().assign_id();
+        }
+    }
+    return assignId;
+}
+
+// What builders report about running builds reaches watchers as
+// CAUSE_PROGRESS DrvStates, at most one per derivation and stats pass,
+// for the derivation's current assignment only.
+void testProgress()
+{
+    Metrics metrics("");
+    Dispatcher disp({.defaultSystem = std::string(x86), .lookupThreads = 0}, metrics);
+    Session wkr;
+    sendOne(disp, wkr.worker, helloMsg("w1", 4));
+    auto const client = disp.connectClient([](const rpc::SchedMsg &) -> bool { return true; }, [] -> void {}, "ci");
+    rpc::ClientMsgs wants;
+    wants.add_msgs()->mutable_want()->set_drv_path("p.drv");
+    disp.clientMsgs(client, wants);
+    auto const assignId = expected(wkr, "p.drv");
+    assert(assignId > 0);
+    Sink sink;
+    auto const watcher = disp.watch(sink.send(), sink.end());
+    assert(watcher);
+    sink.take();
+    auto const progress = [&] -> std::vector<rpc::DrvState> {
+        std::vector<rpc::DrvState> out;
+        for (const auto & event : sink.take()) {
+            if (event.has_drv() && event.drv().cause() == rpc::DrvState::CAUSE_PROGRESS) {
+                out.push_back(event.drv());
+            }
+        }
+        return out;
+    };
+    auto const waitProgress = [&](size_t count) -> std::vector<rpc::DrvState> {
+        std::vector<rpc::DrvState> seen;
+        waitFor([&] -> bool {
+            auto more = progress();
+            seen.insert(seen.end(), more.begin(), more.end());
+            return seen.size() >= count;
+        });
+        return seen;
+    };
+
+    // A report sets the start, the phase and its start on the assigned drv.
+    sendOne(disp, wkr.worker, progressMsg("p.drv", assignId, "", 1000, 0));
+    auto got = waitProgress(1);
+    assert(got.size() == 1 && got.front().build_started_ms() == 1000 && got.front().build_phase().empty());
+    assert(got.front().phase() == rpc::DrvState::PHASE_ASSIGNED && got.front().assign_id() == assignId);
+    // Two phase changes within a stats pass: one DrvState, with the last.
+    sendOne(disp, wkr.worker, progressMsg("p.drv", assignId, "configurePhase", 1000, 2000));
+    sendOne(disp, wkr.worker, progressMsg("p.drv", assignId, "buildPhase", 1000, 3000));
+    got = waitProgress(1);
+    std::this_thread::sleep_for(std::chrono::milliseconds(1200));
+    auto const late = progress();
+    got.insert(got.end(), late.begin(), late.end());
+    assert(got.size() == 1);
+    assert(got.front().build_phase() == "buildPhase" && got.front().build_phase_started_ms() == 3000);
+    assert(got.front().build_started_ms() == 1000);
+    // The same report again changes nothing.
