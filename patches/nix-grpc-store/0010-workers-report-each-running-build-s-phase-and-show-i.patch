diff --git a/proto/events.proto b/proto/events.proto
index 33ec6c1..2dfd6f6 100644
--- a/proto/events.proto
+++ b/proto/events.proto
@@ -56,7 +56,8 @@ message WatchEvent {
   // When the event happened, Unix ms: the scheduler's wall clock at process
   // start plus monotonic time since. It never goes backwards within one
   // instance and does not follow later system clock steps. Every *_ms field
-  // uses this clock.
+  // uses this clock, except the build start and phase times that builders
+  // report.
   uint64 time_ms = 2;
   oneof event {
     Reset reset = 3;
@@ -164,14 +165,17 @@ message ClientGone {
 }
 
 // A derivation the scheduler is tracking: queued or assigned. Upsert keyed by
-// drv_path. Removed by DrvGone.
+// drv_path. Removed by DrvGone. A CAUSE_PROGRESS update changes only
+// build_phase, build_started_ms and build_phase_started_ms, at most once a
+// second per derivation.
 message DrvState {
   enum Phase {
     PHASE_QUEUED = 0;
     // No connected worker offers its system and features. Still queued.
     PHASE_UNPLACEABLE = 1;
     // Sent to a worker. Covers the client's upload, input fetching, the
-    // build and publishing outputs: the scheduler does not see a build start.
+    // build and publishing outputs. The scheduler does not see a build
+    // start itself; builders that report it set build_started_ms.
     PHASE_ASSIGNED = 2;
   }
   // What made the scheduler send this update.
@@ -199,6 +203,8 @@ message DrvState {
     CAUSE_REQUEUED = 5;
     // `phase` switched between PHASE_QUEUED and PHASE_UNPLACEABLE.
     CAUSE_PLACEABILITY = 6;
+    // The builder reported a new phase or the start of the build.
+    CAUSE_PROGRESS = 7;
   }
   string drv_path = 1; // base name, "<hash>-<name>.drv"
   Phase phase = 2;
@@ -230,6 +236,15 @@ message DrvState {
   // inputs_unknown.
   repeated InputSource input_sources = 15;
   uint32 inputs_unknown = 16;
+  // ASSIGNED only, as the builder last reported them. Empty and 0 until
+  // then, and from builders that do not report them. The scheduler sees the
+  // assignment; these say when the build started on the builder (Unix ms,
+  // the builder's clock), its last stdenv phase, and when that began. A
+  // derivation with a buildCommand, a NixOS test included, never sets a
+  // phase.
+  string build_phase = 17;
+  uint64 build_started_ms = 18;
+  uint64 build_phase_started_ms = 19;
 }
 
 message InputSource {
diff --git a/proto/nix_remote.proto b/proto/nix_remote.proto
index 060d346..b8d39f5 100644
--- a/proto/nix_remote.proto
+++ b/proto/nix_remote.proto
@@ -413,6 +413,19 @@ message WorkerReport {
   // on this session or an earlier one, per substituter, only those with
   // traffic. At most 32.
   repeated Substituter substituters = 3;
+  // Running builds here whose phase or start changed since the last report;
+  // every running build in the first report of a session. A build that ends
+  // needs no entry: its Done tells the scheduler.
+  repeated BuildProgress builds = 4;
+}
+
+// What a builder knows about one running build that the scheduler does not.
+message BuildProgress {
+  string drv_path = 1;          // base name
+  uint64 assign_id = 2;
+  string phase = 3;             // the last setPhase, such as "buildPhase"; empty before the first
+  uint64 started_ms = 4;        // when the build started here, Unix ms
+  uint64 phase_started_ms = 5;  // when this node saw that setPhase; 0 with no phase
 }
 
 message WorkerMsg {
diff --git a/src/daemon/builder.cc b/src/daemon/builder.cc
index 930a338..e29c160 100644
--- a/src/daemon/builder.cc
+++ b/src/daemon/builder.cc
@@ -17,6 +17,7 @@
 #include "logfmt.hh"
 #include "metrics.hh"
 #include "nix_remote.pb.h"
+#include "scheduler-link.hh"
 #include "substituter-url.hh"
 
 namespace nixgrpc {
@@ -384,7 +385,34 @@ void Builder::tick()
     giveBack(
         takeUnclaimed([&](const Expected & ent) -> bool { return draining || now - ent.since > expectTimeout; }),
         draining ? nix::remote::Done::DRAINING : nix::remote::Done::UNREACHABLE);
-    link.tick(now);
+    link.tick(now, runningBuilds());
+}
+
+auto Builder::runningBuilds() const -> std::vector<RunningBuild>
+{
+    std::vector<std::pair<RunningBuild, std::shared_ptr<Expected::Shared>>> started;
+    {
+        auto lck = state.lock();
+        for (const auto & [drv, ent] : lck->expected) {
+            if (ent.running && ent.shared->progressVersion > 0) {
+                auto & run = started.emplace_back(RunningBuild{}, ent.shared).first;
+                run.progress.set_drv_path(drv);
+                run.progress.set_assign_id(ent.assignId);
+            }
+        }
+    }
+    // Takes each build's lock only after releasing the table's.
+    std::vector<RunningBuild> out;
+    out.reserve(started.size());
+    for (auto & [run, shared] : started) {
+        const std::scoped_lock lock(shared->mutex);
+        run.version = shared->progressVersion;
+        run.progress.set_started_ms(shared->startedMs);
+        run.progress.set_phase(shared->phase);
+        run.progress.set_phase_started_ms(shared->phaseStartedMs);
+        out.push_back(std::move(run));
+    }
+    return out;
 }
 
 } // namespace nixgrpc
