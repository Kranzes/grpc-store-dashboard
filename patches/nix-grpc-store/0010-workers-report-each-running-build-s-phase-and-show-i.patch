+    // Only the worker's own assignments. A phase name is short; a longer
+    // one is cut, then made valid UTF-8.
+    for (const auto & run : report.builds()) {
+        auto const phase = cleanUtf8(std::string_view(run.phase()).substr(0, maxPhaseLen));
