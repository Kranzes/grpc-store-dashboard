+void reportsCarryWhatChanged(nixgrpc::Metrics & metrics)
+{
+    using std::chrono::seconds;
+    Sent sent;
+    auto now = nixgrpc::Clock::now();
+    Builder builder(config([&] -> nixgrpc::Clock::time_point { return now; }), metrics);
+    builder.setSend(sent.send());
+    builder.reportsWanted();
+    auto const one = start(builder, "aaa-one.drv", 1, 1000);
+    auto const two = start(builder, "bbb-two.drv", 2, 2000);
+    // A buildCommand build never sets a phase: its start alone is reported.
+    auto const three = start(builder, "ccc-three.drv", 3, 3000);
+    one->logged(nixgrpc::SpillKind::phase, "unpackPhase");
+
+    // The first report of a session lists every running build.
+    builder.tick();
+    auto reports = sent.reports();
+    assert(reports.size() == 1 && reports.front().size() == 3);
+    assert(reports.front().at("aaa-one.drv").phase() == "unpackPhase");
+    assert(reports.front().at("aaa-one.drv").phase_started_ms() > 0);
+    assert(reports.front().at("aaa-one.drv").started_ms() == 1000);
+    assert(reports.front().at("ccc-three.drv").phase().empty());
+    assert(reports.front().at("ccc-three.drv").started_ms() == 3000);
+    assert(reports.front().at("ccc-three.drv").phase_started_ms() == 0);
+    assert(reports.front().at("bbb-two.drv").assign_id() == 2);
+
+    // Nothing changed: no report.
+    now += seconds(3);
+    builder.tick();
+    assert(sent.reports().empty());
+
+    // One build changed phase: a report with it alone, and the time it began.
+    auto const before = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                                  std::chrono::system_clock::now().time_since_epoch())
+                                                  .count());
+    two->logged(nixgrpc::SpillKind::phase, "buildPhase");
+    two->logged(nixgrpc::SpillKind::line, "a line is no change");
+    now += seconds(3);
+    builder.tick();
+    reports = sent.reports();
+    assert(reports.size() == 1 && reports.front().size() == 1);
+    assert(reports.front().at("bbb-two.drv").phase() == "buildPhase");
+    assert(reports.front().at("bbb-two.drv").phase_started_ms() >= before);
+
+    // Within 2 s of the last report it waits.
+    one->logged(nixgrpc::SpillKind::phase, "patchPhase");
+    now += seconds(1);
+    builder.tick();
+    assert(sent.reports().empty());
+    // A failed send keeps the change for the next report.
+    {
+        const std::scoped_lock lock(sent.mutex);
+        sent.failing = true;
+    }
+    now += seconds(2);
+    builder.tick();
+    {
+        const std::scoped_lock lock(sent.mutex);
+        sent.failing = false;
+    }
+    now += seconds(3);
+    builder.tick();
+    reports = sent.reports();
+    assert(reports.size() == 1 && reports.front().size() == 1);
+    assert(reports.front().at("aaa-one.drv").phase() == "patchPhase");
+
+    // A phase name is cut at a character boundary and made valid UTF-8,
+    // or the scheduler could not parse the report.
+    one->logged(nixgrpc::SpillKind::phase, std::string(63, 'p') + "\xC3\xA9Phase");
+    two->logged(nixgrpc::SpillKind::phase, "bad\xFF\xC3Phase");
+    now += seconds(3);
+    builder.tick();
+    {
+        const std::scoped_lock lock(sent.mutex);
+        assert(sent.msgs.size() == 1);
+        WorkerMsg parsed;
+        assert(parsed.ParseFromString(sent.msgs.front().SerializeAsString()));
+    }
+    reports = sent.reports();
+    assert(reports.size() == 1 && reports.front().size() == 2);
+    assert(reports.front().at("aaa-one.drv").phase() == std::string(63, 'p'));
+    assert(reports.front().at("bbb-two.drv").phase() == "bad\xEF\xBF\xBD\xEF\xBF\xBDPhase");
+
+    // A new session gets every running build again.
+    builder.setSend(sent.send());
+    builder.reportsWanted();
+    now += seconds(1);
+    builder.tick();
+    reports = sent.reports();
+    assert(reports.size() == 1 && reports.front().size() == 3);
+    (void) three;
+}
