+/// A node without the log answers from the farm's binary cache
+/// (--niks3-cache-url), here a server on 8090 that sends zstd as niks3 does,
+/// named with a user, a password and a query. It answers NOT_FOUND when the
+/// cache has none either or answers 403 as S3 does, and UNAVAILABLE, not
+/// DATA_LOSS, when the cache refuses the read, with none of the URL's
+/// credentials or query in the message.
+#[test]
+fn build_log_from_the_binary_cache() {
+    let base = log_drv(
+        "cached-grpc",
+        "i=0; while [ $i -lt 500 ]; do echo cached line $i; i=$((i+1)); done; echo > $out",
+    );
+    assert!(build_now(&cert_store("client"), "cached-grpc"));
+    let kept = kept_path(&base);
+    succeed(&[
+        "sh",
+        "-c",
+        r#"bzcat "$1.bz2" > /tmp/cached.want && mkdir -p /srv/cache/log && zstd -q < /tmp/cached.want > "/srv/cache/log/$2.zst" && mv "$1.bz2" /tmp/cached.bz2"#,
+        "sh",
+        &kept,
+        &base,
+    ]);
+    let tls = tls_args("client");
+    let call = |extra: &[&str]| {
+        let mut args = vec![base.as_str()];
+        args.extend(extra);
+        args.extend(strs(&tls));
+        build_log(&args)
+    };
+    let got = call(&["--out", "/tmp/cached.got"]);
+    assert_eq!(got.code(), 0, "{got:?}");
+    assert_eq!(got.get("source"), "cache", "{got:?}");
+    same_bytes("/tmp/cached.got", "/tmp/cached.want");
+    let part = call(&["--offset", "1234", "--out", "/tmp/cached.part"]);
+    assert!(part.code() == 0 && part.num("offset") == 1234, "{part:?}");
+    succeed(&["sh", "-c", "tail -c +1235 /tmp/cached.want | cmp - /tmp/cached.part"]);
+    let lines = succeed(&["sh", "-c", "head -c 1234 /tmp/cached.want | tr -cd '\\n' | wc -c"]);
+    assert_eq!(part.num("first_line"), lines.trim().parse::<u64>().unwrap(), "{part:?}");
+    // A derivation the cache does not know either.
+    let mut none = vec!["00000000000000000000000000000009-nowhere.drv"];
+    none.extend(strs(&tls));
+    let missing = build_log(&none);
+    assert_eq!(missing.code(), 5, "{missing:?}");
+    let mut denied = vec!["00000000000000000000000000000008-denied.drv"];
+    denied.extend(strs(&tls));
+    let refused = build_log(&denied);
+    assert_eq!(refused.code(), 14, "{refused:?}");
+    assert!(
+        refused.get("message").contains("cannot be read") && refused.num("has_info") == 0,
+        "{refused:?}"
+    );
+    let message = refused.get("message");
+    assert!(message.contains("http://127.0.0.1:8090/log/"), "{refused:?}");
+    assert!(!message.contains("hunter2") && !message.contains("priority"), "{refused:?}");
+    let mut forbidden = vec!["00000000000000000000000000000005-forbidden.drv"];
+    forbidden.extend(strs(&tls));
+    let unknown = build_log(&forbidden);
+    assert_eq!(unknown.code(), 5, "{unknown:?}");
+    succeed(&["sh", "-c", r#"mv /tmp/cached.bz2 "$1.bz2""#, "sh", &kept]);
+}
