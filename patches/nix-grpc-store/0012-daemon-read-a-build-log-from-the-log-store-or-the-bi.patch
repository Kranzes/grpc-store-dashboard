+
+// The answer of a call that could not start on a decode. When the source
+// has no such log or could not be read, `found` goes false: nothing was sent
+// yet, so the call may try the next source.
+auto notStarted(const grpc::Status & status, const std::string & name, bool & found) -> grpc::Status
+{
+    switch (status.error_code()) {
+    case grpc::StatusCode::NOT_FOUND:
+        found = false;
+        return grpc::Status::OK;
+    case grpc::StatusCode::UNAVAILABLE:
+        found = false;
+        return unreadableLog(name);
+    case grpc::StatusCode::DATA_LOSS:
+        return damagedLog(name);
+    default:
+        return status;
+    }
+}
