+auto BuildLogService::fromStores(Call & call, bool & found) -> grpc::Status
+{
+    std::string_view unreadableSource = "none";
+    grpc::Status unreadable;
+    auto const tried = [&](grpc::Status status) -> std::optional<grpc::Status> {
+        if (found) {
+            return status;
+        }
+        if (!status.ok() && unreadable.ok()) {
+            unreadableSource = call.source;
+            unreadable = std::move(status);
+        }
+        return std::nullopt;
+    };
+    if (config.storeLog) {
+        call.source = "store";
+        if (auto status = tried(fromStore(call, found))) {
+            return *status;
+        }
+    }
+    if (!config.cacheUrl.empty()) {
+        call.source = "cache";
+        if (auto status = tried(fromCache(call, found))) {
+            return *status;
+        }
+    }
+    call.source = unreadableSource;
+    found = !unreadable.ok();
+    return unreadable;
+}
