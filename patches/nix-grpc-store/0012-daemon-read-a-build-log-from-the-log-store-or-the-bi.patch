+// The binary cache's copy, `<url>/log/<drv>`, through Nix's file transfer,
+// so the node's netrc applies and a Content-Encoding is decoded. It goes
+// through the decode cache like a .bz2 kept log. HTTP 404 is no log, and so
+// is 403, as Nix takes it from a binary cache: S3 answers 403 for a key that
+// does not exist when the bucket cannot be listed.
+auto BuildLogService::fromCache(Call & call, bool & found) -> grpc::Status
+{
+    // The path goes before a query, which a substituter URL can have for
+    // Nix's store settings, such as ?priority=10.
+    auto const & cacheUrl = config.cacheUrl;
+    auto const query = std::min(cacheUrl.find_first_of("?#"), cacheUrl.size());
+    auto url = cacheUrl.substr(0, query);
+    while (url.ends_with('/')) {
+        url.pop_back();
+    }
+    url += "/log/" + call.request.drv_path() + cacheUrl.substr(query);
+    Decoding const how{
+        .key = "cache " + url,
+        // Messages go to watchers: no user, password or query.
+        .name = reduceSubstituterUrl(cacheUrl) + "/log/" + call.request.drv_path(),
+        .source = BuildLogInfo::SOURCE_CACHE,
+        .decode = [url](const LogCache::Write & write) -> LogCache::Decoded {
+            struct Stopped : std::exception
+            {
+            };
+            nix::LambdaSink sink([&](std::string_view data) -> void {
+                if (!write(data)) {
+                    throw Stopped{};
+                }
+            });
+            try {
+                nix::getFileTransfer()->download(nix::FileTransferRequest(nix::VerbatimURL(url)), sink);
+            } catch (Stopped &) {
+                return LogCache::Decoded::ok;
+            } catch (nix::FileTransferError & err) {
+                return err.error == nix::FileTransfer::NotFound || err.error == nix::FileTransfer::Forbidden
+                           ? LogCache::Decoded::missing
+                           : LogCache::Decoded::unavailable;
+            } catch (std::exception &) {
+                return LogCache::Decoded::unavailable;
+            }
+            return LogCache::Decoded::ok;
+        }};
+    return decoded(call, how, found);
+}
+
+// The farm's log store, read whole into memory (uploads are at most
+// 64 MiB), written to the decode cache, freed, and served from that cache.
+auto BuildLogService::fromStore(Call & call, bool & found) -> grpc::Status
+{
+    Decoding const how{
+        .key = "store " + call.request.drv_path(),
+        .name = "the log store's copy",
+        .source = BuildLogInfo::SOURCE_STORE,
+        .decode = [read = config.storeLog, drv = call.request.drv_path()](const LogCache::Write & write) -> LogCache::Decoded {
+            std::optional<std::string> log;
+            try {
+                log = read(drv);
+            } catch (std::exception &) {
+                return LogCache::Decoded::unavailable;
+            }
+            if (!log) {
+                return LogCache::Decoded::missing;
+            }
+            for (std::string_view rest = *log; !rest.empty(); rest.remove_prefix(std::min(rest.size(), readSize))) {
+                if (!write(rest.substr(0, readSize))) {
+                    break;
+                }
+            }
+            return LogCache::Decoded::ok;
+        }};
+    return decoded(call, how, found);
+}
