+namespace {
+
+// Who may read the scheduler's events: never anonymous callers, whatever
+// --allow-anonymous grants, because the events name clients and derivations.
+auto admit(const Auth & auth, const grpc::CallbackServerContext & context, std::string_view method)
+    -> std::expected<Caller, grpc::Status>
+{
+    auto caller = auth.identify(context);
+    if (caller.kind == Caller::Kind::anonymous) {
+        if (auth.metrics != nullptr) {
+            auth.metrics->countDenied(std::string(method), "anonymous");
+        }
+        logLine(
+            LogLevel::info,
+            {{"event", "denied"}, {"method", std::string(method)}, {"cn", caller.name}, {"role", "anonymous"}});
+        return std::unexpected(grpc::Status{
+            grpc::StatusCode::UNAUTHENTICATED, std::string(method) + " requires a TLS client certificate or bearer token"});
+    }
+    if (auto status = auth.authorize(caller, method, Role::watch); !status.ok()) {
+        return std::unexpected(std::move(status));
+    }
+    return caller;
+}
+
+// Writes prepared batches one after another, then OK.
+class BatchWriter final : public grpc::ServerWriteReactor<nix::remote::RecentBuildsBatch>
+{
+public:
+    BatchWriter(std::vector<nix::remote::RecentBuildsBatch> batches, std::function<void()> done)
+        : batches(std::move(batches))
+        , done(std::move(done))
+    {
+        next();
+    }
+
+    void OnWriteDone(bool isOk) override
+    {
+        if (!isOk) {
+            Finish({grpc::StatusCode::CANCELLED, "the client went away"});
+            return;
+        }
+        next();
+    }
+
+    void OnDone() override
+    {
+        done();
+        delete this; // NOLINT(cppcoreguidelines-owning-memory): created by EventsService::RecentBuilds
+    }
+
+private:
+    void next()
+    {
+        if (sent == batches.size()) {
+            Finish(grpc::Status::OK);
+            return;
+        }
+        StartWrite(&batches.at(sent++));
+    }
+
+    std::vector<nix::remote::RecentBuildsBatch> batches;
+    size_t sent = 0;
+    std::function<void()> done;
+};
+
+} // namespace
+
+auto EventsService::RecentBuilds(grpc::CallbackServerContext * context, const nix::remote::RecentBuildsRequest * request)
+    -> grpc::ServerWriteReactor<nix::remote::RecentBuildsBatch> *
+{
+    using Reject = RejectWriter<nix::remote::RecentBuildsBatch>;
+    if (!active_) {
+        return new Reject(WatchReactor::passive()); // NOLINT(cppcoreguidelines-owning-memory): deletes itself in OnDone
+    }
+    auto const admitted = admit(*auth, *context, "RecentBuilds");
+    if (!admitted) {
+        return new Reject(admitted.error()); // NOLINT(cppcoreguidelines-owning-memory)
+    }
+    const auto & caller = *admitted;
+    if (!recentCalls.acquire(caller.name)) {
+        return new Reject( // NOLINT(cppcoreguidelines-owning-memory)
+            {grpc::StatusCode::RESOURCE_EXHAUSTED, "too many RecentBuilds calls, for this caller or in all"});
+    }
+    auto release = [this, name = caller.name] -> void { recentCalls.release(name); };
+    auto answer = dispatcher->recentBuilds(*request);
+    if (!answer) {
+        release();
+        return new Reject(WatchReactor::passive()); // NOLINT(cppcoreguidelines-owning-memory)
+    }
+    // Copied out of the shared records, after the dispatcher's lock.
+    bool const withError = request->drv_paths_size() > 0 || (request->failed_only() && request->with_error());
+    std::vector<nix::remote::RecentBuildsBatch> batches(1);
+    for (const auto & record : answer->builds) {
+        if (batches.back().builds_size() == recentBatch) {
+            batches.emplace_back();
+        }
+        auto & out = *batches.back().add_builds();
+        out = *record;
+        if (!withError) {
+            out.clear_error();
+        }
+    }
+    batches.back().set_complete(answer->complete);
+    batches.back().set_oldest_ms(answer->oldestMs);
+    return new BatchWriter(std::move(batches), std::move(release)); // NOLINT(cppcoreguidelines-owning-memory)
+}
