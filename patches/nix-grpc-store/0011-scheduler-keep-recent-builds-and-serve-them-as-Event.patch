diff --git a/proto/events.proto b/proto/events.proto
index 2dfd6f6..3b377aa 100644
--- a/proto/events.proto
+++ b/proto/events.proto
@@ -42,10 +42,60 @@ package nix.remote;
 // Kept self-contained (no imports) so clients can vendor this one file.
 service Events {
   rpc Watch(WatchRequest) returns (stream WatchEvents);
+  // Builds that finished on a builder while this scheduler was active, newest
+  // first, in batches. Same role and anonymous rule as Watch. At most 4 calls
+  // per caller and 16 in all at once; RESOURCE_EXHAUSTED beyond that. A
+  // passive node answers UNAVAILABLE.
+  rpc RecentBuilds(RecentBuildsRequest) returns (stream RecentBuildsBatch);
 }
 
 message WatchRequest {}
 
+// The scheduler keeps two rings, both emptied when it becomes the active
+// scheduler: the last 10,000 builds that finished on a builder (BUILT,
+// FAILED, CANCELLED, and DROPPED after an assignment), without error text,
+// and the last 2,000 FAILED ones, with it.
+message RecentBuildsRequest {
+  // Only builds that finished before this, Unix ms. 0 = now.
+  uint64 before_ms = 1;
+  // At most this many, 0 = 256, capped at 1000; with with_error, capped at 256.
+  uint32 limit = 2;
+  // From the failures ring, which keeps failures longer than the builds ring.
+  bool failed_only = 3;
+  // Fill FinishedBuild.error. Only with failed_only.
+  bool with_error = 4;
+  // Only these derivations (base names, at most 16), the newest record of
+  // each, error included. before_ms, limit and failed_only are ignored.
+  repeated string drv_paths = 5;
+}
+
+message RecentBuildsBatch {
+  // At most 256 per batch.
+  repeated FinishedBuild builds = 1;
+  // Last batch only: the ring holds nothing older than the last row sent.
+  bool complete = 2;
+  // Last batch only: the oldest finish time the ring holds, 0 if empty.
+  uint64 oldest_ms = 3;
+}
+
+message FinishedBuild {
+  string drv_path = 1;
+  string system = 2;
+  string worker_addr = 3;
+  DrvGone.Outcome outcome = 4;
+  DrvGone.Status status = 5;
+  // FAILED, with with_error or drv_paths only: as DrvGone.error.
+  string error = 6;
+  uint64 assign_id = 7;
+  // 0 when unknown (adopted after a restart).
+  uint64 assigned_ms = 8;
+  // 0: the builder did not report it.
+  uint64 build_started_ms = 9;
+  uint64 finished_ms = 10;
+  // Identities of the clients that waited on it when it finished, at most 4.
+  repeated string requested_by = 11;
+}
+
 // Events are batched per stream message, like the scheduler's other streams.
 message WatchEvents {
   repeated WatchEvent msgs = 1;
