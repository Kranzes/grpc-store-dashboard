+// Workers of 50 slots each, for `capacity` builds at once. run() ends
+// builds named <tag><n> as `outcome` says.
+struct Builds
+{
+    static constexpr uint32_t slots = 50;
+    std::vector<std::unique_ptr<FakeWorker>> workers;
+
+    Builds(Farm & farm, size_t capacity)
+    {
+        for (size_t first = 0; first < capacity; first += slots) {
+            auto & wkr = *workers.emplace_back(std::make_unique<FakeWorker>());
+            rpc::WorkerMsgs hello;
+            auto * hel = hello.add_msgs()->mutable_hello();
+            hel->set_addr(std::format("w-{}:50051", first));
+            hel->add_systems("x86_64-linux");
+            hel->set_max_jobs(slots);
+            farm.disp.workerMsgs(wkr.worker, hello);
+        }
+    }
+
+    void run(Farm & farm, size_t count, std::string_view tag, const std::function<rpc::Done::Outcome(size_t)> & outcome)
+    {
+        auto const client = farm.client("ci-" + std::string(tag));
+        rpc::ClientMsgs wants;
+        for (size_t idx = 0; idx < count; idx++) {
+            wants.add_msgs()->mutable_want()->set_drv_path(std::format("{:032}-{}{}.drv", idx, tag, idx));
+        }
+        farm.disp.clientMsgs(client, wants);
+        for (auto & wkr : workers) {
+            rpc::WorkerMsgs dones;
+            const std::scoped_lock lock(wkr->mutex);
+            for (const auto & exp : std::exchange(wkr->expected, {})) {
+                auto const & path = exp.drv_path();
+                auto const out = outcome(static_cast<size_t>(std::stoull(path.substr(0, 32))));
+                auto * done = dones.add_msgs()->mutable_done();
+                done->set_drv_path(path);
+                done->set_assign_id(exp.assign_id());
+                done->set_outcome(out);
+                if (out == rpc::Done::FAILED) {
+                    done->set_status(rpc::Done::STATUS_PERMANENT_FAILURE);
+                    // About 3 KiB, so 256 of them fill more than a stream window.
+                    done->set_error("error: " + std::string(3000, 'x') + " " + path + " failed");
+                }
+            }
+            farm.disp.workerMsgs(wkr->worker, dones);
+        }
+    }
+};
+
+struct Recent
+{
+    grpc::ClientContext ctx;
+    std::unique_ptr<grpc::ClientReader<rpc::RecentBuildsBatch>> reader;
+    std::vector<rpc::RecentBuildsBatch> batches;
+
+    Recent(rpc::Events::Stub & stub, const rpc::RecentBuildsRequest & request)
+    {
+        ctx.set_deadline(std::chrono::system_clock::now() + std::chrono::seconds(20));
+        reader = stub.RecentBuilds(&ctx, request);
+    }
+
+    auto finish() -> grpc::Status
+    {
+        rpc::RecentBuildsBatch batch;
+        while (reader->Read(&batch)) {
+            batches.push_back(batch);
+        }
+        return reader->Finish();
+    }
+
+    [[nodiscard]] auto builds() const -> std::vector<rpc::FinishedBuild>
+    {
+        std::vector<rpc::FinishedBuild> out;
+        for (const auto & batch : batches) {
+            out.insert(out.end(), batch.builds().begin(), batch.builds().end());
+        }
+        return out;
+    }
+};
+
+// Events.RecentBuilds through the service: paging, the failures ring and
+// its text, drv_paths, the last batch's fields, and the service's checks.
+void testRecentBuilds()
+{
+    Farm farm;
+    std::optional<oidc::Verifier> verifier;
+    Tls const tls("dash-viewer");
+    Auth auth{.oidc = &verifier};
+    auth.acl.addRule(tls.name + "=watch");
+    auth.acl.allowAnonymous(Role::write);
+    IdleTracker idle;
+    EventsService service(farm.disp, auth, idle);
+    Server srv(service, tls);
+    auto const ask = [&](const rpc::RecentBuildsRequest & req) -> Recent * {
+        auto * call = new Recent(*srv.certStub, req);
+        assert(call->finish().ok());
+        return call;
+    };
+    // 1,200 builds, a quarter of them failed, in two rounds a few ms apart.
+    Builds pool(farm, 600);
+    auto const quarter = [](size_t idx) -> rpc::Done::Outcome {
+        return idx % 4 == 0 ? rpc::Done::FAILED : rpc::Done::BUILT;
+    };
+    pool.run(farm, 600, "a", quarter);
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    pool.run(farm, 600, "b", quarter);
+
+    // Newest first, 256 per batch, at most 1000; the last batch says more is left.
+    rpc::RecentBuildsRequest all;
+    all.set_limit(5000);
+    std::unique_ptr<Recent> first(ask(all));
+    auto rows = first->builds();
+    assert(rows.size() == 1000 && first->batches.size() == 4);
+    assert(first->batches.front().builds_size() == EventsService::recentBatch);
+    assert(!first->batches.back().complete() && first->batches.back().oldest_ms() > 0);
+    for (size_t idx = 1; idx < rows.size(); idx++) {
+        assert(rows.at(idx - 1).finished_ms() >= rows.at(idx).finished_ms());
+        assert(rows.at(idx).error().empty());
+    }
+    assert(rows.front().drv_path().contains("-b"));
+    // Paging by before_ms, here the oldest of the late round, reaches the
+    // oldest, and says so.
+    rpc::RecentBuildsRequest older;
+    older.set_before_ms(rows.at(599).finished_ms());
+    assert(rows.at(599).drv_path().contains("-b") && rows.at(600).drv_path().contains("-a"));
+    older.set_limit(1000);
+    std::unique_ptr<Recent> page(ask(older));
+    auto const rest = page->builds();
+    assert(rest.size() == 600 && page->batches.back().complete());
+    assert(page->batches.back().oldest_ms() == rest.back().finished_ms());
+    for (const auto & row : rest) {
+        assert(row.finished_ms() < older.before_ms() && row.drv_path().contains("-a"));
+    }
+    // The failures ring: text only with with_error, and then at most 256.
+    rpc::RecentBuildsRequest fails;
+    fails.set_failed_only(true);
+    fails.set_limit(1000);
+    std::unique_ptr<Recent> bare(ask(fails));
+    assert(bare->builds().size() == 300);
+    for (const auto & row : bare->builds()) {
+        assert(row.outcome() == rpc::DrvGone::FAILED && row.error().empty());
+    }
+    fails.set_with_error(true);
+    std::unique_ptr<Recent> texts(ask(fails));
+    assert(texts->builds().size() == 256);
+    for (const auto & row : texts->builds()) {
+        assert(row.error().ends_with(" failed") && row.status() == rpc::DrvGone::STATUS_PERMANENT_FAILURE);
+    }
+    // with_error needs failed_only.
+    all.set_with_error(true);
+    std::unique_ptr<Recent> noText(ask(all));
+    for (const auto & row : noText->builds()) {
+        assert(row.error().empty());
+    }
+    // drv_paths: the newest record of each, with its text.
+    rpc::RecentBuildsRequest some;
+    some.add_drv_paths(std::format("{:032}-a0.drv", 0));
+    some.add_drv_paths(std::format("{:032}-b1.drv", 1));
+    some.add_drv_paths("unknown.drv");
+    std::unique_ptr<Recent> named(ask(some));
+    auto const found = named->builds();
+    assert(found.size() == 2);
+    assert(found.at(0).outcome() == rpc::DrvGone::FAILED && found.at(0).error().ends_with(" failed"));
+    assert(found.at(1).outcome() == rpc::DrvGone::BUILT && found.at(1).worker_addr().starts_with("w-"));
+    assert(named->batches.back().complete());
+
+    // Anonymous callers are refused, as for Watch.
+    {
+        Recent anon(*srv.stub, all);
+        assert(anon.finish().error_code() == grpc::StatusCode::UNAUTHENTICATED);
+    }
+    // Four calls per caller, a fifth is refused. The calls write without
+    // waiting for the client, so the four are held inside the dispatcher: a
+    // watcher's send blocks while it holds the mutex.
+    std::mutex gate;
+    std::condition_variable opened;
+    bool blocking = false;
+    bool open = false;
+    auto const watcher = farm.disp.watch(
+        [&](rpc::WatchEvent && event) -> bool {
+            [[maybe_unused]] auto const dropped = std::move(event);
+            std::unique_lock lock(gate);
+            if (blocking) {
+                opened.wait(lock, [&] -> bool { return open; });
+            }
+            return true;
+        },
+        [] -> void {});
+    assert(watcher);
+    {
+        const std::scoped_lock lock(gate);
+        blocking = true;
+    }
+    std::thread holder([&] -> void {
+        rpc::ClientMsgs want;
+        want.add_msgs()->mutable_want()->set_drv_path("held.drv");
+        farm.disp.clientMsgs(farm.client("ci-held"), want);
+    });
+    std::vector<std::unique_ptr<Recent>> held;
+    std::vector<std::thread> readers;
+    held.reserve(EventsService::maxRecentCallsPerCaller);
+    readers.reserve(EventsService::maxRecentCallsPerCaller);
+    for (unsigned idx = 0; idx < EventsService::maxRecentCallsPerCaller; idx++) {
+        held.push_back(std::make_unique<Recent>(*srv.certStub, all));
+    }
+    for (auto & call : held) {
+        readers.emplace_back([&call] -> void { assert(call->finish().ok()); });
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(500));
+    {
+        Recent fifth(*srv.certStub, all);
+        assert(fifth.finish().error_code() == grpc::StatusCode::RESOURCE_EXHAUSTED);
+    }
+    // Freed, the four finish.
+    {
+        const std::scoped_lock lock(gate);
+        open = true;
+    }
+    opened.notify_all();
+    holder.join();
+    for (auto & reader : readers) {
+        reader.join();
+    }
+    farm.disp.unwatch(*watcher);
+    // A passive node answers UNAVAILABLE.
+    service.setActive(false);
+    {
+        Recent passive(*srv.certStub, all);
+        assert(passive.finish().error_code() == grpc::StatusCode::UNAVAILABLE);
+    }
+    srv.server->Shutdown(std::chrono::system_clock::now() + std::chrono::seconds(1));
+}
