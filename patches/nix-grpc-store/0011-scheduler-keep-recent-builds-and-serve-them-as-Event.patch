+// Runs `count` builds named <tag><n> on `wkr` (63 slots) and ends each as
+// `outcome(n)` says, in rounds of what the worker holds.
+void runBuilds(
+    Dispatcher & disp, Session & wkr, const Dispatcher::ClientPtr & client, const std::string & tag, size_t count,
+    const std::function<rpc::Done::Outcome(size_t)> & outcome)
+{
+    constexpr size_t round = 63;
+    for (size_t first = 0; first < count; first += round) {
+        rpc::ClientMsgs wants;
+        for (size_t idx = first; idx < std::min(count, first + round); idx++) {
+            wants.add_msgs()->mutable_want()->set_drv_path(std::format("{:032}-{}.drv", idx, tag));
+        }
+        disp.clientMsgs(client, wants);
+        std::vector<std::pair<std::string, uint64_t>> held;
+        {
+            const std::scoped_lock lock(wkr.mutex);
+            for (const auto & cmd : std::exchange(wkr.cmds, {})) {
+                if (cmd.has_expect()) {
+                    held.emplace_back(cmd.expect().drv_path(), cmd.expect().assign_id());
+                }
+            }
+        }
+        rpc::WorkerMsgs dones;
+        for (const auto & [path, assignId] : held) {
+            auto const idx = static_cast<size_t>(std::stoull(path.substr(0, 32)));
+            auto const out = outcome(idx);
+            *dones.add_msgs() = doneMsg(
+                path, assignId, out, out == rpc::Done::FAILED ? rpc::Done::STATUS_PERMANENT_FAILURE : rpc::Done::STATUS_BUILT,
+                out == rpc::Done::FAILED ? "error: builder failed\n" + path : "");
+        }
+        disp.workerMsgs(wkr.worker, dones);
+    }
+}
+
+auto recentOf(Dispatcher & disp, const std::vector<std::string> & paths) -> std::vector<rpc::FinishedBuild>
+{
+    rpc::RecentBuildsRequest req;
+    for (const auto & path : paths) {
+        req.add_drv_paths(path);
+    }
+    std::vector<rpc::FinishedBuild> out;
+    for (const auto & rec : disp.recentBuilds(req)->builds) {
+        out.push_back(*rec);
+    }
+    return out;
+}
+
+// The rings: every build that finished on a builder, and failures again
+// with their text, each capped, emptied by a new term.
+void testRecentBuilds()
+{
+    Metrics metrics("");
+    std::unordered_set<std::string> const present{"cached-out"};
+    Dispatcher disp(
+        {.defaultSystem = std::string(x86),
+         .present = [&](const std::vector<std::string> & keys) -> std::unordered_set<std::string> {
+             std::unordered_set<std::string> out;
+             for (const auto & key : keys) {
+                 if (present.contains(key)) {
+                     out.insert(key);
+                 }
+             }
+             return out;
+         },
+         .lookupThreads = 0},
+        metrics);
+    Session wkr;
+    sendOne(disp, wkr.worker, helloMsg("w1", 63));
+    auto const client = disp.connectClient([](const rpc::SchedMsg &) -> bool { return true; }, [] -> void {}, "ci");
+    // Every fourth fails: 10,500 builds, 2,625 failures.
+    constexpr size_t builds = 10500;
+    runBuilds(disp, wkr, client, "r", builds, [](size_t idx) -> rpc::Done::Outcome {
+        return idx % 4 == 0 ? rpc::Done::FAILED : rpc::Done::BUILT;
+    });
+    auto [all, failed] = disp.recentCounts();
+    assert(all == Dispatcher::recentBuildsKept && failed == Dispatcher::recentFailuresKept);
+    // The oldest went first.
+    assert(recentOf(disp, {std::format("{:032}-r.drv", 0)}).empty());
+    auto const kept = recentOf(disp, {std::format("{:032}-r.drv", builds - 1), std::format("{:032}-r.drv", builds - 4)});
+    assert(kept.size() == 2);
+    assert(kept.at(0).outcome() == rpc::DrvGone::BUILT && kept.at(0).error().empty());
+    assert(kept.at(1).outcome() == rpc::DrvGone::FAILED && kept.at(1).error().starts_with("error: builder failed"));
+    assert(kept.at(0).worker_addr() == "w1" && kept.at(0).assign_id() > 0 && kept.at(0).finished_ms() > 0);
+    assert(kept.at(0).assigned_ms() > 0 && kept.at(0).requested_by_size() == 1 && kept.at(0).requested_by(0) == "ci");
+    // A failure's record in the builds ring has no text; the failures ring's has.
+    rpc::RecentBuildsRequest newest;
+    newest.set_limit(10);
+    for (const auto & rec : disp.recentBuilds(newest)->builds) {
+        assert(rec->error().empty());
+    }
+    newest.set_failed_only(true);
+    auto const fails = disp.recentBuilds(newest)->builds;
+    assert(fails.size() == 10);
+    for (const auto & rec : fails) {
+        assert(rec->outcome() == rpc::DrvGone::FAILED && !rec->error().empty());
+    }
+
+    // Cache hits and queued drops do not enter the rings.
+    rpc::ClientMsgs other;
+    auto * hit = other.add_msgs()->mutable_want();
+    hit->set_drv_path("hit.drv");
+    hit->add_out_keys("cached-out");
+    auto * queued = other.add_msgs()->mutable_want();
+    queued->set_drv_path("nowhere.drv");
+    queued->set_system("riscv64-linux");
+    disp.clientMsgs(client, other);
+    rpc::ClientMsgs cancel;
+    cancel.add_msgs()->mutable_cancel()->set_drv_path("nowhere.drv");
+    disp.clientMsgs(client, cancel);
+    assert(disp.recentCounts() == std::pair(all, failed));
+    assert(recentOf(disp, {"hit.drv", "nowhere.drv"}).empty());
+
+    // requested_by keeps at most 4 distinct identities.
+    std::vector<Dispatcher::ClientPtr> waiting;
+    for (int idx = 0; idx < 6; idx++) {
+        waiting.push_back(disp.connectClient(
+            [](const rpc::SchedMsg &) -> bool { return true; }, [] -> void {}, "user-" + std::to_string(idx % 5)));
+        rpc::ClientMsgs want;
+        want.add_msgs()->mutable_want()->set_drv_path("shared.drv");
+        disp.clientMsgs(waiting.back(), want);
+    }
+    sendOne(disp, wkr.worker, doneMsg("shared.drv", wkr.assignId("shared.drv"), rpc::Done::BUILT, rpc::Done::STATUS_BUILT));
+    auto const shared = recentOf(disp, {"shared.drv"});
+    assert(shared.size() == 1 && shared.front().requested_by_size() == 4);
+    std::set<std::string> const names(shared.front().requested_by().begin(), shared.front().requested_by().end());
+    assert(names.size() == 4);
+
+    // A new term starts empty.
+    disp.restarting();
+    disp.serving();
+    assert(disp.recentCounts() == std::pair(size_t{0}, size_t{0}));
+}
