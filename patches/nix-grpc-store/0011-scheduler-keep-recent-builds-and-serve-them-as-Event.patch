+auto Dispatcher::assignmentLocked(const sched::Entry & ent) const -> Assignment
+{
+    Assignment out{
+        .assignId = ent.assignId, .assignMs = ent.assignMs, .buildStartedMs = ent.buildStartedMs, .system = ent.system};
+    for (auto const cid : ent.followers) {
+        if (out.requestedBy.size() >= maxRequestedBy) {
+            break;
+        }
+        if (auto const client = clients.find(cid);
+            client != clients.end() && !std::ranges::contains(out.requestedBy, client->second->identity)) {
+            out.requestedBy.push_back(client->second->identity);
+        }
+    }
+    return out;
+}
+
+void Dispatcher::rememberLocked(
+    const std::string & drvPath, DrvGone::Outcome outcome, sched::WorkerId wid, const Done * done,
+    const Assignment & assignment, const std::string & error)
+{
+    auto record = std::make_shared<nix::remote::FinishedBuild>();
+    record->set_drv_path(drvPath);
+    record->set_system(assignment.system);
+    record->set_worker_addr(core.worker(wid).addr);
+    record->set_outcome(outcome);
+    if (done != nullptr && DrvGone::Status_IsValid(done->status())) {
+        record->set_status(static_cast<DrvGone::Status>(done->status()));
+    }
+    record->set_assign_id(assignment.assignId);
+    record->set_assigned_ms(assignment.assignMs > 0 ? wallMs(assignment.assignMs) : 0);
+    record->set_build_started_ms(assignment.buildStartedMs);
+    record->set_finished_ms(wallMs(nowMs()));
+    for (const auto & identity : assignment.requestedBy) {
+        record->add_requested_by(identity);
+    }
+    // The builds ring never holds text, so it keeps none alive past the
+    // failures ring.
+    if (outcome == DrvGone::FAILED) {
+        auto failed = std::make_shared<nix::remote::FinishedBuild>(*record);
+        failed->set_error(error);
+        recentFailed.push_back(std::move(failed));
+        if (recentFailed.size() > recentFailuresKept) {
+            recentFailed.pop_front();
+        }
+    }
+    recentAll.push_back(std::move(record));
+    if (recentAll.size() > recentBuildsKept) {
+        recentAll.pop_front();
+    }
+    metrics.schedRecentBuilds(recentAll.size(), recentFailed.size());
+}
+
+auto Dispatcher::recentCounts() -> std::pair<size_t, size_t>
+{
+    const Lock lock(*this);
+    return {recentAll.size(), recentFailed.size()};
+}
+
+auto Dispatcher::recentBuilds(const nix::remote::RecentBuildsRequest & request) -> std::optional<RecentAnswer>
+{
+    static constexpr uint32_t defaultLimit = 256;
+    static constexpr uint32_t maxLimit = 1000;
+    static constexpr uint32_t maxWithError = 256;
+    static constexpr int maxPaths = 16;
+    const Lock lock(*this);
+    if (lettingGo) {
+        return std::nullopt;
+    }
+    RecentAnswer answer;
+    if (request.drv_paths_size() > 0) {
+        // The newest record of each, from the failures ring first, which
+        // holds the text.
+        for (int idx = 0; idx < std::min(request.drv_paths_size(), maxPaths); idx++) {
+            const auto & path = request.drv_paths(idx);
+            auto const newest = [&](const auto & ring) -> std::shared_ptr<const nix::remote::FinishedBuild> {
+                auto const found = std::ranges::find_if(
+                    ring.rbegin(), ring.rend(), [&](const auto & rec) -> bool { return rec->drv_path() == path; });
+                return found == ring.rend() ? nullptr : *found;
+            };
+            auto record = newest(recentFailed);
+            auto const any = newest(recentAll);
+            // A newer build of it that did not fail wins.
+            if (!record || (any && any->finished_ms() > record->finished_ms())) {
+                record = any;
+            }
+            if (record) {
+                answer.builds.push_back(std::move(record));
+            }
+        }
+        answer.complete = true;
+        return answer;
+    }
+    const auto & ring = request.failed_only() ? recentFailed : recentAll;
+    auto limit = request.limit() == 0 ? defaultLimit : std::min(request.limit(), maxLimit);
+    if (request.with_error()) {
+        limit = std::min(limit, maxWithError);
+    }
+    auto iter = ring.rbegin();
+    if (request.before_ms() != 0) {
+        // Records go in as builds end, and finished_ms comes from a steady
+        // clock, so each ring is in order.
+        iter = std::make_reverse_iterator(std::ranges::partition_point(
+            ring, [&](const auto & rec) -> bool { return rec->finished_ms() < request.before_ms(); }));
+    }
+    for (; iter != ring.rend() && answer.builds.size() < limit; ++iter) {
+        answer.builds.push_back(*iter);
+    }
+    answer.complete = iter == ring.rend();
+    answer.oldestMs = ring.empty() ? 0 : ring.front()->finished_ms();
+    return answer;
+}
