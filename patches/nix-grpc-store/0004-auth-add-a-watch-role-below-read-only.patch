--- a/tests/oidc-test.cc
+++ b/tests/oidc-test.cc
@@ -231,7 +231,8 @@ auto writeConfig(const std::string & dir, const std::string & base) -> void
                  {{{"bound_subject", {"repo:myorg/*"}}, {"scopes", {"write"}}},
                   {{"bound_claims", {{"repository_owner", {"myorg"}}, {"ref", {"refs/heads/main"}}}},
                    {"scopes", {"admin"}}},
-                  {{"bound_claims", {{"groups", {"readers"}}}}, {"scopes", {"read"}}}}}}},
+                  {{"bound_claims", {{"groups", {"readers"}}}}, {"scopes", {"read"}}},
+                  {{"bound_claims", {{"groups", {"watchers"}}}}, {"scopes", {"watch"}}}}}}},
               // The same issuer, for clients that ask for another audience.
               {"mirror",
                {{"issuer", base},
@@ -259,6 +260,10 @@ auto run(const std::string & dir, const std::string & base) -> int
     nix::writeFile(dir + "/sa-token", ecKey.sign({{"iss", "https://kubernetes.default.svc"}, {"sub", "x"}}));
     writeConfig(dir, base);
 
+    // A rule's role is the highest of its scopes, starting from watch.
+    check(nixgrpc::oidc::ruleFrom(Json{{"scopes", {"watch"}}}).role == Role::watch, "scopes [watch] -> watch");
+    check(nixgrpc::oidc::ruleFrom(Json{{"scopes", {"watch", "read"}}}).role == Role::readOnly, "[watch, read] -> read-only");
+
     // Issuer serves nothing yet: config loads, verifier constructs, tokens are refused.
     auto const cfg = loadConfig(dir + "/oidc.json");
     check(cfg.providers.size() == 3, "three providers, two of one issuer");
@@ -325,6 +330,12 @@ auto run(const std::string & dir, const std::string & base) -> int
         auto res = verifier.verify(pssKey.sign(claims({{"sub", "someone"}, {"groups", {"other", "readers"}}})));
         check(res.identity && res.identity->role == Role::readOnly, "PS256 array claim -> read-only");
     }
+    {
+        auto res = verifier.verify(ecKey.sign(claims({{"sub", "someone"}, {"groups", {"watchers"}}})));
+        check(res.identity && res.identity->role == Role::watch, "watch scope -> watch");
+        res = verifier.verify(ecKey.sign(claims({{"sub", "someone"}, {"groups", {"watchers", "readers"}}})));
+        check(res.identity && res.identity->role == Role::readOnly, "watch and read rules -> read-only");
+    }
     {
         auto res = verifier.verify(edKey.sign(good));
         check(res.identity && res.identity->role == Role::write, "EdDSA");
