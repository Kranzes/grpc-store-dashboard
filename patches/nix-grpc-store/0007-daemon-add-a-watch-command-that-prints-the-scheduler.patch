--- /dev/null
+++ b/src/daemon/watch-command.hh
@@ -0,0 +1,30 @@
+#pragma once
+// nix-grpc-daemon watch: prints the scheduler's events (Events.Watch,
+// proto/events.proto) as JSON lines, for scripts and as a small client of
+// the stream.
+
+#include <functional>
+#include <string_view>
+#include <vector>
+
+#include <grpcpp/support/status.h>
+
+#include "options.hh"
+
+namespace nixgrpc {
+
+// The flags after `watch` (args[0]). The scheduler is reached as a builder
+// reaches it: --scheduler, --scheduler-token-file, --tls-cert, --tls-key and
+// --client-ca. --json is required, so that another format can be the default
+// later without breaking scripts.
+auto parseWatchOptions(const std::vector<std::string_view> & args) -> Options;
+
+// Prints each event as one line of protobuf JSON until the stream ends, one
+// call per batch the scheduler sends, and returns how the stream ended.
+auto watchEvents(const Options & options, const std::function<void(std::string_view lines)> & print) -> grpc::Status;
+
+// `nix-grpc-daemon watch ...`, args[0] being "watch": the events on stdout,
+// the status the stream ended with on stderr. Returns the exit code.
+auto watchCommand(const std::vector<std::string_view> & args) -> int;
+
+} // namespace nixgrpc
diff --git a/src/keepalive.hh b/src/keepalive.hh
index 31ee99c..f86f480 100644
--- a/src/keepalive.hh
+++ b/src/keepalive.hh
@@ -3,9 +3,20 @@
 // Server-side GRPC_ARG_HTTP2_MIN_RECV_PING_INTERVAL_WITHOUT_DATA_MS must stay below the time.
 // Set GRPC_ARG_HTTP2_MAX_PINGS_WITHOUT_DATA to 0 too: by default pings stop after two on a silent stream.
 
+#include <grpc/impl/channel_arg_names.h>
+#include <grpcpp/support/channel_arguments.h>
+
 namespace nixgrpc {
 
 constexpr int kKeepaliveTimeMs = 20'000;
 constexpr int kKeepaliveTimeoutMs = 20'000;
 
+// All three on a client channel.
+inline void setKeepalive(grpc::ChannelArguments & args)
+{
+    args.SetInt(GRPC_ARG_KEEPALIVE_TIME_MS, kKeepaliveTimeMs);
+    args.SetInt(GRPC_ARG_KEEPALIVE_TIMEOUT_MS, kKeepaliveTimeoutMs);
+    args.SetInt(GRPC_ARG_HTTP2_MAX_PINGS_WITHOUT_DATA, 0);
