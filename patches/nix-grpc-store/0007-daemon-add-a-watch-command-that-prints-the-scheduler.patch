+#!/bin/sh
+# `nix-grpc-daemon watch` checks its flags and dials the scheduler without
+# any of the daemon's setup, and says on stderr how the stream ended.
+set -eu
+daemon=$1
+if out=$("$daemon" watch --scheduler 127.0.0.1:1 2>&1); then
+  echo "watch without --json succeeded" >&2
+  exit 1
+fi
+echo "$out" | grep -q -- '--json is required' || { echo "$out" >&2; exit 1; }
+if out=$("$daemon" watch --json --scheduler http://127.0.0.1:1 2>&1); then
+  echo "watch with nothing listening succeeded" >&2
+  exit 1
+fi
+echo "$out" | grep -q '^nix-grpc-daemon watch: UNAVAILABLE: ' || { echo "$out" >&2; exit 1; }
