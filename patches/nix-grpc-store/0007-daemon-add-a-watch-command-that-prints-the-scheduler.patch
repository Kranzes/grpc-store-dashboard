new file mode 100644
index 0000000..5c419ee
--- /dev/null
+++ b/src/daemon/watch-command.cc
@@ -0,0 +1,138 @@
+// nix-grpc-daemon watch: Events.Watch as JSON lines.
+
+#include "watch-command.hh"
+
+#include <cstddef>
+#include <functional>
+#include <iostream>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include <absl/status/status.h>
+#include <google/protobuf/util/json_util.h>
+#include <grpcpp/client_context.h>
+#include <grpcpp/create_channel.h>
+#include <grpcpp/support/channel_arguments.h>
+#include <grpcpp/support/status.h>
+
+#include <nix/util/error.hh>
+
+#include "client/channel.hh"
+#include "events.grpc.pb.h"
+#include "events.pb.h"
+#include "keepalive.hh"
+#include "options.hh"
+
+namespace nixgrpc {
+
+auto parseWatchOptions(const std::vector<std::string_view> & args) -> Options
+{
+    Options options;
+    bool json = false;
+    for (size_t idx = 1; idx < args.size(); ++idx) {
+        // Also `--flag=value`, as for the daemon.
+        std::string_view arg = args.at(idx);
+        std::optional<std::string_view> inlineValue;
+        if (auto const sep = arg.find('='); arg.starts_with("--") && sep != std::string_view::npos) {
+            inlineValue = arg.substr(sep + 1);
+            arg = arg.substr(0, sep);
+        }
+        auto const next = [&] -> std::string_view {
+            if (inlineValue) {
+                return *std::exchange(inlineValue, std::nullopt);
+            }
+            if (++idx >= args.size()) {
+                throw nix::Error("watch: flag '%s' requires an argument", arg);
+            }
+            return args.at(idx);
+        };
+        if (arg == "--json") {
+            json = true;
+        } else if (arg == "--scheduler") {
+            options.schedulerAddr = next();
+        } else if (arg == "--scheduler-token-file") {
+            options.schedulerTokenFile = next();
+        } else if (arg == "--tls-cert") {
+            options.tlsCert = next();
+        } else if (arg == "--tls-key") {
+            options.tlsKey = next();
+        } else if (arg == "--client-ca") {
+            options.clientCA = next();
+        } else {
+            throw nix::Error("watch: unknown flag '%s'", arg);
+        }
+    }
+    if (!json) {
+        throw nix::Error("watch: --json is required, it is the only output format so far");
+    }
+    if (options.schedulerAddr.empty()) {
+        throw nix::Error("watch: --scheduler is required");
+    }
+    if (!options.schedulerTokenFile.empty() && options.schedulerAddr.starts_with(plaintextScheme)) {
+        throw nix::Error("watch: --scheduler-token-file with --scheduler http:// would send the token in clear");
+    }
+    if (options.tlsCert.empty() != options.tlsKey.empty()) {
+        throw nix::Error("watch: --tls-cert and --tls-key go together");
+    }
+    return options;
+}
+
+auto watchEvents(const Options & options, const std::function<void(std::string_view lines)> & print) -> grpc::Status
+{
+    auto const target = schedulerTarget(options);
+    grpc::ChannelArguments args;
+    // A batch holds up to 1024 events, and a drv with many followers or
+    // inputs makes a large one.
+    args.SetMaxReceiveMessageSize(-1);
+    // The stream has no deadline: notice a scheduler that vanished without
+    // a FIN instead of waiting on it forever, as builders do.
+    setKeepalive(args);
+    auto const stub
+        = nix::remote::Events::NewStub(grpc::CreateCustomChannel(target, makeSchedulerCredentials(options), args));
+    grpc::ClientContext ctx;
+    auto const reader = stub->Watch(&ctx, nix::remote::WatchRequest{});
+    google::protobuf::util::JsonPrintOptions json;
+    // Zero values mean something here: PHASE_QUEUED, CAUSE_SNAPSHOT, BUILT.
+    json.always_print_fields_with_no_presence = true;
+    nix::remote::WatchEvents batch;
+    std::string lines;
+    std::string line;
+    while (reader->Read(&batch)) {
+        lines.clear();
+        for (const auto & event : batch.msgs()) {
+            line.clear();
+            if (auto const status = google::protobuf::util::MessageToJsonString(event, &line, json); !status.ok()) {
+                ctx.TryCancel();
+                static_cast<void>(reader->Finish());
+                return {grpc::StatusCode::INTERNAL, "printing an event as JSON: " + std::string(status.message())};
+            }
+            lines += line;
+            lines += '\n';
+        }
+        print(lines);
+    }
+    return reader->Finish();
+}
+
+auto watchCommand(const std::vector<std::string_view> & args) -> int
+{
+    // A short-lived TLS client, as `nix` with the plugin is: let gRPC's
+    // threads free the channel before OpenSSL's exit handlers run.
+    retainGrpcRuntime();
+    auto const status = watchEvents(parseWatchOptions(args), [](std::string_view lines) -> void {
+        std::cout << lines << std::flush;
+    });
+    if (status.ok()) {
+        return 0;
+    }
+    // grpc::StatusCode has the same values as absl::StatusCode.
+    std::cerr << "nix-grpc-daemon watch: "
+              << absl::StatusCodeToString(static_cast<absl::StatusCode>(status.error_code())) << ": "
+              << status.error_message() << "\n";
+    return 1;
+}
+
+} // namespace nixgrpc
