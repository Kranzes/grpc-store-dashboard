+// What `nix-grpc-daemon watch` printed, line by line, handed over from the
+// thread it runs on.
+struct Printed
+{
+    std::mutex mutex;
+    std::condition_variable changed;
+    std::vector<Json> lines;
+
+    auto print() -> std::function<void(std::string_view)>
+    {
+        return [this](std::string_view text) -> void {
+            const std::scoped_lock lock(mutex);
+            while (!text.empty()) {
+                auto const end = text.find('\n');
+                assert(end != std::string_view::npos); // every line ends
+                auto const line = text.substr(0, end);
+                // protobuf's JSON mapping, so it reads back into the message.
+                rpc::WatchEvent event;
+                assert(google::protobuf::util::JsonStringToMessage(line, &event).ok());
+                lines.push_back(Json::parse(line));
+                text.remove_prefix(end + 1);
+            }
+            changed.notify_all();
+        };
+    }
+
+    auto waitFor(const std::function<bool(const Json &)> & found) -> bool
+    {
+        std::unique_lock lock(mutex);
+        return changed.wait_for(lock, std::chrono::seconds(10), [&] -> bool { return std::ranges::any_of(lines, found); });
+    }
+};
+
+// `watch` takes only its own flags and refuses any that cannot work together.
+void testWatchFlags()
+{
+    auto const refused = [](const std::vector<std::string_view> & args, std::string_view why) -> bool {
+        try {
+            static_cast<void>(parseWatchOptions(args));
+        } catch (nix::Error & err) {
+            return std::string_view(err.what()).contains(why);
+        }
+        return false;
+    };
+    assert(refused({"watch", "--scheduler", "sched:50051"}, "--json is required"));
+    assert(refused({"watch", "--json"}, "--scheduler is required"));
+    assert(refused({"watch", "--json", "--scheduler", "http://sched:50051", "--scheduler-token-file", "t"}, "in clear"));
+    assert(refused({"watch", "--json", "--scheduler", "sched:50051", "--tls-cert", "c.pem"}, "go together"));
+    assert(refused({"watch", "--json", "--scheduler"}, "requires an argument"));
+    assert(refused({"watch", "--json", "--scheduler", "sched:50051", "--listen", "x"}, "unknown flag"));
+    auto const opts = parseWatchOptions(
+        {"watch", "--json", "--scheduler=sched:50051", "--scheduler-token-file", "t", "--client-ca=ca.pem"});
+    assert(opts.schedulerAddr == "sched:50051" && opts.schedulerTokenFile == "t" && opts.clientCA == "ca.pem");
+}
+
+// The watch command against the real service, once with a client
+// certificate and once with a bearer token, given as a builder gives them.
+// Each prints every event as a line of JSON and returns UNAVAILABLE when the
+// scheduler steps down.
+void testWatchCommand(const std::string & dir, const std::string & base)
+{
+    Farm farm;
+    Dispatcher::Worker worker{.send = [](const rpc::SchedCmd &) -> bool { return true; }};
+    rpc::WorkerMsgs hello;
+    auto * hel = hello.add_msgs()->mutable_hello();
+    hel->set_addr("10.0.0.1:50051");
+    hel->add_systems("x86_64-linux");
+    hel->set_max_jobs(1);
+    farm.disp.workerMsgs(worker, hello);
+    auto const client = farm.client("ci-1");
+    rpc::ClientMsgs want;
+    want.add_msgs()->mutable_want()->set_drv_path("a.drv");
+    farm.disp.clientMsgs(client, want);
+
+    Issuer const issuer(dir, base);
+    std::optional<oidc::Verifier> verifier(oidc::loadConfig(dir + "/oidc.json"));
+    Tls const tls("dash-viewer");
+    std::string const certFile = dir + "/viewer.pem";
+    std::string const keyFile = dir + "/viewer.key";
+    std::string const tokenFile = dir + "/token";
+    nix::writeFile(certFile, tls.cert);
+    nix::writeFile(keyFile, tls.key);
+    nix::writeFile(tokenFile, issuer.token("alice", Clock::now() + std::chrono::minutes(5)));
+    Auth auth{.oidc = &verifier};
+    auth.acl.addRule(tls.name + "=watch");
+    IdleTracker idle;
+    EventsService service(farm.disp, auth, idle);
+    Server srv(service, tls);
+    std::string const addr = "127.0.0.1:" + std::to_string(srv.tlsPort);
+
+    auto const byCert = parseWatchOptions(
+        {"watch", "--json", "--scheduler", addr, "--tls-cert", certFile, "--tls-key", keyFile, "--client-ca", certFile});
+    auto const byToken = parseWatchOptions(
+        {"watch", "--json", "--scheduler", addr, "--scheduler-token-file", tokenFile, "--client-ca", certFile});
+    Printed certLines;
+    Printed tokenLines;
+    grpc::Status certStatus;
+    grpc::Status tokenStatus;
+    std::thread certWatch([&] -> void { certStatus = watchEvents(byCert, certLines.print()); });
+    std::thread tokenWatch([&] -> void { tokenStatus = watchEvents(byToken, tokenLines.print()); });
+    auto const synced = [](const Json & line) -> bool { return line.contains("snapshotDone"); };
+    assert(certLines.waitFor(synced) && tokenLines.waitFor(synced));
+    auto const other = farm.client("ci-2");
+    // 64-bit integers are strings in protobuf's JSON.
+    auto const joined = [wanted = std::to_string(other->id)](const Json & line) -> bool {
+        return line.contains("client") && line.at("client").at("id") == wanted;
+    };
+    assert(certLines.waitFor(joined) && tokenLines.waitFor(joined));
+    farm.disp.restarting();
+    certWatch.join();
+    tokenWatch.join();
+    assert(certStatus.error_code() == grpc::StatusCode::UNAVAILABLE);
+    assert(tokenStatus.error_code() == grpc::StatusCode::UNAVAILABLE);
+
+    auto const seqOf = [](const Json & line) -> uint64_t { return std::stoull(line.at("seq").get<std::string>()); };
+    for (const auto * printed : {&certLines, &tokenLines}) {
+        const auto & lines = printed->lines;
+        assert(lines.front().contains("reset"));
+        bool live = false;
+        bool drv = false;
+        for (size_t idx = 1; idx < lines.size(); idx++) {
+            const auto & line = lines.at(idx);
+            // The snapshot carries Reset's seq, and every event after it is one higher.
+            assert(seqOf(line) == (live ? seqOf(lines.at(idx - 1)) + 1 : seqOf(lines.front())));
+            live = live || line.contains("snapshotDone");
+            if (line.contains("drv") && line.at("drv").at("drvPath") == "a.drv") {
+                const auto & state = line.at("drv");
+                // Fields at their zero value are there too: CAUSE_SNAPSHOT is 0.
+                assert(state.at("cause") == "CAUSE_SNAPSHOT" && state.at("phase") == "PHASE_ASSIGNED");
+                assert(state.at("workerAddr") == "10.0.0.1:50051" && state.contains("inputsUnknown"));
+                drv = true;
+            }
+        }
+        assert(live && drv);
+    }
+    srv.server->Shutdown(std::chrono::system_clock::now() + std::chrono::seconds(1));
+}
 
