index fe16149..060d346 100644
--- a/proto/nix_remote.proto
+++ b/proto/nix_remote.proto
@@ -119,16 +119,86 @@ message NarFrame {
   bool eof = 3;
 }
 
-// Build log of a derivation built on the server. `drv_path` is a store path
-// base name. Errors: NOT_FOUND (no log), UNIMPLEMENTED (the store keeps no
-// logs), DATA_LOSS (a corrupt .bz2 log).
+// The build log of a derivation on this node: while it builds here, as it
+// builds; afterwards, as `nix log` reads it here. `drv_path` is a store path
+// base name. In a farm only the builder that built a derivation holds its log:
+// name it with x-nix-worker, and one of its systems with x-nix-system, as for
+// BuildDerivation. A node without the log may answer from the farm's log store
+// or binary cache (BuildLogInfo.source).
+//
+// INVALID_ARGUMENT: a bad path, or tail or limit with follow. NOT_FOUND: no
+// log of it here or in a store this node reads. UNIMPLEMENTED: this node keeps
+// no logs. DATA_LOSS: a .bz2 log does not decompress. OUT_OF_RANGE: offset
+// past the end of a finished log. RESOURCE_EXHAUSTED: too many log calls on
+// this node or from this caller, or no decode slot within 10 s.
+// UNAUTHENTICATED "bearer token expired": a follow call outlived its bearer
+// token by a minute, as Events.Watch does.
+//
+// Every response, errors included, carries this node's --advertise address
+// as x-nix-node in its initial metadata (when it sends any) and its trailing
+// metadata. A NOT_FOUND while another build of the derivation runs here also
+// carries that build's assignment as x-nix-rebuilding.
 message GetBuildLogRequest {
   string drv_path = 1;
-}
-
-// The `data` fields of all chunks together form one zstd stream.
+  // Start at this byte of the decoded log. Equal to the end: nothing, or with
+  // follow on a running build, wait for more.
+  uint64 offset = 2;
+  // While the derivation builds here, keep sending as the log grows, until
+  // the build ends. Also waits for a build assigned here that has not started.
+  // Without a running build here it is ignored.
+  bool follow = 3;
+  // The assignment whose log the caller wants (DrvState.assign_id). 0: any.
+  // When set, LIVE answers only for that assignment, and KEPT is skipped
+  // once another assignment of the derivation has started here, since Nix
+  // truncates the kept file when a build starts. Before that start, a call
+  // for any log that does not follow gets KEPT.
+  uint64 assign_id = 4;
+  // Send at most this many decoded bytes. 0: to the end.
+  uint64 limit = 5;
+  // Finished logs only: start at the first line that begins at or after
+  // max(offset, size - tail) instead of at offset. 0: start at offset.
+  uint64 tail = 6;
+}
+
+// The concatenation of all `data` fields in one call is a single zstd stream
+// of the log from `info.offset`. In a follow call the server flushes the
+// stream at the end of every message, so all data sent up to then decodes.
 message GetBuildLogChunk {
   bytes data = 1;
+  // First message only, from servers that know these fields. It may carry no
+  // data. A server that sends no info ignored every field but drv_path.
+  BuildLogInfo info = 2;
+  // Last message of a follow call: the build ended, or left this node.
+  bool ended = 3;
+}
+
+message BuildLogInfo {
+  enum Source {
+    SOURCE_UNSPECIFIED = 0;
+    SOURCE_LIVE = 1;   // the build runs here; the log up to now
+    SOURCE_KEPT = 2;   // the file this node's nix-daemon kept
+    SOURCE_STORE = 3;  // the farm's log store (--build-log-store)
+    SOURCE_CACHE = 4;  // the farm's binary cache (--niks3-cache-url)
+  }
+  Source source = 1;
+  // Decoded size in bytes: up to now for LIVE; the whole log otherwise, once
+  // this node knows it. 0 when unknown (a .bz2, STORE or CACHE log not yet
+  // in the decode cache).
+  uint64 size = 2;
+  // The byte of the decoded log this call starts at: offset, or the line
+  // start that tail picked.
+  uint64 offset = 3;
+  // The number of newlines before `offset`, so the first line sent is line
+  // first_line + 1. Always exact.
+  uint64 first_line = 4;
+  // LIVE: the assignment running here. KEPT: the assignment whose build
+  // wrote this file, if it ran after this daemon started; 0 when unknown.
+  uint64 assign_id = 5;
+  // LIVE: when the build started here (0: not yet).
+  uint64 started_ms = 6;
+  // KEPT: the file's mtime; CACHE: Last-Modified. 0 when unknown. A later
+  // build of the same derivation replaces the log on the node and in stores.
+  uint64 modified_ms = 7;
 }
 
