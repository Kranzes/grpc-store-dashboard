+#include "build-log-service.hh"
+#include "builder.hh"
+#include "metrics.hh"
+#include "nix_remote.pb.h"
+
+// NOLINTBEGIN(*-magic-numbers): assignment ids and waits.
+namespace {
+
+using nixgrpc::Builder;
+using nix::remote::WorkerMsg;
+
+constexpr auto advertise = "10.0.0.1:50051";
+
+auto config() -> Builder::Config
+{
+    return {.advertise = advertise, .systems = {"x86_64-linux"}, .features = {}, .maxJobs = 1};
+}
+
+// Sent messages, for the tests that look at them.
+struct Sent
+{
+    std::mutex mutex;
+    std::vector<WorkerMsg> msgs;
+
+    auto send() -> Builder::SendFn
+    {
+        return [this](const WorkerMsg & msg) -> bool {
+            const std::scoped_lock lock(mutex);
+            msgs.push_back(msg);
+            return true;
+        };
+    }
+};
+
+void expect(Builder & builder, const std::string & drv, uint64_t assignId)
+{
+    nix::remote::Expect exp;
+    exp.set_drv_path(drv);
+    exp.set_assign_id(assignId);
+    builder.onExpect(exp);
+}
+
+// Waits on the Expect's condition variable as a follower does, without a
+// poll of its own, and says how long until the entry was gone.
+auto wokenAfter(Builder & builder, const std::string & drv, const std::function<void()> & act) -> std::chrono::milliseconds
+{
+    auto const run = builder.running(drv);
+    assert(run);
+    auto & shared = *run->shared;
+    auto const start = std::chrono::steady_clock::now();
+    std::thread actor([&] -> void {
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        act();
+    });
+    {
+        std::unique_lock lock(shared.mutex);
+        shared.cv.wait_for(lock, std::chrono::seconds(10), [&] -> bool { return !builder.running(drv); });
+    }
+    actor.join();
+    assert(!builder.running(drv));
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start);
+}
+
+void aRevokeBeforeStartWakesAFollower(nixgrpc::Metrics & metrics)
+{
+    Sent sent;
+    Builder builder(config(), metrics);
+    builder.setSend(sent.send());
+    expect(builder, "aaa-x.drv", 7);
+    nix::remote::Revoke rev;
+    rev.set_drv_path("aaa-x.drv");
+    auto const took = wokenAfter(builder, "aaa-x.drv", [&] -> void { builder.onRevoke(rev); });
+    assert(took < std::chrono::seconds(2));
+}
+
+void aGiveBackOnDrainWakesAFollower(nixgrpc::Metrics & metrics)
+{
+    Sent sent;
+    Builder builder(config(), metrics);
+    builder.setSend(sent.send());
+    assert(builder.greet());
+    expect(builder, "bbb-y.drv", 8);
+    auto const took =
+        wokenAfter(builder, "bbb-y.drv", [&] -> void { builder.setUnavailable(Builder::Unavailable::stopping, true); });
+    assert(took < std::chrono::seconds(2));
+    const std::scoped_lock lock(sent.mutex);
+    bool gaveBack = false;
+    for (const auto & msg : sent.msgs) {
+        gaveBack = gaveBack || (msg.has_done() && msg.done().drv_path() == "bbb-y.drv");
+    }
+    assert(gaveBack);
+}
+
+// A GetBuildLog stream that keeps what it is sent.
+struct Chunks final : nixgrpc::BuildLogStream
+{
+    std::vector<nix::remote::GetBuildLogChunk> msgs;
+
+    void SendInitialMetadata() override {}
+    auto Write(const nix::remote::GetBuildLogChunk & msg, grpc::WriteOptions /*options*/) -> bool override
+    {
+        msgs.push_back(msg);
+        return true;
+    }
+};
+
+// Nix replaces the kept log when a new build of the derivation starts, not
+// when it is assigned here, which can be a minute or more earlier.
+void theKeptLogStaysUntilTheBuildStarts(nixgrpc::Metrics & metrics)
+{
+    std::string const drv = "00000000000000000000000000000000-logged.drv";
+    std::string dir = (std::filesystem::temp_directory_path() / "builder-test-XXXXXX").string();
+    assert(::mkdtemp(dir.data()) != nullptr);
+    std::filesystem::path const logDir = dir;
+    auto const kept = logDir / "drvs" / drv.substr(0, 2) / drv.substr(2);
+    std::filesystem::create_directories(kept.parent_path());
+    std::string const lastLog = "the last build\n";
+    std::ofstream(kept) << lastLog;
+
+    Builder builder(config(), metrics);
+    nixgrpc::BuildLogService service({.advertise = advertise}, metrics, &builder);
+    using Source = nix::remote::BuildLogInfo;
+    struct Got
+    {
+        grpc::Status status;
+        std::vector<nix::remote::GetBuildLogChunk> msgs;
+    };
+    auto const get = [&](uint64_t assignId) -> Got {
+        grpc::ServerContext context;
+        Chunks chunks;
+        nix::remote::GetBuildLogRequest request;
+        request.set_drv_path(drv);
+        request.set_assign_id(assignId);
+        nixgrpc::Caller const caller{
+            .name = "viewer", .role = nixgrpc::Role::watch, .kind = nixgrpc::Caller::Kind::named};
+        auto const served = service.serve(context, caller, request, chunks, logDir);
+        return {.status = served.status, .msgs = chunks.msgs};
+    };
+    auto const keptLog = [&](uint64_t assignId) -> bool {
+        auto const got = get(assignId);
+        return got.status.ok() && !got.msgs.empty() && got.msgs.front().info().source() == Source::SOURCE_KEPT
+               && got.msgs.front().info().size() == lastLog.size();
+    };
+    auto const live = [&](uint64_t assignId) -> bool {
+        auto const got = get(assignId);
+        return got.status.ok() && !got.msgs.empty() && got.msgs.front().info().source() == Source::SOURCE_LIVE;
+    };
+
+    expect(builder, drv, 22);
+    assert(keptLog(0) && keptLog(21) && live(22));
+    auto adm = builder.admit(drv);
+    assert(adm);
+    assert(keptLog(0) && keptLog(21) && live(22));
+    adm->shared->startedMs = 1;
+    assert(live(0) && live(22));
+    assert(get(21).status.error_code() == grpc::StatusCode::NOT_FOUND);
+    builder.finished(drv, nix::remote::Done::FAILED, {}, "");
+    std::filesystem::remove_all(logDir);
+}
+
+void keptByNamesTheLastBuildOfADerivation(nixgrpc::Metrics & metrics)
+{
+    Sent sent;
+    Builder builder(config(), metrics);
+    builder.setSend(sent.send());
+    auto const build = [&](uint64_t assignId, bool started) -> void {
+        expect(builder, "ccc-z.drv", assignId);
+        auto adm = builder.admit("ccc-z.drv");
+        assert(adm && adm->assignId == assignId);
+        if (started) {
+            adm->shared->startedMs = 1;
+        }
+        builder.finished("ccc-z.drv", nix::remote::Done::FAILED, {}, "");
+    };
+    assert(builder.keptBy("ccc-z.drv") == 0);
+    build(11, true);
+    assert(builder.keptBy("ccc-z.drv") == 11);
+    build(12, true);
+    assert(builder.keptBy("ccc-z.drv") == 12);
+    // A build that never started wrote no log.
+    build(13, false);
+    assert(builder.keptBy("ccc-z.drv") == 12);
+    assert(builder.keptBy("ddd-other.drv") == 0);
+}
+
+} // namespace
+// NOLINTEND(*-magic-numbers)
+
+// What the daemon's signal handler sets; the build log service reads it.
+volatile std::sig_atomic_t nixgrpc::stopSignal = 0; // NOLINT(cppcoreguidelines-avoid-non-const-global-variables)
+
+auto main() -> int
+{
+    try {
+        nix::initLibStore(false);
+        nixgrpc::Metrics metrics("");
+        aRevokeBeforeStartWakesAFollower(metrics);
+        aGiveBackOnDrainWakesAFollower(metrics);
+        theKeptLogStaysUntilTheBuildStarts(metrics);
+        keptByNamesTheLastBuildOfADerivation(metrics);
+    } catch (std::exception & err) {
+        std::cerr << "error: " << err.what() << "\n";
+        return 1;
+    }
+    return 0;
+}
