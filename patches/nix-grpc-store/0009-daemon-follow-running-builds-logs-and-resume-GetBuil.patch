+    };
+    check(".bz2");
+    // The same log as a plain file: its size is known from the start.
+    succeed(&["sh", "-c", r#"mv "$1.bz2" /tmp/offsets.bz2 && cp /tmp/offsets.want "$1""#, "sh", &kept]);
+    let plain = check("plain");
+    assert_eq!(plain.num("size"), size, "{plain:?}");
+    succeed(&["sh", "-c", r#"rm "$1" && mv /tmp/offsets.bz2 "$1.bz2""#, "sh", &kept]);
+}
