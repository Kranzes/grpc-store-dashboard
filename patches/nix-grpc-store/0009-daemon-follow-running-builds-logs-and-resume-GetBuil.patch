+// The daemon's own messages are notes: a BuildDerivation client still gets
+// them as log lines, but the build log leaves them out.
+void stderrNextRelaysAsANote()
+{
+    nix::StringSink sink;
+    sink << STDERR_NEXT << "warning: from the daemon\n";
+    sink << STDERR_RESULT << uint64_t{8} << uint64_t{nix::resBuildLogLine} << uint64_t{1} << uint64_t{1} << "built";
+    sink << STDERR_RESULT << uint64_t{8} << uint64_t{nix::resSetPhase} << uint64_t{1} << uint64_t{1} << "buildPhase";
+    sink << STDERR_LAST;
+    nix::StringSource source(sink.s);
+    std::vector<nixgrpc::BuildEvent> events;
+    nixgrpc::relayBuildLog(source, [&](nixgrpc::BuildEvent event) -> void { events.push_back(std::move(event)); });
+    using Kind = nixgrpc::BuildEvent::Kind;
+    assert(events.size() == 3);
+    assert(events.at(0).kind == Kind::note && events.at(0).text == "warning: from the daemon");
+    assert(events.at(1).kind == Kind::line && events.at(2).kind == Kind::phase);
+    auto const note = nixgrpc::toChunk<nix::remote::BuildDerivationChunk>(events.at(0));
+    assert(note.log_line() == "warning: from the daemon" && note.phase().empty());
+    auto const phase = nixgrpc::toChunk<nix::remote::BuildDerivationChunk>(events.at(2));
+    assert(phase.phase() == "buildPhase" && phase.log_line().empty());
+}
