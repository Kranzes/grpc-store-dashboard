+/// A follower that hangs up frees its call within a second or two, even on
+/// a build that prints nothing. Eight per caller, the ninth is refused.
+#[test]
+fn build_log_follow_calls_end_and_count() {
+    let base = log_drv("quiet-grpc", "echo one line; sleep 90; echo > $out");
+    build_in_background(&cert_store("client"), "quiet-grpc");
+    // A caller of its own: other tests read logs on 50052 at the same time.
+    let tls = tls_args("follower");
+    let mut probe = vec![base.as_str()];
+    probe.extend(strs(&tls));
+    retry(120, "the quiet build runs on 50052", || {
+        let got = build_log(&probe);
+        got.code() == 0 && got.get("source") == "live"
+    });
+    // Eight follow calls from one caller stay open; curl hangs up after 30 s.
+    let opened = Instant::now();
+    for idx in 0..8 {
+        let mut args = vec!["sh", "-c", r#"setsid -f ngs-build-log "$@" > "/tmp/quiet-$0.out" 2>&1 < /dev/null"#];
+        let tag = idx.to_string();
+        args.push(&tag);
+        args.push(&base);
+        args.push("--follow");
+        args.extend(strs(&tls));
+        args.extend(["--curl=--max-time", "--curl=30"]);
+        succeed(&args);
+    }
+    retry(20, "eight follow calls are open", || build_log_streams(9464) >= 8);
+    let mut ninth = vec![base.as_str()];
+    ninth.extend(strs(&tls));
+    let refused = build_log(&ninth);
+    assert_eq!(refused.code(), 8, "{refused:?}");
+    assert!(refused.get("message").contains("too many build log readers"), "{refused:?}");
+    // Another caller still gets in.
+    let mut other = vec![base.as_str()];
+    let ro = tls_args("ro");
+    other.extend(strs(&ro));
+    assert_eq!(build_log(&other).code(), 0);
+    // After the hang-up, all eight calls end within a second or two.
+    let hangup = std::time::Duration::from_secs(30);
+    if let Some(left) = hangup.checked_sub(opened.elapsed()) {
+        std::thread::sleep(left);
+    }
+    retry(5, "the follow calls closed", || {
+        crate::harness::journal_count(
+            MACHINE,
+            "nix-grpc-daemon-mtls",
+            &format!("method=GetBuildLog cn=follower .*drv={base} source=live .*code=1"),
+        ) == 8
+    });
+}
+
+/// With assign_id, a node never answers with a newer build's log: while a
+/// retry runs, the earlier build's log is gone (Nix truncated it), and after
+/// it the kept log names the retry. On 50052, which keeps running and so
+/// remembers which build wrote a kept log.
+#[test]
+fn build_log_of_an_earlier_build_while_a_retry_runs() {
+    let base = log_drv("retry-grpc", "echo attempt; sleep 10; exit 1");
+    let store = cert_store("client");
+    let tls = tls_args("client");
+    let call = |extra: &[&str]| {
+        let mut args = vec![base.as_str()];
+        args.extend(extra);
+        args.extend(strs(&tls));
+        build_log(&args)
+    };
+    build_in_background(&store, "retry-grpc");
+    let mut follow_args = vec!["--follow"];
+    follow_args.extend(strs(&tls));
+    let first = follow(&base, &follow_args);
+    let first_id = first.num("assign_id");
+    assert!(first_id > 0 && first.get("ended") == "1", "{first:?}");
+    // A KEPT read names the build that wrote the file.
+    retry(30, "the first build's kept log", || {
+        let got = call(&[]);
+        got.code() == 0 && got.get("source") == "kept" && got.num("assign_id") == first_id
+    });
+    build_in_background(&store, "retry-grpc");
+    let mut second_id = 0;
+    retry(60, "the retry runs", || {
+        let got = call(&[]);
+        if got.get("source") == "live" && got.num("assign_id") != first_id {
+            second_id = got.num("assign_id");
+        }
+        second_id != 0
+    });
+    let first_arg = first_id.to_string();
+    let earlier = call(&["--assign-id", &first_arg]);
+    assert_eq!(earlier.code(), 5, "{earlier:?}");
+    assert_eq!(earlier.num("rebuilding"), second_id, "{earlier:?}");
+    assert!(!earlier.get("node").is_empty(), "{earlier:?}");
+    // Its own assignment still answers from the spill.
+    let second_arg = second_id.to_string();
+    let live = call(&["--assign-id", &second_arg]);
+    assert!(live.code() == 0 && live.get("source") == "live", "{live:?}");
+    retry(60, "the retry ended", || {
+        let got = call(&["--assign-id", &first_arg]);
+        got.code() == 0 && got.get("source") == "kept" && got.num("assign_id") == second_id
+    });
+}
+
+/// Decodes of .bz2 logs: one per caller and two at a time per node. A third
+/// caller waits for a slot, then gets the whole log.
+#[test]
+fn build_log_decode_slots() {
+    succeed(&[
+        "sh",
+        "-c",
+        r#"yes 'a line of a long build log, repeated many times over' | head -c 150M | bzip2 -1 > /tmp/big.bz2
+for n in 1 2 3; do
+  base=0000000000000000000000000000000$n-big-$n.drv
+  mkdir -p /nix/var/log/nix/drvs/00
+  cp /tmp/big.bz2 /nix/var/log/nix/drvs/00/${base#00}.bz2
+done"#,
+    ]);
+    for (n, cert) in [(1, "ro"), (2, "rw")] {
+        let base = format!("0000000000000000000000000000000{n}-big-{n}.drv");
+        let mut args = vec![
+            "sh".to_string(),
+            "-c".to_string(),
+            r#"setsid -f ngs-build-log "$@" > "/tmp/big-$0.out" 2>&1 < /dev/null"#.to_string(),
+            n.to_string(),
+            base,
+        ];
+        args.extend(tls_args(cert));
+        succeed(&strs(&args));
+    }
+    sleep(1);
+    let mut third = vec!["00000000000000000000000000000003-big-3.drv".to_string()];
+    third.extend(tls_args("watcher"));
+    let got = build_log(&strs(&third));
+    assert_eq!(got.code(), 0, "{got:?}");
+    assert_eq!(got.num("bytes"), 150 << 20, "{got:?}");
+    let waited = got.num("first_data_ns") - got.num("start_ns");
+    assert!(waited > 300_000_000, "the third decode did not wait: {got:?}");
+    for n in [1, 2] {
+        wait_until_succeeds(&["grep", "-q", "^bytes=157286400$", &format!("/tmp/big-{n}.out")], 60);
+    }
+}
+
+/// The watch role is enough for build logs. A caller no rule matches is denied.
+#[test]
+fn build_log_needs_only_watch() {
+    let base = log_drv("watched-grpc", "echo watched line; echo > $out");
+    assert!(build_now(STORE, "watched-grpc"));
+    let mut args = vec![base.as_str()];
+    let watcher = tls_args("watcher");
+    args.extend(strs(&watcher));
+    let got = build_log(&args);
+    assert_eq!(got.code(), 0, "{got:?}");
+    let mut args = vec![base.as_str()];
+    let stranger = tls_args("stranger");
+    args.extend(strs(&stranger));
+    let denied = build_log(&args);
+    assert_eq!(denied.code(), 7, "{denied:?}");
+}
+
