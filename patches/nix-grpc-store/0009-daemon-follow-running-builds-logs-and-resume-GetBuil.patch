+// NOLINTBEGIN(*-magic-numbers): test vectors.
+// The log as Nix keeps it, for comparison.
+auto rendering(const Records & records) -> std::string
+{
+    std::string out;
+    for (const auto & [kind, text] : records) {
+        if (kind == SpillKind::line) {
+            out += text + "\n";
+        } else if (kind == SpillKind::phase) {
+            out += R"(@nix { "action": "setPhase", "phase": ")" + text + "\" }\n";
+        }
+    }
+    return out;
+}
+
+auto drainAll(const LogSpill & spill, std::size_t from, std::size_t limit = SIZE_MAX) -> std::string
+{
+    std::string out;
+    auto const reached = spill.drainRendered(from, limit, [&](std::string_view piece) -> void { out += piece; });
+    (void) reached;
+    assert(reached == from + out.size());
+    return out;
+}
+
+// Records of random kinds and sizes, the same for every run.
+auto randomRecords(std::size_t count) -> Records
+{
+    constexpr std::size_t maxText = 300;
+    std::mt19937 rng(42); // NOLINT(cert-msc32-c,cert-msc51-cpp,bugprone-random-generator-seed): the same records every run.
+    std::uniform_int_distribution<int> kind(0, 9);
+    std::uniform_int_distribution<std::size_t> size(0, maxText);
+    Records out;
+    for (std::size_t idx = 0; idx < count; idx++) {
+        auto const pick = kind(rng);
+        auto spillKind = SpillKind::line;
+        if (pick == 0) {
+            spillKind = SpillKind::phase;
+        } else if (pick == 1) {
+            spillKind = SpillKind::note;
+        }
+        out.emplace_back(spillKind, std::string(size(rng), static_cast<char>('a' + (idx % 26))));
+    }
+    return out;
+}
+
+void renderedBytesMatchTheKeptLogRendering()
+{
+    LogSpill spill;
+    Records const records{
+        {SpillKind::line, "Running phase: unpackPhase"},
+        {SpillKind::phase, "unpackPhase"},
+        {SpillKind::note, "worker-1: building x.drv"},
+        {SpillKind::line, ""},
+        {SpillKind::line, "done"}};
+    for (const auto & [kind, text] : records) {
+        spill.append(kind, text);
+    }
+    auto const want = rendering(records);
+    assert(want == "Running phase: unpackPhase\n@nix { \"action\": \"setPhase\", \"phase\": \"unpackPhase\" }\n\ndone\n");
+    assert(spill.renderedSize() == want.size());
+    assert(drainAll(spill, 0) == want);
+    assert(LogSpill::renderedLength(SpillKind::phase, 1) == 44);
+}
+
+void notesRenderAsNothingAndCountNoLines()
+{
+    LogSpill spill;
+    spill.append(SpillKind::note, "a warning from the daemon");
+    assert(spill.renderedSize() == 0 && drainAll(spill, 0).empty());
+    spill.append(SpillKind::line, "x");
+    spill.append(SpillKind::note, "another");
+    assert(drainAll(spill, 0) == "x\n");
+    assert(spill.linesBefore(2) == 1);
+    // A note between two lines is not a line start of its own.
+    assert(spill.lineStartAtOrAfter(1) == 2);
+}
+
+void drainRenderedFromEveryOffsetGivesTheSameSuffix()
+{
+    constexpr std::size_t records = 10000;
+    constexpr std::size_t step = 997;
+    LogSpill spill;
+    auto const all = randomRecords(records);
+    for (const auto & [kind, text] : all) {
+        spill.append(kind, text);
+    }
+    auto const want = rendering(all);
+    assert(spill.renderedSize() == want.size());
+    for (std::size_t from = 0; from <= want.size(); from += step) {
+        // The whole suffix from every 16th offset, a piece of it from every one.
+        if (from % (16 * step) == 0) {
+            assert(drainAll(spill, from) == want.substr(from));
+        }
+        assert(drainAll(spill, from, step) == want.substr(from, step));
+    }
+    assert(drainAll(spill, want.size()).empty());
+    assert(drainAll(spill, want.size() + 1).empty());
+}
+
+void linesBeforeMatchesACountOverTheRendering()
+{
+    constexpr std::size_t records = 10000;
+    constexpr std::size_t step = 997;
+    LogSpill spill;
+    auto const all = randomRecords(records);
+    for (const auto & [kind, text] : all) {
+        spill.append(kind, text);
+    }
+    auto const want = rendering(all);
+    auto const nth = [&](std::size_t pos) -> std::string::const_iterator {
+        return std::next(want.begin(), static_cast<std::ptrdiff_t>(pos));
+    };
+    // A running count, so the check stays linear in the log's size.
+    std::size_t lines = 0;
+    std::size_t counted = 0;
+    for (std::size_t from = 0; from <= want.size(); from += step) {
+        lines += static_cast<std::size_t>(std::count(nth(counted), nth(from), '\n'));
+        counted = from;
+        assert(spill.linesBefore(from) == lines);
+        // the first line start at or after it
+        auto start = from;
+        while (start < want.size() && start > 0 && want.at(start - 1) != '\n') {
+            start++;
+        }
+        assert(spill.lineStartAtOrAfter(from) == start);
+    }
+}
+
+#ifdef __linux__
+// Bytes this process read with read(2) and pread(2) so far.
+auto bytesRead() -> std::uint64_t
+{
+    std::ifstream stats("/proc/self/io");
+    std::string key;
+    std::uint64_t value = 0;
+    while (stats >> key >> value) {
+        if (key == "rchar:") {
+            return value;
+        }
+    }
+    return 0;
+}
+#endif
+
+void theIndexLetsAReaderStartNearTheEnd()
+{
+    constexpr std::size_t size = std::size_t{60} << 20U;
+    constexpr std::size_t lineSize = 999;
+    LogSpill spill;
+    std::string const line(lineSize, 'x');
+    while (spill.renderedSize() < size) {
+        spill.append(SpillKind::line, line);
+    }
+    auto const end = spill.renderedSize();
+#ifdef __linux__
+    auto const before = bytesRead();
+#endif
+    assert(drainAll(spill, end - 1) == "\n");
+#ifdef __linux__
+    auto const read = bytesRead() - before;
+    assert(read <= LogSpill::kStride + (2 * (lineSize + 5)));
+#endif
+}
+
+void manyOneLetterPhasesStopAt64MiBRendered()
+{
+    constexpr std::size_t phases = 10'000'000;
+    LogSpill spill;
+    for (std::size_t idx = 0; idx < phases; idx++) {
+        spill.append(SpillKind::phase, "x");
+    }
+    assert(spill.renderedSize() <= LogSpill::kDefaultCap + LogSpill::kTruncated.size() + 1);
+    std::string last;
+    (void) spill.drain(0, [&](SpillKind, std::string_view text) -> void { last = text; });
+    assert(last == LogSpill::kTruncated);
+    // The index covers the whole rendering: a read from the end is short.
+    assert(drainAll(spill, spill.renderedSize() - 1) == "\n");
+    assert(spill.linesBefore(spill.renderedSize()) == ((spill.renderedSize() - LogSpill::kTruncated.size() - 1) / 44) + 1);
+}
