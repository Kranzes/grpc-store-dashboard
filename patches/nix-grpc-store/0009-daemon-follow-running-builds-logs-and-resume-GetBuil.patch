index 0000000..f698026
--- /dev/null
+++ b/tests/lib/build-log.py
@@ -0,0 +1,248 @@
+"""GetBuildLog through curl, for the VM tests.
+
+Sends one request, as gRPC or gRPC-web, decodes the zstd stream as it
+arrives, writes the log to --out, and prints what came back as key=value
+lines: the status, x-nix-node from the headers and the trailers, the info
+fields, whether `ended` came, and when messages and lines arrived.
+"""
+
+import argparse
+import os
+import subprocess
+import sys
+import time
+
+import zstandard
+
+SOURCES = {0: "unspecified", 1: "live", 2: "kept", 3: "store", 4: "cache"}
+INFO_FIELDS = {
+    1: "source",
+    2: "size",
+    3: "offset",
+    4: "first_line",
+    5: "assign_id",
+    6: "started_ms",
+    7: "modified_ms",
+}
+
+
+def varint(value):
+    out = bytearray()
+    while True:
+        byte = value & 0x7F
+        value >>= 7
+        if value:
+            out.append(byte | 0x80)
+        else:
+            out.append(byte)
+            return bytes(out)
+
+
+def read_varint(data, pos):
+    value = shift = 0
+    while True:
+        byte = data[pos]
+        pos += 1
+        value |= (byte & 0x7F) << shift
+        shift += 7
+        if not byte & 0x80:
+            return value, pos
+
+
+def fields(data):
+    """Yields (number, value) for each field of a protobuf message."""
+    pos = 0
+    while pos < len(data):
+        key, pos = read_varint(data, pos)
+        number, kind = key >> 3, key & 7
+        if kind == 0:
+            value, pos = read_varint(data, pos)
+        elif kind == 2:
+            size, pos = read_varint(data, pos)
+            value, pos = data[pos : pos + size], pos + size
+        else:
+            raise ValueError(f"wire type {kind}")
+        yield number, value
+
+
+def request(args):
+    body = b"\x0a" + varint(len(args.drv)) + args.drv.encode()
+    for number, value in (
+        (2, args.offset),
+        (3, int(args.follow)),
+        (4, args.assign_id),
+        (5, args.limit),
+        (6, args.tail),
+    ):
+        if value:
+            body += varint(number << 3) + varint(value)
+    return b"\x00" + len(body).to_bytes(4, "big") + body
+
+
+def headers(path):
+    """The header blocks curl wrote: the response headers, then trailers."""
+    blocks = [[]]
+    try:
+        text = open(path, encoding="utf-8", errors="replace").read()
+    except FileNotFoundError:
+        return {}, {}
+    for line in text.splitlines():
+        line = line.strip()
+        if not line:
+            if blocks[-1]:
+                blocks.append([])
+            continue
+        blocks[-1].append(line)
+    parsed = []
+    for block in blocks:
+        entries = {}
+        for line in block:
+            if line.startswith("HTTP/"):
+                entries[":status"] = line.split()[1]
+            elif ":" in line:
+                key, value = line.split(":", 1)
+                entries[key.strip().lower()] = value.strip()
+        if entries:
+            parsed.append(entries)
+    head = parsed[0] if parsed else {}
+    tail = {}
+    for block in parsed[1:]:
+        tail.update(block)
+    return head, tail
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("drv")
+    parser.add_argument("--url", default="http://127.0.0.1:50051")
+    parser.add_argument("--offset", type=int, default=0)
+    parser.add_argument("--follow", action="store_true")
+    parser.add_argument("--assign-id", type=int, default=0)
+    parser.add_argument("--limit", type=int, default=0)
+    parser.add_argument("--tail", type=int, default=0)
+    parser.add_argument("--out", default="/dev/null")
+    parser.add_argument("--lines", help="append '<arrival ns> <line>' per line here")
+    parser.add_argument("--web", action="store_true", help="gRPC-web, as a browser sends it")
+    parser.add_argument("-H", "--header", action="append", default=[])
+    parser.add_argument("--curl", action="append", default=[], help="an extra curl argument")
+    args = parser.parse_args()
+
+    tag = f"{os.getpid()}"
+    head_file = f"/tmp/build-log-{tag}.hdr"
+    command = ["curl", "-sS", "-N", "-X", "POST", "-D", head_file, "--data-binary", "@-"]
+    if args.web:
+        command += ["-H", "content-type: application/grpc-web+proto", "-H", "x-grpc-web: 1"]
+    else:
+        command += ["-H", "content-type: application/grpc", "-H", "te: trailers"]
+        if args.url.startswith("http://"):
+            command += ["--http2-prior-knowledge"]
+        else:
+            command += ["--http2"]
+    for header in args.header:
+        command += ["-H", header]
+    command += args.curl
+    command.append(args.url.rstrip("/") + "/nix.remote.NixRemote/GetBuildLog")
+
+    start = time.time_ns()
+    proc = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE)
+    proc.stdin.write(request(args))
+    proc.stdin.close()
+
+    decoder = zstandard.ZstdDecompressor().decompressobj()
+    out = open(args.out, "wb")
+    lines = open(args.lines, "a") if args.lines else None
+    partial = b""
+    buffered = b""
+    info = {}
+    seen_info = False
+    ended = False
+    messages = []  # (arrival ns, data bytes, decoded total)
+    web_trailers = {}
+    decoded = 0
+    first_data = 0
+    while True:
+        chunk = proc.stdout.read1(1 << 16)
+        if not chunk:
+            break
+        buffered += chunk
+        while len(buffered) >= 5:
+            flags = buffered[0]
+            size = int.from_bytes(buffered[1:5], "big")
+            if len(buffered) < 5 + size:
+                break
+            frame, buffered = buffered[5 : 5 + size], buffered[5 + size :]
+            now = time.time_ns()
+            if flags & 0x80:
+                for line in frame.decode(errors="replace").split("\r\n"):
+                    if ":" in line:
+                        key, value = line.split(":", 1)
+                        web_trailers[key.strip().lower()] = value.strip()
+                continue
+            data = b""
+            for number, value in fields(frame):
+                if number == 1:
+                    data = value
+                elif number == 2:
+                    seen_info = True
+                    for inner, field in fields(value):
+                        if inner in INFO_FIELDS:
+                            info[INFO_FIELDS[inner]] = field
+                elif number == 3:
+                    ended = bool(value)
+            text = decoder.decompress(data) if data else b""
+            if text and not first_data:
+                first_data = now
+            decoded += len(text)
+            out.write(text)
+            out.flush()
+            if lines is not None and text:
+                partial += text
+                *done, partial = partial.split(b"\n")
+                for line in done:
+                    lines.write(f"{now} {line.decode(errors='replace')}\n")
+                lines.flush()
+            messages.append((now, len(data), decoded))
+    proc.wait()
+    end = time.time_ns()
+    head, trailers = headers(head_file)
+    trailers.update(web_trailers)
+    if not trailers and "grpc-status" in head:
+        # A trailers-only answer: the status came with the headers.
+        trailers, head = head, {key: value for key, value in head.items() if key == ":status"}
+    if os.path.exists(head_file):
+        os.unlink(head_file)
+    status = trailers.get("grpc-status", head.get("grpc-status", ""))
+    message = trailers.get("grpc-message", head.get("grpc-message", ""))
+
+    per_second = 0
+    times = [t for t, _, _ in messages]
+    for idx, first in enumerate(times):
+        per_second = max(per_second, sum(1 for t in times[idx:] if t - first < 1_000_000_000))
+
+    result = {
+        "code": status,
+        "message": message,
+        "http": head.get(":status", ""),
+        "node": trailers.get("x-nix-node", ""),
+        "initial_node": head.get("x-nix-node", ""),
+        "rebuilding": trailers.get("x-nix-rebuilding", head.get("x-nix-rebuilding", "")),
+        "has_info": int(seen_info),
+        "ended": int(ended),
+        "messages": len(messages),
+        "max_per_second": per_second,
+        "bytes": decoded,
+        "start_ns": start,
+        "first_data_ns": first_data,
+        "end_ns": end,
+        "curl": proc.returncode,
+    }
+    for key in INFO_FIELDS.values():
+        value = info.get(key, 0)
+        result[key] = SOURCES.get(value, value) if key == "source" else value
+    for key, value in result.items():
+        print(f"{key}={value}")
+    sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/log-cache-test.cc b/tests/log-cache-test.cc
new file mode 100644
index 0000000..7472773
--- /dev/null
+++ b/tests/log-cache-test.cc
@@ -0,0 +1,333 @@
+// The decode cache: one decode per log for every reader, readers that join
+// while it runs, line starts and counts, the size cap, and decode slots.
+
+#include <algorithm>
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <exception>
+#include <iostream>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <iterator>
+#include <thread>
+#include <utility>
+
+#include "log-cache.hh"
+
+// NOLINTBEGIN(*-magic-numbers,misc-const-correctness): test vectors, and
+// readers that count while they live.
+using nixgrpc::DecodeSlots;
+using nixgrpc::LogCache;
+
+namespace {
+
+constexpr std::chrono::milliseconds poll{50};
+constexpr std::chrono::seconds patience{10};
+
+// A log of `lines` numbered lines.
+auto numbered(std::size_t lines) -> std::string
+{
+    std::string out;
+    for (std::size_t idx = 0; idx < lines; idx++) {
+        out += "line " + std::to_string(idx) + " of the log\n";
+    }
+    return out;
+}
+
+// Writes `text` in pieces of `piece` bytes, and counts its runs.
+auto decoder(const std::string & text, std::atomic<int> & runs, std::size_t piece = 1000) -> LogCache::Decode
+{
+    return [&text, &runs, piece](const LogCache::Write & write) -> bool {
+        runs++;
+        for (std::size_t pos = 0; pos < text.size(); pos += piece) {
+            if (!write(std::string_view(text).substr(pos, piece))) {
+                return true;
+            }
+        }
+        return true;
+    };
+}
+
+// Tests declare their slots before their cache. The cache joins its threads
+// as it goes, and they give their slots back as they end.
+auto slot(DecodeSlots & slots, const std::string & caller = "c") -> DecodeSlots::Slot
+{
+    auto got = slots.acquire(caller, std::chrono::seconds(1), {});
+    assert(got);
+    return std::move(*got);
+}
+
+// Everything the entry holds once it ends.
+auto readAll(const LogCache::Reader & reader) -> std::string
+{
+    auto const deadline = std::chrono::steady_clock::now() + patience;
+    auto state = reader->state();
+    while (!state.ended() && std::chrono::steady_clock::now() < deadline) {
+        state = reader->waitPast(state.written, poll);
+    }
+    std::string out(state.written, '\0');
+    assert(reader->read(0, out) == out.size());
+    return out;
+}
+
+void twoReadersDecodeOnce()
+{
+    DecodeSlots slots(2, 1);
+    LogCache cache;
+    std::atomic<int> runs{0};
+    auto const text = numbered(5000);
+    assert(!cache.find("a.bz2@1"));
+    auto first = cache.start("a.bz2@1", decoder(text, runs), slot(slots));
+    auto second = cache.find("a.bz2@1");
+    assert(second);
+    assert(readAll(first) == text);
+    assert(readAll(*second) == text);
+    assert(runs == 1);
+    assert(first->state().complete);
+    // A third, after the decode: still the same entry.
+    auto third = cache.find("a.bz2@1");
+    assert(third && readAll(*third) == text);
+    assert(runs == 1);
+    // Another mtime is another log.
+    assert(!cache.find("a.bz2@2"));
+}
+
+// The decode waits for the test at a gate, so the second reader joins midway.
+void aReaderThatJoinsMidDecodeGetsTheSameBytes()
+{
+    DecodeSlots slots(2, 1);
+    LogCache cache;
+    auto const text = numbered(20000);
+    std::mutex mutex;
+    std::condition_variable gate;
+    bool open = false;
+    auto decode = [&](const LogCache::Write & write) -> bool {
+        auto const half = text.size() / 2;
+        if (!write(std::string_view(text).substr(0, half))) {
+            return true;
+        }
+        std::unique_lock lock(mutex);
+        gate.wait(lock, [&] -> bool { return open; });
+        lock.unlock();
+        (void) write(std::string_view(text).substr(half));
+        return true;
+    };
+    auto first = cache.start("b@1", decode, slot(slots));
+    while (first->state().written == 0) {
+        (void) first->waitPast(0, poll);
+    }
+    assert(!first->state().complete);
+    auto second = cache.find("b@1");
+    assert(second);
+    {
+        const std::scoped_lock lock(mutex);
+        open = true;
+    }
+    gate.notify_all();
+    assert(readAll(*second) == text);
+    assert(readAll(first) == text);
+}
+
+void tailStartsAtALineStartAndFirstLineIsExact()
+{
+    LogCache::Limits limits;
+    limits.stride = 4096; // many index entries in a small log
+    DecodeSlots slots(2, 1);
+    LogCache cache(limits);
+    std::atomic<int> runs{0};
+    auto const text = numbered(30000);
+    auto reader = cache.start("c@1", decoder(text, runs, 777), slot(slots));
+    assert(readAll(reader) == text);
+    constexpr std::size_t step = 997;
+    for (std::size_t from = 0; from <= text.size(); from += step) {
+        auto start = from;
+        while (start < text.size() && start > 0 && text.at(start - 1) != '\n') {
+            start++;
+        }
+        assert(reader->lineStartAtOrAfter(from) == start);
+        auto const lines = static_cast<uint64_t>(
+            std::count(text.begin(), std::next(text.begin(), static_cast<std::ptrdiff_t>(start)), '\n'));
+        assert(reader->linesBefore(start) == lines);
+    }
+    assert(reader->lineStartAtOrAfter(text.size() + 5) == text.size());
+}
+
+void anEntryOverTheSizeCapIsNotCached()
+{
+    LogCache::Limits limits;
+    limits.bytes = 10000;
+    limits.tooBigFor = std::chrono::milliseconds(500);
+    DecodeSlots slots(2, 1);
+    LogCache cache(limits);
+    std::atomic<int> runs{0};
+    auto const text = numbered(2000); // about 44 kB
+    auto reader = cache.start("d@1", decoder(text, runs), slot(slots));
+    auto const prefix = readAll(reader);
+    auto const state = reader->state();
+    assert(state.uncached && !state.complete && !state.failed);
+    // What it holds is the start of the log, and the caller decodes the rest.
+    assert(!prefix.empty() && prefix.size() <= limits.bytes && text.starts_with(prefix));
+    assert(cache.size() == 0);
+    assert(cache.bytes() == 0);
+    // A log that fits is cached as usual.
+    auto const small = numbered(10);
+    {
+        auto fits = cache.start("e@1", decoder(small, runs), slot(slots));
+        assert(readAll(fits) == small && fits->state().complete);
+    }
+    // For a while, a call for the log that did not fit gets an empty
+    // uncached reader at once, from find() or start(): no decode, and the
+    // unread entry stays.
+    auto const decodes = runs.load();
+    auto again = cache.find("d@1");
+    assert(again && (*again)->state().uncached && (*again)->state().written == 0);
+    auto started = cache.start("d@1", decoder(text, runs), slot(slots));
+    assert(started->state().uncached && started->state().written == 0);
+    assert(runs == decodes && cache.size() == 1 && cache.find("e@1"));
+    // Then it is tried again.
+    std::this_thread::sleep_for(limits.tooBigFor + poll);
+    assert(!cache.find("d@1"));
+}
+
+void theDecodeGoesOnWhileAnotherReaderRemains()
+{
+    DecodeSlots slots(2, 1);
+    LogCache cache;
+    auto const text = numbered(50000);
+    std::atomic<std::size_t> progress{0};
+    std::atomic<bool> release{false};
+    auto decode = [&](const LogCache::Write & write) -> bool {
+        constexpr std::size_t piece = 1000;
+        for (std::size_t pos = 0; pos < text.size(); pos += piece) {
+            while (pos > 0 && !release) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            }
+            if (!write(std::string_view(text).substr(pos, piece))) {
+                return true;
+            }
+            progress = pos;
+        }
+        return true;
+    };
+    std::optional<LogCache::Reader> second;
+    {
+        auto first = cache.start("f@1", decode, slot(slots));
+        auto joined = cache.find("f@1");
+        assert(joined);
+        second.emplace(std::move(*joined));
+        (void) first;
+    } // the first leaves mid-decode
+    release = true;
+    assert(readAll(*second) == text);
+    assert((*second)->state().complete);
+
+    // With nobody left, it stops early and leaves the cache.
+    std::atomic<bool> begin{false};
+    std::atomic<bool> stopped{false};
+    auto endless = [&](const LogCache::Write & write) -> bool {
+        while (!begin) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+        while (write("more\n")) {
+        }
+        stopped = true;
+        return true;
+    };
+    {
+        auto only = cache.start("g@1", endless, slot(slots));
+        (void) only;
+    }
+    begin = true;
+    auto const deadline = std::chrono::steady_clock::now() + patience;
+    while (!stopped && std::chrono::steady_clock::now() < deadline) {
+        std::this_thread::sleep_for(poll);
+    }
+    assert(stopped);
+    // the slot came back too
+    auto const back = std::chrono::steady_clock::now() + patience;
+    while (slots.inUse() != 0 && std::chrono::steady_clock::now() < back) {
+        std::this_thread::sleep_for(poll);
+    }
+    assert(slots.inUse() == 0);
+    assert(!cache.find("g@1"));
+}
+
+void oldEntriesGoFirst()
+{
+    LogCache::Limits limits;
+    limits.entries = 2;
+    DecodeSlots slots(2, 1);
+    LogCache cache(limits);
+    std::atomic<int> runs{0};
+    auto const text = numbered(10);
+    for (auto const * key : {"h@1", "i@1", "j@1"}) {
+        auto reader = cache.start(key, decoder(text, runs), slot(slots));
+        assert(readAll(reader) == text);
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    assert(cache.size() == 2);
+    assert(!cache.find("h@1"));
+    assert(cache.find("j@1"));
+
+    // Complete entries that nobody read for `keep` leave the cache too.
+    LogCache::Limits brief;
+    brief.keep = std::chrono::milliseconds(20);
+    LogCache shortLived(brief);
+    {
+        auto reader = shortLived.start("k@1", decoder(text, runs), slot(slots));
+        assert(readAll(reader) == text);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    assert(!shortLived.find("k@1"));
+}
+
+void slotsPerCallerAndInAll()
+{
+    DecodeSlots slots(2, 1);
+    auto first = slots.acquire("a", std::chrono::seconds(1), {});
+    assert(first);
+    // One per caller: a's second waits and gives up.
+    auto const before = std::chrono::steady_clock::now();
+    assert(!slots.acquire("a", std::chrono::milliseconds(200), {}));
+    assert(std::chrono::steady_clock::now() - before >= std::chrono::milliseconds(200));
+    auto second = slots.acquire("b", std::chrono::seconds(1), {});
+    assert(second);
+    // Two in all: c waits until one is back, then gets it.
+    std::thread freeing([&] -> void {
+        std::this_thread::sleep_for(std::chrono::milliseconds(300));
+        first->release();
+    });
+    auto const waited = std::chrono::steady_clock::now();
+    auto third = slots.acquire("c", std::chrono::seconds(5), {});
+    assert(third);
+    assert(std::chrono::steady_clock::now() - waited >= std::chrono::milliseconds(250));
+    freeing.join();
+    // A cancelled wait ends early.
+    assert(!slots.acquire("d", std::chrono::seconds(5), [] -> bool { return true; }));
+}
+
+} // namespace
+// NOLINTEND(*-magic-numbers,misc-const-correctness)
+
+auto main() -> int
+{
+    try {
+        twoReadersDecodeOnce();
+        aReaderThatJoinsMidDecodeGetsTheSameBytes();
+        tailStartsAtALineStartAndFirstLineIsExact();
+        anEntryOverTheSizeCapIsNotCached();
+        theDecodeGoesOnWhileAnotherReaderRemains();
+        oldEntriesGoFirst();
+        slotsPerCallerAndInAll();
+    } catch (std::exception & err) {
+        std::cerr << "error: " << err.what() << "\n";
+        return 1;
+    }
+    return 0;
+}
