+/// The kept log's path for `base`, without the .bz2.
+fn kept_path(base: &str) -> String {
+    format!("/nix/var/log/nix/drvs/{}/{}", &base[..2], &base[2..])
+}
+
+/// Follows `base` until a call reaches the running build (earlier calls
+/// find nothing yet), then until it ends.
+fn follow(base: &str, extra: &[&str]) -> LogAnswer {
+    let mut answer = None;
+    retry(120, &format!("a follow call of {base} reaches the build"), || {
+        let mut args = vec![base];
+        if !extra.contains(&"--follow") {
+            args.push("--follow");
+        }
+        args.extend(extra);
+        let got = build_log(&args);
+        let live = got.code() == 0 && got.get("source") == "live";
+        if live {
+            answer = Some(got);
+        }
+        live
+    });
+    answer.unwrap()
+}
