+constexpr size_t readSize = size_t{64} << 10U;
+constexpr uint64_t nsPerMs = 1'000'000;
+constexpr uint64_t nsPerSec = 1'000'000'000;
+
+// When the file last changed, in ns since the epoch.
+auto mtimeNs(const struct stat & info) -> uint64_t
+{
+#ifdef __APPLE__
+    const auto & time = info.st_mtimespec;
+#else
+    const auto & time = info.st_mtim;
+#endif
+    return (static_cast<uint64_t>(time.tv_sec) * nsPerSec) + static_cast<uint64_t>(time.tv_nsec);
+}
+
+// Gives `strm` more input once it used what it had. What read() returned,
+// or 1 when there was input left.
+auto refill(int file, std::string & input, bz_stream & strm) -> ssize_t
+{
+    if (strm.avail_in != 0) {
+        return 1;
+    }
+    auto const got = ::read(file, input.data(), input.size());
+    if (got > 0) {
+        strm.next_in = input.data();
+        strm.avail_in = static_cast<unsigned>(got);
+    }
+    return got;
+}
+
+// The start a tail asks for, before moving to a line start.
+auto tailStart(uint64_t offset, uint64_t size, uint64_t tail) -> uint64_t
+{
+    return std::max(offset, size > tail ? size - tail : 0);
+}
+
+// Reads `size` bytes of `file` from `from`, in pieces, into `out`. False
+// when a read fails.
+// NOLINTNEXTLINE(bugprone-easily-swappable-parameters): an offset, then a length, as pread.
+auto readRange(int file, uint64_t from, uint64_t size, const std::function<bool(std::string_view)> & out) -> bool
+{
+    std::vector<char> buf(readSize);
+    while (size > 0) {
+        auto const want = static_cast<size_t>(std::min<uint64_t>(buf.size(), size));
+        auto const count = preadUpTo(file, std::as_writable_bytes(std::span(buf).first(want)), from);
+        if (count == 0) {
+            return false;
+        }
+        if (!out({buf.data(), count})) {
+            return true;
+        }
+        from += count;
+        size -= count;
+    }
+    return true;
+}
+
+auto countNewlines(std::string_view data) -> uint64_t
+{
+    return static_cast<uint64_t>(std::ranges::count(data, '\n'));
+}
+
+auto clientGone() -> grpc::Status
+{
