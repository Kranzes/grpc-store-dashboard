diff --git a/src/daemon/log-cache.hh b/src/daemon/log-cache.hh
new file mode 100644
index 0000000..5ebbd8e
--- /dev/null
+++ b/src/daemon/log-cache.hh
@@ -0,0 +1,607 @@
+#pragma once
+// The decode cache for GetBuildLog. A build log that must be decoded before
+// it can be served from an offset (a .bz2 kept log, or one from a store) is
+// decoded once into an unlinked temp file under TMPDIR, as log spills are.
+// Every call for the same log reads that file, also while the decode still
+// runs, so N viewers and every resume cost one decode, and a complete entry
+// has an exact size and seeks for offsets and tails.
+//
+// Decodes take slots: a few per node and fewer per caller, so one caller
+// cannot hold them all. A call that joins an entry needs no slot.
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <functional>
+#include <list>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include "log-spill.hh"
+
+namespace nixgrpc {
+
+// At most `total` decodes at once, `perCaller` of them for one caller.
+class DecodeSlots
+{
+public:
+    // NOLINTNEXTLINE(bugprone-easily-swappable-parameters): in all, then per caller.
+    DecodeSlots(unsigned total, unsigned perCaller)
+        : total(total)
+        , perCaller(perCaller)
+    {
+    }
+
+    class Slot
+    {
+    public:
+        Slot() = default;
+        Slot(DecodeSlots & slots, std::string caller)
+            : slots(&slots)
+            , caller(std::move(caller))
+        {
+        }
+        Slot(Slot && other) noexcept
+            : slots(std::exchange(other.slots, nullptr))
+            , caller(std::move(other.caller))
+        {
+        }
+        auto operator=(Slot && other) noexcept -> Slot &
+        {
+            if (this != &other) {
+                release();
+                slots = std::exchange(other.slots, nullptr);
+                caller = std::move(other.caller);
+            }
+            return *this;
+        }
+        Slot(const Slot &) = delete;
+        auto operator=(const Slot &) -> Slot & = delete;
+        ~Slot()
+        {
+            release();
+        }
+
+        void release()
+        {
+            if (auto * const owner = std::exchange(slots, nullptr)) {
+                owner->release(caller);
+            }
+        }
+
+    private:
+        DecodeSlots * slots = nullptr;
+        std::string caller;
+    };
+
+    // Waits up to `wait` for a slot, and gives up early once `cancelled()`.
+    auto acquire(const std::string & caller, std::chrono::milliseconds wait, const std::function<bool()> & cancelled)
+        -> std::optional<Slot>
+    {
+        static constexpr std::chrono::milliseconds poll{100};
+        auto const deadline = std::chrono::steady_clock::now() + wait;
+        std::unique_lock lock(mutex);
+        while (true) {
+            auto & mine = byCaller[caller];
+            if (open < total && mine < perCaller) {
+                open++;
+                mine++;
+                return Slot(*this, caller);
+            }
+            if (mine == 0) {
+                byCaller.erase(caller);
+            }
+            auto const now = std::chrono::steady_clock::now();
+            if (now >= deadline || (cancelled && cancelled())) {
+                return std::nullopt;
+            }
+            freed.wait_for(lock, std::min<std::chrono::steady_clock::duration>(poll, deadline - now));
+        }
+    }
+
+    [[nodiscard]] auto inUse() const -> unsigned
+    {
+        const std::scoped_lock lock(mutex);
+        return open;
+    }
+
+private:
+    void release(const std::string & caller)
+    {
+        {
+            const std::scoped_lock lock(mutex);
+            open--;
+            if (auto const iter = byCaller.find(caller); iter != byCaller.end() && --iter->second == 0) {
+                byCaller.erase(iter);
+            }
+        }
+        freed.notify_all();
+    }
+
+    const unsigned total;
+    const unsigned perCaller;
+    mutable std::mutex mutex;
+    std::condition_variable freed;
+    unsigned open = 0;
+    std::map<std::string, unsigned> byCaller;
+};
+
+class LogCache
+{
+public:
+    static constexpr size_t defaultEntries = 8;
+    static constexpr uint64_t defaultBytes = uint64_t{2} << 30U;
+    static constexpr std::chrono::minutes defaultKeep{5};
+    static constexpr uint64_t defaultStride = uint64_t{1} << 20U;
+    static constexpr std::chrono::hours defaultTooBigFor{1};
+    static constexpr size_t maxTooBig = 64;
+
+    struct Limits
+    {
+        size_t entries = defaultEntries;
+        uint64_t bytes = defaultBytes;
+        // How long an entry stays after its last reader left.
+        std::chrono::milliseconds keep = defaultKeep;
+        // One index entry {offset, lines} per this many bytes.
+        uint64_t stride = defaultStride;
+        // How long the cache remembers a log that did not fit, so that
+        // later calls for it decode on their own at once instead of
+        // evicting the other entries and filling the cache again.
+        std::chrono::milliseconds tooBigFor = defaultTooBigFor;
+    };
+
+    // Writes the decoded log through `write`, which returns false when the
+    // decode should stop: nobody reads it any more, or it does not fit.
+    // Returns false when the log does not decode.
+    using Write = std::function<bool(std::string_view)>;
+    using Decode = std::function<bool(const Write & write)>;
+
+    // What an entry holds at one moment.
+    struct State
+    {
+        uint64_t written = 0;
+        bool complete = false; // the whole log is here: written is its size
+        bool failed = false;   // it did not decode; written is what came before
+        // The cache dropped it: too big for the cache (this time, or lately),
+        // or no temp file. The bytes written stay readable; the rest needs a
+        // decode of its own.
+        bool uncached = false;
+
+        [[nodiscard]] auto ended() const -> bool
+        {
+            return complete || failed || uncached;
+        }
+    };
+
+    class Entry
+    {
+    public:
+        explicit Entry(std::string key)
+            : key(std::move(key))
+        {
+        }
+
+        [[nodiscard]] auto state() const -> State
+        {
+            const std::scoped_lock lock(mutex);
+            return current;
+        }
+
+        // Until more than `offset` bytes are here or the decode ended, for
+        // at most `poll`.
+        auto waitPast(uint64_t offset, std::chrono::milliseconds poll) const -> State
+        {
+            std::unique_lock lock(mutex);
+            grown.wait_for(lock, poll, [&] -> bool { return current.written > offset || current.ended(); });
+            return current;
+        }
+
+        // Reads what is there at `offset`, at most out.size() bytes.
+        [[nodiscard]] auto read(uint64_t offset, std::span<char> out) const -> size_t
+        {
+            auto const have = state().written;
+            if (offset >= have || !file) {
+                return 0;
+            }
+            auto const want = static_cast<size_t>(std::min<uint64_t>(out.size(), have - offset));
+            return preadUpTo(file.get(), std::as_writable_bytes(out.first(want)), offset);
+        }
+
+        // Newlines before `offset`, which must be written already.
+        [[nodiscard]] auto linesBefore(uint64_t offset) const -> uint64_t
+        {
+            uint64_t from = 0;
+            uint64_t lines = 0;
+            {
+                const std::scoped_lock lock(mutex);
+                if (!index.empty() && stride > 0) {
+                    auto const slot = std::min<size_t>(offset / stride, index.size() - 1);
+                    from = slot * stride;
+                    lines = index.at(slot);
+                }
+            }
+            return lines + countNewlines(from, offset);
+        }
+
+        // The first line start at or after `offset` in a complete entry, or
+        // its size when no line starts there.
+        [[nodiscard]] auto lineStartAtOrAfter(uint64_t offset) const -> uint64_t
+        {
+            auto const size = state().written;
+            if (offset == 0 || offset >= size) {
+                return std::min(offset, size);
+            }
+            std::array<char, 1> before{};
+            if (read(offset - 1, before) == 1 && before.front() == '\n') {
+                return offset;
+            }
+            std::vector<char> buf(kReadSize);
+            for (auto pos = offset; pos < size;) {
+                auto const got = read(pos, buf);
+                if (got == 0) {
+                    break;
+                }
+                auto const piece = std::span(buf).first(got);
+                if (auto const newline = std::ranges::find(piece, '\n'); newline != piece.end()) {
+                    return pos + static_cast<uint64_t>(std::distance(piece.begin(), newline)) + 1;
+                }
+                pos += got;
+            }
+            return size;
+        }
+
+        [[nodiscard]] auto readers() const -> unsigned
+        {
+            return readerCount.load();
+        }
+
+    private:
+        friend class LogCache;
+        static constexpr size_t kReadSize = size_t{64} << 10U;
+
+        [[nodiscard]] auto countNewlines(uint64_t from, uint64_t end) const -> uint64_t
+        {
+            uint64_t lines = 0;
+            std::vector<char> buf(kReadSize);
+            while (from < end) {
+                auto const got = read(from, std::span(buf).first(static_cast<size_t>(std::min<uint64_t>(buf.size(), end - from))));
+                if (got == 0) {
+                    break;
+                }
+                lines += static_cast<uint64_t>(std::count(buf.begin(), std::next(buf.begin(), static_cast<std::ptrdiff_t>(got)), '\n'));
+                from += got;
+            }
+            return lines;
+        }
+
+        const std::string key;
+        UniqueFd file;
+        uint64_t stride = 0;
