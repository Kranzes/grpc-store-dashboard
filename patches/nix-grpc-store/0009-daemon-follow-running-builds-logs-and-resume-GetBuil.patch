+/// Offsets, limits and tails on a kept log, .bz2 then plain, against the
+/// whole log.
+#[test]
+fn build_log_offsets_limits_and_tails() {
+    let base = log_drv(
+        "offsets-grpc",
+        "i=0; while [ $i -lt 3000 ]; do echo line $i of a log with some width; i=$((i+1)); done; echo > $out",
+    );
+    assert!(build_now(STORE, "offsets-grpc"));
+    let kept = kept_path(&base);
+    succeed(&["sh", "-c", r#"bzcat "$1.bz2" > /tmp/offsets.want"#, "sh", &kept]);
+    let size: u64 = succeed(&["stat", "-c", "%s", "/tmp/offsets.want"]).trim().parse().unwrap();
+    assert!(size > 100_000, "{size}");
+
+    let check = |what: &str| {
+        let all = build_log(&[&base, "--out", "/tmp/offsets.all"]);
+        assert_eq!(all.code(), 0, "{what}: {all:?}");
+        assert_eq!(all.get("source"), "kept", "{what}: {all:?}");
+        assert!(!all.get("node").is_empty(), "{what}: no x-nix-node: {all:?}");
+        same_bytes("/tmp/offsets.all", "/tmp/offsets.want");
+        for offset in [1, 777, size / 2, size - 1] {
+            let got = build_log(&[&base, "--offset", &offset.to_string(), "--out", "/tmp/offsets.part"]);
+            assert_eq!(got.code(), 0, "{what} {offset}: {got:?}");
+            assert_eq!(got.num("offset"), offset, "{what}: {got:?}");
+            succeed(&[
+                "sh",
+                "-c",
+                r#"tail -c +$(($1 + 1)) /tmp/offsets.want | cmp - /tmp/offsets.part"#,
+                "sh",
+                &offset.to_string(),
+            ]);
+            let lines = succeed(&[
+                "sh",
+                "-c",
+                r#"head -c "$1" /tmp/offsets.want | tr -cd '\n' | wc -c"#,
+                "sh",
+                &offset.to_string(),
+            ]);
+            assert_eq!(got.num("first_line"), lines.trim().parse::<u64>().unwrap(), "{what}: {got:?}");
+        }
+        // At the end: nothing. Past it: OUT_OF_RANGE.
+        let end = build_log(&[&base, "--offset", &size.to_string()]);
+        assert!(end.code() == 0 && end.num("bytes") == 0, "{what}: {end:?}");
+        let past = build_log(&[&base, "--offset", &(size + 1).to_string()]);
+        assert_eq!(past.code(), 11, "{what}: {past:?}");
+        assert!(!past.get("node").is_empty(), "{what}: {past:?}");
+        // A limit stops at that byte.
+        let head = build_log(&[&base, "--limit", "1000", "--out", "/tmp/offsets.part"]);
+        assert_eq!(head.num("bytes"), 1000, "{what}: {head:?}");
+        succeed(&["sh", "-c", "head -c 1000 /tmp/offsets.want | cmp - /tmp/offsets.part"]);
+        // A tail starts at a line start, and first_line counts what it skipped.
+        let tail = build_log(&[&base, "--tail", "5000", "--out", "/tmp/offsets.part"]);
+        assert_eq!(tail.code(), 0, "{what}: {tail:?}");
+        let start = tail.num("offset");
+        assert!(start >= size - 5000 && start < size - 5000 + 100, "{what}: {tail:?}");
+        let before = succeed(&[
+            "sh",
+            "-c",
+            r#"head -c "$1" /tmp/offsets.want | tail -c 1 | od -An -c"#,
+            "sh",
+            &start.to_string(),
+        ]);
+        assert_eq!(before.trim(), "\\n", "{what}: {tail:?}");
+        let lines = succeed(&[
+            "sh",
+            "-c",
+            r#"head -c "$1" /tmp/offsets.want | tr -cd '\n' | wc -c"#,
+            "sh",
+            &start.to_string(),
+        ]);
+        assert_eq!(tail.num("first_line"), lines.trim().parse::<u64>().unwrap(), "{what}: {tail:?}");
+        succeed(&[
+            "sh",
+            "-c",
+            r#"tail -c +$(($1 + 1)) /tmp/offsets.want | cmp - /tmp/offsets.part"#,
+            "sh",
+            &start.to_string(),
