+// Reads from `offset` until `out` is full, the file ends or a read fails.
+// Returns the bytes read.
+inline auto preadUpTo(int file, std::span<std::byte> out, std::size_t offset) -> std::size_t
+{
+    std::size_t done = 0;
+    while (done < out.size()) {
+        auto const rest = out.subspan(done);
+        auto const count = ::pread(file, rest.data(), rest.size(), static_cast<off_t>(offset + done));
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            break;
+        }
+        done += static_cast<std::size_t>(count);
+    }
+    return done;
+}
+
+// Writes all of `data` at `offset`. False when a write fails.
+inline auto pwriteAll(int file, std::span<const std::byte> data, std::size_t offset) -> bool
+{
+    while (!data.empty()) {
+        auto const count = ::pwrite(file, data.data(), data.size(), static_cast<off_t>(offset));
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            return false;
+        }
+        data = data.subspan(static_cast<std::size_t>(count));
+        offset += static_cast<std::size_t>(count);
+    }
+    return true;
+}
