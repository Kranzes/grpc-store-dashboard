+/// A follow call on a running build gets each line as the build prints it,
+/// then `ended`, and the whole log matches the file Nix kept.
+#[test]
+fn build_log_follows_a_running_build() {
+    let base = log_drv(
+        "follow-grpc",
+        "i=0; while [ $i -lt 25 ]; do echo follow-$i $(date +%s%N); sleep 0.2; i=$((i+1)); done; echo > $out",
+    );
+    build_in_background(STORE, "follow-grpc");
+    succeed(&["rm", "-f", "/tmp/follow.lines"]);
+    let got = follow(&base, &["--out", "/tmp/follow.log", "--lines", "/tmp/follow.lines"]);
+    assert_eq!(got.get("ended"), "1", "{got:?}");
+    assert!(got.num("started_ms") > 0 && got.num("assign_id") > 0, "{got:?}");
+    assert!(!got.get("node").is_empty() && !got.get("initial_node").is_empty(), "{got:?}");
+    // Each line within a second of the build printing it.
+    let lines = succeed(&["cat", "/tmp/follow.lines"]);
+    let mut seen = 0;
+    for line in lines.lines() {
+        let parts: Vec<&str> = line.split(' ').collect();
+        if parts.len() == 3 && parts[1].starts_with("follow-") {
+            let arrived: u64 = parts[0].parse().unwrap();
+            let printed: u64 = parts[2].parse().unwrap();
+            assert!(
+                arrived < printed + 1_000_000_000,
+                "{line}: {} ms late",
+                (arrived - printed) / 1_000_000
+            );
+            seen += 1;
+        }
+    }
+    assert!(seen >= 20, "{lines}");
+    // LIVE bytes are the kept log's: the daemon's own messages stay out.
+    wait_until_succeeds(&["test", "-e", &format!("{}.bz2", kept_path(&base))], 60);
+    succeed(&["sh", "-c", r#"bzcat "$1.bz2" | cmp - /tmp/follow.log"#, "sh", &kept_path(&base)]);
+}
