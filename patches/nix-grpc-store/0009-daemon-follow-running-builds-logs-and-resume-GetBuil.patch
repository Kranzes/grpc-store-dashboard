+BuildLogService::BuildLogService(Config config, Metrics & metrics, const Builder * builder)
+    : config(std::move(config))
+    , metrics(metrics)
+    , builder(builder)
+    , cache(this->config.cache)
+{
+}
+
+auto BuildLogService::serve(
+    grpc::ServerContext & context,
+    const Caller & caller,
+    const nix::remote::GetBuildLogRequest & request,
+    BuildLogStream & writer,
+    const std::optional<std::filesystem::path> & logDir) -> Served
+{
+    Served served;
+    context.AddTrailingMetadata("x-nix-node", config.advertise);
+    auto const finish = [&](grpc::Status status) -> Served {
+        served.status = std::move(status);
+        metrics.buildLogCall(served.source, served.status.error_code());
+        return served;
+    };
+    try {
+        nix::StorePath const path(request.drv_path());
+    } catch (nix::BadStorePath & err) {
+        return finish({grpc::StatusCode::INVALID_ARGUMENT, err.what()});
+    }
+    if (request.follow() && (request.limit() != 0 || request.tail() != 0)) {
+        return finish({grpc::StatusCode::INVALID_ARGUMENT, "follow takes no limit or tail"});
+    }
+    if (!calls.acquire(caller.name)) {
+        return finish(tooManyReaders(config.advertise));
+    }
+    Finally const release([&] -> void { calls.release(caller.name); });
+
+    Stream stream(context, writer, config.advertise);
+    Call call(context, caller, request, stream);
+    auto const done = [&](grpc::Status status) -> Served {
+        served.source = call.source;
+        served.offset = call.offset;
+        served.bytes = stream.sent();
+        metrics.buildLogBytes(served.source, served.bytes);
+        return finish(std::move(status));
+    };
+    try {
+        uint64_t rebuilding = 0;
+        if (builder != nullptr) {
+            if (auto run = builder->running(request.drv_path())) {
+                // Nix truncates the kept file when the build starts. Until
+                // then the kept log is the last build's. A call for another
+                // assignment gets it, and so does a call for any log that
+                // does not follow.
+                bool const started = run->shared->startedMs != 0;
+                if (request.assign_id() == run->assignId
+                    || (request.assign_id() == 0 && (started || request.follow()))) {
+                    return done(live(call, *run));
+                }
+                if (started) {
+                    rebuilding = run->assignId;
+                }
+            }
+        }
+        if (rebuilding != 0) {
+            context.AddTrailingMetadata("x-nix-rebuilding", std::to_string(rebuilding));
+            return done(
+                {grpc::StatusCode::NOT_FOUND,
+                 "no build log of " + request.drv_path() + " on " + config.advertise
+                     + ": another build of it runs here and replaced the log"});
+        }
+        if (!logDir) {
+            return done({grpc::StatusCode::UNIMPLEMENTED, config.advertise + " keeps no build logs"});
+        }
+        bool found = false;
+        auto status = kept(call, *logDir, found);
+        if (found) {
+            return done(std::move(status));
+        }
+        return done({grpc::StatusCode::NOT_FOUND, "no build log of " + request.drv_path() + " on " + config.advertise});
+    } catch (StreamClosed &) {
+        return done(clientGone());
+    }
+}
+
+auto BuildLogService::live(Call & call, const Builder::Running & run) -> grpc::Status
+{
+    auto & shared = *run.shared;
+    const auto & spill = shared.spill;
+    const auto & request = call.request;
+    call.source = "live";
+    auto const size = spill.renderedSize();
+    auto start = request.offset();
+    if (request.tail() != 0) {
+        start = spill.lineStartAtOrAfter(tailStart(start, size, request.tail()));
+    } else if (!request.follow() && start > size) {
+        return pastTheEnd();
+    }
+    call.offset = start;
+    BuildLogInfo info;
+    info.set_source(BuildLogInfo::SOURCE_LIVE);
+    info.set_size(size);
+    info.set_offset(start);
+    info.set_first_line(spill.linesBefore(start));
+    info.set_assign_id(run.assignId);
+    info.set_started_ms(shared.startedMs);
+    call.stream.setInfo(std::move(info));
+    auto const add = [&](std::string_view data) -> void { call.stream.add(data); };
+    if (!request.follow()) {
+        (void) spill.drainRendered(start, call.limit(), add);
+        call.stream.finish(false);
+        return grpc::Status::OK;
+    }
+
+    auto const open = metrics.buildLogStream();
+    auto pos = spill.drainRendered(start, std::numeric_limits<size_t>::max(), add);
+    call.stream.flush();
+    while (true) {
+        bool ended = shared.revoked;
+        {
+            // Also when the Expect left without finishing: a revoke before
+            // the start, or a give-back.
+            const std::scoped_lock lock(shared.mutex);
+            ended = ended || shared.finished || shared.left;
+        }
+        auto const before = pos;
+        pos = spill.drainRendered(pos, std::numeric_limits<size_t>::max(), add);
+        if (ended && pos >= spill.renderedSize()) {
+            call.stream.finish(true);
+            return grpc::Status::OK;
+        }
+        if (pos != before) {
+            call.stream.flush();
+        }
+        if (call.cancelled()) {
+            return clientGone();
+        }
+        if (call.expired()) {
+            return {grpc::StatusCode::UNAUTHENTICATED, "bearer token expired"};
+        }
+        if (std::chrono::steady_clock::now() - call.stream.lastSend() >= keepalive) {
+            call.stream.ping();
+        }
+        std::unique_lock lock(shared.mutex);
+        auto const done = [&] -> bool { return shared.finished || shared.left; };
+        auto const grown = [&] -> bool { return done() || spill.renderedSize() > pos; };
+        if (!shared.cv.wait_for(lock, cancelPoll, grown) || done()) {
+            continue;
+        }
+        // Gather a little more, so a chatty build costs a few messages a second.
+        shared.cv.wait_for(lock, batchWait, [&] -> bool { return done() || spill.renderedSize() - pos >= batchBytes; });
+    }
+}
+
+auto BuildLogService::kept(Call & call, const std::filesystem::path & logDir, bool & found) -> grpc::Status
+{
+    for (auto const & plainPath : keptLogPaths(logDir, call.request.drv_path())) {
+        auto bz2 = plainPath;
+        bz2 += ".bz2";
+        struct stat info{};
+        if (::stat(plainPath.c_str(), &info) == 0 || ::lstat(plainPath.c_str(), &info) == 0) {
+            found = true;
+            call.source = "kept";
+            UniqueFd const file(::open(plainPath.c_str(), O_RDONLY | O_CLOEXEC)); // NOLINT(cppcoreguidelines-pro-type-vararg)
+            if (!file || ::fstat(file.get(), &info) != 0) {
+                auto const err = errno;
+                return {grpc::StatusCode::INTERNAL, "cannot open " + plainPath.string() + ": " + std::system_category().message(err)};
+            }
+            return plain(call, file.get(), info);
+        }
+        if (::stat(bz2.c_str(), &info) == 0) {
+            found = true;
+            call.source = "kept";
+            return decoded(call, bz2, mtimeNs(info));
+        }
+    }
+    return grpc::Status::OK;
+}
+
+auto BuildLogService::plain(Call & call, int file, const struct stat & stat) -> grpc::Status
+{
+    const auto & request = call.request;
+    auto const size = static_cast<uint64_t>(stat.st_size);
+    auto start = request.offset();
+    if (request.tail() == 0 && start > size) {
+        return pastTheEnd();
+    }
+    uint64_t lines = 0;
+    if (request.tail() != 0) {
+        // The first line start at or after the tail's start, counting the
+        // newlines before it on the way.
+        auto const want = tailStart(start, size, request.tail());
+        start = want == 0 ? 0 : size;
+        uint64_t base = 0;
+        if (want > 0) {
+            (void) readRange(file, 0, size, [&](std::string_view data) -> bool {
+                for (auto pos = data.find('\n'); pos != std::string_view::npos; pos = data.find('\n', pos + 1)) {
+                    lines++;
+                    if (base + pos + 1 >= want) {
+                        start = base + pos + 1;
+                        return false;
+                    }
+                }
+                base += data.size();
+                return true;
+            });
+        }
+    } else {
+        (void) readRange(file, 0, start, [&](std::string_view data) -> bool {
+            lines += countNewlines(data);
+            return true;
+        });
+    }
+    call.offset = start;
+    call.stream.setInfo(info(call, BuildLogInfo::SOURCE_KEPT, mtimeNs(stat) / nsPerMs, start, size, lines));
+    auto left = call.limit();
+    if (!readRange(file, start, size - start, [&](std::string_view data) -> bool {
+            data = data.substr(0, static_cast<size_t>(std::min<uint64_t>(left, data.size())));
+            call.stream.add(data);
+            left -= data.size();
+            return left > 0;
+        })) {
+        return {grpc::StatusCode::INTERNAL, "cannot read the log"};
+    }
+    call.stream.finish(false);
+    return grpc::Status::OK;
+}
+
+auto BuildLogService::entry(Call & call, const std::filesystem::path & bz2, uint64_t mtime)
+    -> std::expected<LogCache::Reader, grpc::Status>
+{
+    auto const key = bz2.string() + "@" + std::to_string(mtime);
+    if (auto reader = cache.find(key)) {
+        return std::move(*reader);
+    }
+    auto slot = decodeSlot(call);
+    if (!slot) {
+        return std::unexpected(slot.error());
+    }
+    auto decode = [bz2](const LogCache::Write & write) -> bool {
+        UniqueFd const file(::open(bz2.c_str(), O_RDONLY | O_CLOEXEC)); // NOLINT(cppcoreguidelines-pro-type-vararg)
+        return file && bunzip2(file.get(), write);
+    };
+    return cache.start(key, std::move(decode), std::move(*slot));
+}
+
+// Where a call on a cached decode starts, once the entry holds it: the
+// whole log for a tail, else the bytes up to the offset. The status when
+// it cannot start there.
+auto BuildLogService::startIn(Call & call, const LogCache::Reader & entry, LogCache::State & state)
+    -> std::expected<uint64_t, grpc::Status>
+{
+    const auto & request = call.request;
+    auto const start = request.offset();
+    state = entry->state();
+    while (!state.ended() && (request.tail() != 0 || state.written < start)) {
+        if (call.cancelled()) {
+            return std::unexpected(clientGone());
+        }
+        state = entry->waitPast(state.written, cancelPoll);
+    }
+    if (state.failed && state.written < start) {
+        return std::unexpected(grpc::Status{grpc::StatusCode::DATA_LOSS, "the log does not decompress"});
+    }
+    if (request.tail() != 0 && state.complete) {
+        return entry->lineStartAtOrAfter(tailStart(start, state.written, request.tail()));
+    }
+    if (state.complete && start > state.written) {
+        return std::unexpected(pastTheEnd());
+    }
+    return start;
+}
+
+auto BuildLogService::info(
+    // NOLINTNEXTLINE(bugprone-easily-swappable-parameters): as BuildLogInfo orders them.
+    const Call & call, BuildLogInfo::Source source, uint64_t modifiedMs, uint64_t start, uint64_t size, uint64_t lines)
+    -> BuildLogInfo
+{
+    BuildLogInfo out;
+    out.set_source(source);
+    out.set_size(size);
+    out.set_offset(start);
+    out.set_first_line(lines);
+    if (source == BuildLogInfo::SOURCE_KEPT && builder != nullptr) {
+        out.set_assign_id(builder->keptBy(call.request.drv_path()));
+    }
+    out.set_modified_ms(modifiedMs);
+    return out;
+}
+
+auto BuildLogService::decoded(Call & call, const std::filesystem::path & bz2, uint64_t mtime) -> grpc::Status
+{
+    auto opened = entry(call, bz2, mtime);
+    if (!opened) {
+        return opened.error();
+    }
+    // Let go before a decode of this call's own, so the temp file of an
+    // entry that did not fit goes now and not after that decode.
+    std::optional<LogCache::Reader> held(std::move(*opened));
+    auto const & entry = *held;
+    auto const damaged = [&] -> grpc::Status { return {grpc::StatusCode::DATA_LOSS, bz2.string() + " does not decompress"}; };
+    LogCache::State state;
+    auto const start = startIn(call, entry, state);
+    if (!start) {
+        return start.error().error_code() == grpc::StatusCode::DATA_LOSS ? damaged() : start.error();
+    }
+    if (state.uncached && state.written <= *start) {
+        held.reset();
+        return direct(call, bz2, *start, false);
+    }
+    call.offset = *start;
+    call.stream.setInfo(info(
+        call, BuildLogInfo::SOURCE_KEPT, mtime / nsPerMs, *start, state.complete ? state.written : 0,
+        entry->linesBefore(*start)));
+
+    auto left = call.limit();
+    auto pos = *start;
+    std::vector<char> buf(readSize);
+    while (left > 0) {
+        auto const want = static_cast<size_t>(std::min<uint64_t>(buf.size(), left));
+        if (auto const got = entry->read(pos, std::span(buf).first(want)); got > 0) {
+            call.stream.add({buf.data(), got});
+            pos += got;
+            left -= got;
+            continue;
+        }
+        state = entry->state();
+        if (pos < state.written) {
+            continue;
+        }
+        if (state.complete) {
+            break;
+        }
+        if (state.failed) {
+            call.stream.flush();
+            return damaged();
+        }
+        if (state.uncached) {
+            held.reset();
+            return direct(call, bz2, pos, true);
+        }
+        if (call.cancelled()) {
+            return clientGone();
+        }
+        (void) entry->waitPast(pos, cancelPoll);
+    }
+    call.stream.finish(false);
+    return grpc::Status::OK;
+}
+
+auto BuildLogService::decodeSlot(Call & call) -> std::expected<DecodeSlots::Slot, grpc::Status>
+{
+    auto slot = slots.acquire(call.caller.name, decodeWait, [&] -> bool { return call.cancelled(); });
+    if (!slot) {
+        return std::unexpected(tooManyReaders(config.advertise));
+    }
+    return std::move(*slot);
+}
+
+// A log the cache does not hold: decoded again for this call alone, from
+// the start, skipping what comes before `from`.
+auto BuildLogService::direct(Call & call, const std::filesystem::path & bz2, uint64_t from, bool infoSent) -> grpc::Status
+{
+    auto const slot = decodeSlot(call);
+    if (!slot) {
+        return slot.error();
+    }
+    UniqueFd const file(::open(bz2.c_str(), O_RDONLY | O_CLOEXEC)); // NOLINT(cppcoreguidelines-pro-type-vararg)
+    if (!file) {
+        auto const err = errno;
+        return {grpc::StatusCode::INTERNAL, "cannot open " + bz2.string() + ": " + std::system_category().message(err)};
+    }
+    uint64_t pos = 0;
+    uint64_t lines = 0;
+    auto left = call.limit();
+    bool const decodes = bunzip2(file.get(), [&](std::string_view data) -> bool {
+        if (pos + data.size() <= from) {
+            lines += countNewlines(data);
+            pos += data.size();
+            return !call.cancelled();
+        }
+        if (pos < from) {
+            auto const skip = static_cast<size_t>(from - pos);
+            lines += countNewlines(data.substr(0, skip));
+            data.remove_prefix(skip);
+            pos = from;
+        }
+        if (!infoSent) {
+            infoSent = true;
+            call.offset = from;
+            call.stream.setInfo(info(call, BuildLogInfo::SOURCE_KEPT, 0, from, 0, lines));
+        }
+        data = data.substr(0, static_cast<size_t>(std::min<uint64_t>(left, data.size())));
+        call.stream.add(data);
+        left -= data.size();
+        pos += data.size();
+        return left > 0 && !call.cancelled();
+    });
+    if (call.cancelled()) {
+        return clientGone();
+    }
+    if (!decodes) {
+        call.stream.flush();
+        return {grpc::StatusCode::DATA_LOSS, bz2.string() + " does not decompress"};
+    }
+    if (!infoSent && pos < from) {
+        return pastTheEnd();
+    }
+    if (!infoSent) {
+        // An offset at the very end: no bytes, but the info all the same.
+        call.offset = from;
+        call.stream.setInfo(info(call, BuildLogInfo::SOURCE_KEPT, 0, from, pos, lines));
+    }
+    call.stream.finish(false);
+    return grpc::Status::OK;
+}
+
+} // namespace nixgrpc
diff --git a/src/daemon/build-log-service.hh b/src/daemon/build-log-service.hh
new file mode 100644
index 0000000..e74aa40
--- /dev/null
+++ b/src/daemon/build-log-service.hh
@@ -0,0 +1,114 @@
+#pragma once
+// GetBuildLog (proto/nix_remote.proto): a derivation's build log, from the
+// spill while it builds here (LIVE), else from the file Nix kept (KEPT).
+// A .bz2 kept log is decoded once into the decode cache (log-cache.hh), so
+// offsets and tails work on it and N viewers cost one decode.
+
+#include <chrono>
+#include <cstdint>
+#include <expected>
+#include <filesystem>
+#include <functional>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include <sys/stat.h>
+
+#include <grpcpp/server_context.h>
+#include <grpcpp/support/status.h>
+#include <grpcpp/support/sync_stream.h>
+
+#include "auth.hh"
+#include "coordinator.hh"
+#include "events.hh"
+#include "log-cache.hh"
+#include "metrics.hh"
+#include "nix_remote.pb.h"
+
+namespace nixgrpc {
+
+using BuildLogStream = grpc::ServerWriterInterface<nix::remote::GetBuildLogChunk>;
+
+// The log Nix kept here for `drvPath` (a base name), decoded, as `nix log`
+// finds it. Reading stops after `limit` bytes plus one, so a caller can
+// tell a larger log. nullopt: there is none. Throws for a log that cannot
+// be read or does not decompress.
+auto readKeptLog(const std::filesystem::path & logDir, const std::string & drvPath, uint64_t limit)
+    -> std::optional<std::string>;
+
+class BuildLogService
+{
+public:
+    // Per node and per caller name.
+    static constexpr unsigned maxCalls = 32;
+    static constexpr unsigned maxCallsPerCaller = 8;
+    static constexpr unsigned maxDecodes = 2;
+    static constexpr unsigned maxDecodesPerCaller = 1;
+    static constexpr std::chrono::seconds decodeWait{10};
+    // A follow call sends at most one message per wake after this, or once
+    // this much is pending.
+    static constexpr std::chrono::milliseconds batchWait{100};
+    static constexpr size_t batchBytes = size_t{64} << 10U;
+    static constexpr std::chrono::seconds keepalive{30};
+
+    struct Config
+    {
+        std::string advertise;
+        LogCache::Limits cache;
+    };
+
+    // `builder` may be null: a node that only schedules.
+    BuildLogService(Config config, Metrics & metrics, const Builder * builder);
+
+    // What the call served, for its log line.
+    struct Served
+    {
+        grpc::Status status;
+        std::string_view source = "none";
+        uint64_t offset = 0;
+        uint64_t bytes = 0;
+    };
+
+    // `logDir`: where the store keeps logs, nullopt when it keeps none.
+    auto serve(
+        grpc::ServerContext & context,
+        const Caller & caller,
+        const nix::remote::GetBuildLogRequest & request,
+        BuildLogStream & writer,
+        const std::optional<std::filesystem::path> & logDir) -> Served;
+
+private:
+    class Stream;
+    struct Call;
+
+    auto live(Call & call, const Builder::Running & run) -> grpc::Status;
+    auto kept(Call & call, const std::filesystem::path & logDir, bool & found) -> grpc::Status;
+    auto plain(Call & call, int file, const struct stat & stat) -> grpc::Status;
+    // `mtime`: of the .bz2, in ns since the epoch, which keys the cache.
+    auto decoded(Call & call, const std::filesystem::path & bz2, uint64_t mtime) -> grpc::Status;
+    auto entry(Call & call, const std::filesystem::path & bz2, uint64_t mtime)
+        -> std::expected<LogCache::Reader, grpc::Status>;
+    static auto startIn(Call & call, const LogCache::Reader & entry, LogCache::State & state)
+        -> std::expected<uint64_t, grpc::Status>;
+    // A decode slot, waited for as long as decodeWait.
+    auto decodeSlot(Call & call) -> std::expected<DecodeSlots::Slot, grpc::Status>;
+    auto direct(Call & call, const std::filesystem::path & bz2, uint64_t from, bool infoSent) -> grpc::Status;
+    // The info message of a log that is not live.
+    auto info(
+        const Call & call,
+        nix::remote::BuildLogInfo::Source source,
+        uint64_t modifiedMs,
+        uint64_t start,
+        uint64_t size,
+        uint64_t lines) -> nix::remote::BuildLogInfo;
+
+    const Config config;
+    Metrics & metrics;
+    const Builder * builder;
+    StreamLimit calls{maxCalls, maxCallsPerCaller};
+    DecodeSlots slots{maxDecodes, maxDecodesPerCaller};
+    LogCache cache;
+};
+
+} // namespace nixgrpc
