+// Where `nix log` looks for the log Nix kept of `drv` (a base name), in
+// order. Either may also be compressed, with .bz2 appended.
+auto keptLogPaths(const std::filesystem::path & logDir, const std::string & drv) -> std::array<std::filesystem::path, 2>
+{
+    auto const drvs = logDir / nix::LocalFSStore::drvsLogDir;
+    return {drvs / drv.substr(0, 2) / drv.substr(2), drvs / drv};
+}
+
+// Decompresses the bzip2 streams in `logFd`, one after another, into `out`,
+// 64 KiB at a time. As libarchive does for nix, it reads an empty file as an
+// empty log and ignores bytes after a stream that fail within 14 bytes to
+// start another. `out` returns false to stop early. False when the file does
+// not decompress.
+auto bunzip2(int logFd, const std::function<bool(std::string_view)> & out) -> bool
+{
+    static constexpr unsigned bidBytes = 14; // libarchive's bzip2 bid
+    std::string input(readSize, '\0');
+    std::string output(readSize, '\0');
+    bz_stream strm{};
+    std::unique_ptr<bz_stream, decltype(&BZ2_bzDecompressEnd)> open(nullptr, &BZ2_bzDecompressEnd);
+    bool ended = false;
+    auto const ignored = [&] -> bool { return ended && strm.total_in_hi32 == 0 && strm.total_in_lo32 < bidBytes; };
+    for (;;) {
+        if (auto const got = refill(logFd, input, strm); got <= 0) {
+            return got == 0 && (!open || ignored());
+        }
+        if (!open) {
+            if (BZ2_bzDecompressInit(&strm, 0, 0) != BZ_OK) {
+                throw nix::Error("BZ2_bzDecompressInit failed");
+            }
+            open.reset(&strm);
+        }
+        strm.next_out = output.data();
+        strm.avail_out = static_cast<unsigned>(output.size());
+        auto const ret = BZ2_bzDecompress(&strm);
+        if (ret != BZ_OK && ret != BZ_STREAM_END) {
+            return ignored();
+        }
+        if (!out({output.data(), output.size() - strm.avail_out})) {
+            return true;
+        }
+        if (ret == BZ_STREAM_END) {
+            open.reset();
+            ended = true;
+        }
+    }
+}
+
+} // namespace
+
+auto readKeptLog(const std::filesystem::path & logDir, const std::string & drvPath, uint64_t limit)
+    -> std::optional<std::string>
+{
+    std::string log;
+    auto const take = [&](std::string_view data) -> bool {
+        log.append(data.substr(0, static_cast<size_t>(std::min<uint64_t>(data.size(), limit + 1 - log.size()))));
+        return log.size() <= limit;
+    };
+    for (auto const & plainPath : keptLogPaths(logDir, drvPath)) {
+        auto bz2 = plainPath;
+        bz2 += ".bz2";
+        if (UniqueFd const file(::open(plainPath.c_str(), O_RDONLY | O_CLOEXEC)); file) { // NOLINT(cppcoreguidelines-pro-type-vararg)
+            struct stat info{};
+            if (::fstat(file.get(), &info) != 0 || !readRange(file.get(), 0, static_cast<uint64_t>(info.st_size), take)) {
+                throw nix::Error("cannot read %s", plainPath.string());
+            }
+            return log;
+        }
+        if (errno != ENOENT) {
+            throw nix::Error("cannot open %s: %s", plainPath.string(), std::system_category().message(errno));
+        }
+        if (UniqueFd const file(::open(bz2.c_str(), O_RDONLY | O_CLOEXEC)); file) { // NOLINT(cppcoreguidelines-pro-type-vararg)
+            if (!bunzip2(file.get(), take)) {
+                throw nix::Error("%s does not decompress", bz2.string());
+            }
+            return log;
+        }
+        if (errno != ENOENT) {
+            throw nix::Error("cannot open %s: %s", bz2.string(), std::system_category().message(errno));
+        }
+    }
+    return std::nullopt;
+}
+
+// One call's zstd stream of GetBuildLogChunks. The first message carries
+// `info`, and the call's initial metadata goes with it.
+class BuildLogService::Stream
+{
+public:
+    Stream(grpc::ServerContext & context, BuildLogStream & writer, const std::string & node)
+        : context(context)
+        , writer(writer)
+        , node(node)
+    {
+        ZSTD_CCtx_setParameter(cctx.get(), ZSTD_c_compressionLevel, 1);
+    }
+    Stream(const Stream &) = delete;
+    Stream(Stream &&) = delete;
+    auto operator=(const Stream &) -> Stream & = delete;
+    auto operator=(Stream &&) -> Stream & = delete;
+    ~Stream() = default;
+
+    void setInfo(BuildLogInfo value)
+    {
+        info = std::move(value);
+    }
+
+    // Decoded bytes of the log, compressed into the pending message.
+    void add(std::string_view data)
+    {
+        bytes += data.size();
+        compress({.src = data.data(), .size = data.size(), .pos = 0}, ZSTD_e_continue);
+    }
+
+    // Sends everything added so far in one message that decodes on its own,
+    // and `info` if it is still pending, even with no data.
+    void flush()
+    {
+        compress({.src = nullptr, .size = 0, .pos = 0}, ZSTD_e_flush);
+        if (!msg.data().empty() || info) {
+            send();
+        }
+    }
+
+    // An empty message, so proxies see traffic on a quiet log.
+    void ping()
+    {
+        send();
+    }
+
+    // Ends the zstd stream, with `ended` for a follow call.
+    void finish(bool ended)
+    {
+        compress({.src = nullptr, .size = 0, .pos = 0}, ZSTD_e_end);
+        msg.set_ended(ended);
+        send();
+    }
+
+    [[nodiscard]] auto sent() const -> uint64_t
+    {
+        return bytes;
+    }
+
+    [[nodiscard]] auto lastSend() const -> std::chrono::steady_clock::time_point
+    {
+        return lastWrite;
+    }
+
+private:
+    void compress(ZSTD_inBuffer input, ZSTD_EndDirective directive)
+    {
+        zstdCompressInto(*cctx, *msg.mutable_data(), input, directive, [this] -> void { send(); });
+    }
+
+    void send()
+    {
+        if (!started) {
+            context.AddInitialMetadata("x-nix-node", node);
+            started = true;
+        }
+        if (info) {
+            *msg.mutable_info() = std::move(*info);
+            info.reset();
+        }
+        if (!writer.Write(msg)) {
+            throw StreamClosed("the client went away");
+        }
+        msg.Clear();
+        lastWrite = std::chrono::steady_clock::now();
+    }
+
+    grpc::ServerContext & context;
+    BuildLogStream & writer;
+    const std::string & node;
+    std::unique_ptr<ZSTD_CCtx, decltype(&ZSTD_freeCCtx)> cctx{ZSTD_createCCtx(), ZSTD_freeCCtx};
+    GetBuildLogChunk msg;
+    std::optional<BuildLogInfo> info;
+    bool started = false;
+    uint64_t bytes = 0;
+    std::chrono::steady_clock::time_point lastWrite = std::chrono::steady_clock::now();
+};
+
+struct BuildLogService::Call
+{
+    Call(grpc::ServerContext & context, const Caller & caller, const nix::remote::GetBuildLogRequest & request, Stream & stream)
+        : context(context)
+        , caller(caller)
+        , request(request)
+        , stream(stream)
+    {
+    }
+    Call(const Call &) = delete;
+    Call(Call &&) = delete;
+    auto operator=(const Call &) -> Call & = delete;
+    auto operator=(Call &&) -> Call & = delete;
+    ~Call() = default;
+
+    grpc::ServerContext & context;
+    const Caller & caller;
+    const nix::remote::GetBuildLogRequest & request;
+    Stream & stream;
+    std::string_view source = "none";
+    uint64_t offset = 0;
+
+    [[nodiscard]] auto cancelled() const -> bool
+    {
+        return context.IsCancelled() || stopSignal >= kCancelBuilds;
+    }
+
+    [[nodiscard]] auto expired() const -> bool
+    {
+        return caller.validUntil && std::chrono::system_clock::now() > *caller.validUntil;
+    }
+
+    [[nodiscard]] auto limit() const -> uint64_t
+    {
+        return request.limit() == 0 ? std::numeric_limits<uint64_t>::max() : request.limit();
+    }
+};
