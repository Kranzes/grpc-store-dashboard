+
+// Through EventsService: a stream on a bearer token ends with
+// UNAUTHENTICATED once the scheduler would refuse that token, whether its
+// client has read the snapshot or not, and gives its slot back. A
+// certificate caller's stream on the same scheduler goes on.
+void testTokenExpiry(const std::string & dir, const std::string & base)
+{
+    using std::chrono::seconds;
+    Farm farm;
+    Issuer const issuer(dir, base);
+    std::optional<oidc::Verifier> verifier(oidc::loadConfig(dir + "/oidc.json"));
+    Tls const tls("dash-viewer");
+    Auth auth{.oidc = &verifier};
+    auth.acl.addRule(tls.name + "=watch");
+    IdleTracker idle;
+    EventsService service(farm.disp, auth, idle);
+    Server srv(service, tls);
+    auto const any = [](const rpc::WatchEvent &) -> bool { return true; };
+    auto const never = [](const rpc::WatchEvent &) -> bool { return false; };
+    auto const synced = [](const rpc::WatchEvent & event) -> bool { return event.has_snapshot_done(); };
+
+    // Already past exp plus the leeway: refused when the stream opens.
+    {
+        Stream late(*srv.stub, issuer.token("alice", Clock::now() - seconds(61)));
+        assert(!late.readUntil(any));
+        assert(late.reader->Finish().error_code() == grpc::StatusCode::UNAUTHENTICATED);
+    }
+
+    // Two to three seconds left. Alice opens all her streams with it.
+    auto const exp = Clock::now() - seconds(57);
+    auto const until = std::chrono::floor<seconds>(exp) + seconds(oidc::clockSkewSecs);
+    auto const token = issuer.token("alice", exp);
+    std::vector<std::unique_ptr<Stream>> alice;
+    alice.reserve(EventsService::maxStreamsPerCaller);
+    for (unsigned idx = 0; idx < EventsService::maxStreamsPerCaller; idx++) {
+        alice.push_back(std::make_unique<Stream>(*srv.stub, token));
+    }
+    Stream cert(*srv.certStub);
+    assert(cert.readUntil(synced));
+    // All but the first read their snapshot now. The first reads nothing
+    // before the cut, so for its client the cut falls inside the snapshot.
+    for (size_t idx = 1; idx < alice.size(); idx++) {
+        assert(alice.at(idx)->readUntil(synced));
+    }
+    for (auto & stream : alice) {
+        assert(!stream->readUntil(never));
+        auto const status = stream->reader->Finish();
+        assert(status.error_code() == grpc::StatusCode::UNAUTHENTICATED);
+        assert(status.error_message() == "bearer token expired");
+        // Not before the scheduler would refuse the token, and soon after.
+        auto const now = Clock::now();
+        assert(now > until && now < until + seconds(5));
+    }
+    const auto & first = alice.front()->events;
+    assert(first.front().has_reset() && std::ranges::any_of(first, synced));
+
+    // The certificate caller's stream outlives the cut.
+    auto const cutMs = std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now().time_since_epoch()).count();
+    assert(cert.readUntil([&](const rpc::WatchEvent & event) -> bool {
+        return event.has_stats() && event.time_ms() > static_cast<uint64_t>(cutMs);
+    }));
+
+    // Every slot came back: alice can open all her streams again, and no more.
+    // A slot frees in OnDone, which may run just after the client saw the status.
+    auto const fresh = issuer.token("alice", Clock::now() + std::chrono::minutes(5));
+    std::vector<std::unique_ptr<Stream>> again;
+    assert(wait([&] -> bool {
+        auto stream = std::make_unique<Stream>(*srv.stub, fresh);
+        if (stream->readUntil(synced)) {
+            again.push_back(std::move(stream));
+        } else {
+            assert(stream->reader->Finish().error_code() == grpc::StatusCode::RESOURCE_EXHAUSTED);
+        }
+        return again.size() == EventsService::maxStreamsPerCaller;
+    }));
+    Stream extra(*srv.stub, fresh);
+    assert(!extra.readUntil(any));
+    assert(extra.reader->Finish().error_code() == grpc::StatusCode::RESOURCE_EXHAUSTED);
+    for (auto & stream : again) {
+        stream->ctx.TryCancel();
+        assert(!stream->reader->Finish().ok());
+    }
+    cert.ctx.TryCancel();
+    assert(!cert.reader->Finish().ok());
+    srv.server->Shutdown(std::chrono::system_clock::now() + std::chrono::seconds(1));
+}
