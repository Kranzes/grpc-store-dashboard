index eeb0600..ac41a2b 100644
--- a/proto/events.proto
+++ b/proto/events.proto
@@ -19,6 +19,14 @@ package nix.remote;
 // stream with a write still in flight is cancelled instead, so a client that
 // stopped reading cannot hold it open.
 //
+// A stream opened with a bearer token ends with UNAUTHENTICATED ("bearer
+// token expired") once the scheduler would refuse that token: one minute
+// after its exp, the clock skew the scheduler allows. The check runs with
+// each event, and Stats come once a second, so the end comes at most a
+// second later. The client renews the token and reconnects. A write still
+// in flight is cancelled here too. Streams of certificate callers do not
+// end this way.
+//
 // Callers need the `watch` role or higher. For a bearer token that is an
 // --oidc-config rule with scopes ["watch"], not an OAuth scope. Anonymous
 // callers are refused even where the anonymous role would allow it, because
@@ -53,6 +61,7 @@ message WatchEvent {
     DrvState drv = 8;
     DrvGone drv_gone = 9;
     DrvCached cached = 10;
+    Stats stats = 11;
   }
 }
 
@@ -60,12 +69,19 @@ message WatchEvent {
 message Reset {
   // Random per scheduler process. seq restarts with every new instance.
   string instance = 1;
+  // When this process last became the active scheduler, Unix ms. Counters
+  // and history start here.
+  uint64 serving_since_ms = 2;
   // nix-grpc-store version of the scheduler.
   string version = 3;
   // The system the scheduler assumes for derivations that name none.
   string default_system = 4;
   // niks3 server the scheduler asks for cache hits. Empty without a cache.
   string cache_url = 5;
+  // Cumulative counters sampled once a minute, oldest first, newest last,
+  // for "last N minutes" totals right after connecting. The current
+  // values arrive with the next Stats.
+  repeated CounterSample history = 6;
 }
 
 message SnapshotDone {}
@@ -206,3 +222,54 @@ message DrvCached {
   string system = 2;
   uint64 client_id = 3;
 }
+
+// Once a second while anyone watches. Doubles as a heartbeat.
+message Stats {
+  Counters totals = 1;
+  // Per system and feature set, as in the nix_grpc_sched_system metric.
+  repeated SystemStats systems = 2;
+}
+
+// Monotonic since Reset.serving_since_ms. They restart from zero when this
+// process becomes the active scheduler again, while instance and seq carry
+// on.
+message Counters {
+  uint64 wanted = 1;     // new queue entries
+  uint64 cache_hits = 2; // Wants answered Cached, one DrvCached each
+  // Wants the cache was asked about and lacked. This counts every such Want,
+  // including a repeat Want for a drv already tracked and a Want refused
+  // for its system, which the events do not show one by one. Take miss
+  // rates from this counter.
+  uint64 cache_misses = 3;
+  uint64 assigned = 4;
+  uint64 built = 5;
+  uint64 failed = 6;
+  uint64 cancelled = 7;
+  uint64 dropped = 8;
+  uint64 requeued = 9;
+  // Sum of nar_size of BUILT outputs, i.e. bytes published to the cache.
+  uint64 published_bytes = 10;
+  // Sum of input_sources nar_bytes from workers other than the assigned
+  // one, at each assignment. An estimate of bytes fetched from the cache, not
+  // a bound either way: it leaves out inputs nobody here built, and counts an
+  // input again for every build that needs it, even once the worker has it.
+  uint64 fetched_bytes_estimate = 11;
+}
+
+message CounterSample {
+  uint64 time_ms = 1;
+  Counters counters = 2;
+}
+
+message SystemStats {
+  string system = 1;
+  // Sorted, comma-joined. Empty for none.
+  string features = 2;
+  // Keyed by what derivations require.
+  uint32 queued = 3;
+  uint32 unplaceable = 4;
+  // Keyed by what workers offer (their native system).
+  uint32 running = 5;
+  uint32 slots = 6;
+  uint32 free = 7;
+}
