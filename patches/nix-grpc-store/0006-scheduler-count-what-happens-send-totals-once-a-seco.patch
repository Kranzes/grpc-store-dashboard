+// Counters and history cover the current term as leader.
+void Dispatcher::startServingLocked()
+{
+    servingSinceMs = sampledAtMs = nowMs();
+    counters.Clear();
+    history.clear();
+}
+
+void Dispatcher::sampleLocked()
+{
+    if (history.empty()) {
+        // Everything is zero when serving starts.
+        auto & first = history.emplace_back();
+        first.set_time_ms(wallMs(servingSinceMs));
+        first.mutable_counters();
+    }
+    auto const now = nowMs();
+    if (now - sampledAtMs < minuteMs) {
+        return;
+    }
+    sampledAtMs = now;
+    auto & sample = history.emplace_back();
+    sample.set_time_ms(wallMs(now));
+    *sample.mutable_counters() = counters;
+    while (history.size() > historyLen) {
+        history.pop_front();
+    }
+}
+
+// Once a second from the stats thread, which computes `systems` once for this
+// and the gauges.
+void Dispatcher::statsEventLocked(const std::map<sched::Core::StatsKey, sched::Core::Stats> & systems)
+{
+    if (eventWatchers.empty()) {
+        return;
+    }
+    WatchEvent event;
+    auto & stats = *event.mutable_stats();
+    *stats.mutable_totals() = counters;
+    for (const auto & [key, sst] : systems) {
+        auto & sys = *stats.add_systems();
+        sys.set_system(key.system);
+        sys.set_features(key.features);
+        sys.set_queued(static_cast<uint32_t>(sst.queued));
+        sys.set_unplaceable(static_cast<uint32_t>(sst.unplaceable));
+        sys.set_running(static_cast<uint32_t>(sst.running));
+        sys.set_slots(static_cast<uint32_t>(sst.slots));
+        sys.set_free(static_cast<uint32_t>(sst.free));
+    }
+    emitLocked(std::move(event));
+}
