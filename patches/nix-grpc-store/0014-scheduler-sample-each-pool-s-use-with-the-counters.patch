From a8bb9e26e4e4e4cc4a93a5f9e0feca0bf17abf00 Mon Sep 17 00:00:00 2001
From: Ilan Joselevich <personal@ilanjoselevich.com>
Date: Thu, 19 Nov 2026 06:50:57 +0100
Subject: [PATCH 14/14] scheduler: sample each pool's use with the counters

A watcher that connects sees the counters of the last hour in
Reset.history, but each pool's slots and load only from then on. How
busy a pool was over the last hour, and whether its CPUs kept up with
its slots, starts empty on every new page.

Each CounterSample now carries a PoolSample per native system of the
connected builders: how many are up, drvs assigned to them, and the
max_jobs and free slots of those that take work, as Stats counts them.
It also carries the sums of busy CPUs and memory of the builders whose
WorkerState has them, unset while none does. The scheduler fills them
in the once-a-minute sample from the same counts as Stats, so
Reset.history's 61 samples give a new watcher the last hour. The sample
taken when serving starts has none, and so does every sample from an
older scheduler.

events-test covers the samples.
---
 proto/events.proto              | 24 +++++++++++--
 src/daemon/dispatcher-events.cc | 60 +++++++++++++++++++++++++++++++++
 src/daemon/dispatcher.hh        |  1 +
 tests/events-test.cc            | 52 ++++++++++++++++++++++++++++
 4 files changed, 135 insertions(+), 2 deletions(-)

diff --git a/proto/events.proto b/proto/events.proto
index 3645190..7289047 100644
--- a/proto/events.proto
+++ b/proto/events.proto
@@ -146,8 +146,8 @@ message Reset {
   // niks3 server the scheduler asks for cache hits. Empty without a cache.
   string cache_url = 5;
   // Cumulative counters sampled once a minute, oldest first, newest last,
-  // for "last N minutes" totals right after connecting. The current
-  // values arrive with the next Stats.
+  // for "last N minutes" totals right after connecting, with each pool's
+  // use at the time. The current values arrive with the next Stats.
   repeated CounterSample history = 6;
   // The farm cache as builders list it among their substituters
   // (--niks3-cache-url, reduced like WorkerState.substituters). Empty when
@@ -427,6 +427,26 @@ message Counters {
 message CounterSample {
   uint64 time_ms = 1;
   Counters counters = 2;
+  // The builders of each native system at the time, sorted by system. Empty
+  // in the sample taken when serving starts, and from older schedulers.
+  repeated PoolSample pools = 3;
+}
+
+// The connected builders of one native system.
+message PoolSample {
+  string system = 1;
+  uint32 builders_up = 2;
+  // As SystemStats counts them: drvs assigned to these builders, and the
+  // max_jobs and free slots of those that take work.
+  uint32 running = 3;
+  uint32 slots = 4;
+  uint32 free = 5;
+  // Summed over the builders whose WorkerState has them. Unset while none
+  // does.
+  optional uint64 cpu_busy_millicores = 6;
+  optional uint32 cpu_cores = 7;
+  optional uint64 mem_used_bytes = 8;
+  optional uint64 mem_total_bytes = 9;
 }
 
 message SystemStats {
diff --git a/src/daemon/dispatcher-events.cc b/src/daemon/dispatcher-events.cc
index c919ca5..596b596 100644
--- a/src/daemon/dispatcher-events.cc
+++ b/src/daemon/dispatcher-events.cc
@@ -243,11 +243,71 @@ void Dispatcher::sampleLocked()
     auto & sample = history.emplace_back();
     sample.set_time_ms(wallMs(now));
     *sample.mutable_counters() = counters;
+    addPoolsLocked(sample);
     while (history.size() > historyLen) {
         history.pop_front();
     }
 }
 
+// Each native system's connected builders: drvs assigned to them, slots and
+// free as Stats counts them, and their summed load. O(entries), once a minute.
+void Dispatcher::addPoolsLocked(nix::remote::CounterSample & sample) const
+{
+    struct Pool
+    {
+        uint32_t up = 0;
+        sched::Core::Stats stats;
+        std::optional<HostLoad> load;
+    };
+    std::map<std::string, Pool> pools;
+    // Rows of what workers offer carry running and slots; a row of what
+    // queued drvs need carries neither.
+    for (const auto & [key, sst] : core.stats()) {
+        if (sst.running == 0 && sst.slots == 0) {
+            continue;
+        }
+        auto & stats = pools[key.system].stats;
+        stats.running += sst.running;
+        stats.slots += sst.slots;
+        stats.free += sst.free;
+    }
+    for (size_t wid = 0; wid < core.workerCount(); wid++) {
+        const auto & wkr = core.worker(static_cast<sched::WorkerId>(wid));
+        if (!wkr.up || wkr.systems.empty()) {
+            continue;
+        }
+        auto & pool = pools[wkr.systems.front()];
+        pool.up++;
+        if (wid >= workerInfo.size()) {
+            continue;
+        }
+        const auto & load = workerInfo.at(wid).load;
+        if (!load) {
+            continue;
+        }
+        const auto & add = *load;
+        auto & sum = pool.load.has_value() ? pool.load.value() : pool.load.emplace();
+        sum.cpuBusyMillicores += add.cpuBusyMillicores;
+        sum.cpuCores += add.cpuCores;
+        sum.memUsedBytes += add.memUsedBytes;
+        sum.memTotalBytes += add.memTotalBytes;
+    }
+    for (const auto & [system, pool] : pools) {
+        auto & out = *sample.add_pools();
+        out.set_system(system);
+        out.set_builders_up(pool.up);
+        out.set_running(static_cast<uint32_t>(pool.stats.running));
+        out.set_slots(static_cast<uint32_t>(pool.stats.slots));
+        out.set_free(static_cast<uint32_t>(pool.stats.free));
+        if (pool.load) {
+            out.set_cpu_busy_millicores(pool.load->cpuBusyMillicores);
+            out.set_cpu_cores(pool.load->cpuCores);
+            out.set_mem_used_bytes(pool.load->memUsedBytes);
+            out.set_mem_total_bytes(pool.load->memTotalBytes);
+        }
+    }
+}
+
