     assert(back.up() && !back.has_cpu_busy_millicores() && !back.has_mem_total_bytes());
 }
 
+// History samples carry each native system's connected builders: assigned,
+// slots and free as Stats counts them, and the load their reports gave.
+void testPoolSamples()
+{
+    Metrics metrics("");
+    Dispatcher disp({.defaultSystem = std::string(x86), .lookupThreads = 0, .sampleEveryMs = 100}, metrics);
+    Session one;
+    Session two;
+    Session three;
+    auto busy = helloMsg("w1", 4);
+    auto * run = busy.mutable_hello()->add_running();
+    run->set_drv_path("aaaa-a.drv");
+    run->set_assign_id(1);
+    sendOne(disp, one.worker, busy);
+    sendOne(disp, two.worker, helloMsg("w2", 8));
+    auto arm = helloMsg("a1", 2);
+    arm.mutable_hello()->clear_systems();
+    arm.mutable_hello()->add_systems("aarch64-linux");
+    sendOne(disp, three.worker, arm);
+    rpc::WorkerMsg load;
+    auto * rep = load.mutable_report();
+    rep->set_cpu_busy_millicores(1500);
+    rep->set_cpu_cores(8);
+    rep->set_mem_used_bytes(3000);
+    rep->set_mem_total_bytes(8000);
+    sendOne(disp, two.worker, load);
+    std::this_thread::sleep_for(std::chrono::milliseconds(1500));
+
+    Sink sink;
+    auto watcher = disp.watch(sink.send(), sink.end());
+    assert(watcher);
+    std::optional<rpc::Reset> reset;
+    for (const auto & event : sink.take()) {
+        reset = event.has_reset() ? std::optional(event.reset()) : reset;
+    }
+    disp.unwatch(*watcher);
+    assert(reset && reset->history_size() >= 2);
+    // The sample taken when serving starts has none.
+    assert(reset->history(0).pools().empty());
+    const auto & pools = reset->history(reset->history_size() - 1).pools();
+    assert(pools.size() == 2);
+    const auto & arm64 = pools.Get(0);
+    assert(arm64.system() == "aarch64-linux" && arm64.builders_up() == 1 && arm64.slots() == 2 && arm64.free() == 2);
+    assert(!arm64.has_cpu_cores() && !arm64.has_mem_total_bytes());
+    const auto & x86pool = pools.Get(1);
+    assert(x86pool.system() == x86 && x86pool.builders_up() == 2 && x86pool.running() == 1);
+    assert(x86pool.slots() == 12 && x86pool.free() == 11);
+    assert(x86pool.cpu_busy_millicores() == 1500 && x86pool.cpu_cores() == 8);
+    assert(x86pool.mem_used_bytes() == 3000 && x86pool.mem_total_bytes() == 8000);
+}
