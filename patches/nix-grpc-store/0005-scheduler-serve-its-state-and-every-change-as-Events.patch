+// What an entry keeps besides what placing it needs: whether the cache was
+// asked, where its inputs are, and when it was placed.
+void testEntryBookkeeping()
+{
+    Core shard;
+    std::vector<Assign> out;
+    auto const w0 = hello(shard, "w0", 4);
+    auto const w1 = hello(shard, "w1", 4);
+    shard.done(lease(shard, w0, "x.drv"), {{"/nix/store/x", 100}});
+    shard.done(lease(shard, w1, "y.drv"), {{"/nix/store/y", 200}, {"/nix/store/z", 300}});
+    std::vector<std::string_view> const inputs{"/nix/store/x", "/nix/store/y", "/nix/store/src", "/nix/store/z"};
+    // One Want the cache was asked about is enough.
+    shard.want(1, {.drvPath = "a.drv", .inputs = inputs, .system = "x", .features = {}, .cpHintMs = 0, .cacheChecked = true}, 0);
+    shard.want(2, {.drvPath = "a.drv", .inputs = inputs, .system = "x", .features = {}, .cpHintMs = 0}, 0);
+    shard.want(1, {.drvPath = "b.drv", .inputs = {}, .system = "x", .features = {}, .cpHintMs = 0}, 0);
+    shard.dispatch(out);
+    assert(out.size() == 2);
+    auto const drv = *shard.findDrv("a.drv");
+    const auto & ent = shard.entry(drv);
+    assert(ent && ent->cacheChecked && !shard.entry(*shard.findDrv("b.drv"))->cacheChecked);
+    // By who built them last, in the order the inputs name them. Nobody
+    // here built the source. w1 has more of them, so it builds a.drv.
+    assert(ent->worker == w1 && ent->sources.size() == 2);
+    assert(ent->sources[0].worker == w0 && ent->sources[0].paths == 1 && ent->sources[0].narBytes == 100);
+    assert(ent->sources[1].worker == w1 && ent->sources[1].paths == 2 && ent->sources[1].narBytes == 500);
+    // Placed once the Expect is out. A Hello that reports the same
+    // assignment keeps that time, another one makes it unknown.
+    assert(ent->assignMs == 0);
+    shard.markPlaced(drv, 1234);
+    std::vector<Core::Superseded> superseded;
+    auto const again = [&](uint64_t assignId) -> void {
+        shard.hello(
+            {.addr = "w1", .systems = {"x"}, .features = {}, .maxJobs = 4, .running = {{"a.drv", assignId}}},
+            superseded);
+    };
+    again(ent->assignId);
+    assert(shard.entry(drv)->assignMs == 1234 && shard.entry(drv)->sources.size() == 2);
+    again(ent->assignId + 100);
+    assert(shard.entry(drv)->assignMs == 0 && shard.entry(drv)->worker == w1);
+}
