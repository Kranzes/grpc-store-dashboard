+    static auto passive() -> grpc::Status
+    {
+        return {grpc::StatusCode::UNAVAILABLE, "scheduler passive, another node serves"};
+    }
+
+    void OnWriteDone(bool isOk) override
+    {
+        if (!isOk) {
+            {
+                const absl::MutexLock lock(sendq->mutex);
+                sendq->closed = true;
+                sendq->writing = false;
+            }
+            ctx->TryCancel();
+            maybeDone();
+            return;
+        }
+        writeNext();
+    }
+
+    // Must not take the Dispatcher mutex: the sender cancels under it.
+    void OnCancel() override
+    {
+        {
+            const absl::MutexLock lock(sendq->mutex);
+            sendq->closed = true;
+        }
+        maybeDone();
+    }
