+#include "nix_remote.pb.h"
+#include "oidc.hh"
+#include "sched-reactor.hh"
+
+using namespace nixgrpc;
+namespace rpc = nix::remote;
+
+// NOLINTBEGIN(*-magic-numbers, bugprone-unchecked-optional-access, cppcoreguidelines-owning-memory, misc-use-internal-linkage): test setup.
+namespace {
+
+// A Dispatcher with no cache, and clients that take every message.
+struct Farm
+{
+    Metrics metrics{""};
+    Dispatcher disp{{.defaultSystem = "x86_64-linux", .lookupThreads = 0}, metrics};
+
+    auto client(std::string identity) -> Dispatcher::ClientPtr
+    {
+        return disp.connectClient([](const rpc::SchedMsg &) -> bool { return true; }, [] -> void {}, std::move(identity));
+    }
+};
+
+// EventsService without auth, to reach the reactor.
+class Open final : public rpc::Events::CallbackService
+{
+public:
+    explicit Open(Dispatcher & disp)
+        : disp(disp)
+    {
+    }
+
+    auto Watch(grpc::CallbackServerContext * ctx, const rpc::WatchRequest * /*request*/)
+        -> grpc::ServerWriteReactor<rpc::WatchEvents> * override
+    {
+        return new WatchReactor(ctx, disp, idle, [this] -> void { done++; });
+    }
+
+    // Streams that reached OnDone.
+    [[nodiscard]] auto finished() const -> int
+    {
+        return done;
+    }
+
+private:
+    Dispatcher & disp;
+    IdleTracker idle;
+    std::atomic<int> done{0};
+};
+
+// PEM text from an OpenSSL writer.
+auto pem(const std::function<int(BIO *)> & write) -> std::string
+{
+    std::unique_ptr<BIO, decltype(&BIO_free_all)> const bio(BIO_new(BIO_s_mem()), BIO_free_all);
+    assert(bio && write(bio.get()) == 1);
+    char * data = nullptr;
+    auto const len = BIO_get_mem_data(bio.get(), &data); // NOLINT(cppcoreguidelines-pro-type-cstyle-cast): macro
+    return {data, static_cast<size_t>(len)};
+}
+
+auto privatePem(EVP_PKEY * key) -> std::string
+{
+    return pem([&](BIO * bio) -> int { return PEM_write_bio_PrivateKey(bio, key, nullptr, nullptr, 0, nullptr, nullptr); });
+}
+
+using Key = std::unique_ptr<EVP_PKEY, decltype(&EVP_PKEY_free)>;
+
+// A self-signed certificate with CN `name`. It is the server's
+// certificate, the client's and the CA for both.
+struct Tls
+{
+    std::string name;
+    std::string key;
+    std::string cert;
+
+    explicit Tls(std::string commonName)
+        : name(std::move(commonName))
+    {
+        Key const pkey(EVP_EC_gen("P-256"), EVP_PKEY_free); // NOLINT(cppcoreguidelines-pro-type-vararg)
+        std::unique_ptr<X509, decltype(&X509_free)> const x509(X509_new(), X509_free);
+        assert(pkey && x509);
+        X509_set_version(x509.get(), 2);
+        ASN1_INTEGER_set(X509_get_serialNumber(x509.get()), 1);
+        X509_gmtime_adj(X509_getm_notBefore(x509.get()), -3600);
+        X509_gmtime_adj(X509_getm_notAfter(x509.get()), 3600);
+        X509_set_pubkey(x509.get(), pkey.get());
+        auto * subject = X509_get_subject_name(x509.get());
+        X509_NAME_add_entry_by_txt(
+            subject, "CN", MBSTRING_ASC,
+            reinterpret_cast<const unsigned char *>(name.c_str()), // NOLINT(cppcoreguidelines-pro-type-reinterpret-cast)
+            -1, -1, 0);
+        X509_set_issuer_name(x509.get(), subject);
+        X509V3_CTX extCtx{};
+        X509V3_set_ctx(&extCtx, x509.get(), x509.get(), nullptr, nullptr, 0);
+        auto * ext = X509V3_EXT_conf_nid(nullptr, &extCtx, NID_basic_constraints, "critical,CA:TRUE");
+        X509_add_ext(x509.get(), ext, -1);
+        X509_EXTENSION_free(ext);
+        assert(X509_sign(x509.get(), pkey.get(), EVP_sha256()) > 0);
+        key = privatePem(pkey.get());
+        cert = pem([&](BIO * bio) -> int { return PEM_write_bio_X509(bio, x509.get()); });
+    }
+};
+
+struct Server
+{
+    std::unique_ptr<grpc::Server> server;
+    std::unique_ptr<rpc::Events::Stub> stub;
+    // Over TLS with `tls` as the client certificate, if given.
+    std::unique_ptr<rpc::Events::Stub> certStub;
+
+    explicit Server(grpc::Service & service, const std::optional<Tls> & tls = std::nullopt)
+    {
+        grpc::ServerBuilder builder;
+        int port = 0;
+        int tlsPort = 0;
+        builder.AddListeningPort("127.0.0.1:0", grpc::InsecureServerCredentials(), &port);
+        if (tls) {
+            grpc::SslServerCredentialsOptions opts(GRPC_SSL_REQUEST_AND_REQUIRE_CLIENT_CERTIFICATE_AND_VERIFY);
+            opts.pem_root_certs = tls->cert;
+            opts.pem_key_cert_pairs.push_back({.private_key = tls->key, .cert_chain = tls->cert});
+            builder.AddListeningPort("127.0.0.1:0", grpc::SslServerCredentials(opts), &tlsPort);
+        }
+        builder.RegisterService(&service);
+        server = builder.BuildAndStart();
+        assert(server && port > 0);
+        // A fixed, small window, so a client that does not read holds up the
+        // server's writes at once.
+        grpc::ChannelArguments args;
+        args.SetInt(GRPC_ARG_HTTP2_BDP_PROBE, 0);
+        args.SetInt(GRPC_ARG_HTTP2_STREAM_LOOKAHEAD_BYTES, 64 * 1024);
+        stub = rpc::Events::NewStub(grpc::CreateCustomChannel(
+            "127.0.0.1:" + std::to_string(port), grpc::InsecureChannelCredentials(), args));
+        if (tls) {
+            assert(tlsPort > 0);
+            args.SetSslTargetNameOverride(tls->name);
+            auto const creds = grpc::SslCredentials(
+                {.pem_root_certs = tls->cert, .pem_private_key = tls->key, .pem_cert_chain = tls->cert});
+            certStub = rpc::Events::NewStub(
+                grpc::CreateCustomChannel("127.0.0.1:" + std::to_string(tlsPort), creds, args));
+        }
+    }
+};
+
+struct Stream
+{
+    grpc::ClientContext ctx;
+    std::unique_ptr<grpc::ClientReader<rpc::WatchEvents>> reader;
+    std::vector<rpc::WatchEvent> events;
+
+    explicit Stream(rpc::Events::Stub & stub, const std::string & token = "")
+    {
+        ctx.set_deadline(std::chrono::system_clock::now() + std::chrono::seconds(20));
+        if (!token.empty()) {
+            ctx.AddMetadata("authorization", "Bearer " + token);
+        }
+        reader = stub.Watch(&ctx, rpc::WatchRequest{});
+    }
+
+    // Reads until `stop` holds for the last event; false if the stream ended.
+    auto readUntil(const std::function<bool(const rpc::WatchEvent &)> & stop) -> bool
+    {
+        rpc::WatchEvents batch;
+        while (reader->Read(&batch)) {
+            for (const auto & event : batch.msgs()) {
+                events.push_back(event);
+                if (stop(event)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+};
+
+auto wait(const std::function<bool()> & cond) -> bool
+{
+    auto const deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    while (!cond()) {
+        if (std::chrono::steady_clock::now() > deadline) {
+            return false;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+    return true;
+}
+
+void testStream()
+{
+    Farm farm;
+    Dispatcher::Worker worker{.send = [](const rpc::SchedCmd &) -> bool { return true; }};
+    rpc::WorkerMsgs hello;
+    auto * hel = hello.add_msgs()->mutable_hello();
+    hel->set_addr("10.0.0.1:50051");
+    hel->add_systems("x86_64-linux");
+    hel->set_max_jobs(1);
+    farm.disp.workerMsgs(worker, hello);
+    auto const client = farm.client("ci-1");
+    rpc::ClientMsgs want;
+    want.add_msgs()->mutable_want()->set_drv_path("a.drv");
+    farm.disp.clientMsgs(client, want);
+
+    Open open(farm.disp);
+    Server srv(open);
+    Stream stream(*srv.stub);
+    assert(stream.readUntil([](const rpc::WatchEvent & event) -> bool { return event.has_snapshot_done(); }));
+    const auto & first = stream.events.front();
+    assert(first.has_reset() && first.time_ms() > 0);
+    size_t drvs = 0;
+    for (const auto & event : stream.events) {
+        assert(event.seq() == first.seq());
+        drvs += event.has_drv() && event.drv().phase() == rpc::DrvState::PHASE_ASSIGNED ? 1 : 0;
+    }
+    assert(stream.events.size() == 5 && drvs == 1); // reset, worker, client, drv, done
+
+    // The next change is the next seq.
+    auto const other = farm.client("ci-2");
+    auto const snapshotEvents = stream.events.size();
+    assert(stream.readUntil([&](const rpc::WatchEvent & event) -> bool {
+        return event.has_client() && event.client().id() == other->id;
+    }));
+    for (size_t idx = snapshotEvents; idx < stream.events.size(); idx++) {
+        assert(stream.events.at(idx).seq() == first.seq() + 1 + (idx - snapshotEvents));
+    }
+
+    // A client that cancels is let go.
+    {
+        Stream gone(*srv.stub);
+        assert(gone.readUntil([](const rpc::WatchEvent & event) -> bool { return event.has_snapshot_done(); }));
+        gone.ctx.TryCancel();
+        assert(wait([&] -> bool { return open.finished() == 1; }));
+    }
+
+    // Stepping down ends the stream, and a passive node opens none.
+    farm.disp.restarting();
+    assert(!stream.readUntil([](const rpc::WatchEvent &) -> bool { return false; }));
+    auto status = stream.reader->Finish();
+    assert(status.error_code() == grpc::StatusCode::UNAVAILABLE);
+    Stream passive(*srv.stub);
+    assert(!passive.readUntil([](const rpc::WatchEvent &) -> bool { return true; }));
+    status = passive.reader->Finish();
+    assert(status.error_code() == grpc::StatusCode::UNAVAILABLE);
+    assert(wait([&] -> bool { return open.finished() == 3; }));
+    srv.server->Shutdown(std::chrono::system_clock::now() + std::chrono::seconds(1));
+}
+
+// `count` queued drvs, all wanted by one client.
+auto wantMany(Farm & farm, size_t count) -> Dispatcher::ClientPtr
+{
+    auto client = farm.client("ci-big");
+    rpc::ClientMsgs msgs;
+    for (size_t idx = 0; idx < count; idx++) {
+        msgs.add_msgs()->mutable_want()->set_drv_path(std::format("{:032}-d.drv", idx));
+    }
+    farm.disp.clientMsgs(client, msgs);
+    return client;
+}
+
+// The snapshot does not count against the queue limit, and neither does one
+// change that emits more events than the limit at once.
+void testBacklog()
+{
+    Farm farm;
+    constexpr size_t drvs = 80'000; // more than SendQueue::limit
+    auto const big = wantMany(farm, drvs);
+    Open open(farm.disp);
+    Server srv(open);
+    Stream stream(*srv.stub);
+    // The whole snapshot is queued before the first write. Change something
+    // while nearly all of it still waits.
+    rpc::WatchEvents batch;
+    assert(stream.reader->Read(&batch));
+    auto const other = farm.client("ci-2");
+    assert(stream.readUntil([&](const rpc::WatchEvent & event) -> bool {
+        return event.has_client() && event.client().id() == other->id;
+    }));
+    // Caught up. One DROPPED per drv, all under one lock.
+    farm.disp.clientGone(big);
+    size_t dropped = 0;
+    bool const left = stream.readUntil([&](const rpc::WatchEvent & event) -> bool {
+        dropped += event.has_drv_gone() ? 1 : 0;
+        return event.has_client_gone() && event.client_gone().id() == big->id;
+    });
+    assert(left && dropped == drvs);
+    stream.ctx.TryCancel();
+    assert(wait([&] -> bool { return open.finished() == 1; }));
+    srv.server->Shutdown(std::chrono::system_clock::now() + std::chrono::seconds(1));
+}
+
+// A client that stopped reading does not keep its stream on a node that
+// stepped down: the write in flight is cancelled.
+void testStalledStepDown()
+{
+    Farm farm;
+    // Far more than the client's window, well below the queue limit.
+    auto const big = wantMany(farm, 20'000);
+    Open open(farm.disp);
+    Server srv(open);
+    Stream stalled(*srv.stub);
+    rpc::WatchEvents batch;
+    assert(stalled.reader->Read(&batch));
+    // Let the writer fill the flow control window.
+    std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    farm.disp.restarting();
+    assert(wait([&] -> bool { return open.finished() == 1; }));
+    stalled.ctx.TryCancel();
+    assert(!stalled.reader->Finish().ok());
+    srv.server->Shutdown(std::chrono::system_clock::now() + std::chrono::seconds(1));
+}
+
+// One caller cannot take every stream.
+void testLimit()
+{
+    StreamLimit limit(3, 2);
+    assert(limit.acquire("alice") && limit.acquire("alice"));
+    assert(!limit.acquire("alice")); // her share
+    assert(limit.acquire("bob"));
+    assert(!limit.acquire("carol")); // all three
+    limit.release("alice");
+    assert(limit.acquire("carol"));
+    limit.release("bob");
+    limit.release("carol");
+    assert(limit.acquire("alice"));
+    assert(!limit.acquire("alice"));
+    limit.release("nobody"); // never acquired: no effect
+    assert(limit.acquire("bob") && !limit.acquire("carol"));
+}
+
+// The service's own checks: anonymous callers and passive nodes are turned
+// away, the watch role is enough, and a caller gets only its share of the
+// streams.
+void testService()
+{
+    Farm farm;
+    std::optional<oidc::Verifier> verifier;
+    Tls const tls("dash-viewer");
+    Auth auth{.oidc = &verifier};
+    auth.acl.addRule(tls.name + "=watch");
+    auth.acl.allowAnonymous(Role::write);
+    IdleTracker idle;
+    EventsService service(farm.disp, auth, idle);
+    Server srv(service, tls);
+    auto const any = [](const rpc::WatchEvent &) -> bool { return true; };
+    auto const synced = [](const rpc::WatchEvent & event) -> bool { return event.has_snapshot_done(); };
+    // Anonymous callers get write here, and are still refused.
+    {
+        Stream anon(*srv.stub);
+        assert(!anon.readUntil(any));
+        assert(anon.reader->Finish().error_code() == grpc::StatusCode::UNAUTHENTICATED);
+    }
+    std::vector<std::unique_ptr<Stream>> mine;
+    for (unsigned idx = 0; idx < EventsService::maxStreamsPerCaller; idx++) {
+        mine.push_back(std::make_unique<Stream>(*srv.certStub));
+        assert(mine.back()->readUntil(synced));
+    }
+    {
+        Stream extra(*srv.certStub);
+        assert(!extra.readUntil(any));
+        assert(extra.reader->Finish().error_code() == grpc::StatusCode::RESOURCE_EXHAUSTED);
+    }
+    for (auto & stream : mine) {
+        stream->ctx.TryCancel();
+        assert(!stream->reader->Finish().ok());
+    }
+    service.setActive(false);
+    {
+        Stream passive(*srv.stub);
+        assert(!passive.readUntil(any));
+        assert(passive.reader->Finish().error_code() == grpc::StatusCode::UNAVAILABLE);
+    }
+    srv.server->Shutdown(std::chrono::system_clock::now() + std::chrono::seconds(1));
+}
+
+
+} // namespace
+// NOLINTEND(*-magic-numbers, bugprone-unchecked-optional-access, cppcoreguidelines-owning-memory, misc-use-internal-linkage)
+
+auto main() -> int
+try {
+    testStream();
+    testBacklog();
+    testStalledStepDown();
+    testLimit();
+    testService();
+    // gRPC frees TLS endpoints on EventEngine threads that can outlive the
+    // servers and channels, which races OpenSSL's atexit cleanup (see
+    // retainGrpcRuntime in src/client/channel.hh). Every test passed, so
+    // skip the exit handlers.
+    std::cout.flush();
+    std::cerr.flush();
+    std::_Exit(0);
+} catch (std::exception & err) {
+    std::cerr << err.what() << "\n";
+    return 1;
+}
