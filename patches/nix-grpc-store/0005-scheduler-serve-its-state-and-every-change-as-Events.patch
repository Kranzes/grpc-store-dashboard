diff --git a/src/daemon/dispatcher-events.cc b/src/daemon/dispatcher-events.cc
new file mode 100644
index 0000000..458f82c
--- /dev/null
+++ b/src/daemon/dispatcher-events.cc
@@ -0,0 +1,431 @@
+// The Dispatcher's side of Events.Watch (proto/events.proto): the
+// snapshot and one event per change. Everything here runs under
+// Dispatcher::mutex. Events are built only while someone watches.
+
+#include "dispatcher.hh"
+
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <format>
+#include <functional>
+#include <iterator>
+#include <map>
+#include <optional>
+#include <random>
+#include <ratio>
+#include <set>
+#include <span>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "events.pb.h"
+#include "nix_remote.pb.h"
+#include "scheduler.hh"
+
+namespace nixgrpc {
+
+using nix::remote::Done;
+using nix::remote::DrvGone;
+using nix::remote::DrvState;
+using nix::remote::WatchEvent;
+
+namespace {
+
+auto giveBackReason(const Done & done) -> std::string
+{
+    if (done.outcome() == Done::NO_SHOW) {
+        return "no client came for it";
+    }
+    switch (done.reason()) {
+    case Done::DRAINING:
+        return "the worker is draining";
+    case Done::PUBLISH_UNAVAILABLE:
+        return "the worker cannot reach the cache";
+    case Done::INPUT_UNAVAILABLE:
+        return "the worker cannot fetch its inputs";
+    case Done::UNREACHABLE:
+        return "no client came for it";
+    case Done::TRANSIENT_FAILURE:
+        return "a transient failure on the worker";
+    default:
+        return "the worker gave it back";
+    }
+}
+
+} // namespace
+
+auto Dispatcher::newInstance() -> std::string
+{
+    std::random_device rnd;
+    return std::format("{:08x}{:08x}{:08x}{:08x}", rnd(), rnd(), rnd(), rnd());
+}
+
+auto Dispatcher::unixMs() -> double
+{
+    return std::chrono::duration<double, std::milli>(std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+auto Dispatcher::wallMs(double steadyMs) const -> uint64_t
+{
+    return static_cast<uint64_t>(wallEpochMs + steadyMs);
+}
+
+auto Dispatcher::watch(WatchSend send, std::function<void()> end) -> std::optional<uint64_t>
+{
+    const Lock lock(*this);
+    if (lettingGo || !snapshotLocked(send)) {
+        return std::nullopt;
+    }
+    auto const watcher = nextEventWatcher++;
+    eventWatchers.emplace(watcher, Watcher{.send = std::move(send), .end = std::move(end)});
+    return watcher;
+}
+
+void Dispatcher::unwatch(uint64_t watcher)
+{
+    const Lock lock(*this);
+    eventWatchers.erase(watcher);
+}
+
+void Dispatcher::emitLocked(WatchEvent event)
+{
+    event.set_seq(++eventSeq);
+    event.set_time_ms(wallMs(nowMs()));
+    // False: the watcher fell behind and is being cancelled. The last watcher
+    // gets the event itself and the others get copies, so one watcher costs
+    // no copy.
+    if (eventWatchers.empty()) {
+        return;
+    }
+    auto const last = std::prev(eventWatchers.end());
+    for (auto iter = eventWatchers.begin(); iter != last;) {
+        auto const next = std::next(iter);
+        if (!iter->second.send(WatchEvent(event))) {
+            eventWatchers.erase(iter);
+        }
+        iter = next;
+    }
+    if (!last->second.send(std::move(event))) {
+        eventWatchers.erase(last);
+    }
+}
+
+// Every event carries the seq of the last change, so the first change after
+// it is one higher.
+auto Dispatcher::snapshotLocked(const WatchSend & send) -> bool
+{
+    auto const seq = eventSeq;
+    auto const now = wallMs(nowMs());
+    auto const stamped = [&](WatchEvent event) -> bool {
+        event.set_seq(seq);
+        event.set_time_ms(now);
+        return send(std::move(event));
+    };
+    WatchEvent reset;
+    auto & rst = *reset.mutable_reset();
+    rst.set_instance(instance);
+    rst.set_version(config.version);
+    rst.set_default_system(config.defaultSystem);
+    rst.set_cache_url(config.cacheUrl);
+    if (!stamped(std::move(reset))) {
+        return false;
+    }
+    for (size_t wid = 0; wid < core.workerCount(); wid++) {
+        auto const worker = static_cast<sched::WorkerId>(wid);
+        if (core.worker(worker).up && !stamped(workerEventLocked(worker))) {
+            return false;
+        }
+    }
+    for (const auto & [cid, client] : clients) {
+        if (!stamped(clientEventLocked(*client))) {
+            return false;
+        }
+    }
+    // unplaceableReason() checks every worker, and its result is the same for
+    // every drv with one system and feature set.
+    std::map<std::pair<std::string, std::vector<std::string>>, std::string> reasons;
+    for (size_t idx = 0; idx < core.entryCount(); idx++) {
+        const auto & ent = core.entry(static_cast<sched::DrvId>(idx));
+        if (!ent) {
+            continue;
+        }
+        std::string reason;
+        if (ent->unplaceable && ent->worker == sched::noWorker) {
+            auto [iter, fresh] = reasons.try_emplace({ent->system, ent->features});
+            if (fresh) {
+                iter->second = unplaceableReason(*ent);
+            }
+            reason = iter->second;
+        }
+        if (!stamped(drvEventLocked(*ent, DrvState::CAUSE_SNAPSHOT, std::move(reason)))) {
+            return false;
+        }
+    }
+    WatchEvent done;
+    done.mutable_snapshot_done();
+    return stamped(std::move(done));
+}
+
+// Stepping down: watchers reconnect through the balancer to the new leader.
+void Dispatcher::endEventWatchersLocked()
+{
+    for (auto & [key, watcher] : std::exchange(eventWatchers, {})) {
+        watcher.end();
+    }
+}
+
+auto Dispatcher::drvEventLocked(const sched::Entry & ent, DrvState::Cause cause, std::string reason) const
+    -> WatchEvent
+{
+    WatchEvent event;
+    auto & out = *event.mutable_drv();
+    out.set_drv_path(ent.drvPath);
+    out.set_cause(cause);
+    out.set_system(ent.system);
+    for (const auto & feat : ent.features) {
+        out.add_features(feat);
+    }
+    for (auto const cid : ent.followers) {
+        out.add_client_ids(cid);
+    }
+    out.set_queued_ms(ent.enqMs > 0 ? wallMs(ent.enqMs) : 0);
+    out.set_cp_hint_ms(static_cast<uint64_t>(ent.cpHint));
+    out.set_inputs(static_cast<uint32_t>(ent.inputs.size()));
+    out.set_cache_checked(ent.cacheChecked);
+    if (ent.worker == sched::noWorker) {
+        out.set_phase(ent.unplaceable ? DrvState::PHASE_UNPLACEABLE : DrvState::PHASE_QUEUED);
+        if (ent.unplaceable && reason.empty()) {
+            reason = unplaceableReason(ent);
+        }
+        out.set_reason(std::move(reason));
+        return event;
+    }
+    out.set_phase(DrvState::PHASE_ASSIGNED);
+    out.set_reason(std::move(reason));
+    out.set_worker_addr(core.worker(ent.worker).addr);
+    out.set_assign_id(ent.assignId);
+    out.set_assigned_ms(ent.assignMs > 0 ? wallMs(ent.assignMs) : 0);
+    uint32_t known = 0;
+    for (const auto & src : ent.sources) {
+        auto & source = *out.add_input_sources();
+        source.set_worker_addr(core.worker(src.worker).addr);
+        source.set_paths(src.paths);
+        source.set_nar_bytes(src.narBytes);
+        known += src.paths;
+    }
+    out.set_inputs_unknown(static_cast<uint32_t>(ent.inputs.size()) - known);
+    return event;
+}
+
+auto Dispatcher::workerEventLocked(sched::WorkerId wid) const -> WatchEvent
+{
+    WatchEvent event;
+    const auto & wkr = core.worker(wid);
+    auto & out = *event.mutable_worker();
+    out.set_addr(wkr.addr);
+    for (const auto & system : wkr.systems) {
+        out.add_systems(system);
+    }
+    for (const auto & feat : wkr.features) {
+        out.add_features(feat);
+    }
+    out.set_max_jobs(static_cast<uint32_t>(wkr.maxJobs));
+    out.set_up(wkr.up);
+    out.set_draining(wkr.draining);
+    return event;
+}
+
+auto Dispatcher::clientEventLocked(const Client & client) const -> WatchEvent
+{
+    WatchEvent event;
+    auto & out = *event.mutable_client();
+    out.set_id(client.id);
+    out.set_identity(client.identity);
+    out.set_connected_ms(wallMs(client.connectedMs));
+    return event;
+}
+
+void Dispatcher::drvChangedLocked(sched::DrvId drv, DrvState::Cause cause, std::string reason)
+{
+    if (const auto & ent = core.entry(drv); ent && !eventWatchers.empty()) {
+        emitLocked(drvEventLocked(*ent, cause, std::move(reason)));
+    }
+}
+
+void Dispatcher::drvGoneLocked(std::string drvPath, DrvGone::Outcome outcome, sched::WorkerId wid, const Done * done)
+{
+    if (eventWatchers.empty()) {
+        return;
+    }
+    WatchEvent event;
+    auto & gone = *event.mutable_drv_gone();
+    gone.set_drv_path(std::move(drvPath));
+    gone.set_outcome(outcome);
+    if (wid != sched::noWorker) {
+        gone.set_worker_addr(core.worker(wid).addr);
+    }
+    if (outcome == DrvGone::BUILT && done != nullptr) {
+        for (const auto & output : done->outputs()) {
+            auto & out = *gone.add_outputs();
+            out.set_path(output.path());
+            out.set_nar_size(output.nar_size());
+        }
+    }
+    emitLocked(std::move(event));
+}
+
+void Dispatcher::workerChangedLocked(sched::WorkerId wid)
+{
+    if (!eventWatchers.empty()) {
+        emitLocked(workerEventLocked(wid));
+    }
+}
+
+void Dispatcher::clientConnectedLocked(const Client & client)
+{
+    if (!eventWatchers.empty()) {
+        emitLocked(clientEventLocked(client));
+    }
+}
+
+void Dispatcher::clientLeftLocked(sched::ClientId cid)
+{
+    if (!eventWatchers.empty()) {
+        WatchEvent event;
+        event.mutable_client_gone()->set_id(cid);
+        emitLocked(std::move(event));
+    }
+}
+
+void Dispatcher::wantedLocked(const sched::Core::WantResult & res)
+{
+    drvChangedLocked(res.drv, res.fresh ? DrvState::CAUSE_WANTED : DrvState::CAUSE_FOLLOWERS);
+}
+
+void Dispatcher::cachedLocked(const Client & client, const nix::remote::Want & want)
+{
+    if (eventWatchers.empty()) {
+        return;
+    }
+    WatchEvent event;
+    auto & hit = *event.mutable_cached();
+    hit.set_drv_path(want.drv_path());
+    if (want.system().size() <= maxSystemLen) {
+        hit.set_system(std::string(systemFor(want.system())));
+    }
+    hit.set_client_id(client.id);
+    emitLocked(std::move(event));
+}
+
+auto Dispatcher::heldLocked(sched::WorkerId wid) const -> std::vector<Tracked>
+{
+    std::vector<Tracked> held;
+    for (auto const drv : core.worker(wid).running) {
+        if (drv >= core.entryCount()) {
+            continue;
+        }
+        if (const auto & ent = core.entry(drv); ent && ent->worker == wid) {
+            held.push_back({.drv = drv, .path = ent->drvPath, .worker = wid});
+        }
+    }
+    return held;
+}
+
+auto Dispatcher::followedLocked(sched::ClientId cid, std::span<const sched::DrvId> wanted) const
+    -> std::vector<Tracked>
+{
+    if (eventWatchers.empty()) {
+        return {};
+    }
+    std::vector<sched::DrvId> drvs(wanted.begin(), wanted.end());
+    std::ranges::sort(drvs);
+    auto const dups = std::ranges::unique(drvs);
+    drvs.erase(dups.begin(), dups.end());
+    std::vector<Tracked> followed;
+    for (auto const drv : drvs) {
+        if (drv >= core.entryCount()) {
+            continue;
+        }
+        if (const auto & ent = core.entry(drv); ent && std::ranges::contains(ent->followers, cid)) {
+            followed.push_back({.drv = drv, .path = ent->drvPath, .worker = ent->worker});
+        }
+    }
+    return followed;
+}
+
+void Dispatcher::settledLocked(const std::vector<Tracked> & tracked, DrvState::Cause cause, const std::string & reason)
+{
+    for (const auto & was : tracked) {
+        const auto & ent = core.entry(was.drv);
+        // Within one Hello a retired id may be reused already, and the drv
+        // may be back under another id, which adoptedLocked reports.
+        if (!ent || ent->drvPath != was.path) {
+            if (!core.findDrv(was.path)) {
+                drvGoneLocked(was.path, DrvGone::DROPPED, was.worker);
+            }
+            continue;
+        }
+        if (cause == DrvState::CAUSE_REQUEUED && ent->worker != sched::noWorker) {
+            continue; // reported again by the same Hello, adoptedLocked tells
+        }
+        drvChangedLocked(was.drv, cause, reason);
+    }
+}
+
+void Dispatcher::workerGoneLocked(sched::WorkerId wid, const std::string & reason)
+{
+    bool const wasUp = core.worker(wid).up;
+    auto const held = heldLocked(wid);
+    core.workerGone(wid);
+    settledLocked(held, DrvState::CAUSE_REQUEUED, reason);
+    if (wasUp) {
+        workerChangedLocked(wid);
+    }
+}
+
+// After Hello: what the worker stopped reporting since its last Hello on an
+// open session, the worker itself, then what it reports now. The worker goes
+// first so that no drv is ever assigned to a worker the watchers have not seen.
+void Dispatcher::adoptedLocked(sched::WorkerId wid, const nix::remote::Hello & hel, const std::vector<Tracked> & before)
+{
+    settledLocked(before, DrvState::CAUSE_REQUEUED, "the worker reconnected without it");
+    workerChangedLocked(wid);
+    std::set<sched::DrvId> reported;
+    for (const auto & run : hel.running()) {
+        auto const drv = core.findDrv(run.drv_path());
+        if (drv && reported.insert(*drv).second) {
+            drvChangedLocked(*drv, DrvState::CAUSE_ADOPTED);
+        }
+    }
+}
+
+void Dispatcher::doneLocked(sched::WorkerId wid, const Done & done, bool assigned)
+{
+    if (!assigned) {
+        return; // stale: not this worker's
+    }
+    switch (done.outcome()) {
+    case Done::GIVEN_BACK:
+    case Done::NO_SHOW:
+        // Back in the queue, or retired when no client follows it.
+        if (auto const drv = core.findDrv(done.drv_path())) {
+            drvChangedLocked(*drv, DrvState::CAUSE_REQUEUED, giveBackReason(done));
+        } else {
+            drvGoneLocked(done.drv_path(), DrvGone::DROPPED, wid);
+        }
+        break;
+    case Done::BUILT:
+        drvGoneLocked(done.drv_path(), DrvGone::BUILT, wid, &done);
+        break;
+    case Done::FAILED:
+        drvGoneLocked(done.drv_path(), DrvGone::FAILED, wid);
+        break;
+    default:
+        drvGoneLocked(done.drv_path(), DrvGone::CANCELLED, wid);
+    }
+}
+
