new file mode 100644
index 0000000..43309f1
--- /dev/null
+++ b/src/daemon/events.hh
@@ -0,0 +1,69 @@
+#pragma once
+// Events.Watch: a read-only live view of the active scheduler
+// (proto/events.proto). Served next to the Scheduler service.
+
+#include <absl/base/thread_annotations.h>
+#include <absl/synchronization/mutex.h>
+#include <atomic>
+#include <map>
+#include <string>
+
+#include <grpcpp/server_context.h>
+#include <grpcpp/support/server_callback.h>
+
+#include "auth.hh"
+#include "dispatcher.hh"
+#include "events.grpc.pb.h"
+#include "events.pb.h"
+#include "idle.hh"
+
+namespace nixgrpc {
+
+// Open streams, in total and per caller, so one caller cannot take them all.
+class StreamLimit
+{
+public:
+    // NOLINTNEXTLINE(bugprone-easily-swappable-parameters): in all, then per caller.
+    StreamLimit(unsigned total, unsigned perCaller)
+        : total(total)
+        , perCaller(perCaller)
+    {
+    }
+
+    [[nodiscard]] auto acquire(const std::string & caller) -> bool;
+    void release(const std::string & caller);
+
+private:
+    const unsigned total;
+    const unsigned perCaller;
+    absl::Mutex mutex;
+    unsigned open ABSL_GUARDED_BY(mutex) = 0;
+    std::map<std::string, unsigned> byCaller ABSL_GUARDED_BY(mutex);
+};
+
+class EventsService final : public nix::remote::Events::CallbackService
+{
+public:
+    // As EdsService: each stream holds a snapshot's worth of memory.
+    static constexpr unsigned maxStreams = 64;
+    static constexpr unsigned maxStreamsPerCaller = 8;
+
+    EventsService(Dispatcher & dispatcher, Auth & auth, IdleTracker & idle);
+
+    auto Watch(grpc::CallbackServerContext * context, const nix::remote::WatchRequest * request)
+        -> grpc::ServerWriteReactor<nix::remote::WatchEvents> * override;
+
+    void setActive(bool active)
+    {
+        active_ = active;
+    }
+
+private:
+    Dispatcher * dispatcher;
+    Auth * auth;
+    IdleTracker * idle;
+    std::atomic<bool> active_{true};
+    StreamLimit streams{maxStreams, maxStreamsPerCaller};
+};
+
+} // namespace nixgrpc
