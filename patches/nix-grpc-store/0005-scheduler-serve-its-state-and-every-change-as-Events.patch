+// Events.Watch: the Dispatcher's snapshot, then its events. Ends when the
+// client cancels, falls too far behind after the snapshot, or the node stops
+// serving (UNAVAILABLE, so the client goes back through the balancer).
+class WatchReactor final : public grpc::ServerWriteReactor<nix::remote::WatchEvents>
+{
+public:
+    struct Queue : SendQueue<nix::remote::WatchEvent, nix::remote::WatchEvents>
+    {
+        // Events queued after SnapshotDone. They sit behind the snapshot's.
+        size_t deltas ABSL_GUARDED_BY(mutex) = 0;
+    };
+
+    // `done` runs last, in OnDone.
+    WatchReactor(
+        grpc::CallbackServerContext * ctx, Dispatcher & disp, IdleTracker & idle, std::function<void()> done)
+        : active(idle)
+        , ctx(ctx)
+        , disp(disp)
+        , sendq(std::make_shared<Queue>())
+        , done(std::move(done))
+    {
+        watcher = disp.watch(sender(), ender());
+        if (!watcher) {
+            {
+                const absl::MutexLock lock(sendq->mutex);
+                sendq->closed = true;
+                status = passive();
+            }
+            maybeDone();
+        }
+    }
