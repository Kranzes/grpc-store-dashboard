diff --git a/proto/events.proto b/proto/events.proto
new file mode 100644
index 0000000..eeb0600
--- /dev/null
+++ b/proto/events.proto
@@ -0,0 +1,208 @@
+syntax = "proto3";
+
+package nix.remote;
+
+// The scheduler's events: a read-only live view of the active scheduler,
+// for anything that follows a farm as it runs, such as a dashboard or a
+// script.
+//
+// Watch sends a snapshot of the scheduler's state, then one event per change.
+// A snapshot starts with Reset and ends with SnapshotDone, and every event in
+// it carries Reset's seq. Each event after the snapshot has seq one higher
+// than the one before. A client that sees any other seq drops its state and
+// reconnects for a fresh snapshot. The server cancels a watcher that falls
+// too far behind instead of skipping events.
+//
+// Only the active scheduler serves Watch. A passive node answers UNAVAILABLE,
+// and the active node ends open streams with UNAVAILABLE when it steps down,
+// so clients reconnect through the balancer and reach the new leader. A
+// stream with a write still in flight is cancelled instead, so a client that
+// stopped reading cannot hold it open.
+//
+// Callers need the `watch` role or higher. For a bearer token that is an
+// --oidc-config rule with scopes ["watch"], not an OAuth scope. Anonymous
+// callers are refused even where the anonymous role would allow it, because
+// the stream names clients and derivations. A scheduler serves at most 64
+// streams, 8 per caller, and answers RESOURCE_EXHAUSTED beyond that.
+//
+// Kept self-contained (no imports) so clients can vendor this one file.
+service Events {
+  rpc Watch(WatchRequest) returns (stream WatchEvents);
+}
+
+message WatchRequest {}
+
+// Events are batched per stream message, like the scheduler's other streams.
+message WatchEvents {
+  repeated WatchEvent msgs = 1;
+}
+
+message WatchEvent {
+  uint64 seq = 1;
+  // When the event happened, Unix ms: the scheduler's wall clock at process
+  // start plus monotonic time since. It never goes backwards within one
+  // instance and does not follow later system clock steps. Every *_ms field
+  // uses this clock.
+  uint64 time_ms = 2;
+  oneof event {
+    Reset reset = 3;
+    SnapshotDone snapshot_done = 4;
+    WorkerState worker = 5;
+    ClientState client = 6;
+    ClientGone client_gone = 7;
+    DrvState drv = 8;
+    DrvGone drv_gone = 9;
+    DrvCached cached = 10;
+  }
+}
+
+// First event of every snapshot: drop all state.
+message Reset {
+  // Random per scheduler process. seq restarts with every new instance.
+  string instance = 1;
+  // nix-grpc-store version of the scheduler.
+  string version = 3;
+  // The system the scheduler assumes for derivations that name none.
+  string default_system = 4;
+  // niks3 server the scheduler asks for cache hits. Empty without a cache.
+  string cache_url = 5;
+}
+
+message SnapshotDone {}
+
+// A builder's session. Upsert keyed by addr, sent in the snapshot (connected
+// workers only) and on Hello, Load and disconnect. A worker that went away
+// stays known with up = false until it says Hello again.
+message WorkerState {
+  // The address the balancer reaches it at (its --advertise).
+  string addr = 1;
+  // Native system first, then extra platforms.
+  repeated string systems = 2;
+  repeated string features = 3;
+  uint32 max_jobs = 4;
+  bool up = 5;
+  // Stopping, or low on disk. The scheduler cannot tell which.
+  bool draining = 6;
+}
+
+// One Schedule stream: a build client. Hook-mode builds open one per
+// derivation, so group clients by identity for display.
+message ClientState {
+  uint64 id = 1;
+  // Certificate CN, "oidc:<provider>:<sub>" for a bearer token, or "-" for
+  // an anonymous caller.
+  string identity = 2;
+  uint64 connected_ms = 3;
+}
+
+message ClientGone {
+  uint64 id = 1;
+}
+
+// A derivation the scheduler is tracking: queued or assigned. Upsert keyed by
+// drv_path. Removed by DrvGone.
+message DrvState {
+  enum Phase {
+    PHASE_QUEUED = 0;
+    // No connected worker offers its system and features. Still queued.
+    PHASE_UNPLACEABLE = 1;
+    // Sent to a worker. Covers the client's upload, input fetching, the
+    // build and publishing outputs: the scheduler does not see a build start.
+    PHASE_ASSIGNED = 2;
+  }
+  // What made the scheduler send this update.
+  enum Cause {
+    CAUSE_SNAPSHOT = 0;
+    // No entry existed: the first Want for it. `cache_checked` tells whether
+    // the cache was asked first and missed.
+    CAUSE_WANTED = 1;
+    // A Want for a drv already tracked (by another client, by the same
+    // client again, or its first Want after a worker's Hello reported it),
+    // or a client cancelled or left and the drv stays. An assigned drv stays
+    // with empty client_ids after its last client leaves, until its worker
+    // reports an outcome.
+    CAUSE_FOLLOWERS = 2;
+    CAUSE_ASSIGNED = 3;
+    // A worker's Hello reported it as running: after a scheduler restart,
+    // when a worker reconnects or says Hello again, or when it takes over a
+    // drv queued here or placed on another worker (superseded).
+    CAUSE_ADOPTED = 4;
+    // Back in the queue: given back, never claimed, or its worker
+    // disconnected or reconnected without it. `reason` says which. Also sent,
+    // with reason "the worker's stream broke", for a drv whose Expect could
+    // not be delivered, which was never shown as ASSIGNED. A drv another
+    // worker reports as running comes as CAUSE_ADOPTED.
+    CAUSE_REQUEUED = 5;
+    // `phase` switched between PHASE_QUEUED and PHASE_UNPLACEABLE.
+    CAUSE_PLACEABILITY = 6;
+  }
+  string drv_path = 1; // base name, "<hash>-<name>.drv"
+  Phase phase = 2;
+  Cause cause = 3;
+  // Required system and features. Empty for a drv only known from a
+  // worker's Hello.
+  string system = 4;
+  repeated string features = 5;
+  // Schedule streams waiting for it.
+  repeated uint64 client_ids = 6;
+  // First Want, Unix ms. 0 when unknown (adopted after a restart).
+  uint64 queued_ms = 7;
+  // Remaining critical path the clients reported, ms. Higher goes first.
+  uint64 cp_hint_ms = 8;
+  // Number of input paths (sources and input drv outputs).
+  uint32 inputs = 9;
+  bool cache_checked = 10;
+  // UNPLACEABLE: why. REQUEUED: why it came back.
+  string reason = 11;
+
+  // ASSIGNED only.
+  string worker_addr = 12;
+  uint64 assign_id = 13;
+  uint64 assigned_ms = 14;
+  // Where the inputs are, from what the scheduler remembers about recent
+  // builds: one entry per worker that built some of them. Inputs built on the
+  // assigned worker are local. Inputs built elsewhere come through the cache.
+  // Inputs nobody here built (sources, uploads, older cache content) count in
+  // inputs_unknown.
+  repeated InputSource input_sources = 15;
+  uint32 inputs_unknown = 16;
+}
+
+message InputSource {
+  string worker_addr = 1;
+  uint32 paths = 2;
+  uint64 nar_bytes = 3;
+}
+
+// A derivation left the scheduler.
+message DrvGone {
+  enum Outcome {
+    BUILT = 0;
+    FAILED = 1;
+    // The worker reported the build as cancelled.
+    CANCELLED = 2;
+    // Nobody wants it any more: every client cancelled or left a queued drv,
+    // or its worker gave it back, went away or reconnected without it while
+    // no client was waiting.
+    DROPPED = 3;
+  }
+  string drv_path = 1;
+  Outcome outcome = 2;
+  // The worker it was assigned to, if any.
+  string worker_addr = 3;
+  // BUILT only. These have been published to the cache.
+  repeated Output outputs = 4;
+}
+
+message Output {
+  string path = 1;
+  uint64 nar_size = 2;
+}
+
+// A Want answered from the cache: all outputs were already there. The
+// scheduler keeps no entry for it.
+message DrvCached {
+  string drv_path = 1;
+  string system = 2;
+  uint64 client_id = 3;
+}
