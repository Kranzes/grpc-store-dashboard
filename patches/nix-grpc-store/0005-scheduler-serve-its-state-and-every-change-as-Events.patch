new file mode 100644
index 0000000..56c1371
--- /dev/null
+++ b/tests/events-test.cc
@@ -0,0 +1,1058 @@
+// Events.Watch at the Dispatcher, without gRPC. A seeded random farm of
+// clients and workers runs against one Dispatcher while a watcher rebuilds
+// the state from the snapshot and the events, as a dashboard does. After
+// every step that state must equal a fresh snapshot, and the events must
+// match what the step did.
+
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <exception>
+#include <format>
+#include <functional>
+#include <iostream>
+#include <iterator>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <random>
+#include <set>
+#include <string>
+#include <string_view>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+#include "dispatcher.hh"
+#include "events.pb.h"
+#include "metrics.hh"
+#include "nix_remote.pb.h"
+
+using namespace nixgrpc;
+namespace rpc = nix::remote;
+
+// NOLINTBEGIN(*-magic-numbers, *-avoid-unchecked-container-access, bugprone-unchecked-optional-access, readability-identifier-length, cert-msc32-c, cert-msc51-cpp, bugprone-random-generator-seed, misc-use-internal-linkage): test vectors, seeded on purpose.
+namespace {
+
+// What the Dispatcher sends one watcher. Closures may run on its stats thread.
+struct Sink
+{
+    std::mutex mutex;
+    std::vector<rpc::WatchEvent> events;
+    bool ended = false;
+
+    auto send() -> Dispatcher::WatchSend
+    {
+        return [this](rpc::WatchEvent && event) -> bool {
+            const std::scoped_lock lock(mutex);
+            events.push_back(std::move(event));
+            return true;
+        };
+    }
+
+    auto end() -> std::function<void()>
+    {
+        return [this] -> void {
+            const std::scoped_lock lock(mutex);
+            ended = true;
+        };
+    }
+
+    auto take() -> std::vector<rpc::WatchEvent>
+    {
+        const std::scoped_lock lock(mutex);
+        return std::exchange(events, {});
+    }
+};
+
+// A watcher's state, rebuilt from the stream.
+struct Model
+{
+    std::optional<uint64_t> seq;
+    bool live = false;
+    rpc::Reset reset;
+    std::map<std::string, rpc::WorkerState> workers;
+    std::map<uint64_t, rpc::ClientState> clients;
+    std::map<std::string, rpc::DrvState> drvs;
+};
+
+// Which kinds of event the random runs produced, to know they covered all.
+std::map<std::string, size_t> seen; // NOLINT(cppcoreguidelines-avoid-non-const-global-variables)
+
+void count(const rpc::WatchEvent & event)
+{
+    if (event.has_drv()) {
+        const auto & drv = event.drv();
+        seen[rpc::DrvState::Cause_Name(drv.cause())]++;
+        if (drv.phase() == rpc::DrvState::PHASE_UNPLACEABLE) {
+            seen["unplaceable"]++;
+        }
+        if (drv.reason() == "the worker's stream broke") {
+            seen["undeliverable"]++;
+        }
+    } else if (event.has_drv_gone()) {
+        seen[rpc::DrvGone::Outcome_Name(event.drv_gone().outcome())]++;
+    } else {
+        seen[std::to_string(event.event_case())]++;
+    }
+}
+
+// "path:CAUSE" or "path:OUTCOME" for drv events, else the kind.
+auto label(const rpc::WatchEvent & event) -> std::string
+{
+    if (event.has_drv()) {
+        return event.drv().drv_path() + ":" + rpc::DrvState::Cause_Name(event.drv().cause());
+    }
+    if (event.has_drv_gone()) {
+        return event.drv_gone().drv_path() + ":" + rpc::DrvGone::Outcome_Name(event.drv_gone().outcome());
+    }
+    if (event.has_worker()) {
+        return "worker";
+    }
+    return event.has_client() ? "client" : "other";
+}
+
+// Applies one event as a client must: seq checks, then upserts and removals.
+void apply(Model & model, const rpc::WatchEvent & event)
+{
+    if (event.has_reset()) {
+        model = Model{.seq = event.seq(), .reset = event.reset()};
+        return;
+    }
+    assert(model.seq);
+    if (!model.live) {
+        assert(event.seq() == *model.seq);
+    } else {
+        assert(event.seq() == *model.seq + 1);
+        model.seq = event.seq();
+    }
+    switch (event.event_case()) {
+    case rpc::WatchEvent::kSnapshotDone:
+        assert(!model.live);
+        model.live = true;
+        break;
+    case rpc::WatchEvent::kWorker:
+        model.workers[event.worker().addr()] = event.worker();
+        break;
+    case rpc::WatchEvent::kClient:
+        model.clients[event.client().id()] = event.client();
+        break;
+    case rpc::WatchEvent::kClientGone:
+        assert(model.clients.erase(event.client_gone().id()) == 1);
+        break;
+    case rpc::WatchEvent::kDrv: {
+        const auto & drv = event.drv();
+        assert(model.live == (drv.cause() != rpc::DrvState::CAUSE_SNAPSHOT));
+        // Every event leaves a consistent state, not just the last one.
+        if (drv.phase() == rpc::DrvState::PHASE_ASSIGNED) {
+            assert(model.workers.contains(drv.worker_addr()) && model.workers.at(drv.worker_addr()).up());
+        }
+        for (auto const cid : drv.client_ids()) {
+            assert(model.clients.contains(cid));
+        }
+        model.drvs[drv.drv_path()] = drv;
+        break;
+    }
+    case rpc::WatchEvent::kDrvGone:
+        assert(model.drvs.erase(event.drv_gone().drv_path()) == 1);
+        break;
+    case rpc::WatchEvent::kCached:
+        assert(model.live);
+        break;
+    default:
+        assert(false && "unknown event");
+    }
+}
+
+// The parts a snapshot reproduces: cause and reason belong to one event.
+auto normal(const Model & model) -> std::map<std::string, std::string>
+{
+    std::map<std::string, std::string> out;
+    for (const auto & [addr, wkr] : model.workers) {
+        if (wkr.up()) {
+            out["worker " + addr] = wkr.DebugString();
+        }
+    }
+    for (const auto & [cid, client] : model.clients) {
+        out["client " + std::to_string(cid)] = client.DebugString();
+    }
+    for (const auto & [path, drv] : model.drvs) {
+        auto copy = drv;
+        copy.clear_cause();
+        copy.clear_reason();
+        out["drv " + path] = copy.DebugString();
+        for (auto const cid : drv.client_ids()) {
+            assert(model.clients.contains(cid));
+        }
+        if (drv.phase() == rpc::DrvState::PHASE_ASSIGNED) {
+            assert(model.workers.contains(drv.worker_addr()) && model.workers.at(drv.worker_addr()).up());
+        } else {
+            assert(drv.worker_addr().empty() && drv.input_sources().empty());
+        }
+    }
+    return out;
+}
+
+auto snapshot(Dispatcher & disp) -> Model
+{
+    Sink sink;
+    auto const watcher = disp.watch(sink.send(), sink.end());
+    assert(watcher);
+    disp.unwatch(*watcher);
+    Model model;
+    for (const auto & event : sink.take()) {
+        apply(model, event);
+    }
+    assert(model.live);
+    return model;
+}
+
+void assertSame(const Model & got, const Model & want)
+{
+    auto const lhs = normal(got);
+    auto const rhs = normal(want);
+    if (lhs == rhs) {
+        return;
+    }
+    for (const auto & [key, val] : lhs) {
+        if (!rhs.contains(key) || rhs.at(key) != val) {
+            std::cerr << "events: " << key << " " << val << "\nsnapshot: " << (rhs.contains(key) ? rhs.at(key) : "-")
+                      << "\n";
+        }
+    }
+    for (const auto & [key, val] : rhs) {
+        if (!lhs.contains(key)) {
+            std::cerr << "only in snapshot: " << key << " " << val << "\n";
+        }
+    }
+    assert(false && "events and snapshot disagree");
+}
+
+// ------------------------------------------------------------------ the farm
+
+constexpr size_t drvCount = 30;
+constexpr std::string_view x86 = "x86_64-linux";
+
+auto drvPath(size_t idx) -> std::string
+{
+    return std::format("{:032}-d{}.drv", idx, idx);
+}
+
+auto outPath(size_t idx) -> std::string
+{
+    return std::format("/nix/store/o{:031}-d{}", idx, idx);
+}
+
+// The cache key of its output.
+auto outKey(size_t idx) -> std::string
+{
+    return outPath(idx).substr(11, 32) + ".narinfo";
+}
+
+auto drvIndex(const std::string & path) -> size_t
+{
+    return std::stoul(path.substr(0, 32));
+}
+
+auto outSize(size_t idx) -> uint64_t
+{
+    return (idx + 1) * 1000;
+}
+
+// Fixed per drv, so every Want for it says the same.
+auto inputsOf(size_t idx) -> std::vector<std::string>
+{
+    std::mt19937 rng(static_cast<unsigned>(idx));
+    std::vector<std::string> inputs{std::format("/nix/store/s{:031}-src", idx)};
+    for (size_t dep = 0; dep < idx; dep++) {
+        if (rng() % 4 == 0) {
+            inputs.push_back(outPath(dep));
+        }
+    }
+    return inputs;
+}
+
+auto systemOf(size_t idx) -> std::string
+{
+    if (idx % 7 == 6) {
+        return "riscv64-linux"; // nobody offers it
+    }
+    if (idx % 5 == 4) {
+        return "aarch64-linux";
+    }
+    return idx % 3 == 0 ? "" : std::string(x86); // "" is the default system
+}
+
+auto featuresOf(size_t idx) -> std::vector<std::string>
+{
+    if (idx % 6 == 5) {
+        return {"kvm"};
+    }
+    if (idx % 11 == 10) {
+        return {"big"};
+    }
+    return {};
+}
+
+struct SimWorker
+{
+    std::string addr;
+    std::vector<std::string> systems;
+    std::vector<std::string> features;
+    bool varyJobs = false; // max_jobs 0..3, else 2
+    std::unique_ptr<Dispatcher::Worker> session;
+    std::mutex mutex; // the stats thread sends too (orphan Revokes)
+    std::vector<rpc::SchedCmd> cmds;
+    bool broken = false;  // sends fail, as on a dead stream
+    bool aborted = false; // the scheduler ended the session, so its stream is over
+    std::map<std::string, uint64_t> running; // drv -> assign id, kept across sessions like a builder
+};
+
+class Sim
+{
+public:
+    // Unwatched, the same steps run blind and only the late watcher's
+    // snapshot is checked.
+    Sim(unsigned seed, bool watched)
+        : watched(watched)
+        , rng(seed)
+        , disp(
+              Dispatcher::Config{
+                  .defaultSystem = std::string(x86),
+                  .present = [this](const std::vector<std::string> & keys) -> std::unordered_set<std::string> {
+                      std::unordered_set<std::string> have;
+                      for (const auto & key : keys) {
+                          if (cache.contains(key)) {
+                              have.insert(key);
+                          }
+                      }
+                      return have;
+                  },
+                  .lookupThreads = 0,
+                  .version = "test",
+                  .cacheUrl = "http://cache"},
+              metrics)
+    {
+        auto const add = [&](std::string addr, std::vector<std::string> systems, std::vector<std::string> features)
+            -> SimWorker * {
+            auto & wkr = *workers.emplace_back(std::make_unique<SimWorker>());
+            wkr.addr = std::move(addr);
+            wkr.systems = std::move(systems);
+            wkr.features = std::move(features);
+            return &wkr;
+        };
+        add("10.0.0.1:50051", {std::string(x86)}, {});
+        add("10.0.0.2:50051", {std::string(x86), "i686-linux"}, {"kvm"});
+        add("10.0.0.3:50051", {"aarch64-linux"}, {"big", "kvm"});
+        add("10.0.0.4:50051", {std::string(x86)}, {})->varyJobs = true;
+        if (watched) {
+            watchA();
+        }
+    }
+
+    void run(size_t steps)
+    {
+        for (size_t step = 0; step < steps; step++) {
+            before = model;
+            randomStep();
+            if (settle()) {
+                assertSame(model, snapshot(disp));
+            }
+        }
+        if (!watched) {
+            watched = true;
+            watchA();
+        }
+        checkRestart();
+    }
+
+private:
+    bool watched;
+    std::mt19937 rng;
+    Metrics metrics{""};
+    std::set<std::string> cache; // out keys the stub cache has
+    std::vector<std::unique_ptr<SimWorker>> workers;
+    std::map<uint64_t, Dispatcher::ClientPtr> clients;
+    std::unique_ptr<Sink> sinkA;
+    uint64_t watcherA = 0;
+    Model model;
+    Model before;
+    std::vector<rpc::WatchEvent> step; // this step's events
+    std::map<std::string, std::pair<std::string, uint64_t>> lastBuilder; // output -> worker, size
+    // Last, so its stats thread stops before the sessions and sinks it calls into go.
+    Dispatcher disp;
+
+    auto pick(size_t bound) -> size_t
+    {
+        return std::uniform_int_distribution<size_t>(0, bound - 1)(rng);
+    }
+
+    auto chance(double prob) -> bool
+    {
+        return std::bernoulli_distribution(prob)(rng);
+    }
+
+    void watchA()
+    {
+        sinkA = std::make_unique<Sink>();
+        auto const watcher = disp.watch(sinkA->send(), sinkA->end());
+        assert(watcher);
+        watcherA = *watcher;
+        model = Model{};
+        settle();
+        assert(model.live && model.reset.instance().size() == 32 && model.reset.version() == "test");
+        assert(model.reset.cache_url() == "http://cache" && model.reset.default_system() == x86);
+    }
+
+    // Apply what watcher A got since the last call. False when blind.
+    auto settle() -> bool
+    {
+        step.clear();
+        if (!watched) {
+            return false;
+        }
+        for (auto & event : sinkA->take()) {
+            apply(model, event);
+            if (!model.live || event.has_snapshot_done()) {
+                continue;
+            }
+            count(event);
+            checkSources(event);
+            step.push_back(std::move(event));
+        }
+        return true;
+    }
+
+    // Where the inputs of a just assigned drv come from, by our own record of
+    // who built what.
+    void checkSources(const rpc::WatchEvent & event)
+    {
+        if (!event.has_drv() || event.drv().phase() != rpc::DrvState::PHASE_ASSIGNED) {
+            return;
+        }
+        const auto & drv = event.drv();
+        auto const cause = drv.cause();
+        if (cause != rpc::DrvState::CAUSE_ASSIGNED && cause != rpc::DrvState::CAUSE_ADOPTED) {
+            return;
+        }
+        std::map<std::string, std::pair<uint32_t, uint64_t>> want;
+        uint32_t unknown = 0;
+        if (drv.inputs() > 0) {
+            auto const inputs = inputsOf(drvIndex(drv.drv_path()));
+            assert(drv.inputs() == inputs.size());
+            for (const auto & input : inputs) {
+                if (auto const iter = lastBuilder.find(input); iter != lastBuilder.end()) {
+                    want[iter->second.first].first++;
+                    want[iter->second.first].second += iter->second.second;
+                } else {
+                    unknown++;
+                }
+            }
+        }
+        std::map<std::string, std::pair<uint32_t, uint64_t>> got;
+        for (const auto & src : drv.input_sources()) {
+            got[src.worker_addr()] = {src.paths(), src.nar_bytes()};
+        }
+        assert(got == want && drv.inputs_unknown() == unknown);
+    }
+
+    auto events(const std::string & drv) const -> std::vector<const rpc::WatchEvent *>
+    {
+        std::vector<const rpc::WatchEvent *> out;
+        for (const auto & event : step) {
+            if ((event.has_drv() && event.drv().drv_path() == drv) || (event.has_drv_gone() && event.drv_gone().drv_path() == drv)
+                || (event.has_cached() && event.cached().drv_path() == drv)) {
+                out.push_back(&event);
+            }
+        }
+        return out;
+    }
+
+    auto gone(const std::string & drv) const -> const rpc::DrvGone *
+    {
+        for (const auto * event : events(drv)) {
+            if (event->has_drv_gone()) {
+                return &event->drv_gone();
+            }
+        }
+        return nullptr;
+    }
+
+    auto changed(const std::string & drv, rpc::DrvState::Cause cause) const -> const rpc::DrvState *
+    {
+        for (const auto * event : events(drv)) {
+            if (event->has_drv() && event->drv().cause() == cause) {
+                return &event->drv();
+            }
+        }
+        return nullptr;
+    }
+
+    // A drv that leaves `clients`: what the events must say about it.
+    void checkLeft(const std::string & path, const rpc::DrvState & was, uint64_t cid)
+    {
+        if (std::ranges::find(was.client_ids(), cid) == was.client_ids().end()) {
+            return;
+        }
+        if (was.client_ids_size() == 1 && was.phase() != rpc::DrvState::PHASE_ASSIGNED) {
+            const auto * out = gone(path);
+            assert(out && out->outcome() == rpc::DrvGone::DROPPED && out->worker_addr().empty());
+            return;
+        }
+        const auto * now = changed(path, rpc::DrvState::CAUSE_FOLLOWERS);
+        assert(now && std::ranges::find(now->client_ids(), cid) == now->client_ids().end());
+        assert(now->client_ids_size() == was.client_ids_size() - 1);
+    }
+
+    // A worker the scheduler took for gone is not in a later snapshot.
+    [[nodiscard]] auto up(const SimWorker & wkr) const -> bool
+    {
+        auto const iter = model.workers.find(wkr.addr);
+        return iter != model.workers.end() && iter->second.up();
+    }
+
+    [[nodiscard]] auto anyBroken() const -> bool
+    {
+        return std::ranges::any_of(workers, [](const auto & wkr) -> bool { return wkr->session && wkr->broken; });
+    }
+
+    void randomStep()
+    {
+        auto const roll = pick(100);
+        if (roll < 8) {
+            connect();
+        } else if (roll < 35) {
+            want();
+        } else if (roll < 42) {
+            cancel();
+        } else if (roll < 47) {
+            leave();
+        } else if (roll < 57) {
+            hello(*workers.at(pick(workers.size())));
+        } else if (roll < 85) {
+            done(*workers.at(pick(workers.size())));
+        } else if (roll < 91) {
+            load(*workers.at(pick(workers.size())));
+        } else if (roll < 96) {
+            workerGone(*workers.at(pick(workers.size())));
+        } else if (roll < 97) {
+            auto & wkr = *workers.at(pick(workers.size()));
+            const std::scoped_lock lock(wkr.mutex);
+            wkr.broken = true; // the next Expect to it fails
+        } else if (watched) {
+            disp.unwatch(watcherA);
+            watchA();
+        }
+    }
+
+    void connect()
+    {
+        static constexpr std::array<std::string_view, 3> identities{"ci-1", "oidc:dex:alice", "oidc:dex:bob"};
+        std::string const identity(identities.at(pick(identities.size())));
+        auto client = disp.connectClient([](const rpc::SchedMsg &) -> bool { return true; }, [] -> void {}, identity);
+        auto const cid = client->id;
+        clients.emplace(cid, std::move(client));
+        if (!settle()) {
+            return;
+        }
+        assert(step.size() == 1 && step[0].has_client() && step[0].client().id() == cid);
+        assert(step[0].client().identity() == identity && step[0].client().connected_ms() > 0);
+    }
+
+    auto anyClient() -> Dispatcher::ClientPtr
+    {
+        if (clients.empty()) {
+            return nullptr;
+        }
+        auto iter = clients.begin();
+        std::advance(iter, static_cast<std::ptrdiff_t>(pick(clients.size())));
+        return iter->second;
+    }
+
+    void want()
+    {
+        auto const client = anyClient();
+        if (client == nullptr) {
+            return;
+        }
+        rpc::ClientMsgs msgs;
+        struct Sent
+        {
+            std::string path;
+            bool cached;
+            bool checked;
+        };
+        std::vector<Sent> sent;
+        std::set<std::string> known;
+        for (const auto & [path, drv] : model.drvs) {
+            known.insert(path);
+        }
+        for (size_t n = 1 + pick(3); n > 0; n--) {
+            auto const idx = pick(drvCount);
+            auto * want = msgs.add_msgs()->mutable_want();
+            want->set_drv_path(drvPath(idx));
+            want->add_out_keys(outKey(idx));
+            for (const auto & input : inputsOf(idx)) {
+                want->add_inputs(input);
+            }
+            want->set_system(systemOf(idx));
+            for (const auto & feat : featuresOf(idx)) {
+                want->add_required_features(feat);
+            }
+            // Far apart, so the time a step takes never reorders the queue.
+            want->set_cp_hint_ms(pick(3) * 10'000'000);
+            want->set_build_mode(chance(0.15) ? 1 : 0);
+            bool const checked = want->build_mode() == 0;
+            bool const cached = checked && cache.contains(want->out_keys(0));
+            sent.push_back({.path = want->drv_path(), .cached = cached, .checked = checked && !cached});
+        }
+        disp.clientMsgs(client, msgs);
+        if (!settle()) {
+            return;
+        }
+        for (const auto & want : sent) {
+            if (want.cached) {
+                auto const hits = events(want.path);
+                assert(std::ranges::any_of(hits, [&](const rpc::WatchEvent * event) -> bool {
+                    return event->has_cached() && event->cached().client_id() == client->id
+                           && event->cached().system() == (systemOf(drvIndex(want.path)).empty() ? std::string(x86) : systemOf(drvIndex(want.path)));
+                }));
+            } else if (known.insert(want.path).second) {
+                const auto * fresh = changed(want.path, rpc::DrvState::CAUSE_WANTED);
+                assert(fresh && fresh->cache_checked() == want.checked && fresh->queued_ms() > 0);
+                assert(fresh->client_ids_size() == 1 && fresh->client_ids(0) == client->id);
+            }
+        }
+    }
+
+    void cancel()
+    {
+        auto const client = anyClient();
+        if (client == nullptr) {
+            return;
+        }
+        auto const path = drvPath(pick(drvCount));
+        rpc::ClientMsgs msgs;
+        msgs.add_msgs()->mutable_cancel()->set_drv_path(path);
+        disp.clientMsgs(client, msgs);
+        if (!settle()) {
+            return;
+        }
+        if (auto const was = before.drvs.find(path); was != before.drvs.end()) {
+            checkLeft(path, was->second, client->id);
+        } else {
+            assert(events(path).empty());
+        }
+    }
+
+    void leave()
+    {
+        auto const client = anyClient();
+        if (client == nullptr) {
+            return;
+        }
+        auto const cid = client->id;
+        disp.clientGone(client);
+        clients.erase(cid);
+        if (!settle()) {
+            return;
+        }
+        for (const auto & [path, was] : before.drvs) {
+            checkLeft(path, was, cid);
+        }
+        assert(!step.empty() && step.back().has_client_gone() && step.back().client_gone().id() == cid);
+    }
+
+    auto send(SimWorker & wkr, const rpc::WorkerMsg & msg) -> void
+    {
+        rpc::WorkerMsgs msgs;
+        *msgs.add_msgs() = msg;
+        disp.workerMsgs(*wkr.session, msgs);
+        const std::scoped_lock lock(wkr.mutex);
+        for (const auto & cmd : std::exchange(wkr.cmds, {})) {
+            if (cmd.has_expect()) {
+                wkr.running[cmd.expect().drv_path()] = cmd.expect().assign_id();
+            }
+        }
+    }
+
+    void hello(SimWorker & wkr)
+    {
+        std::unique_ptr<Dispatcher::Worker> old;
+        bool endedFirst = false; // the old session went before the Hello
+        bool aborted = false;
+        {
+            const std::scoped_lock lock(wkr.mutex);
+            aborted = std::exchange(wkr.aborted, false);
+        }
+        if (!wkr.session || aborted || chance(0.5)) {
+            // A new session; an old one closes after the new Hello, as a half-open stream does.
+            old = std::exchange(wkr.session, std::make_unique<Dispatcher::Worker>());
+            wkr.session->send = [&wkr](const rpc::SchedCmd & cmd) -> bool {
+                const std::scoped_lock lock(wkr.mutex);
+                wkr.cmds.push_back(cmd);
+                return !wkr.broken;
+            };
+            wkr.session->abort = [&wkr] -> void {
+                const std::scoped_lock lock(wkr.mutex);
+                wkr.aborted = true;
+            };
+            bool broken = false;
+            {
+                const std::scoped_lock lock(wkr.mutex);
+                broken = std::exchange(wkr.broken, false);
+            }
+            if (old && (broken || aborted)) {
+                // A stream that died ends before its worker reconnects.
+                disp.workerGone(*old);
+                old.reset();
+                endedFirst = true;
+            }
+        }
+        // Some builds finished while it was away, one comes from before a restart.
+        std::erase_if(wkr.running, [&](const auto &) -> bool { return chance(0.2); });
+        if (chance(0.1)) {
+            wkr.running[drvPath(pick(drvCount))] = 1'000'000 + pick(1000);
+        }
+        rpc::WorkerMsg msg;
+        auto * hel = msg.mutable_hello();
+        hel->set_addr(wkr.addr);
+        for (const auto & system : wkr.systems) {
+            hel->add_systems(system);
+        }
+        for (const auto & feat : wkr.features) {
+            hel->add_features(feat);
+        }
+        hel->set_max_jobs(wkr.varyJobs ? static_cast<uint32_t>(pick(4)) : 2);
+        auto const reported = wkr.running;
+        for (const auto & [path, assignId] : reported) {
+            auto * run = hel->add_running();
+            run->set_drv_path(path);
+            run->set_assign_id(assignId);
+        }
+        send(wkr, msg);
+        if (old) {
+            disp.workerGone(*old); // replaced: a no-op
+        }
+        if (!settle()) {
+            return;
+        }
+        for (const auto & [path, assignId] : reported) {
+            const auto * adopted = changed(path, rpc::DrvState::CAUSE_ADOPTED);
+            assert(adopted && adopted->worker_addr() == wkr.addr && adopted->assign_id() == assignId);
+            // Still running there, so not gone, unless a session ended in this step.
+            assert(endedFirst || anyBroken() || !gone(path));
+        }
+        // Assigned here before, not reported now: back in the queue or gone.
+        for (const auto & [path, was] : before.drvs) {
+            if (was.worker_addr() != wkr.addr || reported.contains(path)) {
+                continue;
+            }
+            assert(gone(path) || changed(path, rpc::DrvState::CAUSE_REQUEUED));
+        }
+        assert(up(wkr) || anyBroken());
+    }
+
+    // An aborted session is over, as its stream would be. The builder
+    // reconnects with a Hello later.
+    auto live(SimWorker & wkr) -> bool
+    {
+        if (!wkr.session) {
+            return false;
+        }
+        bool aborted = false;
+        {
+            const std::scoped_lock lock(wkr.mutex);
+            aborted = std::exchange(wkr.aborted, false);
+        }
+        if (aborted) {
+            disp.workerGone(*wkr.session);
+            wkr.session.reset();
+            return false;
+        }
+        return true;
+    }
+
+    void done(SimWorker & wkr)
+    {
+        if (!live(wkr)) {
+            return;
+        }
+        std::string path;
+        uint64_t assignId = 0;
+        if (!wkr.running.empty() && chance(0.85)) {
+            auto iter = wkr.running.begin();
+            std::advance(iter, static_cast<std::ptrdiff_t>(pick(wkr.running.size())));
+            path = iter->first;
+            assignId = iter->second;
+        } else {
+            path = drvPath(pick(drvCount)); // stale or unknown
+            assignId = pick(4);             // rarely the current assignment
+        }
+        static constexpr std::array outcomes{
+            rpc::Done::BUILT, rpc::Done::BUILT, rpc::Done::BUILT, rpc::Done::FAILED, rpc::Done::CANCELLED,
+            rpc::Done::GIVEN_BACK, rpc::Done::NO_SHOW};
+        rpc::WorkerMsg msg;
+        auto * done = msg.mutable_done();
+        done->set_drv_path(path);
+        done->set_assign_id(assignId);
+        done->set_outcome(outcomes.at(pick(outcomes.size())));
+        done->set_reason(static_cast<rpc::Done::Reason>(pick(6)));
+        auto const idx = drvIndex(path);
+        if (done->outcome() == rpc::Done::BUILT) {
+            auto * out = done->add_outputs();
+            out->set_path(outPath(idx));
+            out->set_nar_size(outSize(idx));
+            lastBuilder[outPath(idx)] = {wkr.addr, outSize(idx)};
+            if (chance(0.7)) {
+                cache.insert(outKey(idx));
+            }
+        }
+        wkr.running.erase(path);
+        bool const strict = !anyBroken(); // else dispatching may requeue or drop anything
+        send(wkr, msg);
+        if (!settle()) {
+            return;
+        }
+        auto const was = before.drvs.find(path);
+        // A Done ends only the assignment it names.
+        bool const mine = was != before.drvs.end() && was->second.phase() == rpc::DrvState::PHASE_ASSIGNED
+                          && was->second.worker_addr() == wkr.addr && was->second.assign_id() == assignId;
+        const auto * out = gone(path);
+        if (!mine) {
+            assert(!strict || (!out && !changed(path, rpc::DrvState::CAUSE_REQUEUED)));
+            return;
+        }
+        switch (done->outcome()) {
+        case rpc::Done::GIVEN_BACK:
+        case rpc::Done::NO_SHOW:
+            if (was->second.client_ids_size() == 0) {
+                assert(out && out->outcome() == rpc::DrvGone::DROPPED && out->worker_addr() == wkr.addr);
+            } else {
+                const auto * back = changed(path, rpc::DrvState::CAUSE_REQUEUED);
+                assert(!out && back && !back->reason().empty());
+            }
+            break;
+        default:
+            assert(out && out->worker_addr() == wkr.addr);
+            assert(static_cast<int>(out->outcome()) == static_cast<int>(done->outcome()));
+            assert(out->outputs_size() == (done->outcome() == rpc::Done::BUILT ? 1 : 0));
+        }
+    }
+
+    void load(SimWorker & wkr)
+    {
+        if (!live(wkr)) {
+            return;
+        }
+        rpc::WorkerMsg msg;
+        msg.mutable_load()->set_draining(chance(0.5));
+        send(wkr, msg);
+        if (!settle()) {
+            return;
+        }
+        assert(!up(wkr) || model.workers.at(wkr.addr).draining() == msg.load().draining());
+    }
+
+    void workerGone(SimWorker & wkr)
+    {
+        if (!wkr.session) {
+            return;
+        }
+        disp.workerGone(*wkr.session);
+        wkr.session.reset();
+        if (!settle()) {
+            return;
+        }
+        assert(!up(wkr));
+        for (const auto & [path, was] : before.drvs) {
+            if (was.worker_addr() != wkr.addr) {
+                continue;
+            }
+            if (was.client_ids_size() == 0) {
+                const auto * out = gone(path);
+                assert(out && out->outcome() == rpc::DrvGone::DROPPED);
+            } else {
+                assert(changed(path, rpc::DrvState::CAUSE_REQUEUED));
+            }
+        }
+    }
+
+    // Yielding ends every stream.
+    void checkRestart()
+    {
+        disp.restarting();
+        {
+            const std::scoped_lock lock(sinkA->mutex);
+            assert(sinkA->ended);
+        }
+        Sink passive;
+        assert(!disp.watch(passive.send(), passive.end()));
+        disp.serving();
+        auto const fresh = snapshot(disp);
+        assert(fresh.reset.instance() == model.reset.instance());
+    }
+};
+
+// One drv end to end, with the fields a dashboard shows.
+void testLifecycle()
+{
+    Metrics metrics("");
+    Dispatcher disp({.defaultSystem = std::string(x86), .lookupThreads = 0}, metrics);
+    Sink sink;
+    auto const watcher = disp.watch(sink.send(), sink.end());
+    assert(watcher);
+    std::vector<rpc::SchedCmd> cmds;
+    std::mutex mutex;
+    Dispatcher::Worker wkr{.send = [&](const rpc::SchedCmd & cmd) -> bool {
+        const std::scoped_lock lock(mutex);
+        cmds.push_back(cmd);
+        return true;
+    }};
+    auto const hello = [&](const std::string & addr, Dispatcher::Worker & session) -> void {
+        rpc::WorkerMsgs msgs;
+        auto * hel = msgs.add_msgs()->mutable_hello();
+        hel->set_addr(addr);
+        hel->add_systems(std::string(x86));
+        hel->set_max_jobs(1);
+        disp.workerMsgs(session, msgs);
+    };
+    hello("w1", wkr);
+    // dep.drv is built on w1 first, so app.drv's input is local there.
+    auto client = disp.connectClient([](const rpc::SchedMsg &) -> bool { return true; }, [] -> void {}, "oidc:dex:alice");
+    rpc::ClientMsgs msgs;
+    auto * dep = msgs.add_msgs()->mutable_want();
+    dep->set_drv_path("dep.drv");
+    disp.clientMsgs(client, msgs);
+    rpc::WorkerMsgs done;
+    auto * out = done.add_msgs()->mutable_done();
+    out->set_drv_path("dep.drv");
+    {
+        const std::scoped_lock lock(mutex);
+        out->set_assign_id(cmds.back().expect().assign_id());
+    }
+    out->set_outcome(rpc::Done::BUILT);
+    auto * path = out->add_outputs();
+    path->set_path("/nix/store/dep-out");
+    path->set_nar_size(4096);
+    disp.workerMsgs(wkr, done);
+    msgs.Clear();
+    auto * app = msgs.add_msgs()->mutable_want();
+    app->set_drv_path("app.drv");
+    app->add_inputs("/nix/store/dep-out");
+    app->add_inputs("/nix/store/src");
+    disp.clientMsgs(client, msgs);
+
+    Model model;
+    std::vector<std::string> kinds;
+    for (const auto & event : sink.take()) {
+        apply(model, event);
+        if (model.live && !event.has_snapshot_done()) {
+            kinds.push_back(label(event));
+        }
+    }
+    assert(
+        (kinds
+         == std::vector<std::string>{
+             "worker", "client", "dep.drv:CAUSE_WANTED", "dep.drv:CAUSE_ASSIGNED", "dep.drv:BUILT",
+             "app.drv:CAUSE_WANTED", "app.drv:CAUSE_ASSIGNED"}));
+    const auto & assigned = model.drvs.at("app.drv");
+    assert(assigned.phase() == rpc::DrvState::PHASE_ASSIGNED && assigned.worker_addr() == "w1");
+    assert(assigned.queued_ms() > 0 && assigned.assigned_ms() >= assigned.queued_ms());
+    assert(assigned.system() == x86 && assigned.inputs() == 2 && assigned.inputs_unknown() == 1);
+    assert(assigned.input_sources_size() == 1 && assigned.input_sources(0).worker_addr() == "w1");
+    assert(assigned.input_sources(0).nar_bytes() == 4096 && !assigned.cache_checked());
+    assert(model.clients.at(client->id).identity() == "oidc:dex:alice");
+    // A watcher that refuses its snapshot is not kept.
+    Sink stuck;
+    assert(!disp.watch([](const rpc::WatchEvent &) -> bool { return false; }, stuck.end()));
+    disp.unwatch(*watcher);
+}
+
+// A worker says Hello on a new session while the old one still looks open,
+// reporting two drvs no client waits for. Hello retires them first and adopts
+// them again under swapped ids. They are still running: not dropped.
+void testRehello()
+{
+    Metrics metrics("");
+    Dispatcher disp({.defaultSystem = std::string(x86), .lookupThreads = 0}, metrics);
+    auto const hello = [&](Dispatcher::Worker & session) -> void {
+        rpc::WorkerMsgs msgs;
+        auto * hel = msgs.add_msgs()->mutable_hello();
+        hel->set_addr("10.0.0.1:50051");
+        hel->add_systems(std::string(x86));
+        hel->set_max_jobs(4);
+        uint64_t assignId = 1;
+        for (auto const * path : {"aaaa-a.drv", "bbbb-b.drv"}) {
+            auto * run = hel->add_running();
+            run->set_drv_path(path);
+            run->set_assign_id(assignId++);
+        }
+        disp.workerMsgs(session, msgs);
+    };
+    auto const send = [](const rpc::SchedCmd &) -> bool { return true; };
+    Dispatcher::Worker first{.send = send, .abort = [] -> void {}};
+    Dispatcher::Worker second{.send = send, .abort = [] -> void {}};
+    hello(first);
+    Sink sink;
+    auto const watcher = disp.watch(sink.send(), sink.end());
+    assert(watcher);
+    Model model;
+    for (const auto & event : sink.take()) {
+        apply(model, event);
+    }
+    assert(model.live && model.drvs.size() == 2);
+    hello(second);
+    std::vector<std::string> kinds;
+    for (const auto & event : sink.take()) {
+        apply(model, event);
+        kinds.push_back(label(event));
+    }
+    assert((kinds == std::vector<std::string>{"worker", "aaaa-a.drv:CAUSE_ADOPTED", "bbbb-b.drv:CAUSE_ADOPTED"}));
+    assert(model.drvs.size() == 2);
+    for (const auto & [path, drv] : model.drvs) {
+        assert(drv.phase() == rpc::DrvState::PHASE_ASSIGNED && drv.worker_addr() == "10.0.0.1:50051");
+    }
+    disp.unwatch(*watcher);
+}
+
+void testRandom()
+{
+    for (unsigned seed = 1; seed <= 8; seed++) {
+        Sim(seed, true).run(1500);
+    }
+    // Without a watcher, other code paths run. A watcher that comes last
+    // still gets a snapshot that agrees with the scheduler.
+    for (unsigned seed = 11; seed <= 13; seed++) {
+        Sim(seed, false).run(1500);
+    }
+    for (const auto & [kind, times] : seen) {
+        std::cerr << "seen " << kind << " " << times << "\n";
+    }
+    for (auto const * kind :
+         {"CAUSE_WANTED", "CAUSE_FOLLOWERS", "CAUSE_ASSIGNED", "CAUSE_ADOPTED", "CAUSE_REQUEUED", "CAUSE_PLACEABILITY",
+          "unplaceable", "undeliverable", "BUILT", "FAILED", "CANCELLED", "DROPPED"}) {
+        assert(seen[kind] > 0);
+    }
+    for (auto const kind :
+         {rpc::WatchEvent::kWorker, rpc::WatchEvent::kClient, rpc::WatchEvent::kClientGone, rpc::WatchEvent::kCached}) {
+        assert(seen[std::to_string(kind)] > 0);
+    }
+}
+
+} // namespace
+// NOLINTEND(*-magic-numbers, *-avoid-unchecked-container-access, bugprone-unchecked-optional-access, readability-identifier-length, cert-msc32-c, cert-msc51-cpp, bugprone-random-generator-seed, misc-use-internal-linkage)
+
+auto main() -> int
+try {
+    testLifecycle();
+    testRehello();
+    testRandom();
+    return 0;
+} catch (std::exception & err) {
+    std::cerr << err.what() << "\n";
+    return 1;
+}
