new file mode 100644
index 0000000..1d5758a
--- /dev/null
+++ b/src/daemon/events.cc
@@ -0,0 +1,88 @@
+// Events.Watch: auth and the stream caps. WatchReactor does the rest.
+
+#include "events.hh"
+
+#include <absl/synchronization/mutex.h>
+#include <string>
+#include <utility>
+
+#include <grpcpp/server_context.h>
+#include <grpcpp/support/server_callback.h>
+#include <grpcpp/support/status.h>
+
+#include "acl.hh"
+#include "auth.hh"
+#include "dispatcher.hh"
+#include "events.pb.h"
+#include "idle.hh"
+#include "logfmt.hh"
+#include "sched-reactor.hh"
+
+namespace nixgrpc {
+
+EventsService::EventsService(Dispatcher & dispatcher, Auth & auth, IdleTracker & idle)
+    : dispatcher(&dispatcher)
+    , auth(&auth)
+    , idle(&idle)
+{
+}
+
+auto StreamLimit::acquire(const std::string & caller) -> bool
+{
+    const absl::MutexLock lock(mutex);
+    auto const iter = byCaller.find(caller);
+    if (open >= total || (iter != byCaller.end() && iter->second >= perCaller)) {
+        return false;
+    }
+    open++;
+    byCaller[caller]++;
+    return true;
+}
+
+void StreamLimit::release(const std::string & caller)
+{
+    const absl::MutexLock lock(mutex);
+    auto const iter = byCaller.find(caller);
+    if (iter == byCaller.end()) {
+        return;
+    }
+    open--;
+    if (--iter->second == 0) {
+        byCaller.erase(iter);
+    }
+}
+
+auto EventsService::Watch(grpc::CallbackServerContext * context, const nix::remote::WatchRequest * /*request*/)
+    -> grpc::ServerWriteReactor<nix::remote::WatchEvents> *
+{
+    using Reject = RejectWriter<nix::remote::WatchEvents>;
+    if (!active_) {
+        return new Reject(WatchReactor::passive()); // NOLINT(cppcoreguidelines-owning-memory): deletes itself in OnDone
+    }
+    auto const caller = auth->identify(*context);
+    // The stream names clients and derivations: never for anonymous callers,
+    // whatever --allow-anonymous grants.
+    if (caller.kind == Caller::Kind::anonymous) {
+        if (auth->metrics != nullptr) {
+            auth->metrics->countDenied("Watch", "anonymous");
+        }
+        logLine(LogLevel::info, {{"event", "denied"}, {"method", "Watch"}, {"cn", caller.name}, {"role", "anonymous"}});
+        return new Reject({grpc::StatusCode::UNAUTHENTICATED, "Watch requires a TLS client certificate or bearer token"}); // NOLINT(cppcoreguidelines-owning-memory)
+    }
+    if (auto const status = auth->authorize(caller, "Watch", Role::watch); !status.ok()) {
+        return new Reject(status); // NOLINT(cppcoreguidelines-owning-memory)
+    }
+    if (!streams.acquire(caller.name)) {
+        logLine(LogLevel::info, {{"event", "watch_stream_refused"}, {"cn", caller.name}});
+        return new Reject({grpc::StatusCode::RESOURCE_EXHAUSTED, "too many Watch streams, for this caller or in all"}); // NOLINT(cppcoreguidelines-owning-memory)
+    }
+    auto peer = context->peer();
+    logLine(LogLevel::info, {{"event", "watch_stream_open"}, {"cn", caller.name}, {"peer", peer}});
+    return new WatchReactor( // NOLINT(cppcoreguidelines-owning-memory): deletes itself in OnDone
+        context, *dispatcher, *idle, [this, name = caller.name, peer = std::move(peer)] -> void {
+            streams.release(name);
+            logLine(LogLevel::info, {{"event", "watch_stream_closed"}, {"cn", name}, {"peer", peer}});
+        });
+}
+
+} // namespace nixgrpc
