# Refuse a dependency whose engines field rules out this Node.
engine-strict=true
# No dependency needs an install script. fsevents, the only one with one, ships its binary.
ignore-scripts=true
# The dev shell links node_modules from the Nix store. npm install and npm update then
# write only package.json and package-lock.json; the next nix develop links the result.
package-lock-only=true
